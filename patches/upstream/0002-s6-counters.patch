+uint32_t CurrentProcessorNumber() {
+#ifdef _WIN32
+  PROCESSOR_NUMBER number;
+  GetCurrentProcessorNumberEx(&number);
+  return uint32_t(number.Group) * 64 + uint32_t(number.Number);
