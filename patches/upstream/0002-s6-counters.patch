+// wwe2k14 patch (Session 6, COUNTERS): per-frame counters and GPU timestamps. Measurement only: nothing here
+// changes what is emulated, recorded into the command stream for the guest, or presented.
+
+void VulkanCommandProcessor::CollectFrameCounters(FrameCounters& counters) {
+  if (shared_memory_) {
+    SharedMemory::RequestStats request_stats = shared_memory_->TakeRequestStats();
+    counters.request_ranges = request_stats.calls;
+    counters.request_ranges_all_valid = request_stats.calls - request_stats.upload_calls;
+    counters.upload_kib = uint32_t(request_stats.upload_bytes >> 10);
+  }
+  counters.checkpoint_next_id = crash_checkpoints_enabled() ? uint32_t(crash_checkpoint_next_id_) : 0;
+}
+
+void VulkanCommandProcessor::CountFetchConstantsWritten(uint32_t first_index, uint32_t last_index) {
+  // The same range TextureCache::TextureFetchConstantsWritten handles.
+  if (first_index > last_index) {
+    std::swap(first_index, last_index);
+  }
+  if (first_index > 31) {
+    return;
+  }
+  last_index = std::min(last_index, uint32_t(31));
+  frame_counters_.fetch_constant_notifications += last_index - first_index + 1;
+  if (!frame_counters_enabled_) {
+    return;
+  }
+  const uint32_t* fetch_constants = &register_file_->values[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0];
+  for (uint32_t i = first_index; i <= last_index; ++i) {
+    const uint32_t* fetch_constant = fetch_constants + i * 6;
+    if (std::memcmp(fetch_constants_seen_[i], fetch_constant, sizeof(fetch_constants_seen_[i]))) {
+      std::memcpy(fetch_constants_seen_[i], fetch_constant, sizeof(fetch_constants_seen_[i]));
+      ++frame_counters_.fetch_constant_changed;
+    }
+  }
+}
+
+uint32_t VulkanCommandProcessor::GpuTimestampsBeginSubmission(bool is_swap) {
+  // Latched here, per submission: the query pair is either written at both ends of the command buffer or not
+  // at all.
+  if (!REXCVAR_GET(vulkan_gpu_timestamps) || !perf::timeline::Enabled()) {
+    return UINT32_MAX;
+  }
+  if (gpu_timestamps_pool_ == VK_NULL_HANDLE &&
+      (gpu_timestamps_unsupported_ || !GpuTimestampsInitialize())) {
+    return UINT32_MAX;
+  }
+  const uint64_t submission = GetCurrentSubmission();
+  const uint32_t slot = uint32_t(submission % kGpuTimestampSlots);
+  uint64_t& slot_submission = gpu_timestamps_slot_submission_[slot];
+  if (slot_submission && slot_submission != submission && slot_submission > submission_completed_) {
+    // Too many submissions in flight: the slot's previous submission hasn't completed. Skip this one.
+    return UINT32_MAX;
+  }
+  slot_submission = submission;
+  gpu_timestamps_slot_is_swap_[slot] = is_swap;
+  return slot;
+}
+
+bool VulkanCommandProcessor::GpuTimestampsInitialize() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkPhysicalDevice physical_device = vulkan_device->physical_device();
+  const VkDevice device = vulkan_device->device();
+
+  uint32_t queue_family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count, nullptr);
+  std::vector<VkQueueFamilyProperties> queue_families(queue_family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count,
+                                               queue_families.data());
+  const uint32_t queue_family = vulkan_device->queue_family_graphics_compute();
+  const uint32_t valid_bits =
+      queue_family < queue_family_count ? queue_families[queue_family].timestampValidBits : 0;
+  VkPhysicalDeviceProperties physical_device_properties;
+  ifn.vkGetPhysicalDeviceProperties(physical_device, &physical_device_properties);
+  const float period_ns = physical_device_properties.limits.timestampPeriod;
+  // Core Vulkan 1.0 functions that the device function table doesn't load.
+  gpu_timestamps_cmd_write_ =
+      PFN_vkCmdWriteTimestamp(ifn.vkGetDeviceProcAddr(device, "vkCmdWriteTimestamp"));
+  gpu_timestamps_get_results_ =
+      PFN_vkGetQueryPoolResults(ifn.vkGetDeviceProcAddr(device, "vkGetQueryPoolResults"));
+  if (!valid_bits || !(period_ns > 0.0f) || !gpu_timestamps_cmd_write_ || !gpu_timestamps_get_results_) {
+    REXGPU_WARN(
+        "[s6][COUNTERS] GPU timestamps unavailable (queue family {} timestampValidBits {}, timestampPeriod "
+        "{}); vulkan_gpu_timestamps disabled",
+        queue_family, valid_bits, period_ns);
+    gpu_timestamps_unsupported_ = true;
+    return false;
+  }
+  VkQueryPoolCreateInfo query_pool_create_info = {};
+  query_pool_create_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  query_pool_create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  query_pool_create_info.queryCount = kGpuTimestampSlots * 2;
+  if (dfn.vkCreateQueryPool(device, &query_pool_create_info, nullptr, &gpu_timestamps_pool_) !=
+      VK_SUCCESS) {
+    REXGPU_WARN("[s6][COUNTERS] GPU timestamps: failed to create a query pool; vulkan_gpu_timestamps disabled");
+    gpu_timestamps_pool_ = VK_NULL_HANDLE;
+    gpu_timestamps_unsupported_ = true;
+    return false;
+  }
+  gpu_timestamps_period_ns_ = double(period_ns);
+  gpu_timestamps_mask_ = valid_bits >= 64 ? UINT64_MAX : (uint64_t(1) << valid_bits) - 1;
+  gpu_timestamps_slot_submission_.fill(0);
+  gpu_timestamps_read_up_to_ = submission_completed_;
+  REXGPU_INFO("[s6][COUNTERS] GPU timestamps on: {} valid bits, {} ns per tick", valid_bits, period_ns);
+  return true;
+}
+
+void VulkanCommandProcessor::GpuTimestampsWriteBegin(VkCommandBuffer command_buffer,
+                                                     uint32_t slot) const {
+  // At the start of the command buffer: outside any render pass, and before the first command of the
+  // submission. Query commands execute in submission order, so the reset precedes the write.
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  dfn.vkCmdResetQueryPool(command_buffer, gpu_timestamps_pool_, slot * 2, 2);
+  gpu_timestamps_cmd_write_(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, gpu_timestamps_pool_,
+                            slot * 2);
+}
+
+void VulkanCommandProcessor::GpuTimestampsWriteEnd(VkCommandBuffer command_buffer, uint32_t slot) const {
+  gpu_timestamps_cmd_write_(command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_timestamps_pool_,
+                            slot * 2 + 1);
+}
+
+void VulkanCommandProcessor::GpuTimestampsRead() {
+  // Only submissions whose fence has been seen signaled (submission_completed_), so the results are available
+  // and this never waits.
+  const VkDevice device = GetVulkanDevice()->device();
+  uint64_t first = gpu_timestamps_read_up_to_ + 1;
+  if (submission_completed_ >= kGpuTimestampSlots &&
+      first + kGpuTimestampSlots <= submission_completed_) {
+    first = submission_completed_ - kGpuTimestampSlots + 1;
+  }
+  for (uint64_t submission = first; submission <= submission_completed_; ++submission) {
+    const uint32_t slot = uint32_t(submission % kGpuTimestampSlots);
+    if (gpu_timestamps_slot_submission_[slot] != submission) {
+      continue;
+    }
+    gpu_timestamps_slot_submission_[slot] = 0;
+    uint64_t ticks[2];
+    if (gpu_timestamps_get_results_(device, gpu_timestamps_pool_, slot * 2, 2, sizeof(ticks), ticks,
+                                    sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      continue;
+    }
+    const uint64_t delta_ticks = (ticks[1] - ticks[0]) & gpu_timestamps_mask_;
+    const double gpu_us = double(delta_ticks) * gpu_timestamps_period_ns_ / 1000.0;
+    perf::timeline::Record("gpu_ts", uint32_t(submission),
+                           uint32_t(std::min(gpu_us + 0.5, double(UINT32_MAX))),
+                           gpu_timestamps_slot_is_swap_[slot] ? 1 : 0);
+  }
+  gpu_timestamps_read_up_to_ = submission_completed_;
+}
+
+void VulkanCommandProcessor::GpuTimestampsShutdown() {
+  if (gpu_timestamps_pool_ != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), gpu_timestamps_pool_, nullptr);
+    gpu_timestamps_pool_ = VK_NULL_HANDLE;
+  }
+  gpu_timestamps_slot_submission_.fill(0);
+}
+
 }  // namespace rex::graphics::vulkan
