+void VulkanCommandProcessor::ReportGpuCrashDiagnostics() {
+  if (gpu_crash_reported_) {
+    return;
+  }
+  gpu_crash_reported_ = true;
+
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const ui::vulkan::VulkanDevice::Extensions& extensions = vulkan_device->extensions();
+  if (!extensions.ext_EXT_device_fault && !extensions.ext_NV_device_diagnostic_checkpoints) {
+    REXGPU_ERROR("GPU crash diagnostics: not enabled (vulkan_gpu_crash_diagnostics)");
+    return;
+  }
+  REXGPU_ERROR(
+      "GPU crash diagnostics: device lost; current submission {}, completed {}, frame {}; "
+      "readback buffers {} (+{} memexport)",
+      GetCurrentSubmission(), submission_completed_, frame_current_, readback_buffers_.size(),
+      memexport_readback_buffers_.size());
+
+  if (extensions.ext_EXT_device_fault && dfn.vkGetDeviceFaultInfoEXT) {
+    VkDeviceFaultCountsEXT fault_counts = {VK_STRUCTURE_TYPE_DEVICE_FAULT_COUNTS_EXT};
+    VkResult fault_result =
+        dfn.vkGetDeviceFaultInfoEXT(vulkan_device->device(), &fault_counts, nullptr);
+    if (fault_result != VK_SUCCESS && fault_result != VK_INCOMPLETE) {
+      REXGPU_ERROR("GPU crash diagnostics: vkGetDeviceFaultInfoEXT (counts) failed: {}",
+                   int32_t(fault_result));
+    } else {
+      std::vector<VkDeviceFaultAddressInfoEXT> address_infos(fault_counts.addressInfoCount);
+      std::vector<VkDeviceFaultVendorInfoEXT> vendor_infos(fault_counts.vendorInfoCount);
+      // The vendor binary crash dump isn't requested.
+      fault_counts.vendorBinarySize = 0;
+      VkDeviceFaultInfoEXT fault_info = {VK_STRUCTURE_TYPE_DEVICE_FAULT_INFO_EXT};
+      fault_info.pAddressInfos = address_infos.empty() ? nullptr : address_infos.data();
+      fault_info.pVendorInfos = vendor_infos.empty() ? nullptr : vendor_infos.data();
+      fault_result =
+          dfn.vkGetDeviceFaultInfoEXT(vulkan_device->device(), &fault_counts, &fault_info);
+      REXGPU_ERROR(
+          "GPU crash diagnostics: device fault (result {}): '{}', {} address(es), {} vendor "
+          "info(s)",
+          int32_t(fault_result), fault_info.description, fault_counts.addressInfoCount,
+          fault_counts.vendorInfoCount);
+      for (uint32_t i = 0; i < fault_counts.addressInfoCount && i < address_infos.size(); ++i) {
+        const VkDeviceFaultAddressInfoEXT& address_info = address_infos[i];
+        VkDeviceSize precision = std::max(address_info.addressPrecision, VkDeviceSize(1));
+        VkDeviceAddress lower = address_info.reportedAddress & ~(precision - 1);
+        REXGPU_ERROR(
+            "GPU crash diagnostics:   address {}: {} at 0x{:016X} (range 0x{:016X}-0x{:016X})", i,
+            DeviceFaultAddressTypeName(address_info.addressType), address_info.reportedAddress,
+            lower, lower + precision - 1);
+      }
+      for (uint32_t i = 0; i < fault_counts.vendorInfoCount && i < vendor_infos.size(); ++i) {
+        const VkDeviceFaultVendorInfoEXT& vendor_info = vendor_infos[i];
+        REXGPU_ERROR("GPU crash diagnostics:   vendor {}: '{}' code 0x{:X} data 0x{:X}", i,
+                     vendor_info.description, vendor_info.vendorFaultCode,
+                     vendor_info.vendorFaultData);
+      }
+    }
+  }
+
+  if (extensions.ext_NV_device_diagnostic_checkpoints && dfn.vkGetQueueCheckpointDataNV) {
+    std::vector<VkCheckpointDataNV> checkpoints;
+    {
+      ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+          vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+      uint32_t checkpoint_count = 0;
+      dfn.vkGetQueueCheckpointDataNV(queue_acquisition.queue(), &checkpoint_count, nullptr);
+      VkCheckpointDataNV checkpoint_template = {VK_STRUCTURE_TYPE_CHECKPOINT_DATA_NV};
+      checkpoints.resize(checkpoint_count, checkpoint_template);
+      if (checkpoint_count) {
+        dfn.vkGetQueueCheckpointDataNV(queue_acquisition.queue(), &checkpoint_count,
+                                       checkpoints.data());
+        checkpoints.resize(checkpoint_count);
+      }
+    }
+    REXGPU_ERROR("GPU crash diagnostics: {} queue checkpoint(s); last id issued {}",
+                 checkpoints.size(), crash_checkpoint_next_id_ - 1);
+    uint64_t id_min = UINT64_MAX, id_max = 0;
+    for (const VkCheckpointDataNV& checkpoint : checkpoints) {
+      uint64_t marker = uint64_t(reinterpret_cast<uintptr_t>(checkpoint.pCheckpointMarker));
+      uint64_t id = marker >> 2;
+      REXGPU_ERROR("GPU crash diagnostics:   stage 0x{:X}: id {} ({})",
+                   uint32_t(checkpoint.stage), id, CrashCheckpointPhaseName(uint32_t(marker & 3)));
+      if (id) {
+        id_min = std::min(id_min, id);
+        id_max = std::max(id_max, id);
+      }
+    }
+    if (id_max && !crash_checkpoint_ring_.empty()) {
+      uint64_t first = id_min > 8 ? id_min - 8 : 1;
+      uint64_t last = std::min(id_max + 8, crash_checkpoint_next_id_ - 1);
+      if (last - first > 96) {
+        first = last - 96;
+      }
+      for (uint64_t id = first; id <= last; ++id) {
+        const CrashCheckpointRecord& r = crash_checkpoint_ring_[id % kCrashCheckpointRingSize];
+        if (r.id != id) {
+          continue;
+        }
+        REXGPU_ERROR(
+            "GPU crash diagnostics:   #{} {} sub={} frame={} vs={:016X} ps={:016X} prim={}/{} "
+            "guest_count={} host_count={} ib_type={} ib_base=0x{:X} edram_mode={} "
