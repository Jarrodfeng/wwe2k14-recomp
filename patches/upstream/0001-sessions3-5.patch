diff --git a/src/core/perf/timeline.cpp b/src/core/perf/timeline.cpp
new file mode 100644
index 0000000..70534f4
--- /dev/null
+++ b/src/core/perf/timeline.cpp
@@ -0,0 +1,75 @@
+/**
+ * @file        perf/timeline.cpp
+ * @brief       Event timeline for frame-pacing investigations (wwe2k14 patch); see perf/timeline.h
+ */
+#include <rex/perf/timeline.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <mutex>
+
+#ifdef _WIN32
+#include "../platform_win.h"
+#else
+#include <pthread.h>
+#endif
+
+namespace rex::perf::timeline {
+namespace {
+
+std::atomic<bool> g_enabled{false};
+std::mutex g_mutex;
+std::FILE* g_file = nullptr;
+std::chrono::steady_clock::time_point g_start;
+std::chrono::steady_clock::time_point g_last_flush;
+
+uint32_t HostThreadId() {
+#ifdef _WIN32
+  return uint32_t(GetCurrentThreadId());
+#else
+  return uint32_t(uintptr_t(pthread_self()));
+#endif
+}
+
+}  // namespace
+
+bool Start(const char* path) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_file) return true;
+  g_file = std::fopen(path, "w");
+  if (!g_file) return false;
+  std::setvbuf(g_file, nullptr, _IOFBF, 4 << 20);
+  std::fputs("t_ns,thread,event,a,b,c\n", g_file);
+  g_start = g_last_flush = std::chrono::steady_clock::now();
+  g_enabled.store(true, std::memory_order_release);
+  return true;
+}
+
+void Stop() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_enabled.store(false, std::memory_order_release);
+  if (g_file) {
+    std::fclose(g_file);
+    g_file = nullptr;
+  }
+}
+
+bool Enabled() { return g_enabled.load(std::memory_order_relaxed); }
+
+void Record(const char* event, uint32_t a, uint32_t b, uint32_t c) {
+  if (!Enabled()) return;
+  const auto now = std::chrono::steady_clock::now();
+  const uint32_t thread = HostThreadId();
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (!g_file) return;
+  const long long t = std::chrono::duration_cast<std::chrono::nanoseconds>(now - g_start).count();
+  std::fprintf(g_file, "%lld,%u,%s,0x%X,0x%X,0x%X\n", t, thread, event, a, b, c);
+  // Flush about once a second so a crash loses little and the file can be read while the game runs.
+  if (now - g_last_flush >= std::chrono::seconds(1)) {
+    std::fflush(g_file);
+    g_last_flush = now;
+  }
+}
+
+}  // namespace rex::perf::timeline
