+void VulkanCommandProcessor::AsyncSubmitThreadMain() {
+  rex::thread::set_current_thread_name("GPU Submit");
+  for (;;) {
+    AsyncSubmitJob job;
+    {
+      std::unique_lock<std::mutex> lock(async_submit_mutex_);
+      async_submit_work_cv_.wait(lock,
+                                 [this] { return async_submit_stop_ || !async_submit_queue_.empty(); });
+      if (async_submit_queue_.empty()) {
+        return;  // Stop requested and nothing left to submit.
+      }
+      job = std::move(async_submit_queue_.front());
+      async_submit_queue_.pop_front();
+      async_submit_busy_ = true;
+    }
+    AsyncSubmitExecute(job);
+    {
+      std::lock_guard<std::mutex> lock(async_submit_mutex_);
+      async_submit_busy_ = false;
+      job.stream.clear();
+      async_submit_free_streams_.push_back(std::move(job.stream));
+    }
+    async_submit_idle_cv_.notify_all();
+  }
+}
+
+void VulkanCommandProcessor::AsyncSubmitExecute(AsyncSubmitJob& job) {
+  perf::timeline::Scope timeline_scope("asub_b", "asub_e", uint32_t(job.submission));
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  bool recorded = dfn.vkResetCommandPool(device, job.command_buffer.pool, 0) == VK_SUCCESS;
+  if (recorded) {
+    VkCommandBufferBeginInfo command_buffer_begin_info;
+    command_buffer_begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    command_buffer_begin_info.pNext = nullptr;
+    command_buffer_begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    command_buffer_begin_info.pInheritanceInfo = nullptr;
+    recorded = dfn.vkBeginCommandBuffer(job.command_buffer.buffer, &command_buffer_begin_info) ==
+               VK_SUCCESS;
+    if (recorded) {
+      deferred_command_buffer_.ExecuteStream(job.stream, job.command_buffer.buffer);
+      recorded = dfn.vkEndCommandBuffer(job.command_buffer.buffer) == VK_SUCCESS;
+    }
+  }
+  if (!recorded) {
+    REXGPU_ERROR("Async submit: failed to record a Vulkan command buffer (submission {})", job.submission);
+  }
+
+  // Even without a command buffer, submit so the wait semaphores are consumed and the fence gets signaled:
+  // the command processor thread may already be waiting on it.
+  VkSubmitInfo submit_info;
+  submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+  submit_info.pNext = nullptr;
+  submit_info.waitSemaphoreCount = uint32_t(job.wait_semaphores.size());
+  submit_info.pWaitSemaphores = job.wait_semaphores.empty() ? nullptr : job.wait_semaphores.data();
+  submit_info.pWaitDstStageMask = job.wait_stage_masks.empty() ? nullptr : job.wait_stage_masks.data();
+  submit_info.commandBufferCount = recorded ? 1 : 0;
+  submit_info.pCommandBuffers = recorded ? &job.command_buffer.buffer : nullptr;
+  submit_info.signalSemaphoreCount = 0;
+  submit_info.pSignalSemaphores = nullptr;
+  VkResult submit_result;
+  {
+    ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+        vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+    perf::timeline::Scope submit_scope("vsubmit_b", "vsubmit_e");
+    submit_result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, job.fence);
+  }
+  if (submit_result != VK_SUCCESS) {
+    REXGPU_ERROR("Async submit: failed to submit a Vulkan command buffer (submission {}, result {})",
+                 job.submission, int(submit_result));
+    if (submit_result == VK_ERROR_DEVICE_LOST) {
+      async_submit_device_lost_ = true;
+    }
+  }
+}
+
+void VulkanCommandProcessor::AsyncSubmitDrain() {
+  if (!async_submit_thread_.joinable()) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  async_submit_idle_cv_.wait(lock,
+                             [this] { return async_submit_queue_.empty() && !async_submit_busy_; });
+}
+
+void VulkanCommandProcessor::AsyncSubmitStop() {
+  if (!async_submit_thread_.joinable()) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(async_submit_mutex_);
+    async_submit_stop_ = true;
+  }
+  async_submit_work_cv_.notify_all();
+  async_submit_thread_.join();
+}
