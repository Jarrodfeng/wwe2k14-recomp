+// Called at every swap while vulkan_pipeline_no_submit_wait or its _verify is
+// on. A run of frames with skipped draws is logged when it ends: with
+// vulkan_async_skip_incomplete_frames the picture stays on the last complete
+// frame for the run's duration (the guest keeps running unless the command
+// processor waits), otherwise those frames are shown without the draws.
+void NotePipelineNoWaitSwap(bool frame_had_skipped_draws, bool frame_held,
+                            bool creating_at_swap, bool no_submit_wait, bool verify) {
+  PipelineNoWaitStats& stats = pipeline_no_wait_stats;
+  if (frame_had_skipped_draws) {
+    if (!stats.run_frames) {
+      stats.run_start = std::chrono::steady_clock::now();
+    }
+    ++stats.run_frames;
+    stats.run_held_frames += frame_held ? 1 : 0;
+    stats.run_skipped_draws += stats.frame_skipped_draws;
+  } else if (stats.run_frames) {
+    REXGPU_INFO(
+        "[s6][H1] {} frame(s) over {} ms skipped {} draw(s) for pipelines still being created: "
+        "{} held (not presented), {} presented without them (no_submit_wait={})",
+        stats.run_frames,
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() -
+                                                              stats.run_start)
+            .count(),
+        stats.run_skipped_draws, stats.run_held_frames,
+        stats.run_frames - stats.run_held_frames, no_submit_wait);
+    stats.run_frames = 0;
+    stats.run_held_frames = 0;
+    stats.run_skipped_draws = 0;
+  }
+  if (!verify) {
+    return;
+  }
+  ++stats.verify_frames;
+  stats.verify_skipped_draws += stats.frame_skipped_draws;
+  stats.verify_held_frames += frame_held ? 1 : 0;
+  stats.verify_unwaited_swaps += creating_at_swap ? 1 : 0;
+  if (stats.verify_frames >= 300) {
+    REXGPU_INFO(
+        "[s6][H1] verify: {} frames, {} pipeline binds checked, {} mismatches, {} draws skipped, "
+        "{} frames held, {} submissions ended while creating pipelines, {} swaps with creations "
+        "in flight (no_submit_wait={})",
+        stats.verify_frames, stats.verify_binds_checked, stats.verify_mismatches,
+        stats.verify_skipped_draws, stats.verify_held_frames, stats.verify_early_submissions,
+        stats.verify_unwaited_swaps, no_submit_wait);
+    stats.verify_frames = 0;
+    stats.verify_binds_checked = 0;
+    stats.verify_mismatches = 0;
+    stats.verify_early_submissions = 0;
+    stats.verify_unwaited_swaps = 0;
+    stats.verify_skipped_draws = 0;
+    stats.verify_held_frames = 0;
+  }
+}
