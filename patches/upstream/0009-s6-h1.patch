+  uint32_t run_held_frames = 0;
+  uint64_t run_skipped_draws = 0;
+  std::chrono::steady_clock::time_point run_start;
+  // vulkan_pipeline_no_submit_wait_verify, reset with every summary.
+  uint32_t verify_frames = 0;
+  uint64_t verify_binds_checked = 0;
+  uint64_t verify_mismatches = 0;
+  uint32_t verify_mismatches_logged = 0;
+  // Submissions ended while pipelines were being created (the original path
+  // keeps the submission open until the swap instead).
+  uint64_t verify_early_submissions = 0;
