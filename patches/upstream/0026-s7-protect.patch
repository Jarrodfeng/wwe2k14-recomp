+// could see a released page as still allocated and undo the no-access - which the original loops can't do
+// in one step, as they never touch pages they don't watch or unwatch themselves.
+uint32_t ProtectBridgeMaxPages() {
+  return REXCVAR_GET(protect_on_release) ? 0 : kProtectBridgeMaxPages;
