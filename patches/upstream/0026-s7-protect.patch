+
+// Whether the host pages page_first...page_last (from a page-aligned base) all have the access `expected`:
+// an empty string if so, otherwise a description of the first page that doesn't (or of the VirtualQuery
+// failure).
+std::string ProtectQueryAccess(uint8_t* base, uint32_t page_size, uint32_t page_first, uint32_t page_last,
+                               rex::memory::PageAccess expected) {
+  uint8_t* address = base + size_t(page_first) * page_size;
+  uint8_t* end = base + (size_t(page_last) + 1) * page_size;
+  while (address < end) {
+    size_t region_length = 0;
+    rex::memory::PageAccess access = rex::memory::PageAccess::kNoAccess;
+    if (!rex::memory::QueryProtect(address, region_length, access) || !region_length) {
+      return "VirtualQuery failed";
+    }
+    if (access != expected) {
+      return fmt::format("host page {:X} is {} instead of {}", uint32_t((address - base) / page_size),
+                         ProtectAccessName(access), ProtectAccessName(expected));
+    }
+    address += region_length;
+  }
+  return std::string();
+}
+
+// A range the batch has just protected or unprotected: anything else than `expected` is a batch defect.
+void ProtectVerifyAccess(uint8_t* base, uint32_t page_size, uint32_t heap_base, uint32_t page_first,
