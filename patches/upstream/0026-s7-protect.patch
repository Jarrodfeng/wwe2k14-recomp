+void ResetPhysicalProtectStats();
+void LogPhysicalProtectStats(uint64_t first_frame, uint64_t last_frame);
+
+void ResetPhysicalProtectStats() {
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  protect_stats = ProtectStats();
+}
+
+void LogPhysicalProtectStats(uint64_t first_frame, uint64_t last_frame) {
+  ProtectStats stats;
+  uint64_t verify_mismatches_total;
+  uint64_t verify_gap_changed_total[2];
+  uint64_t fallbacks_total;
+  {
+    auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+    stats = protect_stats;
+    protect_stats = ProtectStats();
+    verify_mismatches_total = protect_verify_mismatches_total;
+    verify_gap_changed_total[0] = protect_verify_gap_changed_total[0];
+    verify_gap_changed_total[1] = protect_verify_gap_changed_total[1];
+    fallbacks_total = protect_fallbacks_total;
+  }
+  double frames = double(std::max(last_frame - first_frame, uint64_t(1)));
+  for (uint32_t batch = 0; batch < 2; ++batch) {
+    for (uint32_t view = 0; view < 8; ++view) {
+      const ProtectHeapStats& watch = stats.heaps[batch][view];
+      const UnwatchHeapStats& unwatch = stats.unwatch[batch][view];
+      if (!watch.calls && !unwatch.triggers) {
+        continue;
+      }
+      REXSYS_INFO(
+          "[s7][PROTECT] frames {}-{} gpu_protect_batch {} view {:08X}: watch: {} calls, {} pages, {} "
+          "newly watched in {} runs ({} {}), {} VirtualProtect ({:.1f}/frame, {} pages; {} sequential, {} "
+          "1-64 pages ahead), {} watched pages skipped | unwatch: {} triggers ({} from access "
+          "violations), {} pages unwatched, {} runs ({} {}), {} VirtualProtect ({:.1f}/frame, {} pages)",
+          first_frame, last_frame, batch ? "on" : "off", view << 29, watch.calls, watch.pages_scanned,
+          watch.pages_watched, watch.runs, batch ? watch.runs_bridged : watch.runs_bridgeable,
+          batch ? "joined" : "joinable", watch.protect_calls, double(watch.protect_calls) / frames,
+          watch.pages_protected, watch.protect_sequential, watch.protect_ahead, watch.pages_skipped,
+          unwatch.triggers, unwatch.triggers_expanded, unwatch.pages_unwatched, unwatch.runs,
+          batch ? unwatch.runs_bridged : unwatch.runs_bridgeable, batch ? "joined" : "joinable",
+          unwatch.unprotect_calls, double(unwatch.unprotect_calls) / frames, unwatch.pages_unprotected);
+    }
