+uint32_t protect_verify_mismatches_logged = 0;
+uint64_t protect_verify_gap_changed_total[2] = {};
+uint32_t protect_verify_gap_changed_logged = 0;
+
+void ProtectVerifyMismatch(uint32_t heap_base, uint32_t page_first, uint32_t page_last,
+                           const char* what) {
