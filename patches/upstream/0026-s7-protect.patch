+// A gpu_protect_batch run: up to kProtectJoinMaxRuns runs of the original loop (pages that need the new
+// protection), joined over pages that already have it.
+constexpr uint32_t kProtectJoinMaxRuns = 16;
+struct ProtectJoinedRun {
+  uint32_t count = 0;      // runs of the original loop in it; 0 = no open run
+  uint32_t gap_pages = 0;  // pages after the last run already having the protection (joined if a run follows)
+  uint32_t first[kProtectJoinMaxRuns];
+  uint32_t last[kProtectJoinMaxRuns];
+
+  void Start(uint32_t page) {
+    count = 1;
+    first[0] = page;
+    last[0] = page;
+    gap_pages = 0;
+  }
+  // The next page of the run directly after the previous one (no gap).
+  void Extend(uint32_t page) { last[count - 1] = page; }
+  // A new run of the original loop after gap_pages joined pages (count < kProtectJoinMaxRuns).
+  void Join(uint32_t page) {
+    first[count] = page;
+    last[count] = page;
+    ++count;
+    gap_pages = 0;
+  }
+  void Reset() {
+    count = 0;
+    gap_pages = 0;
+  }
+};
+
+uint64_t protect_fallbacks_total = 0;  // protected by the global critical region
+
+// Sets the protection of a joined run with one Protect call. If that fails (a page in it can't be protected,
+// for instance one never committed on the host), sets it for its original runs one by one instead, so each
+// of them fails or succeeds as with the original loop. count_call(first page, last page) for every call.
+// Returns whether the joined call succeeded.
+template <typename CountCall>
+bool ProtectJoinedRunApply(const ProtectJoinedRun& run, uint8_t* base, uint32_t page_size,
+                           rex::memory::PageAccess access, uint32_t heap_base, CountCall&& count_call) {
+  uint32_t page_first = run.first[0];
+  uint32_t page_last = run.last[run.count - 1];
+  bool result = rex::memory::Protect(base + size_t(page_first) * page_size,
+                                     size_t(page_last + 1 - page_first) * page_size, access);
+  count_call(page_first, page_last);
+  if (result || run.count <= 1) {
+    return result;
+  }
+  ++protect_fallbacks_total;
+  if (protect_fallbacks_total <= 16) {
+    REXSYS_WARN(
+        "[s7][PROTECT] joined Protect of view {:08X} system pages {:X}-{:X} ({}) failed, setting its {} "
+        "original runs one by one ({} such fallbacks so far)",
+        heap_base, page_first, page_last, ProtectAccessName(access), run.count, protect_fallbacks_total);
+  }
+  for (uint32_t k = 0; k < run.count; ++k) {
+    rex::memory::Protect(base + size_t(run.first[k]) * page_size,
+                         size_t(run.last[k] + 1 - run.first[k]) * page_size, access);
+    count_call(run.first[k], run.last[k]);
+  }
+  return false;
+}
