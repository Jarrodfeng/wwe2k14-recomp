+const char* ProtectAccessName(rex::memory::PageAccess access) {
+  switch (access) {
+    case rex::memory::PageAccess::kNoAccess:
+      return "no access";
+    case rex::memory::PageAccess::kReadOnly:
+      return "read-only";
+    case rex::memory::PageAccess::kReadWrite:
