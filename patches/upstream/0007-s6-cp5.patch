+// wwe2k14 patch (Session 6, CP5): vulkan_reuse_texture_bindings state - for each guest shader stage, the
+// texture descriptor set written last with reuse on, and everything it was written from. A set may be reused
+// (bound again without being written) by a later draw only if all of these hold:
+// - It was written in the current submission (and frame). Transient texture sets are recycled when their
+//   frame is completed, and a sampler can only be destroyed (and its handle reused) once the last submission
+//   that used it has completed, so within a submission the sampler handles still name the same samplers.
+// - The descriptor set layout is the same (same stage, texture count and sampler count).
+// - The shader texture bindings are the same (fetch constant, fetch dimension, signedness), and for each of
+//   them the texture cache's binding generation of the fetch constant is the same. The generation changes in
+//   VulkanTextureCache::UpdateTextureBindingsImpl, the only place where the binding state that
+//   GetActiveBindingOrNullImageView reads changes (texture key, swizzle, signedness, the textures and their
+//   views); textures are only destroyed after ResetTextureBindings has updated all bindings, and a texture's
+//   views live as long as the texture. The exception, 3D textures sampled as 1D/2D (the view is created
+//   lazily by GetActiveBindingOrNullImageView, and depends on gpu_3d_to_2d_texture), is never reused.
+// - The sampler handles are the same.
+struct VulkanCommandProcessor::TextureBindingReuse {
+  enum Result : uint32_t {
+    kReused,
+    // No set written with reuse on in this submission for the stage (or the last one wasn't reusable).
+    kMissNoSet,
+    // Different descriptor set layout.
+    kMissLayout,
+    // Different shader texture bindings.
+    kMissBindings,
+    // A used fetch constant's texture binding has been updated by the texture cache.
+    kMissGeneration,
+    // Different samplers.
+    kMissSamplers,
+    // vulkan_reuse_texture_bindings_verify found a difference.
+    kMissVerify,
+    kResultCount,
+  };
+
+  struct TextureKey {
+    uint32_t fetch_constant;
+    uint32_t generation;
+    xenos::FetchOpDimension dimension;
+    bool is_signed;
+  };
+
+  struct Stage {
+    bool valid = false;
+    uint64_t submission = 0;
+    uint64_t frame = 0;
+    VkDescriptorSetLayout layout = VK_NULL_HANDLE;
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    std::vector<TextureKey> textures;
+    std::vector<VkSampler> samplers;
+    // Shadow copy of the image descriptors written to the set, for the _verify comparison.
+    std::vector<VkDescriptorImageInfo> written_images;
+    // The key of a set about to be written, taken before the descriptors are obtained, so that if anything
+    // changed in between, the stored key is the older one (the next check fails rather than passes).
+    std::vector<TextureKey> pending_textures;
+    bool pending_reusable = false;
+  };
+
+  using Samplers = std::vector<std::pair<VulkanTextureCache::SamplerParameters, VkSampler>>;
+
+  // [0] - vertex shader, [1] - pixel shader.
+  Stage stages[2];
+
+  // Pipeline layout of the last UpdateBindings that ran with reuse on, nullptr after one with reuse off. The
+  // texture sets bound in the command buffer are kept bound only while it stays the same: IssueDraw doesn't
+  // drop the bound bits of the texture sets when the pipeline layout changes, as without reuse they were
+  // bound again on every draw anyway.
+  const PipelineLayout* bound_pipeline_layout = nullptr;
+
+  // Statistics since stats_frame, logged every kStatsFrames frames.
+  static constexpr uint64_t kStatsFrames = 300;
+  uint64_t stats_frame = 0;
+  uint64_t results[kResultCount] = {};
+  uint64_t binds_kept = 0;
+  uint64_t not_reusable_3d_as_2d = 0;
+  uint64_t verify_checks = 0;
+  uint64_t verify_mismatches = 0;
+  uint64_t verify_mismatches_total = 0;
+  uint32_t verify_mismatches_logged = 0;
+  static constexpr uint32_t kVerifyMismatchesLogged = 16;
+
+  static bool Is3DAs2D(uint32_t bindings_3d_mask, const VulkanShader::TextureBinding& binding) {
+    // Same condition as force_special_view in GetActiveBindingOrNullImageView (1D and 2D fetches are
+    // compatible with 3D textures).
+    return ((bindings_3d_mask >> binding.fetch_constant) & 1) &&
+           (binding.dimension == xenos::FetchOpDimension::k1D ||
+            binding.dimension == xenos::FetchOpDimension::k2D);
+  }
+
+  static Result Check(const Stage& stage, uint64_t submission, uint64_t frame,
+                      VkDescriptorSetLayout layout,
+                      const std::vector<VulkanShader::TextureBinding>& textures,
+                      const Samplers& samplers, const VulkanTextureCache& texture_cache) {
+    if (!stage.valid || stage.submission != submission || stage.frame != frame) {
+      return kMissNoSet;
+    }
+    if (stage.layout != layout || stage.textures.size() != textures.size() ||
+        stage.samplers.size() != samplers.size()) {
+      return kMissLayout;
+    }
+    size_t texture_count = textures.size();
+    for (size_t i = 0; i < texture_count; ++i) {
+      const TextureKey& key = stage.textures[i];
+      const VulkanShader::TextureBinding& binding = textures[i];
+      if (key.fetch_constant != binding.fetch_constant || key.dimension != binding.dimension ||
+          key.is_signed != binding.is_signed) {
+        return kMissBindings;
+      }
+    }
+    // With the same generations, the 3D mask bits of these fetch constants are the same as when the set was
+    // written, so no 3D-as-2D binding can be among them (such sets aren't stored as reusable).
+    for (size_t i = 0; i < texture_count; ++i) {
+      const TextureKey& key = stage.textures[i];
+      if (key.generation != texture_cache.GetTextureBindingGeneration(key.fetch_constant)) {
+        return kMissGeneration;
+      }
+    }
+    for (size_t i = 0; i < samplers.size(); ++i) {
+      if (stage.samplers[i] != samplers[i].second) {
+        return kMissSamplers;
+      }
+    }
+    return kReused;
+  }
+
+  // Takes the key of the set about to be written for the stage, before its descriptors are obtained.
+  void PrepareWrite(Stage& stage, const std::vector<VulkanShader::TextureBinding>& textures,
+                    const VulkanTextureCache& texture_cache) {
+    uint32_t bindings_3d_mask = texture_cache.GetTextureBindings3DMask();
+    stage.pending_reusable = true;
+    stage.pending_textures.clear();
+    stage.pending_textures.reserve(textures.size());
+    for (const VulkanShader::TextureBinding& binding : textures) {
+      if (Is3DAs2D(bindings_3d_mask, binding)) {
+        stage.pending_reusable = false;
+      }
+      TextureKey& key = stage.pending_textures.emplace_back();
+      key.fetch_constant = binding.fetch_constant;
+      key.generation = texture_cache.GetTextureBindingGeneration(binding.fetch_constant);
+      key.dimension = binding.dimension;
+      key.is_signed = binding.is_signed;
+    }
+  }
+
+  // Stores the set once it has been written (or its write has been recorded before any bind of it).
+  void CommitWrite(Stage& stage, uint64_t submission, uint64_t frame, VkDescriptorSetLayout layout,
+                   VkDescriptorSet set, const Samplers& samplers, const VkDescriptorImageInfo* images,
+                   size_t image_count) {
+    if (!stage.pending_reusable) {
+      stage.valid = false;
+      ++not_reusable_3d_as_2d;
+      return;
+    }
+    stage.valid = true;
+    stage.submission = submission;
+    stage.frame = frame;
+    stage.layout = layout;
+    stage.set = set;
+    stage.textures.swap(stage.pending_textures);
+    stage.samplers.clear();
+    stage.samplers.reserve(samplers.size());
+    for (const auto& sampler_pair : samplers) {
+      stage.samplers.push_back(sampler_pair.second);
+    }
+    stage.written_images.assign(images, images + image_count);
+  }
+};
