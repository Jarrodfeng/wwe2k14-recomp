+// wwe2k14 patch (Session 7c, TEXLOAD): vulkan_texture_load_scratch_ring (see the declaration). Why it's safe:
+// - An entry is only written by the dispatches of the load that acquired it, and read by that load's copy (and
+//   its float conversion pass); the load's own barriers order those, exactly as with the single scratch buffer.
+// - Before an entry is written again, its previous reads (and writes) must be complete. Either the acquisition
+//   pushes the barrier from the entry's last usage into the initial one (as AcquireScratchGpuBuffer does), or the
+//   entry already got that same barrier while idle: it was pushed along with another entry's acquisition barrier,
+//   after all of the entry's earlier commands had been recorded, and the entry hasn't been used since (its state
+//   is then the initial usage, and PushBufferMemoryBarrier drops a barrier between equal usages). A pipeline
+//   barrier's first scope is everything recorded before it, so that barrier orders the entry's earlier commands
+//   before every command of the initial stages recorded after it, the acquiring load's dispatches included.
+// - A new or grown buffer has no earlier usage. A buffer being replaced is destroyed only after the last
+//   submission that used it has completed (destroy_buffers_ / destroy_memory_), like the single scratch buffer.
+// - The image write-after-write hazard between two loads of the same texture (no sampling in between) is ordered by
+//   an explicit image barrier whenever either load used the ring (LoadTextureDataFromResidentMemoryImpl).
+// Texture contents are the same as with the single scratch buffer, with one pre-existing (upstream) exception that
+// the ring doesn't change the correctness of: a resolution-scaled texture with mips can have a level whose image
+// extent ((height * scale) >> level, e.g. 2160 >> 5 = 67 rows) exceeds the rows its dispatch writes
+// ((height >> level) * scale = 66), and the copy then reads the extra texels from scratch bytes no dispatch of the
+// load wrote (also an invalid bufferImageHeight). Those texels hold stale scratch data either way; which stale data
+// differs (the previous load's with one buffer, an older load's or none with the ring).
+VulkanCommandProcessor::ScratchBufferAcquisition VulkanCommandProcessor::AcquireScratchGpuBufferRing(
+    VkDeviceSize size, VkPipelineStageFlags initial_stage_mask, VkAccessFlags initial_access_mask) {
+  assert_true(submission_open_);
+  if (!submission_open_ || !size) {
+    return ScratchBufferAcquisition();
+  }
+  // The next idle entry, round robin.
+  uint32_t ring_index = UINT32_MAX;
+  for (uint32_t i = 0; i < kScratchRingSize; ++i) {
+    const uint32_t candidate = (scratch_ring_next_ + i) % kScratchRingSize;
+    if (!scratch_ring_[candidate].used) {
+      ring_index = candidate;
+      break;
+    }
+  }
+  assert_true(ring_index != UINT32_MAX);
+  if (ring_index == UINT32_MAX) {
+    return ScratchBufferAcquisition();
+  }
+  scratch_ring_next_ = (ring_index + 1) % kScratchRingSize;
+  ScratchRingEntry& entry = scratch_ring_[ring_index];
+  const uint64_t submission_current = GetCurrentSubmission();
+  ++scratch_ring_stats_.acquisitions;
+
+  if (entry.buffer != VK_NULL_HANDLE && size <= entry.size) {
+    if (entry.last_stage_mask != initial_stage_mask || entry.last_access_mask != initial_access_mask) {
+      // The barrier from the entry's last usage. Idle entries whose last usage is covered by the same stages and
+      // accesses get the same transition in it (same stage masks, so the pipeline barrier waits for nothing more).
+      const VkPipelineStageFlags src_stage_mask = entry.last_stage_mask;
+      const VkAccessFlags src_access_mask = entry.last_access_mask;
+      PushBufferMemoryBarrier(entry.buffer, 0, VK_WHOLE_SIZE, src_stage_mask, initial_stage_mask,
+                              src_access_mask, initial_access_mask);
+      ++scratch_ring_stats_.barriers;
+      for (uint32_t i = 0; i < kScratchRingSize; ++i) {
+        ScratchRingEntry& other = scratch_ring_[i];
+        if (i == ring_index || other.used || other.buffer == VK_NULL_HANDLE ||
+            (other.last_stage_mask == initial_stage_mask &&
+             other.last_access_mask == initial_access_mask) ||
+            (other.last_stage_mask & ~src_stage_mask) || (other.last_access_mask & ~src_access_mask)) {
+          continue;
+        }
+        PushBufferMemoryBarrier(other.buffer, 0, VK_WHOLE_SIZE, other.last_stage_mask, initial_stage_mask,
+                                other.last_access_mask, initial_access_mask);
+        other.last_stage_mask = initial_stage_mask;
+        other.last_access_mask = initial_access_mask;
+        // The barrier references the buffer in this submission.
+        other.last_usage_submission = submission_current;
+        ++scratch_ring_stats_.pre_transitions;
+      }
+    }
+    entry.last_stage_mask = initial_stage_mask;
+    entry.last_access_mask = initial_access_mask;
+    entry.last_usage_submission = submission_current;
+    entry.used = true;
+    return ScratchBufferAcquisition(*this, entry.buffer, initial_stage_mask, initial_access_mask,
+                                    ring_index);
+  }
+
+  // Too small or not created yet: a new buffer, in increments like the single scratch buffer.
+  const VkDeviceSize new_size = rex::align(size, kScratchBufferSizeIncrement);
+  VkDeviceMemory new_memory;
+  VkBuffer new_buffer;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          GetVulkanDevice(), new_size,
+          VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+          ui::vulkan::util::MemoryPurpose::kDeviceLocal, new_buffer, new_memory)) {
+    REXGPU_ERROR("[s7][TEXLOAD] Failed to create a {} MB texture load scratch ring buffer", new_size >> 20);
+    return ScratchBufferAcquisition();
+  }
+  FreeScratchRingEntry(entry);
+  entry.memory = new_memory;
+  entry.buffer = new_buffer;
+  entry.size = new_size;
+  // Not used yet, no need for a barrier.
+  entry.last_stage_mask = initial_stage_mask;
+  entry.last_access_mask = initial_access_mask;
+  entry.last_usage_submission = submission_current;
+  entry.used = true;
+  ++scratch_ring_stats_.grows;
+  return ScratchBufferAcquisition(*this, new_buffer, initial_stage_mask, initial_access_mask, ring_index);
+}
+
