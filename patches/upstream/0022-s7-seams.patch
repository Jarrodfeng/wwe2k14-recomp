+  }
+  ++stats.draws_clip_enabled;
+  draw_util::ViewportInfo without_fix{};
+  draw_util::ViewportInfo with_fix{};
+  draw_util::GetHostViewportInfo(regs, draw_resolution_scale_x, draw_resolution_scale_y, false, x_max,
+                                 y_max, true, normalized_depth_control, convert_z_to_float24,
+                                 full_float24_in_0_to_1, pixel_shader_writes_depth, without_fix, false);
+  draw_util::GetHostViewportInfo(regs, draw_resolution_scale_x, draw_resolution_scale_y, false, x_max,
+                                 y_max, true, normalized_depth_control, convert_z_to_float24,
+                                 full_float24_in_0_to_1, pixel_shader_writes_depth, with_fix, true);
+  if (!std::memcmp(&without_fix, &with_fix, sizeof(with_fix))) {
+    return;
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    stats.min_origin_with_fix[i] = std::min(stats.min_origin_with_fix[i], with_fix.xy_offset[i]);
+  }
+  if (window_offset_entry) {
+    ++window_offset_entry->differ;
+  }
+  if (window_offset_applied) {
+    ++stats.differ_window_offset;
+    return;
+  }
+  ++stats.differ_no_window_offset;
+  // Outside predicated tiling: a guest viewport that itself starts left of or above 0. Log the first few.
+  if (stats.no_window_offset_logged < 8) {
+    ++stats.no_window_offset_logged;
+    REXGPU_INFO(
+        "[s7][SEAMS] frame {}: draw without a window offset gets a different host viewport with the fix: "
+        "PA_CL_VPORT X/Y scale/offset {}/{} {}/{} (VTE_CNTL {:08X}, VTX_CNTL {:08X}, SC_MODE_CNTL {:08X}, "
+        "WINDOW_OFFSET {:08X}); without the fix origin ({}, {}) extent ({}, {}) ndc scale ({}, {}) offset "
+        "({}, {}); with it origin ({}, {}) extent ({}, {}) ndc scale ({}, {}) offset ({}, {})",
+        frame_current_, regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE),
+        regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET), regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+        regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET), regs[XE_GPU_REG_PA_CL_VTE_CNTL],
+        regs[XE_GPU_REG_PA_SU_VTX_CNTL], pa_su_sc_mode_cntl.value, pa_sc_window_offset.value,
+        without_fix.xy_offset[0], without_fix.xy_offset[1], without_fix.xy_extent[0],
+        without_fix.xy_extent[1], without_fix.ndc_scale[0], without_fix.ndc_scale[1],
+        without_fix.ndc_offset[0], without_fix.ndc_offset[1], with_fix.xy_offset[0], with_fix.xy_offset[1],
+        with_fix.xy_extent[0], with_fix.xy_extent[1], with_fix.ndc_scale[0], with_fix.ndc_scale[1],
+        with_fix.ndc_offset[0], with_fix.ndc_offset[1]);
+  }
+}
