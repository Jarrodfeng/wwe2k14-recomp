+    bool convert_z_to_float24, bool full_float24_in_0_to_1, bool pixel_shader_writes_depth) {
+  TilingViewportFixStats& stats = tiling_viewport_fix_stats_;
+  // A new window: the first draw since the setting was turned on, or frame_current_ went back (the context
+  // was recreated; ShutdownContext resets it to 1). Otherwise close the window every 300 frames.
+  if (!stats.active || frame_current_ < stats.last_frame) {
+    if (stats.active) {
+      TilingViewportFixStatsReport(" (partial window: context recreated)");
+    }
+    uint32_t no_window_offset_logged = stats.no_window_offset_logged;
+    stats = TilingViewportFixStats();
+    stats.no_window_offset_logged = no_window_offset_logged;
+    stats.active = true;
+    stats.window_first_frame = frame_current_;
+  } else if (frame_current_ - stats.window_first_frame >= 300) {
+    TilingViewportFixStatsReport("");
+    uint32_t no_window_offset_logged = stats.no_window_offset_logged;
+    stats = TilingViewportFixStats();
+    stats.no_window_offset_logged = no_window_offset_logged;
+    stats.active = true;
+    stats.window_first_frame = frame_current_;
+  }
+  stats.last_frame = frame_current_;
