+        "first {}, base {}, point {}, FSI {}, clip planes {}; texture part skipped {} of {} "
+        "({:.1f}%); base inputs that differed: {}; verify {} checks, {} mismatches ({} total), {} "
+        "recomputes dirty with the same bytes (NaN)",
+        stats_frame, frame - 1, draws, state_results[kStateSkipped],
+        draws ? 100.0 * double(state_results[kStateSkipped]) / double(draws) : 0.0,
+        state_results[kStateMissFirst], state_results[kStateMissBase],
+        state_results[kStateMissPoint], state_results[kStateMissFsi],
+        state_results[kStateMissUserClipPlanes], texture_skipped, texture_checks,
+        texture_checks ? 100.0 * double(texture_skipped) / double(texture_checks) : 0.0,
+        base_misses.empty() ? std::string("none") : base_misses, verify_checks, verify_mismatches,
+        verify_mismatches_total, verify_dirty_only);
+    std::memset(state_results, 0, sizeof(state_results));
+    std::memset(base_dword_misses, 0, sizeof(base_dword_misses));
+    texture_skipped = 0;
+    texture_computed = 0;
+    verify_checks = 0;
+    verify_mismatches = 0;
+    verify_dirty_only = 0;
+    stats_frame = frame;
+  }
