+      {offsetof(SC, point_vertex_diameter_min), "point_vertex_diameter_min"},
+      {offsetof(SC, ndc_offset), "ndc_offset"},
+      {offsetof(SC, point_vertex_diameter_max), "point_vertex_diameter_max"},
+      {offsetof(SC, point_constant_diameter), "point_constant_diameter"},
+      {offsetof(SC, point_screen_diameter_to_ndc_radius), "point_screen_diameter_to_ndc_radius"},
+      {offsetof(SC, textures_resolution_scaled), "textures_resolution_scaled"},
+      {offsetof(SC, texture_swizzled_signs), "texture_swizzled_signs"},
+      {offsetof(SC, texture_swizzles), "texture_swizzles"},
+      {offsetof(SC, alpha_test_reference), "alpha_test_reference"},
+      {offsetof(SC, alpha_to_mask), "alpha_to_mask"},
+      {offsetof(SC, edram_32bpp_tile_pitch_dwords_scaled), "edram_32bpp_tile_pitch_dwords_scaled"},
+      {offsetof(SC, edram_depth_base_dwords_scaled), "edram_depth_base_dwords_scaled"},
+      {offsetof(SC, color_exp_bias), "color_exp_bias"},
+      {offsetof(SC, edram_poly_offset_front_scale), "edram_poly_offset_front_scale"},
+      {offsetof(SC, edram_poly_offset_back_scale), "edram_poly_offset_back_scale"},
+      {offsetof(SC, edram_poly_offset_front_offset), "edram_poly_offset_front_offset"},
+      {offsetof(SC, edram_poly_offset_back_offset), "edram_poly_offset_back_offset"},
+      {offsetof(SC, edram_stencil_front), "edram_stencil_front"},
+      {offsetof(SC, edram_stencil_back), "edram_stencil_back"},
+      {offsetof(SC, edram_rt_base_dwords_scaled), "edram_rt_base_dwords_scaled"},
+      {offsetof(SC, edram_rt_format_flags), "edram_rt_format_flags"},
+      {offsetof(SC, edram_rt_blend_factors_ops), "edram_rt_blend_factors_ops"},
+      {offsetof(SC, edram_rt_keep_mask), "edram_rt_keep_mask"},
+      {offsetof(SC, edram_rt_clamp), "edram_rt_clamp"},
+      {offsetof(SC, edram_blend_constant), "edram_blend_constant"},
+      {offsetof(SC, vertex_index_min), "vertex_index_min"},
+      {offsetof(SC, vertex_index_max), "vertex_index_max"},
+      {offsetof(SC, tessellation_factor_range_min), "tessellation_factor_range_min"},
+      {offsetof(SC, tessellation_factor_range_max), "tessellation_factor_range_max"},
+  };
+  const Field* found = &kFields[0];
+  for (const Field& field : kFields) {
+    if (field.offset <= offset && field.offset >= found->offset) {
+      found = &field;
+    }
+  }
+  field_offset_out = offset - found->offset;
+  return found->name;
+}
