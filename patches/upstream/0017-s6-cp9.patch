+// wwe2k14 patch (Session 6, CP9): vulkan_system_constants_skip state.
+// UpdateSystemConstantValuesFull writes three disjoint groups of system constant fields, each
+// computed only from its own inputs:
+// - Index part: the index flags (kIndexFlags), vertex_index_load_address, vertex_index_reset,
+//   compute_memexport_vertex_count, vertex_index_endian, line_loop_closing_index,
+//   vertex_base_index, vertex_index_min/max. Inputs: the primitive processing result,
+//   shader_32bit_index_dma, compute_memexport_vertex_count, VGT_DRAW_INITIATOR index_size,
+//   VGT_DMA_SIZE, VGT_INDX_OFFSET, VGT_MIN/MAX_VTX_INDX, VGT_MULTI_PRIM_IB_RESET_INDX. Different on
+//   most draws (the index buffer address) and cheap, so always recomputed.
+// - Texture part: texture_swizzled_signs (the bytes of the used fetch constants),
+//   textures_resolution_scaled, texture_swizzles (without imageViewFormatSwizzle). Inputs:
+//   used_texture_mask and the texture cache's active bindings, which only change together with
+//   TextureCache::active_texture_bindings_version.
+// - State part: everything else (the other flags, user clip planes, tessellation factor range, NDC
+//   transform, point size, alpha test, color exponent bias, the FSI EDRAM fields). Inputs:
+//   StateKey.
+// Every value written is a function of the group's inputs (plain stores, or stores into bit ranges
+// and array elements that only that group writes - edram_stencil_back is copied from
+// edram_stencil_front written just before it), and nothing but UpdateSystemConstantValuesFull and
+// the parts below writes system_constants_ after SetupContext (which invalidates this). So while a
+// group's inputs are bit-for-bit what they were when the group was last computed, computing it
+// again would store the same bits into the same fields, and skipping it leaves system_constants_
+// exactly as it would be. The original's dirty flag for those fields would be false then too,
+// except when a float field holds a NaN (float != is true for NaN == NaN): then the original marks
+// the system constant buffer dirty and uploads the same bytes again, which the skip doesn't.
+struct VulkanCommandProcessor::SystemConstantsSkip {
+  // The index part's flags - all the flags below kSysFlag_XYDividedByW.
+  static constexpr uint32_t kIndexFlags =
+      SpirvShaderTranslator::kSysFlag_VertexIndexLoad |
+      SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad |
+      SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit |
+      SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset |
+      SpirvShaderTranslator::kSysFlag_ComputeMemExportPatchIndexFromInvocation |
+      SpirvShaderTranslator::kSysFlag_ComputeMemExportPatchIndexInRegister1 |
+      SpirvShaderTranslator::kSysFlag_ComputeMemExportTriangleCPIndexed |
+      SpirvShaderTranslator::kSysFlag_ComputeMemExportQuadCPIndexed;
+  static_assert(kIndexFlags ==
+                    (UINT32_C(1) << SpirvShaderTranslator::kSysFlag_XYDividedByW_Shift) - 1,
+                "The state part's flags must be the ones from kSysFlag_XYDividedByW up");
+
+  // StateKey::Base::config bits.
+  enum : uint32_t {
+    kConfigFsi = 1u << 0,
+    kConfigHostRenderTargets = 1u << 1,
+    kConfigGammaAsUnorm16 = 1u << 2,
+    kConfigRG16Truncated = 1u << 3,
+    kConfigRGBA16Truncated = 1u << 4,
+    kConfigPrimitivePolygonal = 1u << 5,
+  };
+
+  // Every input of the state part, as bit patterns. The sections after base are filled and compared
+  // only when base says the state part reads them (prim_type, config FSI bit, PA_CL_CLIP_CNTL), so
+  // two keys with the same base and the same active sections mean the same inputs.
+  struct StateKey {
+    struct Base {
+      // kConfig*: render target path, gamma_render_target_as_unorm16,
+      // IsFixedRG16/RGBA16TruncatedToMinus1To1 (host render targets only, they depend on
+      // snorm16_render_target_full_range), primitive_polygonal.
+      uint32_t config;
+      uint32_t draw_resolution_scale_x;
+      uint32_t draw_resolution_scale_y;
+      uint32_t pa_cl_clip_cntl;
+      uint32_t pa_cl_vte_cntl;
+      uint32_t rb_colorcontrol;
+      uint32_t rb_alpha_ref;
+      uint32_t rb_surface_info;
+      uint32_t rb_depth_info;
+      uint32_t rb_color_info[4];
+      // VGT_DRAW_INITIATOR prim_type only (index_size is an index part input, num_indices is not
+      // read at all).
+      uint32_t prim_type;
+      uint32_t vgt_output_path_cntl;
+      uint32_t vgt_hos_max_tess_level;
+      uint32_t vgt_hos_min_tess_level;
+      uint32_t ndc_scale[3];
+      uint32_t ndc_offset[3];
+    };
+    static constexpr uint32_t kBaseDwords = 23;
+    static_assert(sizeof(Base) == kBaseDwords * sizeof(uint32_t));
+    // Point lists.
+    struct Point {
+      uint32_t pa_su_point_size;
+      uint32_t pa_su_point_minmax;
+      uint32_t viewport_xy_extent[2];
+    };
+    // Fragment shader interlock.
+    struct Fsi {
+      uint32_t normalized_depth_control;
+      uint32_t normalized_color_mask;
+      uint32_t pa_su_sc_mode_cntl;
+      uint32_t rb_stencilrefmask;
+      uint32_t rb_stencilrefmask_bf;
+      uint32_t rb_blendcontrol[4];
+      // Front scale, front offset, back scale, back offset.
+      uint32_t pa_su_poly_offset[4];
+      uint32_t rb_blend_rgba[4];
+    };
+    Base base;
+    Point point;
+    Fsi fsi;
+    // PA_CL_UCP_0_X...PA_CL_UCP_5_W, if !clip_disable and any ucp_ena bit.
+    uint32_t user_clip_planes[6 * 4];
+
+    bool IsPointUsed() const {
+      return base.prim_type == uint32_t(xenos::PrimitiveType::kPointList);
+    }
+    bool IsFsiUsed() const { return (base.config & kConfigFsi) != 0; }
+    bool AreUserClipPlanesUsed() const {
+      reg::PA_CL_CLIP_CNTL clip_cntl;
+      clip_cntl.value = base.pa_cl_clip_cntl;
+      return !clip_cntl.clip_disable && clip_cntl.ucp_ena;
+    }
+  };
+
+  // StateKey::Base dwords, for the log.
+  static constexpr const char* kBaseDwordNames[StateKey::kBaseDwords] = {
+      "config",
+      "resolution_scale_x",
+      "resolution_scale_y",
+      "PA_CL_CLIP_CNTL",
+      "PA_CL_VTE_CNTL",
+      "RB_COLORCONTROL",
+      "RB_ALPHA_REF",
+      "RB_SURFACE_INFO",
+      "RB_DEPTH_INFO",
+      "RB_COLOR_INFO",
+      "RB_COLOR1_INFO",
+      "RB_COLOR2_INFO",
+      "RB_COLOR3_INFO",
+      "prim_type",
+      "VGT_OUTPUT_PATH_CNTL",
+      "VGT_HOS_MAX_TESS_LEVEL",
+      "VGT_HOS_MIN_TESS_LEVEL",
+      "ndc_scale_x",
+      "ndc_scale_y",
+      "ndc_scale_z",
+      "ndc_offset_x",
+      "ndc_offset_y",
+      "ndc_offset_z",
+  };
+
+  enum StateResult : uint32_t {
+    kStateSkipped,
+    // No state part computed with the setting on yet (or since it was off, or since SetupContext).
+    kStateMissFirst,
+    kStateMissBase,
+    kStateMissPoint,
+    kStateMissFsi,
+    kStateMissUserClipPlanes,
+    kStateResultCount,
+  };
+
+  // The inputs the state part in system_constants_ was last computed from.
+  bool state_valid = false;
+  StateKey state;
+  // The inputs the texture part in system_constants_ was last computed from.
+  bool texture_valid = false;
+  uint32_t texture_used_mask = 0;
+  uint64_t texture_bindings_version = 0;
+
+  // Statistics since stats_frame, logged every kStatsFrames frames.
+  static constexpr uint64_t kStatsFrames = 300;
+  uint64_t stats_frame = 0;
+  uint64_t state_results[kStateResultCount] = {};
+  uint64_t base_dword_misses[StateKey::kBaseDwords] = {};
+  uint64_t texture_skipped = 0;
+  uint64_t texture_computed = 0;
+  uint64_t verify_checks = 0;
+  uint64_t verify_mismatches = 0;
+  uint64_t verify_mismatches_total = 0;
+  uint64_t verify_dirty_only = 0;
+  uint32_t verify_mismatches_logged = 0;
+  static constexpr uint32_t kVerifyMismatchesLogged = 16;
+
+  void Invalidate() {
+    state_valid = false;
+    texture_valid = false;
+  }
+
+  // Whether `key` is the stored state key. If not, stores it (the state part is about to be
+  // computed from it) and counts why.
+  StateResult CheckAndStoreState(const StateKey& key) {
+    bool point_used = key.IsPointUsed();
+    bool fsi_used = key.IsFsiUsed();
+    bool user_clip_planes_used = key.AreUserClipPlanesUsed();
+    StateResult result;
+    if (!state_valid) {
+      result = kStateMissFirst;
+    } else if (std::memcmp(&key.base, &state.base, sizeof(key.base))) {
+      result = kStateMissBase;
+      const uint32_t* key_dwords = reinterpret_cast<const uint32_t*>(&key.base);
+      const uint32_t* state_dwords = reinterpret_cast<const uint32_t*>(&state.base);
+      for (uint32_t i = 0; i < StateKey::kBaseDwords; ++i) {
+        base_dword_misses[i] += key_dwords[i] != state_dwords[i] ? 1 : 0;
+      }
+    } else if (point_used && std::memcmp(&key.point, &state.point, sizeof(key.point))) {
+      result = kStateMissPoint;
+    } else if (fsi_used && std::memcmp(&key.fsi, &state.fsi, sizeof(key.fsi))) {
+      result = kStateMissFsi;
+    } else if (user_clip_planes_used && std::memcmp(key.user_clip_planes, state.user_clip_planes,
+                                                    sizeof(key.user_clip_planes))) {
+      result = kStateMissUserClipPlanes;
+    } else {
+      ++state_results[kStateSkipped];
+      return kStateSkipped;
+    }
+    ++state_results[result];
+    // Only the sections the key has filled.
+    state.base = key.base;
+    if (point_used) {
+      state.point = key.point;
+    }
+    if (fsi_used) {
+      state.fsi = key.fsi;
+    }
+    if (user_clip_planes_used) {
+      std::memcpy(state.user_clip_planes, key.user_clip_planes, sizeof(state.user_clip_planes));
+    }
+    state_valid = true;
+    return result;
+  }
+
+  // Whether the texture part in system_constants_ was computed from these inputs. Either way, it
+  // will be after this draw.
+  bool CheckAndStoreTextures(uint32_t used_texture_mask, uint64_t bindings_version) {
+    bool same = texture_valid && texture_used_mask == used_texture_mask &&
+                texture_bindings_version == bindings_version;
+    texture_valid = true;
+    texture_used_mask = used_texture_mask;
+    texture_bindings_version = bindings_version;
+    if (same) {
+      ++texture_skipped;
+    } else {
+      ++texture_computed;
+    }
+    return same;
+  }
+
+  void LogStats(uint64_t frame) {
+    uint64_t draws = 0;
+    for (uint32_t i = 0; i < kStateResultCount; ++i) {
+      draws += state_results[i];
+    }
+    std::string base_misses;
+    for (uint32_t i = 0; i < StateKey::kBaseDwords; ++i) {
+      if (base_dword_misses[i]) {
+        if (!base_misses.empty()) {
+          base_misses += ' ';
+        }
+        base_misses += kBaseDwordNames[i];
+        base_misses += '=';
+        base_misses += std::to_string(base_dword_misses[i]);
+      }
+    }
+    uint64_t texture_checks = texture_skipped + texture_computed;
