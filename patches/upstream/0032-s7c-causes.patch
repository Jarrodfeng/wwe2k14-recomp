+    // Event-free: a block mark after the draw call ends the block of rows sparse_first_row...this one.
+    marks.sparse_post_pending = true;
+    marks.sparse_post_kind = GpuMarkKind::kBlockEnd;
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksSparseDrawPost() {
+  GpuMarks& marks = *gpu_marks_;
+  if (marks.sparse_post_pending) {
+    marks.sparse_post_pending = false;
+    GpuMark(marks.sparse_post_kind);
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksSparseNoteMark(GpuMarkKind kind) {
+  GpuMarks& marks = *gpu_marks_;
+  // Any mark starts a new interval, so the block (if one was open) ends here.
+  deferred_command_buffer_.SetEventHook(nullptr);
+  switch (kind) {
+    case GpuMarkKind::kDrawPost:
+    case GpuMarkKind::kCopyAfter:
+    case GpuMarkKind::kBlockEnd:
+      // The row's end: what is recorded from here on counts for the next row's decision.
+      marks.sparse_event_sum = CausesEventSum();
+      marks.sparse_first_row = anatomy_gpu_row_ + 1;
+      marks.sparse_row_marked = true;
+      break;
+    case GpuMarkKind::kPrepBegin:
+      // The rows before here are in the block that ends here; sparse_event_sum is kept, so the events recorded
+      // from here on (and any since the last row end) still mark the next draw.
+      marks.sparse_first_row = GpuMarksPosition(true) / 2;
+      break;
+    default:
+      break;
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksSparseRowEnd() {
+  GpuMarks& marks = *gpu_marks_;
+  if (!marks.sparse_row_marked && submission_open_) {
+    // An unmarked row: its time stays in a block; the first event command recorded from here on gets a
+    // prep_begin mark. (Without an open submission, the next one's cb_begin starts the next interval.)
+    deferred_command_buffer_.SetEventHook(this);
+  }
+  marks.sparse_row_marked = false;
+  marks.sparse_post_pending = false;
+}
+
+void VulkanCommandProcessor::GpuMarksSparseBeforeEvent() {
+  // The event hook is only armed while marking in mode 1, and cleared at every frame boundary.
+  if (gpu_marks_active_ && gpu_marks_sparse_) {
+    GpuMark(GpuMarkKind::kPrepBegin);
+  }
+}
