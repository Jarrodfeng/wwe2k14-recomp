+// wwe2k14 patch (Session 7c, CAUSES): the frame-anatomy cause columns and the per-frame counters. Measurement only:
+// the counters are plain increments at the recording sites (CauseCounts, DeferredCommandBuffer::
+// dispatches_recorded / rendering_begins_recorded); this reads differences.
+// A row's cause window runs from the end of the previous row's window (or the start of the capture frame, or, when
+// later, the start of the current submission's command buffer) to:
+//   - a draw that reached its draw call: right after the draw call (CausesCut), like its GPU marks - what IssueDraw
+//     records after it in the same submission (memexport readback) is the next row's (on the GPU it falls into the
+//     next row's prep);
+//   - a resolve: right after its before mark (CausesCut), so its columns are its preparation, like its GPU prep
+//     interval; the resolve's own commands (from there to the end of the row) are its exec on the GPU, between its
+//     before / after marks, and are counted for no row (review fix);
+//   - any other row (skipped or failed draws, a resolve that couldn't begin a submission): the end of its IssueDraw
+//     call.
+// Review fix: a new submission's command buffer starts a new window (BeginSubmission): what was recorded before it
+// (a submission's end - EndSubmission's barriers -, a memexport readback that waits for the GPU) ran in the earlier
+// submission, after its last mark (its tail up to cb_end), not in the next row's preparation.
+// So a draw's columns are what was recorded for its preparation (plus any between-packet work before it in the same
+// submission; the commands of skipped rows are in their own rows). Not in any row: the resolves' own commands,
+// submission tails and the swap. The cpf_sync / cpf_sync2 events and the [s7][CAUSES] summary count everything.
+
+VulkanCommandProcessor::CauseSnapshot VulkanCommandProcessor::CausesNow() const {
+  CauseSnapshot now;
+  now.counts = cause_counts_;
+  now.dispatches = deferred_command_buffer_.dispatches_recorded();
+  now.rendering_begins = deferred_command_buffer_.rendering_begins_recorded();
+  return now;
+}
+
+uint64_t VulkanCommandProcessor::CausesEventSum() const {
+  const CauseCounts& counts = cause_counts_;
+  return uint64_t(counts.up_calls) + counts.tex_loads + counts.barrier_batches + counts.pipeline_binds +
+         counts.pipelines_created + deferred_command_buffer_.dispatches_recorded() +
+         deferred_command_buffer_.rendering_begins_recorded();
+}
+
+void VulkanCommandProcessor::CausesCloseWindow(AnatomyCauses& out) {
+  const CauseSnapshot end = CausesNow();
+  const CauseSnapshot& start = causes_row_start_;
+  const CauseCounts& e = end.counts;
+  const CauseCounts& s = start.counts;
+  out.up_calls = e.up_calls - s.up_calls;
+  out.up_pages = e.up_pages - s.up_pages;
+  out.tex_loads = e.tex_loads - s.tex_loads;
+  out.tex_loads_scaled = e.tex_loads_scaled - s.tex_loads_scaled;
+  out.tex_load_kib = uint32_t(std::min((e.tex_load_bytes - s.tex_load_bytes + 1023) >> 10, uint64_t(UINT32_MAX)));
+  out.dispatches = end.dispatches - start.dispatches;
+  out.barrier_batches = e.barrier_batches - s.barrier_batches;
+  out.barrier_src_stages = cause_counts_.barrier_src_stages;
+  out.barrier_dst_stages = cause_counts_.barrier_dst_stages;
+  out.rendering_restarts = end.rendering_begins - start.rendering_begins;
+  out.fsi_edram_barriers = e.fsi_edram_barriers - s.fsi_edram_barriers;
+  out.desc_writes = e.desc_writes - s.desc_writes;
+  out.pipeline_created = e.pipelines_created - s.pipelines_created;
+  out.pipeline_pending = e.pipelines_pending - s.pipelines_pending;
+  // The stage masks are ORed since the window's start: the next window's start from here.
+  cause_counts_.barrier_src_stages = 0;
+  cause_counts_.barrier_dst_stages = 0;
+  causes_row_start_ = end;
+}
+
+void VulkanCommandProcessor::CausesRestartWindow() {
+  causes_row_start_ = CausesNow();
+  cause_counts_.barrier_src_stages = 0;
+  cause_counts_.barrier_dst_stages = 0;
+}
+
+void VulkanCommandProcessor::CausesCut(bool copy) {
+  CausesCloseWindow(causes_row_cut_result_);
+  if (copy) {
+    // A resolve: the row (and its mode 1 bookkeeping) ends at AnatomyRowCauses, after its after mark.
+    causes_copy_cut_valid_ = true;
+    return;
+  }
+  causes_row_cut_valid_ = true;
+  // The row's end for mode 1 too (after its post / block mark, if it got one).
+  if (gpu_marks_active_ && gpu_marks_sparse_) {
+    GpuMarksSparseRowEnd();
+  }
+}
+
+bool VulkanCommandProcessor::AnatomyRowCauses(AnatomyCauses* out) {
+  const bool draw_cut = causes_row_cut_valid_;
+  const bool copy_cut = causes_copy_cut_valid_;
+  causes_row_cut_valid_ = false;
+  causes_copy_cut_valid_ = false;
+  if (!out) {
+    // A capture frame starts (or a row is dropped): discard what was counted since the last row.
+    CausesRestartWindow();
+    return true;
+  }
+  if (draw_cut || copy_cut) {
+    *out = causes_row_cut_result_;
+    if (copy_cut) {
+      // Review fix: the resolve's own commands since its before point are its exec, no row's preparation.
+      CausesRestartWindow();
+    }
+    // After a draw's cut, what was recorded since stays counted for the next row.
+  } else {
+    // A row without a draw call or a resolve (a skipped or failed draw) ends here.
+    CausesCloseWindow(*out);
+  }
+  // A row without a draw call (a resolve or a skipped draw) ends here for mode 1 (a draw's ended at its cut).
+  if (!draw_cut && gpu_marks_active_ && gpu_marks_sparse_) {
+    GpuMarksSparseRowEnd();
+  }
+  return true;
+}
+
+// Every frame boundary (CollectFrameCounters, right before the cpf* events and cp_swap). With the timeline on:
+//   cpf_sync   a = pipeline barrier batches recorded, b = render pass / dynamic rendering instances begun (the
+//              rendering restarts), c = compute dispatches recorded
+//   cpf_sync2  a = texture loads recorded, b = of those, from the resolution-scaled resolve buffer, c = full-EDRAM
+//              barriers placed by EDRAM write commits (fragment shader interlock barriers)
+// and, about every 300 frames while the timeline is on, an [s7][CAUSES] summary of all the cause counters.
+void VulkanCommandProcessor::CausesFrameBoundary() {
+  const CauseSnapshot now = CausesNow();
+  const bool timeline = perf::timeline::Enabled();
+  if (timeline) {
+    const CauseSnapshot& start = causes_frame_start_;
+    perf::timeline::Record("cpf_sync", now.counts.barrier_batches - start.counts.barrier_batches,
+                           now.rendering_begins - start.rendering_begins, now.dispatches - start.dispatches);
+    perf::timeline::Record("cpf_sync2", now.counts.tex_loads - start.counts.tex_loads,
+                           now.counts.tex_loads_scaled - start.counts.tex_loads_scaled,
+                           now.counts.fsi_edram_barriers - start.counts.fsi_edram_barriers);
+  }
+  causes_frame_start_ = now;
+  if (!causes_log_frames_) {
+    causes_log_first_frame_ = frame_current_;
+  }
+  causes_log_timeline_ = causes_log_timeline_ && timeline;
+  if (++causes_log_frames_ < 300) {
+    return;
+  }
+  if (causes_log_timeline_) {
+    const CauseSnapshot& first = causes_log_start_;
+    const CauseCounts& e = now.counts;
+    const CauseCounts& s = first.counts;
+    const double frames = double(causes_log_frames_);
+    auto per_frame = [frames](uint64_t value) { return double(value) / frames; };
+    REXGPU_INFO(
+        "[s7][CAUSES] frames {}-{}, per frame: barrier batches {:.1f}, rendering begins {:.1f}, dispatches "
+        "{:.1f}, uploads {:.1f} ({:.1f} pages), texture loads {:.1f} ({:.1f} scaled, {:.0f} KiB), FSI EDRAM "
+        "barriers {:.1f}, descriptor sets {:.1f}, pipeline binds {:.1f}, pipelines created {:.2f}, draws skipped "
+        "for pending pipelines {:.2f}",
+        causes_log_first_frame_, frame_current_, per_frame(e.barrier_batches - s.barrier_batches),
+        per_frame(uint32_t(now.rendering_begins - first.rendering_begins)),
+        per_frame(uint32_t(now.dispatches - first.dispatches)), per_frame(uint32_t(e.up_calls - s.up_calls)),
+        per_frame(uint32_t(e.up_pages - s.up_pages)), per_frame(uint32_t(e.tex_loads - s.tex_loads)),
+        per_frame(uint32_t(e.tex_loads_scaled - s.tex_loads_scaled)),
+        per_frame((e.tex_load_bytes - s.tex_load_bytes) >> 10),
+        per_frame(uint32_t(e.fsi_edram_barriers - s.fsi_edram_barriers)),
+        per_frame(uint32_t(e.desc_writes - s.desc_writes)), per_frame(uint32_t(e.pipeline_binds - s.pipeline_binds)),
+        per_frame(uint32_t(e.pipelines_created - s.pipelines_created)),
+        per_frame(uint32_t(e.pipelines_pending - s.pipelines_pending)));
+  }
+  causes_log_start_ = now;
+  causes_log_frames_ = 0;
+  causes_log_timeline_ = true;
 }
 
