+// wwe2k14 patch (Session 7c, NOOPSKIP): gpu_skip_noop_draws / gpu_skip_noop_draws_stats. Called by IssueDraw in
+// the fragment shader interlock path (either setting on) after the render target cache update, with the values the
+// draw would be drawn with. A draw can be skipped only if all of these hold:
+// (1) No color render target written. The FSI pixel shader writes render target i only if its keep mask
+//     (UpdateSystemConstantValuesFull -> GetPSIColorFormatInfo, from bits 4i..4i+3 of normalized_color_mask) isn't
+//     all ones. draw_util::GetNormalizedColorMask is 0 unless RB_MODECONTROL is kColorDepth, the pixel shader
+//     statically writes the target and RB_COLOR_MASK enables a component the format has; 0 without a pixel shader.
+// (2) No depth or stencil stored. FSI_DepthStencilTest (spirv_translator_rb.cpp) stores a sample's depth / stencil
+//     only if the new value differs from the old one. The depth part changes only with kSysFlag_FSIDepthWrite,
+//     which UpdateSystemConstantValuesFull sets only with normalized z_enable and z_write_enable. The stencil part
+//     is old & ~write mask | new & write mask, with new = old for kKeep; the back-face reference / masks / ops are
+//     used only for polygons with backface_enable (otherwise the front ones are copied). Normalized depth control
+//     is all 0 outside kColorDepth / kDepthOnly. Conservative: depth func never, replace with an equal reference
+//     and the like count as writes.
+// (3) No memexport: the only memory a guest vertex shader writes, and besides the EDRAM, a pixel shader's.
+// (4) No sample counting: the only draw-dependent result the guest can read is the host occlusion query between
+//     EVENT_WRITE_ZPD begin and end (BeginGuestOcclusionQuery / EndGuestOcclusionQuery, active_occlusion_query_);
+//     without it ZPD writes a fixed fake count, and VIZ_QUERY results are always "visible"
+//     (CommandProcessor::ExecutePacketType3_VIZ_QUERY), neither depending on draws.
+// Without rasterization nothing reaches the EDRAM ((1) and (2) hold); IssueDraw only gets here then for
+// memexport, which (3) rejects. Alpha test, alpha to coverage and pixel shader kills only narrow the samples that
+// are written or counted, so they don't matter once (1), (2) and (4) hold.
+bool VulkanCommandProcessor::NoopSkipDraw(bool skip, bool is_rasterization_done,
+                                          bool primitive_polygonal,
+                                          reg::RB_DEPTHCONTROL normalized_depth_control,
+                                          uint32_t normalized_color_mask, bool memexport_used_vertex,
+                                          bool memexport_used_pixel) {
+  NoopSkipStats& stats = noop_skip_stats_;
+  NoopSkipStats::Counts& frame = stats.frame;
+  ++frame.checked;
+  NoopSkipOutcome outcome = kNoopSkipOk;
+  if (is_rasterization_done) {
+    if (normalized_color_mask) {
+      ++frame.color;
+      return false;
+    }
+    if (normalized_depth_control.z_enable && normalized_depth_control.z_write_enable) {
+      outcome = kNoopSkipRejectDepthWrite;
+    } else if (normalized_depth_control.stencil_enable) {
+      const RegisterFile& regs = *register_file_;
+      auto face_may_write = [](uint32_t write_mask, xenos::StencilOp fail, xenos::StencilOp zpass,
+                               xenos::StencilOp zfail) {
+        return write_mask != 0 &&
+               (fail != xenos::StencilOp::kKeep || zpass != xenos::StencilOp::kKeep ||
+                zfail != xenos::StencilOp::kKeep);
+      };
+      bool stencil_may_write = face_may_write(
+          regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask, normalized_depth_control.stencilfail,
+          normalized_depth_control.stencilzpass, normalized_depth_control.stencilzfail);
+      if (!stencil_may_write && primitive_polygonal && normalized_depth_control.backface_enable) {
+        stencil_may_write = face_may_write(
+            regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF).stencilwritemask,
+            normalized_depth_control.stencilfail_bf, normalized_depth_control.stencilzpass_bf,
+            normalized_depth_control.stencilzfail_bf);
+      }
+      if (stencil_may_write) {
+        outcome = kNoopSkipRejectStencilWrite;
+      }
+    }
+  }
+  if (outcome == kNoopSkipOk) {
+    if (memexport_used_vertex) {
+      outcome = kNoopSkipRejectMemexportVertex;
+    } else if (memexport_used_pixel) {
+      outcome = kNoopSkipRejectMemexportPixel;
+    } else if (active_occlusion_query_.valid) {
+      outcome = kNoopSkipRejectOcclusionQuery;
+    }
+  }
+  ++frame.outcomes[outcome];
+  if (outcome != kNoopSkipOk) {
+    return false;
+  }
+  // Guest shader pair, as the frame anatomy records it (the bound shaders, also when the pixel shader isn't used).
+  const Shader* guest_vertex_shader = active_vertex_shader();
+  const Shader* guest_pixel_shader = active_pixel_shader();
+  uint64_t vs_hash = guest_vertex_shader ? guest_vertex_shader->ucode_data_hash() : 0;
+  uint64_t ps_hash = guest_pixel_shader ? guest_pixel_shader->ucode_data_hash() : 0;
+  bool pair_found = false;
+  for (uint32_t i = 0; i < stats.shader_pair_count; ++i) {
+    NoopSkipStats::ShaderPair& pair = stats.shader_pairs[i];
+    if (pair.vs_hash == vs_hash && pair.ps_hash == ps_hash) {
+      ++pair.draws;
+      pair_found = true;
+      break;
+    }
+  }
+  if (!pair_found) {
+    if (stats.shader_pair_count < NoopSkipStats::kMaxShaderPairs) {
+      NoopSkipStats::ShaderPair& pair = stats.shader_pairs[stats.shader_pair_count++];
+      pair.vs_hash = vs_hash;
+      pair.ps_hash = ps_hash;
+      pair.draws = 1;
+    } else {
+      ++stats.shader_pairs_dropped;
+    }
+  }
+  if (!skip) {
+    return false;
+  }
+  ++frame.skipped;
+  return true;
+}
+
+// wwe2k14 patch (Session 7c, NOOPSKIP): called at every frame boundary (from CollectFrameCounters, right before the
+// cpf* events and cp_swap). Records, while the timeline is on and either setting is on (or the frame classified a
+// draw), with a fixed layout (for the report tool):
+//   cpf_noop  a = draws that can't change anything (skipped with gpu_skip_noop_draws, would be with the stats
+//             setting only), b = draws writing no color render target but depth (or stencil), c = draws writing
+//             nothing to the EDRAM but rejected for memexport (vertex or pixel shader) or an active occlusion query
+// and logs an [s7][NOOPSKIP] summary every 300 frames when the window classified any draw. The window and its
+// per-frame rates only count classified frames (either setting on at this boundary, or a draw classified in the
+// frame), so a window spanning a toggle (or both settings off) isn't diluted by frames that weren't classified; for
+// an A/B of gpu_skip_noop_draws keep gpu_skip_noop_draws_stats on in both arms, so both are classified and cost the
+// same.
+void VulkanCommandProcessor::NoopSkipFrameBoundary() {
+  NoopSkipStats& stats = noop_skip_stats_;
+  NoopSkipStats::Counts& frame = stats.frame;
+  const bool skip_on = REXCVAR_GET(gpu_skip_noop_draws);
+  const bool frame_classified = frame.checked || skip_on || REXCVAR_GET(gpu_skip_noop_draws_stats);
+  if (frame_classified && perf::timeline::Enabled()) {
+    perf::timeline::Record(
+        "cpf_noop", uint32_t(frame.outcomes[kNoopSkipOk]),
+        uint32_t(frame.outcomes[kNoopSkipRejectDepthWrite] +
+                 frame.outcomes[kNoopSkipRejectStencilWrite]),
+        uint32_t(frame.outcomes[kNoopSkipRejectMemexportVertex] +
+                 frame.outcomes[kNoopSkipRejectMemexportPixel] +
+                 frame.outcomes[kNoopSkipRejectOcclusionQuery]));
+  }
+  // Logs and empties the window. The shader pairs are counted straight into the window by NoopSkipDraw, so they're
+  // emptied here, not when the next window starts (after the next frame's draws).
+  auto close_window = [this, &stats](const char* note) {
+    NoopSkipLogWindow(note);
+    stats.window = NoopSkipStats::Counts();
+    stats.shader_pair_count = 0;
+    stats.shader_pairs_dropped = 0;
+    stats.window_first_frame = UINT64_MAX;
+    stats.window_frames_classified = 0;
+    stats.window_frames_skip_on = 0;
+  };
+  const uint64_t frame_number = frame_current_;
+  if (stats.window_first_frame != UINT64_MAX && frame_number < stats.window_last_frame) {
+    // frame_current_ went back: the context was recreated (ShutdownContext resets it to 1). The pairs of this
+    // frame's draws go into the closed window.
+    close_window(" (partial window: context recreated)");
+  }
+  if (frame_classified) {
+    if (stats.window_first_frame == UINT64_MAX) {
+      stats.window_first_frame = frame_number;
+    }
+    ++stats.window_frames_classified;
+    if (skip_on || frame.skipped) {
+      ++stats.window_frames_skip_on;
+    }
+    NoopSkipStats::Counts& window = stats.window;
+    window.checked += frame.checked;
+    window.color += frame.color;
+    for (uint32_t i = 0; i < kNoopSkipOutcomeCount; ++i) {
+      window.outcomes[i] += frame.outcomes[i];
+    }
+    window.skipped += frame.skipped;
+    frame = NoopSkipStats::Counts();
+  }
+  // Not classified: frame is already empty (frame.checked is 0, and only NoopSkipDraw counts).
+  if (stats.window_first_frame == UINT64_MAX) {
+    return;
+  }
+  stats.window_last_frame = frame_number;
+  if (frame_number - stats.window_first_frame + 1 >= 300) {
+    close_window("");
+  }
+}
+
+void VulkanCommandProcessor::NoopSkipLogWindow(const char* note) {
+  const NoopSkipStats& stats = noop_skip_stats_;
+  const NoopSkipStats::Counts& window = stats.window;
+  if (!window.checked || stats.window_first_frame == UINT64_MAX) {
+    return;
+  }
+  static const char* const kRejectNames[kNoopSkipOutcomeCount] = {
+      nullptr, "depth write", "stencil write", "vertex shader memexport", "pixel shader memexport",
+      "occlusion query active"};
+  // Rejection reasons, most first.
+  uint32_t reject_order[kNoopSkipOutcomeCount - 1];
+  for (uint32_t i = 0; i < kNoopSkipOutcomeCount - 1; ++i) {
+    reject_order[i] = i + 1;
+  }
+  std::stable_sort(std::begin(reject_order), std::end(reject_order),
+                   [&window](uint32_t a, uint32_t b) { return window.outcomes[a] > window.outcomes[b]; });
+  std::string rejects;
+  for (uint32_t outcome : reject_order) {
+    if (!window.outcomes[outcome]) {
+      continue;
+    }
+    fmt::format_to(std::back_inserter(rejects), "{}{} {}", rejects.empty() ? "" : ", ",
+                   kRejectNames[outcome], window.outcomes[outcome]);
+  }
+  std::string pairs;
+  for (uint32_t i = 0; i < stats.shader_pair_count; ++i) {
+    const NoopSkipStats::ShaderPair& pair = stats.shader_pairs[i];
+    fmt::format_to(std::back_inserter(pairs), "{}{:016X}/{:016X} {}", i ? ", " : "", pair.vs_hash,
+                   pair.ps_hash, pair.draws);
+  }
+  if (stats.shader_pairs_dropped) {
+    fmt::format_to(std::back_inserter(pairs), "{}{} more with other pairs", pairs.empty() ? "" : ", ",
+                   stats.shader_pairs_dropped);
+  }
+  // Per-frame rates over the classified frames only (see NoopSkipFrameBoundary). Skipped draws can only happen in
+  // frames with gpu_skip_noop_draws on, and drawn (stats only) ones in the other classified frames, so each is
+  // averaged over its own arm.
+  const uint64_t frames = stats.window_frames_classified;
+  const uint64_t frames_skip_on = stats.window_frames_skip_on;  // a subset of the classified frames
+  const uint64_t frames_skip_off = frames - frames_skip_on;
+  auto per_frame = [](uint64_t count, uint64_t frame_count) {
+    return frame_count ? double(count) / double(frame_count) : 0.0;
+  };
+  const uint64_t noop = window.outcomes[kNoopSkipOk];
+  const uint64_t drawn = noop - window.skipped;
+  REXGPU_INFO(
+      "[s7][NOOPSKIP] frames {}-{}{}: {} of them classified ({} with gpu_skip_noop_draws on, {} off; now "
+      "gpu_skip_noop_draws {}, gpu_skip_noop_draws_stats {}), /frame = per classified frame: {} draws checked "
+      "({:.1f}/frame), {} of them writing color; {} can't change anything ({:.1f}/frame): {} skipped "
+      "({:.1f}/frame with skip on), {} drawn, stats only ({:.1f}/frame with skip off); not skipped although no "
+      "color is written (most first): {}; can't-change-anything draws by guest VS/PS: {}",
+      stats.window_first_frame, stats.window_last_frame, note, frames, frames_skip_on, frames_skip_off,
+      REXCVAR_GET(gpu_skip_noop_draws) ? "on" : "off",
+      REXCVAR_GET(gpu_skip_noop_draws_stats) ? "on" : "off", window.checked,
+      per_frame(window.checked, frames), window.color, noop, per_frame(noop, frames), window.skipped,
+      per_frame(window.skipped, frames_skip_on), drawn, per_frame(drawn, frames_skip_off),
+      rejects.empty() ? std::string("none") : rejects, pairs.empty() ? std::string("none") : pairs);
+}
