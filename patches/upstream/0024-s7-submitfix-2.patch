+    constexpr uint32_t kRetriesWithCommands = 16;
     for (uint32_t retry = 1; submit_result != VK_SUCCESS && submit_result != VK_ERROR_DEVICE_LOST;
          ++retry) {
       if (retry == 1 || !(retry % 100)) {
@@ -5105,7 +5108,8 @@ void VulkanCommandProcessor::AsyncSubmitExecute(AsyncSubmitJob& job) {
       if (retry > kRetriesWithCommands && submit_info.commandBufferCount) {
         REXGPU_ERROR(
             "[s7][SUBMITFIX] Async submit: dropping the commands of submission {}, submitting only its "
