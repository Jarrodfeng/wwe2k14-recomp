@@ -5124,7 +5128,11 @@ void VulkanCommandProcessor::AsyncSubmitExecute(AsyncSubmitJob& job) {
       order_fence_signals_failed = async_swap_order_->MarkSubmitted(
           job.order_ticket, dfn, queue_acquisition.queue(), &order_fence_signal_result);
       // wwe2k14 patch (Session 7, SUBMITFIX): the presenter's submission tracker already counts those fences as
-      // pending and would wait on them forever - retry like above, with the queue still acquired.
+      // pending (a resize or shutdown wait on the newest of them would never end) - retry like above, with the
+      // queue still acquired. Unlike the job's own fence, giving up here doesn't hang the command processor,
