+        // the next MarkSubmitted doesn't queue new signals behind them or submit their stale handles.
+        async_swap_order_->DropFailedFenceSignals();
+      }
     }
   }
   if (order_fence_signals_failed) {
     REXGPU_ERROR(
         "[s6][DRAIN] Async swap: {} presenter fence signal(s) after submission {} failed (given up: device "
-        "lost or stopping)",
