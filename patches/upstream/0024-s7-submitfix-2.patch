+      // signals are dropped, leaving those fences unsignaled and pending in the tracker as before SUBMITFIX.
+      constexpr uint32_t kFenceSignalRetries = kRetriesWithCommands;
       for (uint32_t retry = 1;
            order_fence_signals_failed && order_fence_signal_result != VK_ERROR_DEVICE_LOST; ++retry) {
         if (retry == 1 || !(retry % 100)) {
@@ -5133,7 +5141,7 @@ void VulkanCommandProcessor::AsyncSubmitExecute(AsyncSubmitJob& job) {
               "{}), retry {}",
