+VulkanCommandProcessor::VertexResidencyCheck* VulkanCommandProcessor::VertexResidencyCheckBeginDraw() {
+  // wwe2k14 patch (Session 6, RESID).
+  if (!vertex_residency_check_) {
+    vertex_residency_check_ = std::make_unique<VertexResidencyCheck>();
+    vertex_residency_check_->frame = frame_current_;
+    vertex_residency_check_->window_first_frame = frame_current_;
+  }
+  VertexResidencyCheck& check = *vertex_residency_check_;
+  if (!check.active) {
+    // Turned on (again): report what was counted before it was turned off, and start a new window.
+    check.EndFrame();
+    if (check.requests || check.match_hits || check.sync_skips) {
+      check.Report(check.frame);
+    }
+    check.ResetWindow(frame_current_);
+    check.frame = frame_current_;
+    check.recorded[0] = 0;
+    check.recorded[1] = 0;
+    check.active = true;
+  }
+  if (check.frame != frame_current_) {
+    check.EndFrame();
+    check.frame = frame_current_;
+    if (frame_current_ - check.window_first_frame >= VertexResidencyCheck::kStatsFrames) {
+      check.Report(frame_current_ - 1);
+      check.ResetWindow(frame_current_);
+    }
+  }
+  return &check;
+}
+
+void VulkanCommandProcessor::VertexResidencyCheckInSync(VertexResidencyCheck& check,
+                                                        uint32_t vfetch_index) {
+  // wwe2k14 patch (Session 6, RESID): the cache skips this request because the fetch constant is in sync -
+  // RequestRange would have been called for the fetch constant's current range.
+  ++check.sync_skips;
+  const VertexBufferState& state = vertex_buffer_states_[vfetch_index];
+  xenos::xe_gpu_vertex_fetch_t vfetch_constant = register_file_->GetVertexFetch(vfetch_index);
+  if (vfetch_constant.address != state.address || vfetch_constant.size != state.size) {
+    // In sync means not written since it was synchronized with the address and size in the state.
+    ++check.sync_constant_changed;
+    ++check.sync_constant_changed_total;
+    if (check.detailed_logs[2] < VertexResidencyCheck::kDetailedLogs) {
+      ++check.detailed_logs[2];
+      REXGPU_WARN(
+          "[s6][RESID] frame {}: vertex fetch constant {} is in sync for {:08X}+{:X}, but now holds "
+          "{:08X}+{:X} (type {}) - changed without clearing its in-sync bit",
+          frame_current_, vfetch_index, state.address << 2, state.size << 2,
+          uint32_t(vfetch_constant.address) << 2, uint32_t(vfetch_constant.size) << 2,
+          uint32_t(vfetch_constant.type));
+    }
+  }
+  uint32_t address = uint32_t(vfetch_constant.address) << 2;
+  uint32_t size = uint32_t(vfetch_constant.size) << 2;
+  if (shared_memory_->IsRangeUpToDate(address, size)) {
+    return;
+  }
+  ++check.sync_invalid;
+  uint32_t word = vfetch_index >> 6;
+  uint64_t bit = uint64_t(1) << (vfetch_index & 63);
+  if (!(check.recorded[word] & check.up_to_date_at_sync[word] & bit)) {
+    // Not up to date at the synchronization already (a match - counted there), or not seen by the check.
+    return;
+  }
+  check.up_to_date_at_sync[word] &= ~bit;
+  ++check.sync_invalidated;
+  ++check.frame_sync_invalidated;
+  ++check.sync_invalidated_total;
+  VertexResidencyCheck::AddExample(check.sync_examples, check.sync_example_count, vfetch_index, address,
+                                   size);
+  if (check.detailed_logs[1] < VertexResidencyCheck::kDetailedLogs) {
+    ++check.detailed_logs[1];
+    REXGPU_WARN(
+        "[s6][RESID] frame {}: vertex fetch constant {} ({:08X}+{:X}) is in sync and its pages were up "
+        "to date when it was synchronized this frame, but not any more - the skipped request would "
+        "have uploaded (potentially stale vertex data)",
+        frame_current_, vfetch_index, address, size);
+  }
+}
+
+void VulkanCommandProcessor::VertexResidencyCheckMatch(
+    VertexResidencyCheck& check, uint32_t vfetch_index,
+    const xenos::xe_gpu_vertex_fetch_t& vfetch_constant) {
+  // wwe2k14 patch (Session 6, RESID): the cache skips this request because the address and size equal the
+  // fetch constant's last request.
+  ++check.match_hits;
+  uint32_t address = uint32_t(vfetch_constant.address) << 2;
+  uint32_t size = uint32_t(vfetch_constant.size) << 2;
+  bool up_to_date = shared_memory_->IsRangeUpToDate(address, size);
+  uint32_t word = vfetch_index >> 6;
+  uint64_t bit = uint64_t(1) << (vfetch_index & 63);
+  check.recorded[word] |= bit;
+  if (up_to_date) {
+    check.up_to_date_at_sync[word] |= bit;
+    return;
+  }
+  check.up_to_date_at_sync[word] &= ~bit;
+  ++check.match_invalid;
+  ++check.frame_match_invalid;
+  ++check.match_invalid_total;
+  VertexResidencyCheck::AddExample(check.match_examples, check.match_example_count, vfetch_index,
+                                   address, size);
+  // With clear_memory_page_state, nearly every match in a later frame than the upload gets here.
+  if (!REXCVAR_GET(clear_memory_page_state) &&
+      check.detailed_logs[0] < VertexResidencyCheck::kDetailedLogs) {
+    ++check.detailed_logs[0];
+    REXGPU_WARN(
+        "[s6][RESID] frame {}: vertex fetch constant {} ({:08X}+{:X}) matches its last request, but its "
+        "pages are not up to date - the skipped request would have uploaded (potentially stale vertex "
+        "data)",
+        frame_current_, vfetch_index, address, size);
+  }
+}
+
+void VulkanCommandProcessor::VertexResidencyCheckRequested(
+    VertexResidencyCheck& check, uint32_t vfetch_index,
+    const xenos::xe_gpu_vertex_fetch_t& vfetch_constant) {
+  // wwe2k14 patch (Session 6, RESID): RequestRange has just synchronized the fetch constant. Its pages are up
+  // to date unless a guest write has invalidated them since.
+  ++check.requests;
+  uint32_t word = vfetch_index >> 6;
+  uint64_t bit = uint64_t(1) << (vfetch_index & 63);
+  check.recorded[word] |= bit;
+  if (shared_memory_->IsRangeUpToDate(uint32_t(vfetch_constant.address) << 2,
+                                      uint32_t(vfetch_constant.size) << 2)) {
+    check.up_to_date_at_sync[word] |= bit;
+  } else {
+    check.up_to_date_at_sync[word] &= ~bit;
+  }
+}
