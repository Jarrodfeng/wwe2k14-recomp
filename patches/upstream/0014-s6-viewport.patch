+// wwe2k14 patch (Session 6, VIEWPORT): vulkan_viewport_info_cache.
+namespace {
+
+// Space-separated 32-bit words, for the [s6][VIEWPORT] mismatch log.
+std::string ViewportInfoCacheWordsHex(const void* data, size_t size) {
+  std::string text;
+  const uint8_t* bytes = static_cast<const uint8_t*>(data);
+  for (size_t i = 0; i + sizeof(uint32_t) <= size; i += sizeof(uint32_t)) {
+    uint32_t word;
+    std::memcpy(&word, bytes + i, sizeof(word));
+    fmt::format_to(std::back_inserter(text), "{}{:08X}", i ? " " : "", word);
+  }
+  return text;
+}
+
+}  // namespace
+
+// draw_util::GetHostViewportInfo (util/draw.cpp) is a pure function of the following, and all of it is in
+// the key (read in source, Session 6):
+// - Registers: PA_CL_CLIP_CNTL (clip_disable, dx_clip_space_def), PA_CL_VTE_CNTL (vport_x/y/z_scale_ena,
+//   vport_x/y/z_offset_ena), PA_SU_SC_MODE_CNTL (vtx_window_offset_enable), PA_SU_VTX_CNTL (pix_center),
+//   PA_SC_WINDOW_OFFSET (read only with vtx_window_offset_enable), PA_CL_VPORT_XSCALE...ZOFFSET (each read
+//   only if its _ena bit is set), RB_DEPTH_INFO (depth_format, read only with z_enable). Whole registers are
+//   keyed, including fields and registers that end up not being read, which can only cause extra misses.
+// - Arguments: draw_resolution_scale_x/y, origin_bottom_left, x_max, y_max, allow_reverse_z,
+//   normalized_depth_control (only z_enable is read; the whole value is keyed), convert_z_to_float24,
+//   full_float24_in_0_to_1, pixel_shader_writes_depth.
+// - Setting: half_pixel_offset (REXCVAR_GET inside the function, so keyed as a flag).
+// Everything else it uses is a constant (xenos::kTexture2DCubeMaxWidthHeight) or a pure function of the
+// above (rex::clamp_float, rex::saturate, std::abs, xenos::Float32To20e4 / Float20e4To32). As IssueDraw
+// calls it, origin_bottom_left (false) and allow_reverse_z (true) are constants, and the resolution scale
+// (texture cache), x_max / y_max (device maxViewportDimensions), full_float24_in_0_to_1 (render target cache
+// path) and the float24 conversion setting of the render target cache are fixed at initialization; they're
+// keyed anyway, so a hit doesn't depend on that. pixel_shader_writes_depth is per shader (ucode analysis).
+// - Host floating-point control (key.host_fp_control): the function's float math (scales, offsets, clamps,
+//   z range) runs under this thread's rounding mode and flush-to-zero / denormals-are-zero bits, and those
+//   do change between draws on this thread: a PM4_INTERRUPT packet runs the guest's interrupt callback here
+//   (ExecutePacketType3_INTERRUPT -> GraphicsSystem::DispatchInterruptCallback ->
+//   FunctionDispatcher::ExecuteInterrupt), recompiled guest code sets those bits (ctx.fpscr
+//   enable/disableFlushMode for VMX/FPU code, storeFromGuest for mtfsf), and ExecuteInterrupt doesn't
+//   restore them. So the current bits are read and keyed: rex::platform::FPSCRPlatform RoundMaskVal |
+//   FlushMask, the same bits as ppc::FPSCRRegister::GuestMask. On x64 those are all the MXCSR bits that
+//   affect results (the rest are sticky status flags, which would only break hits, and exception masks); on
+//   arm64 the other FPCR bits are host policy that guest code doesn't touch.
+// Registers: draws read them on this (the command processor) thread, which writes them from the ring
+// buffer. Guest MMIO writes (GraphicsSystem::WriteRegister) can store any register from another thread,
+// but a write to any register other than CP_RB_WPTR / AVIVO_D1GRPH_PRIMARY_SURFACE_ADDRESS logs "Unknown
+// GPU register". Such a write landing between the key reads below and the computation would store the new
+// value's result under the old key; the next draw then misses (the register no longer matches the key)
+// unless the register was written back to the old value in between, which _verify would show.
+void VulkanCommandProcessor::GetHostViewportInfoCached(
+    const RegisterFile& regs, uint32_t draw_resolution_scale_x, uint32_t draw_resolution_scale_y,
+    bool origin_bottom_left, uint32_t x_max, uint32_t y_max, bool allow_reverse_z,
+    reg::RB_DEPTHCONTROL normalized_depth_control, bool convert_z_to_float24,
+    bool full_float24_in_0_to_1, bool pixel_shader_writes_depth,
+    draw_util::ViewportInfo& viewport_info_out) {
+  static_assert(sizeof(ViewportInfoCacheKey) == sizeof(uint32_t) * 19,
+                "ViewportInfoCacheKey must have no padding (== compares every member)");
+  static_assert(sizeof(draw_util::ViewportInfo) == sizeof(uint32_t) * 12,
+                "ViewportInfo must have no padding (the verify memcmp compares every field)");
+  static_assert(XE_GPU_REG_PA_CL_VPORT_ZOFFSET == XE_GPU_REG_PA_CL_VPORT_XSCALE + 5,
+                "PA_CL_VPORT_* must be 6 consecutive registers");
+
+  ViewportInfoCacheKey key;
+  key.pa_cl_clip_cntl = regs[XE_GPU_REG_PA_CL_CLIP_CNTL];
+  key.pa_cl_vte_cntl = regs[XE_GPU_REG_PA_CL_VTE_CNTL];
+  key.pa_su_sc_mode_cntl = regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL];
+  key.pa_su_vtx_cntl = regs[XE_GPU_REG_PA_SU_VTX_CNTL];
+  key.pa_sc_window_offset = regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET];
+  key.rb_depth_info = regs[XE_GPU_REG_RB_DEPTH_INFO];
+  std::memcpy(key.vport_regs, &regs[XE_GPU_REG_PA_CL_VPORT_XSCALE], sizeof(key.vport_regs));
+  key.normalized_depth_control = normalized_depth_control.value;
+  key.draw_resolution_scale_x = draw_resolution_scale_x;
+  key.draw_resolution_scale_y = draw_resolution_scale_y;
+  key.x_max = x_max;
+  key.y_max = y_max;
+  key.flags = (origin_bottom_left ? kViewportInfoCacheFlagOriginBottomLeft : 0) |
+              (allow_reverse_z ? kViewportInfoCacheFlagAllowReverseZ : 0) |
+              (convert_z_to_float24 ? kViewportInfoCacheFlagConvertZToFloat24 : 0) |
+              (full_float24_in_0_to_1 ? kViewportInfoCacheFlagFullFloat24In0To1 : 0) |
+              (pixel_shader_writes_depth ? kViewportInfoCacheFlagPixelShaderWritesDepth : 0) |
+              (REXCVAR_GET(half_pixel_offset) ? kViewportInfoCacheFlagHalfPixelOffset : 0);
+  key.host_fp_control =
+      rex::platform::FPSCRPlatform::getcsr() &
+      uint32_t(rex::platform::FPSCRPlatform::RoundMaskVal | rex::platform::FPSCRPlatform::FlushMask);
+
+  // Statistics window, before counting so this lookup counts in the window of its own frame.
+  ViewportInfoCacheStats& stats = viewport_info_cache_stats_;
+  {
+    // Nothing cached: the first lookup, or the first since the cache was turned back on (the off path in
+    // IssueDraw clears viewport_info_cache_valid_). frame_current_ going back: the context was recreated
+    // (ShutdownContext resets it to 1). In both cases close the open window at its last lookup, so neither
+    // the off period nor another context is counted in it, and start a new one at this frame.
+    bool window_restart = !viewport_info_cache_valid_ || frame_current_ < stats.last_frame;
+    if (window_restart || frame_current_ - stats.stats_frame >= 300) {
+      if (stats.last_frame) {
+        uint64_t misses = stats.misses_invalid + stats.misses_viewport + stats.misses_registers +
+                          stats.misses_arguments;
+        uint64_t lookups = stats.hits + misses;
+        REXGPU_INFO(
+            "[s6][VIEWPORT] frames {}-{}{}: viewport info reused {} of {} ({:.1f}%); computed: "
+            "nothing cached {}, viewport registers {}, other registers {}, other inputs {}; verify {} "
+            "checks, {} mismatches ({} total)",
+            stats.stats_frame, window_restart ? stats.last_frame : frame_current_ - 1,
+            window_restart ? " (partial window: cache turned off or context recreated after it)" : "",
+            stats.hits, lookups, lookups ? 100.0 * double(stats.hits) / double(lookups) : 0.0,
+            stats.misses_invalid, stats.misses_viewport, stats.misses_registers,
+            stats.misses_arguments, stats.verify_checks, stats.verify_mismatches,
+            stats.verify_mismatches_total);
+      }
+      uint64_t verify_mismatches_total = stats.verify_mismatches_total;
+      uint32_t verify_mismatches_logged = stats.verify_mismatches_logged;
+      stats = ViewportInfoCacheStats();
+      stats.stats_frame = frame_current_;
+      stats.verify_mismatches_total = verify_mismatches_total;
+      stats.verify_mismatches_logged = verify_mismatches_logged;
+    }
+    stats.last_frame = frame_current_;
+  }
+
+  if (viewport_info_cache_valid_ && key == viewport_info_cache_key_) {
+    ++stats.hits;
+    if (REXCVAR_GET(vulkan_viewport_info_cache_verify)) {
+      draw_util::ViewportInfo computed{};
+      draw_util::GetHostViewportInfo(regs, draw_resolution_scale_x, draw_resolution_scale_y,
+                                     origin_bottom_left, x_max, y_max, allow_reverse_z,
+                                     normalized_depth_control, convert_z_to_float24,
+                                     full_float24_in_0_to_1, pixel_shader_writes_depth, computed);
+      ++stats.verify_checks;
+      if (std::memcmp(&computed, &viewport_info_cache_value_, sizeof(computed))) {
+        ++stats.verify_mismatches;
+        ++stats.verify_mismatches_total;
+        if (stats.verify_mismatches_logged < 8) {
+          ++stats.verify_mismatches_logged;
+          REXGPU_WARN(
+              "[s6][VIEWPORT] verify mismatch at frame {}: cached [{}] computed [{}] (xy_offset[2] "
+              "xy_extent[2] z_min z_max ndc_scale[3] ndc_offset[3]); key [{}] (clip_cntl vte_cntl "
+              "sc_mode_cntl vtx_cntl window_offset depth_info vport[6] depth_control scale_x scale_y "
+              "x_max y_max flags fp_control)",
+              frame_current_,
+              ViewportInfoCacheWordsHex(&viewport_info_cache_value_,
+                                        sizeof(viewport_info_cache_value_)),
+              ViewportInfoCacheWordsHex(&computed, sizeof(computed)),
+              ViewportInfoCacheWordsHex(&key, sizeof(key)));
+        }
+        // Continue with the computed value, as with the cache off.
+        viewport_info_cache_value_ = computed;
+      }
+    }
+    viewport_info_out = viewport_info_cache_value_;
+  } else {
+    if (!viewport_info_cache_valid_) {
+      ++stats.misses_invalid;
+    } else if (std::memcmp(key.vport_regs, viewport_info_cache_key_.vport_regs,
+                           sizeof(key.vport_regs))) {
+      ++stats.misses_viewport;
+    } else if (key.pa_cl_clip_cntl != viewport_info_cache_key_.pa_cl_clip_cntl ||
+               key.pa_cl_vte_cntl != viewport_info_cache_key_.pa_cl_vte_cntl ||
+               key.pa_su_sc_mode_cntl != viewport_info_cache_key_.pa_su_sc_mode_cntl ||
+               key.pa_su_vtx_cntl != viewport_info_cache_key_.pa_su_vtx_cntl ||
+               key.pa_sc_window_offset != viewport_info_cache_key_.pa_sc_window_offset ||
+               key.rb_depth_info != viewport_info_cache_key_.rb_depth_info) {
+      ++stats.misses_registers;
+    } else {
+      ++stats.misses_arguments;
+    }
+    draw_util::GetHostViewportInfo(regs, draw_resolution_scale_x, draw_resolution_scale_y,
+                                   origin_bottom_left, x_max, y_max, allow_reverse_z,
+                                   normalized_depth_control, convert_z_to_float24,
+                                   full_float24_in_0_to_1, pixel_shader_writes_depth,
+                                   viewport_info_out);
+    viewport_info_cache_key_ = key;
+    viewport_info_cache_value_ = viewport_info_out;
+    viewport_info_cache_valid_ = true;
+  }
+}
+
 bool VulkanCommandProcessor::IssueDraw_MemexportReadbackFullPath(uint32_t total_size) {
   if (!total_size || memexport_ranges_.empty()) {
     return true;
