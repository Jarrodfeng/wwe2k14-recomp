diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index c56e9d2..62a279d 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -6233,6 +6233,18 @@ void VulkanCommandProcessor::TilingViewportFixStatsDraw(
   if (!std::memcmp(&without_fix, &with_fix, sizeof(with_fix))) {
     return;
   }
+  // A host viewport that is empty on either axis renders nothing either way: UpdateDynamicState then ignores
+  // xy_offset and sets its 1x1 viewport outside the framebuffer. The fix still changes such a viewport's
+  // origin (its start is no longer cropped at 0 - for example a guest viewport left of the strip, or NaN
+  // registers, which clamp to -max), so count it apart and keep it out of the differ counts and the
+  // smallest origin.
+  auto viewport_empty = [](const draw_util::ViewportInfo& info) {
+    return !info.xy_extent[0] || !info.xy_extent[1];
+  };
+  if (viewport_empty(without_fix) && viewport_empty(with_fix)) {
+    ++stats.differ_empty_only;
+    return;
+  }
   for (uint32_t i = 0; i < 2; ++i) {
     stats.min_origin_with_fix[i] = std::min(stats.min_origin_with_fix[i], with_fix.xy_offset[i]);
   }
