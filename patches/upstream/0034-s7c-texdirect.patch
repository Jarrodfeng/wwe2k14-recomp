+  VkDescriptorImageInfo descriptor_image_info;
+  descriptor_image_info.sampler = VK_NULL_HANDLE;
+  descriptor_image_info.imageView = direct_load_view_;
+  descriptor_image_info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
