+VkDescriptorSet VulkanTextureCache::VulkanTexture::GetDirectLoadDescriptorSet() {
+  // wwe2k14 patch (Session 7c, TEXDIRECT).
+  VulkanTextureCache& vulkan_texture_cache = static_cast<VulkanTextureCache&>(texture_cache());
