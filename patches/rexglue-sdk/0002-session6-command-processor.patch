+void VulkanCommandProcessor::VertexResidencyCheckMatch(
+    VertexResidencyCheck& check, uint32_t vfetch_index,
+    const xenos::xe_gpu_vertex_fetch_t& vfetch_constant) {
+  // wwe2k14 patch (Session 6, RESID): the cache skips this request because the address and size equal the
+  // fetch constant's last request.
+  ++check.match_hits;
+  uint32_t address = uint32_t(vfetch_constant.address) << 2;
+  uint32_t size = uint32_t(vfetch_constant.size) << 2;
+  bool up_to_date = shared_memory_->IsRangeUpToDate(address, size);
+  uint32_t word = vfetch_index >> 6;
+  uint64_t bit = uint64_t(1) << (vfetch_index & 63);
+  check.recorded[word] |= bit;
+  if (up_to_date) {
+    check.up_to_date_at_sync[word] |= bit;
+    return;
+  }
+  check.up_to_date_at_sync[word] &= ~bit;
+  ++check.match_invalid;
+  ++check.frame_match_invalid;
+  ++check.match_invalid_total;
+  VertexResidencyCheck::AddExample(check.match_examples, check.match_example_count, vfetch_index,
+                                   address, size);
+  // With clear_memory_page_state, nearly every match in a later frame than the upload gets here.
+  if (!REXCVAR_GET(clear_memory_page_state) &&
+      check.detailed_logs[0] < VertexResidencyCheck::kDetailedLogs) {
+    ++check.detailed_logs[0];
+    REXGPU_WARN(
+        "[s6][RESID] frame {}: vertex fetch constant {} ({:08X}+{:X}) matches its last request, but its "
+        "pages are not up to date - the skipped request would have uploaded (potentially stale vertex "
+        "data)",
+        frame_current_, vfetch_index, address, size);
+  }
+}
+
+void VulkanCommandProcessor::VertexResidencyCheckRequested(
+    VertexResidencyCheck& check, uint32_t vfetch_index,
+    const xenos::xe_gpu_vertex_fetch_t& vfetch_constant) {
+  // wwe2k14 patch (Session 6, RESID): RequestRange has just synchronized the fetch constant. Its pages are up
+  // to date unless a guest write has invalidated them since.
+  ++check.requests;
+  uint32_t word = vfetch_index >> 6;
+  uint64_t bit = uint64_t(1) << (vfetch_index & 63);
+  check.recorded[word] |= bit;
+  if (shared_memory_->IsRangeUpToDate(uint32_t(vfetch_constant.address) << 2,
+                                      uint32_t(vfetch_constant.size) << 2)) {
+    check.up_to_date_at_sync[word] |= bit;
+  } else {
+    check.up_to_date_at_sync[word] &= ~bit;
+  }
+}
