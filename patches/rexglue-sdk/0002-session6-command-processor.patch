+  // In the current frame.
+  uint64_t frame_match_invalid = 0;
+  uint64_t frame_sync_invalidated = 0;
+  // In the current window.
+  uint64_t requests = 0;
+  uint64_t match_hits = 0;
+  uint64_t match_invalid = 0;
+  uint64_t match_invalid_frames = 0;
+  uint64_t match_invalid_frame_max = 0;
+  uint64_t sync_skips = 0;
+  uint64_t sync_invalid = 0;
+  uint64_t sync_invalidated = 0;
+  uint64_t sync_invalidated_frames = 0;
+  uint64_t sync_invalidated_frame_max = 0;
+  uint64_t sync_constant_changed = 0;
+  Example match_examples[kExamples] = {};
+  uint32_t match_example_count = 0;
+  Example sync_examples[kExamples] = {};
+  uint32_t sync_example_count = 0;
+  // Since the check was created.
+  uint64_t match_invalid_total = 0;
+  uint64_t sync_invalidated_total = 0;
+  uint64_t sync_constant_changed_total = 0;
+  // Detailed log lines so far: [0] match not up to date (only logged with clear_memory_page_state off),
+  // [1] invalidated since synchronized, [2] in-sync fetch constant changed.
+  uint64_t detailed_logs[3] = {};
+
+  void EndFrame() {
+    if (frame_match_invalid) {
+      ++match_invalid_frames;
+      match_invalid_frame_max = std::max(match_invalid_frame_max, frame_match_invalid);
+    }
+    if (frame_sync_invalidated) {
+      ++sync_invalidated_frames;
+      sync_invalidated_frame_max = std::max(sync_invalidated_frame_max, frame_sync_invalidated);
+    }
+    frame_match_invalid = 0;
+    frame_sync_invalidated = 0;
+  }
+
+  void ResetWindow(uint64_t first_frame) {
+    window_first_frame = first_frame;
+    requests = 0;
+    match_hits = 0;
+    match_invalid = 0;
+    match_invalid_frames = 0;
+    match_invalid_frame_max = 0;
+    sync_skips = 0;
+    sync_invalid = 0;
+    sync_invalidated = 0;
+    sync_invalidated_frames = 0;
+    sync_invalidated_frame_max = 0;
+    sync_constant_changed = 0;
+    match_example_count = 0;
+    sync_example_count = 0;
+  }
+
+  static void AddExample(Example* examples, uint32_t& count, uint32_t vfetch_index, uint32_t address,
+                         uint32_t size) {
+    if (count < kExamples) {
+      examples[count++] = Example{vfetch_index, address, size};
+    }
+  }
+
+  static std::string FormatExamples(const Example* examples, uint32_t count) {
+    std::string text;
+    for (uint32_t i = 0; i < count; ++i) {
+      text += fmt::format("{}#{} {:08X}+{:X}", i ? ", " : "", examples[i].vfetch_index,
+                          examples[i].address, examples[i].size);
+    }
+    return text.empty() ? std::string("none") : text;
+  }
+
+  void Report(uint64_t last_frame) const {
+    REXGPU_INFO(
+        "[s6][RESID] frames {}-{} (clear_memory_page_state {}, vulkan_vertex_residency_cache_off {}): "
+        "{} vertex buffer requests; skipped by the cache (or would be): match {}, {} with pages not up "
+        "to date (in {} frames, max {}/frame; e.g. {}); in sync {}, {} not up to date, {} invalidated "
+        "since synchronized this frame (in {} frames, max {}/frame; e.g. {}); {} in-sync fetch "
+        "constants changed. Totals: {} match not up to date, {} invalidated in sync, {} changed in sync",
+        window_first_frame, last_frame, REXCVAR_GET(clear_memory_page_state),
+        REXCVAR_GET(vulkan_vertex_residency_cache_off), requests, match_hits, match_invalid,
+        match_invalid_frames, match_invalid_frame_max,
+        FormatExamples(match_examples, match_example_count), sync_skips, sync_invalid,
+        sync_invalidated, sync_invalidated_frames, sync_invalidated_frame_max,
+        FormatExamples(sync_examples, sync_example_count), sync_constant_changed,
+        match_invalid_total, sync_invalidated_total, sync_constant_changed_total);
+  }
+};
