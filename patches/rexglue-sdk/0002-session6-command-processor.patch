+bool VulkanCommandProcessor::SystemConstantsSkip::UpdateIndexPart(
+    SpirvShaderTranslator::SystemConstants& constants, const RegisterFile& regs,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    bool shader_32bit_index_dma, uint32_t compute_memexport_vertex_count) {
+  auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  auto vgt_indx_offset = regs.Get<int32_t>(XE_GPU_REG_VGT_INDX_OFFSET);
+  auto vgt_max_vtx_indx = regs.Get<uint32_t>(XE_GPU_REG_VGT_MAX_VTX_INDX);
+  auto vgt_min_vtx_indx = regs.Get<uint32_t>(XE_GPU_REG_VGT_MIN_VTX_INDX);
+
+  bool dirty = false;
+
+  // The index flags, as in UpdateSystemConstantValuesFull.
+  uint32_t index_flags = 0;
+  if (shader_32bit_index_dma) {
+    index_flags |= SpirvShaderTranslator::kSysFlag_VertexIndexLoad;
+  }
+  if (primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForDMA ||
+      primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA ||
+      primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kHostConverted) {
+    index_flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad;
+    if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt32) {
+      index_flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit;
+    }
+    bool compute_or_primitive_vertex_index_reset =
+        primitive_processing_result.host_primitive_reset_enabled &&
+        primitive_processing_result.host_vertex_shader_type !=
+            Shader::HostVertexShaderType::kPointListAsTriangleStrip &&
+        primitive_processing_result.host_vertex_shader_type !=
+            Shader::HostVertexShaderType::kRectangleListAsTriangleStrip;
+    if (compute_or_primitive_vertex_index_reset) {
+      index_flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset;
+    }
+  }
+  if (primitive_processing_result.host_vertex_shader_type ==
+      Shader::HostVertexShaderType::kTriangleDomainPatchIndexed) {
+    index_flags |= SpirvShaderTranslator::kSysFlag_ComputeMemExportPatchIndexInRegister1;
+  }
+  if (primitive_processing_result.host_vertex_shader_type ==
+      Shader::HostVertexShaderType::kTriangleDomainCPIndexed) {
+    index_flags |= SpirvShaderTranslator::kSysFlag_ComputeMemExportTriangleCPIndexed;
+  } else if (primitive_processing_result.host_vertex_shader_type ==
+             Shader::HostVertexShaderType::kQuadDomainCPIndexed) {
+    index_flags |= SpirvShaderTranslator::kSysFlag_ComputeMemExportQuadCPIndexed;
+  }
+  if (primitive_processing_result.tessellation_mode == xenos::TessellationMode::kAdaptive &&
+      (primitive_processing_result.host_vertex_shader_type ==
+           Shader::HostVertexShaderType::kTriangleDomainPatchIndexed ||
+       primitive_processing_result.host_vertex_shader_type ==
+           Shader::HostVertexShaderType::kQuadDomainPatchIndexed)) {
+    index_flags |= SpirvShaderTranslator::kSysFlag_ComputeMemExportPatchIndexFromInvocation;
+  }
+  // The state part's flags are what they were computed as from the same inputs.
+  uint32_t flags = (constants.flags & ~kIndexFlags) | index_flags;
+  dirty |= constants.flags != flags;
+  constants.flags = flags;
+
+  // Index buffer address for loading in the shaders.
+  if (flags & (SpirvShaderTranslator::kSysFlag_VertexIndexLoad |
+               SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad)) {
+    dirty |= constants.vertex_index_load_address != primitive_processing_result.guest_index_base;
+    constants.vertex_index_load_address = primitive_processing_result.guest_index_base;
+  }
+
+  // Primitive reset index for shader-side index loading.
+  uint32_t vertex_index_reset =
+      (flags & SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset)
+          ? regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx
+          : 0;
+  dirty |= constants.vertex_index_reset != vertex_index_reset;
+  constants.vertex_index_reset = vertex_index_reset;
+  dirty |= constants.compute_memexport_vertex_count != compute_memexport_vertex_count;
+  constants.compute_memexport_vertex_count = compute_memexport_vertex_count;
+
+  // Index or tessellation edge factor buffer endianness.
+  xenos::Endian guest_index_endian = vgt_dma_size.swap_mode;
+  if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16 &&
+      guest_index_endian != xenos::Endian::kNone && guest_index_endian != xenos::Endian::k8in16) {
+    guest_index_endian =
+        guest_index_endian == xenos::Endian::k8in32 ? xenos::Endian::k8in16 : xenos::Endian::kNone;
+  }
+  xenos::Endian index_endian =
+      (flags & SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad)
+          ? guest_index_endian
+          : primitive_processing_result.host_shader_index_endian;
+  dirty |= constants.vertex_index_endian != index_endian;
+  constants.vertex_index_endian = index_endian;
+
+  dirty |= constants.line_loop_closing_index != primitive_processing_result.line_loop_closing_index;
+  constants.line_loop_closing_index = primitive_processing_result.line_loop_closing_index;
+
+  // Vertex index offset.
+  dirty |= constants.vertex_base_index != vgt_indx_offset;
+  constants.vertex_base_index = vgt_indx_offset;
+
+  // Vertex index range.
+  dirty |= constants.vertex_index_min != vgt_min_vtx_indx;
+  dirty |= constants.vertex_index_max != vgt_max_vtx_indx;
+  constants.vertex_index_min = vgt_min_vtx_indx;
+  constants.vertex_index_max = vgt_max_vtx_indx;
+
+  return dirty;
+}
+
+bool VulkanCommandProcessor::SystemConstantsSkip::UpdateTexturePart(
+    SpirvShaderTranslator::SystemConstants& constants, const VulkanTextureCache& texture_cache,
+    uint32_t used_texture_mask, bool image_view_format_swizzle) {
+  bool dirty = false;
+
+  // Texture signedness / gamma.
+  uint32_t textures_resolution_scaled = 0;
+  {
+    uint32_t textures_remaining = used_texture_mask;
+    uint32_t texture_index;
+    while (bit_inline::bit_scan_forward(textures_remaining, &texture_index)) {
+      textures_remaining &= ~(UINT32_C(1) << texture_index);
+      uint32_t& texture_signs_uint = constants.texture_swizzled_signs[texture_index >> 2];
+      uint32_t texture_signs_shift = 8 * (texture_index & 3);
+      uint8_t texture_signs = texture_cache.GetActiveTextureSwizzledSigns(texture_index);
+      uint32_t texture_signs_shifted = uint32_t(texture_signs) << texture_signs_shift;
+      uint32_t texture_signs_mask = ((UINT32_C(1) << 8) - 1) << texture_signs_shift;
+      dirty |= (texture_signs_uint & texture_signs_mask) != texture_signs_shifted;
+      texture_signs_uint = (texture_signs_uint & ~texture_signs_mask) | texture_signs_shifted;
+      textures_resolution_scaled |=
+          uint32_t(texture_cache.IsActiveTextureResolutionScaled(texture_index)) << texture_index;
+    }
+  }
+  dirty |= constants.textures_resolution_scaled != textures_resolution_scaled;
+  constants.textures_resolution_scaled = textures_resolution_scaled;
+
+  // Texture host swizzle in the shader.
+  if (!image_view_format_swizzle) {
+    uint32_t textures_remaining = used_texture_mask;
+    uint32_t texture_index;
+    while (bit_inline::bit_scan_forward(textures_remaining, &texture_index)) {
+      textures_remaining &= ~(UINT32_C(1) << texture_index);
+      uint32_t& texture_swizzles_uint = constants.texture_swizzles[texture_index >> 1];
+      uint32_t texture_swizzle_shift = 12 * (texture_index & 1);
+      uint32_t texture_swizzle = texture_cache.GetActiveTextureHostSwizzle(texture_index);
+      uint32_t texture_swizzle_shifted = uint32_t(texture_swizzle) << texture_swizzle_shift;
+      uint32_t texture_swizzle_mask = ((UINT32_C(1) << 12) - 1) << texture_swizzle_shift;
+      dirty |= (texture_swizzles_uint & texture_swizzle_mask) != texture_swizzle_shifted;
+      texture_swizzles_uint =
+          (texture_swizzles_uint & ~texture_swizzle_mask) | texture_swizzle_shifted;
+    }
+  }
+
+  return dirty;
+}
+
+void VulkanCommandProcessor::SystemConstantsSkip::Verify(
+    const SpirvShaderTranslator::SystemConstants& before,
+    const SpirvShaderTranslator::SystemConstants& skipped,
+    const SpirvShaderTranslator::SystemConstants& recomputed, bool skipped_dirty,
+    bool recomputed_dirty, bool state_skipped, bool texture_skipped, uint32_t used_texture_mask,
+    uint64_t frame) {
+  ++verify_checks;
+  bool bytes_differ = std::memcmp(&skipped, &recomputed, sizeof(skipped)) != 0;
+  if (!bytes_differ && skipped_dirty == recomputed_dirty) {
+    return;
+  }
+  if (!bytes_differ && recomputed_dirty) {
+    // A NaN compared unequal to itself in the original - the same bytes uploaded again.
+    ++verify_dirty_only;
+    return;
+  }
+  ++verify_mismatches;
+  ++verify_mismatches_total;
+  if (verify_mismatches_logged >= kVerifyMismatchesLogged) {
+    return;
+  }
+  ++verify_mismatches_logged;
+  constexpr size_t kDwords = sizeof(skipped) / sizeof(uint32_t);
+  const uint32_t* before_dwords = reinterpret_cast<const uint32_t*>(&before);
+  const uint32_t* skipped_dwords = reinterpret_cast<const uint32_t*>(&skipped);
+  const uint32_t* recomputed_dwords = reinterpret_cast<const uint32_t*>(&recomputed);
+  uint32_t differing_dwords = 0;
+  std::string differences;
+  for (size_t i = 0; i < kDwords; ++i) {
+    if (skipped_dwords[i] == recomputed_dwords[i]) {
+      continue;
+    }
+    if (++differing_dwords > 6) {
+      continue;
+    }
+    size_t field_offset;
+    const char* field_name = SystemConstantsFieldName(i * sizeof(uint32_t), field_offset);
+    differences +=
+        fmt::format(" {}+{}: before {:08X} skipped {:08X} recomputed {:08X};", field_name,
+                    field_offset, before_dwords[i], skipped_dwords[i], recomputed_dwords[i]);
+  }
+  REXGPU_WARN(
+      "[s6][CP9] verify mismatch at frame {}: render state part {}, texture part {} (used fetch "
+      "constants {:08X}), {} dwords differ, dirty skipped {} recomputed {}:{}",
+      frame, state_skipped ? "skipped" : "recomputed", texture_skipped ? "skipped" : "recomputed",
+      used_texture_mask, differing_dwords, skipped_dirty, recomputed_dirty, differences);
+}
+
+// wwe2k14 patch (Session 6, CP9): with vulkan_system_constants_skip off, the original function. On,
+// it skips the state part and/or the texture part when their inputs are the same as when they were
+// last computed (see SystemConstantsSkip for why that leaves the same constants), and recomputes
+// the rest.
 void VulkanCommandProcessor::UpdateSystemConstantValues(
     bool primitive_polygonal,
     const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
     bool shader_32bit_index_dma, uint32_t compute_memexport_vertex_count,
     const draw_util::ViewportInfo& viewport_info, uint32_t used_texture_mask,
     reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask) {
+  if (!REXCVAR_GET(vulkan_system_constants_skip)) {
+    if (system_constants_skip_) {
+      // The constants are about to be computed without the stored inputs being updated.
+      system_constants_skip_->Invalidate();
+    }
+    UpdateSystemConstantValuesFull(primitive_polygonal, primitive_processing_result,
+                                   shader_32bit_index_dma, compute_memexport_vertex_count,
+                                   viewport_info, used_texture_mask, normalized_depth_control,
+                                   normalized_color_mask, true);
+    return;
+  }
+  if (!system_constants_skip_) {
+    system_constants_skip_ = std::make_unique<SystemConstantsSkip>();
+    system_constants_skip_->stats_frame = frame_current_;
+  }
+  SystemConstantsSkip& skip = *system_constants_skip_;
+  if (frame_current_ - skip.stats_frame >= SystemConstantsSkip::kStatsFrames) {
+    skip.LogStats(frame_current_);
+  }
+
+  const RegisterFile& regs = *register_file_;
+
+  // The state part's inputs (see UpdateSystemConstantValuesFull for where each is read).
+  using StateKey = SystemConstantsSkip::StateKey;
+  StateKey key;
+  StateKey::Base& key_base = key.base;
+  RenderTargetCache::Path render_target_path = render_target_cache_->GetPath();
+  uint32_t config = 0;
+  if (render_target_path == RenderTargetCache::Path::kPixelShaderInterlock) {
+    config |= SystemConstantsSkip::kConfigFsi;
+  }
+  if (render_target_path == RenderTargetCache::Path::kHostRenderTargets) {
+    config |= SystemConstantsSkip::kConfigHostRenderTargets;
+    if (render_target_cache_->IsFixedRG16TruncatedToMinus1To1()) {
+      config |= SystemConstantsSkip::kConfigRG16Truncated;
+    }
+    if (render_target_cache_->IsFixedRGBA16TruncatedToMinus1To1()) {
+      config |= SystemConstantsSkip::kConfigRGBA16Truncated;
+    }
+  }
+  if (render_target_cache_->gamma_render_target_as_unorm16()) {
+    config |= SystemConstantsSkip::kConfigGammaAsUnorm16;
+  }
+  if (primitive_polygonal) {
+    config |= SystemConstantsSkip::kConfigPrimitivePolygonal;
+  }
+  key_base.config = config;
+  key_base.draw_resolution_scale_x = texture_cache_->draw_resolution_scale_x();
+  key_base.draw_resolution_scale_y = texture_cache_->draw_resolution_scale_y();
+  key_base.pa_cl_clip_cntl = regs[XE_GPU_REG_PA_CL_CLIP_CNTL];
+  key_base.pa_cl_vte_cntl = regs[XE_GPU_REG_PA_CL_VTE_CNTL];
+  key_base.rb_colorcontrol = regs[XE_GPU_REG_RB_COLORCONTROL];
+  key_base.rb_alpha_ref = regs[XE_GPU_REG_RB_ALPHA_REF];
+  key_base.rb_surface_info = regs[XE_GPU_REG_RB_SURFACE_INFO];
+  key_base.rb_depth_info = regs[XE_GPU_REG_RB_DEPTH_INFO];
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    key_base.rb_color_info[i] = regs[reg::RB_COLOR_INFO::rt_register_indices[i]];
+  }
+  key_base.prim_type = uint32_t(regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type);
+  key_base.vgt_output_path_cntl = regs[XE_GPU_REG_VGT_OUTPUT_PATH_CNTL];
+  key_base.vgt_hos_max_tess_level = regs[XE_GPU_REG_VGT_HOS_MAX_TESS_LEVEL];
+  key_base.vgt_hos_min_tess_level = regs[XE_GPU_REG_VGT_HOS_MIN_TESS_LEVEL];
+  std::memcpy(key_base.ndc_scale, viewport_info.ndc_scale, sizeof(key_base.ndc_scale));
+  std::memcpy(key_base.ndc_offset, viewport_info.ndc_offset, sizeof(key_base.ndc_offset));
+  if (key.IsPointUsed()) {
+    key.point.pa_su_point_size = regs[XE_GPU_REG_PA_SU_POINT_SIZE];
+    key.point.pa_su_point_minmax = regs[XE_GPU_REG_PA_SU_POINT_MINMAX];
+    key.point.viewport_xy_extent[0] = viewport_info.xy_extent[0];
+    key.point.viewport_xy_extent[1] = viewport_info.xy_extent[1];
+  }
+  if (key.IsFsiUsed()) {
+    StateKey::Fsi& key_fsi = key.fsi;
+    key_fsi.normalized_depth_control = normalized_depth_control.value;
+    key_fsi.normalized_color_mask = normalized_color_mask;
+    key_fsi.pa_su_sc_mode_cntl = regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL];
+    key_fsi.rb_stencilrefmask = regs[XE_GPU_REG_RB_STENCILREFMASK];
+    key_fsi.rb_stencilrefmask_bf = regs[XE_GPU_REG_RB_STENCILREFMASK_BF];
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      key_fsi.rb_blendcontrol[i] = regs[reg::RB_BLENDCONTROL::rt_register_indices[i]];
+    }
+    key_fsi.pa_su_poly_offset[0] = regs[XE_GPU_REG_PA_SU_POLY_OFFSET_FRONT_SCALE];
+    key_fsi.pa_su_poly_offset[1] = regs[XE_GPU_REG_PA_SU_POLY_OFFSET_FRONT_OFFSET];
+    key_fsi.pa_su_poly_offset[2] = regs[XE_GPU_REG_PA_SU_POLY_OFFSET_BACK_SCALE];
+    key_fsi.pa_su_poly_offset[3] = regs[XE_GPU_REG_PA_SU_POLY_OFFSET_BACK_OFFSET];
+    key_fsi.rb_blend_rgba[0] = regs[XE_GPU_REG_RB_BLEND_RED];
+    key_fsi.rb_blend_rgba[1] = regs[XE_GPU_REG_RB_BLEND_GREEN];
+    key_fsi.rb_blend_rgba[2] = regs[XE_GPU_REG_RB_BLEND_BLUE];
+    key_fsi.rb_blend_rgba[3] = regs[XE_GPU_REG_RB_BLEND_ALPHA];
+  }
+  if (key.AreUserClipPlanesUsed()) {
+    std::memcpy(key.user_clip_planes, &regs[XE_GPU_REG_PA_CL_UCP_0_X],
+                sizeof(key.user_clip_planes));
+  }
+
+  bool state_skipped = skip.CheckAndStoreState(key) == SystemConstantsSkip::kStateSkipped;
+  bool texture_skipped = skip.CheckAndStoreTextures(
+      used_texture_mask, texture_cache_->active_texture_bindings_version());
+
+  const uint32_t system_constants_bit = UINT32_C(1) << SpirvShaderTranslator::kConstantBufferSystem;
+  if (!REXCVAR_GET(vulkan_system_constants_skip_verify)) {
+    if (!state_skipped) {
+      UpdateSystemConstantValuesFull(primitive_polygonal, primitive_processing_result,
+                                     shader_32bit_index_dma, compute_memexport_vertex_count,
+                                     viewport_info, used_texture_mask, normalized_depth_control,
+                                     normalized_color_mask, !texture_skipped);
+      return;
+    }
+    bool dirty = SystemConstantsSkip::UpdateIndexPart(
+        system_constants_, regs, primitive_processing_result, shader_32bit_index_dma,
+        compute_memexport_vertex_count);
+    if (!texture_skipped) {
+      dirty |= SystemConstantsSkip::UpdateTexturePart(
+          system_constants_, *texture_cache_, used_texture_mask,
+          GetVulkanDevice()->properties().imageViewFormatSwizzle);
+    }
+    if (dirty) {
+      current_constant_buffers_up_to_date_ &= ~system_constants_bit;
+    }
+    return;
+  }
+
+  // vulkan_system_constants_skip_verify: compute what skipping gives into `skipped`, then recompute
+  // everything with the original function into system_constants_ (which is kept - the same result
+  // as with the setting off), and compare. The original marks the buffer dirty itself, so for its
+  // dirty result the bit is set before and restored after.
+  auto update_full = [&](bool update_textures) {
+    uint32_t up_to_date = current_constant_buffers_up_to_date_;
+    current_constant_buffers_up_to_date_ |= system_constants_bit;
+    UpdateSystemConstantValuesFull(primitive_polygonal, primitive_processing_result,
+                                   shader_32bit_index_dma, compute_memexport_vertex_count,
+                                   viewport_info, used_texture_mask, normalized_depth_control,
+                                   normalized_color_mask, update_textures);
+    bool dirty = !(current_constant_buffers_up_to_date_ & system_constants_bit);
+    current_constant_buffers_up_to_date_ = up_to_date;
+    return dirty;
+  };
+  if (!state_skipped && !texture_skipped) {
+    // Nothing to check.
+    UpdateSystemConstantValuesFull(primitive_polygonal, primitive_processing_result,
+                                   shader_32bit_index_dma, compute_memexport_vertex_count,
+                                   viewport_info, used_texture_mask, normalized_depth_control,
+                                   normalized_color_mask, true);
+    return;
+  }
+  SpirvShaderTranslator::SystemConstants before, skipped;
+  std::memcpy(&before, &system_constants_, sizeof(before));
+  bool skipped_dirty;
+  if (state_skipped) {
+    std::memcpy(&skipped, &system_constants_, sizeof(skipped));
+    skipped_dirty = SystemConstantsSkip::UpdateIndexPart(skipped, regs, primitive_processing_result,
+                                                         shader_32bit_index_dma,
+                                                         compute_memexport_vertex_count);
+    if (!texture_skipped) {
+      skipped_dirty |= SystemConstantsSkip::UpdateTexturePart(
+          skipped, *texture_cache_, used_texture_mask,
+          GetVulkanDevice()->properties().imageViewFormatSwizzle);
+    }
+  } else {
+    skipped_dirty = update_full(false);
+    std::memcpy(&skipped, &system_constants_, sizeof(skipped));
+    std::memcpy(&system_constants_, &before, sizeof(system_constants_));
+  }
+  bool recomputed_dirty = update_full(true);
+  if (recomputed_dirty) {
+    current_constant_buffers_up_to_date_ &= ~system_constants_bit;
+  }
+  skip.Verify(before, skipped, system_constants_, skipped_dirty, recomputed_dirty, state_skipped,
+              texture_skipped, used_texture_mask, frame_current_);
+}
