+VulkanCommandProcessor::VertexResidencyCheck* VulkanCommandProcessor::VertexResidencyCheckBeginDraw() {
+  // wwe2k14 patch (Session 6, RESID).
+  if (!vertex_residency_check_) {
+    vertex_residency_check_ = std::make_unique<VertexResidencyCheck>();
+    vertex_residency_check_->frame = frame_current_;
+    vertex_residency_check_->window_first_frame = frame_current_;
+  }
+  VertexResidencyCheck& check = *vertex_residency_check_;
+  if (!check.active) {
+    // Turned on (again): report what was counted before it was turned off, and start a new window.
+    check.EndFrame();
+    if (check.requests || check.match_hits || check.sync_skips) {
+      check.Report(check.frame);
+    }
+    check.ResetWindow(frame_current_);
+    check.frame = frame_current_;
+    check.recorded[0] = 0;
+    check.recorded[1] = 0;
+    check.active = true;
+  }
+  if (check.frame != frame_current_) {
+    check.EndFrame();
+    check.frame = frame_current_;
+    if (frame_current_ - check.window_first_frame >= VertexResidencyCheck::kStatsFrames) {
+      check.Report(frame_current_ - 1);
+      check.ResetWindow(frame_current_);
+    }
+  }
+  return &check;
+}
