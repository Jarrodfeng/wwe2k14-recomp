+        stats.verify_skipped_draws, stats.verify_held_frames, stats.verify_early_submissions,
+        stats.verify_unwaited_swaps, no_submit_wait);
+    stats.verify_frames = 0;
+    stats.verify_binds_checked = 0;
+    stats.verify_mismatches = 0;
+    stats.verify_early_submissions = 0;
+    stats.verify_unwaited_swaps = 0;
+    stats.verify_skipped_draws = 0;
