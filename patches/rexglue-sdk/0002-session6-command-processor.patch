+// wwe2k14 patch (Session 6, CP3): gathers the float constants marked in a shader's usage bitmap
+// (Shader::ConstantRegisterMap::float_bitmap: 4 x 64 bits, bit n = constant n of the stage's 256)
+// from the register file into a constant buffer, in the same order and packing as the per-constant
+// loops in UpdateBindings (constant n is at constant_regs[n * 4], 16 bytes), but with one memcpy
+// per run of consecutive used constants within each 64-bit word. Returns the number of bytes
+// written.
+// Micro-benchmark (clang -O3, 5950X, ns per gather; old = the loop with a noinline bsf call per
+// constant, inline = the loop with bit_inline::bit_scan_forward, runs = this):
+//   c0-c31: old 51, inline 23, runs 8. c0-c199: old 255, inline 155, runs 29.
+//   20 isolated constants: old 32, inline 11, runs 15. 10 pairs: old 35, inline 12, runs 24.
+// So runs win for contiguous maps and lose to the inline loop for scattered ones; the verify
+// summary reports the game's run statistics.
+size_t GatherFloatConstantRuns(uint8_t* out, const uint32_t* constant_regs,
+                               const uint64_t* bitmap) {
+  uint8_t* const out_start = out;
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t bits = bitmap[i];
+    const uint32_t* word_regs = constant_regs + (i << 8);
+    while (bits) {
+      uint32_t run_first = uint32_t(std::countr_zero(bits));
+      const uint32_t* run_regs = word_regs + (run_first << 2);
+      if (!(bits & (UINT64_C(2) << run_first))) {
+        // A run of one constant: a fixed-size copy, and clearing the lowest set bit keeps the loop
+        // as short as the one-at-a-time loop. (For run_first == 63, 2 << 63 wraps to 0.)
+        std::memcpy(out, run_regs, sizeof(float) * 4);
+        out += sizeof(float) * 4;
+        bits &= bits - 1;
+        continue;
+      }
+      uint32_t run_count = uint32_t(std::countr_one(bits >> run_first));
+      size_t run_size = sizeof(float) * 4 * run_count;
+      std::memcpy(out, run_regs, run_size);
+      out += run_size;
+      // Clear the run: adding its lowest bit carries through the whole run (and wraps to 0 if the
+      // run reaches bit 63).
+      bits &= bits + (UINT64_C(1) << run_first);
+    }
+  }
+  return size_t(out - out_start);
+}
+
+// The pre-Session 6 gather (one rex::bit_scan_forward and one 16-byte memcpy per used constant),
+// kept verbatim as the reference for vulkan_float_constant_runs_verify.
+size_t GatherFloatConstantsReference(uint8_t* out, const uint32_t* constant_regs,
+                                     const uint64_t* bitmap) {
+  uint8_t* const out_start = out;
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t float_constant_map_entry = bitmap[i];
+    uint32_t float_constant_index;
+    while (rex::bit_scan_forward(float_constant_map_entry, &float_constant_index)) {
+      float_constant_map_entry &= ~(1ull << float_constant_index);
+      std::memcpy(out, constant_regs + (i << 8) + (float_constant_index << 2), sizeof(float) * 4);
+      out += sizeof(float) * 4;
+    }
+  }
+  return size_t(out - out_start);
+}
+
+// vulkan_float_constant_runs_verify statistics. Only touched by the command processor thread
+// (UpdateBindings). The constant and run counts (since the last summary) show how contiguous the
+// game's constant maps are, which decides whether the runs pay off (see GatherFloatConstantRuns).
+struct FloatConstantRunsVerifyStats {
+  uint64_t buffers_checked = 0;
+  uint64_t buffers_mismatched = 0;
+  uint64_t buffers_checked_at_summary = 0;
+  uint64_t buffers_mismatched_at_summary = 0;
+  uint64_t constants = 0;
+  uint64_t runs = 0;
+  uint64_t single_constant_runs = 0;
+  uint64_t summary_frame = UINT64_MAX;
+  uint32_t mismatches_logged = 0;
+};
+FloatConstantRunsVerifyStats float_constant_runs_verify_stats;
+
+// Compares the run gather with the reference gather for one constant buffer. The constant buffer
+// is upload memory (possibly write-combined) and is not read back: the run gather is deterministic
+// and the register file and the bitmap are only written by this thread, so gathering the runs again
+// into scratch memory reproduces exactly the bytes written to the buffer. Not inlined, to keep the
+// 8 KB of scratch out of UpdateBindings' stack frame.
+[[gnu::noinline]] void VerifyFloatConstantRuns(const uint32_t* constant_regs,
+                                               const uint64_t* bitmap, size_t written_size,
+                                               bool is_pixel, uint64_t frame) {
+  alignas(16) uint8_t runs[sizeof(float) * 4 * 256];
+  alignas(16) uint8_t reference[sizeof(float) * 4 * 256];
+  size_t runs_size = GatherFloatConstantRuns(runs, constant_regs, bitmap);
+  size_t reference_size = GatherFloatConstantsReference(reference, constant_regs, bitmap);
+  FloatConstantRunsVerifyStats& stats = float_constant_runs_verify_stats;
+  ++stats.buffers_checked;
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t run_starts = bitmap[i] & ~(bitmap[i] << 1);
+    stats.constants += uint64_t(std::popcount(bitmap[i]));
+    stats.runs += uint64_t(std::popcount(run_starts));
+    stats.single_constant_runs += uint64_t(std::popcount(run_starts & ~(bitmap[i] >> 1)));
+  }
+  bool sizes_match = runs_size == reference_size && written_size == reference_size;
+  if (!sizes_match || std::memcmp(runs, reference, reference_size)) {
+    ++stats.buffers_mismatched;
+    if (stats.mismatches_logged < 8) {
+      ++stats.mismatches_logged;
+      size_t first_difference = 0;
+      size_t common_size = std::min(runs_size, reference_size);
+      while (first_difference < common_size &&
+             runs[first_difference] == reference[first_difference]) {
+        ++first_difference;
+      }
+      REXGPU_WARN(
+          "[s6][CP3] float constant runs mismatch ({} shader, frame {}): written {} / runs {} / "
+          "reference {} bytes, first difference at byte {} (packed constant {}), bitmap "
+          "{:016X} {:016X} {:016X} {:016X}",
+          is_pixel ? "pixel" : "vertex", frame, written_size, runs_size, reference_size,
+          first_difference, first_difference / (sizeof(float) * 4), bitmap[0], bitmap[1],
+          bitmap[2], bitmap[3]);
+    }
+  }
+  if (stats.summary_frame == UINT64_MAX) {
+    stats.summary_frame = frame;
+  } else if (frame >= stats.summary_frame + 300) {
+    REXGPU_INFO(
+        "[s6][CP3] float constant runs verify, frame {}: {} buffers checked, {} mismatched; since "
+        "the last summary: {} buffers, {} mismatched, {} constants in {} runs ({} of one "
+        "constant)",
+        frame, stats.buffers_checked, stats.buffers_mismatched,
+        stats.buffers_checked - stats.buffers_checked_at_summary,
+        stats.buffers_mismatched - stats.buffers_mismatched_at_summary, stats.constants,
+        stats.runs, stats.single_constant_runs);
+    stats.summary_frame = frame;
+    stats.buffers_checked_at_summary = stats.buffers_checked;
+    stats.buffers_mismatched_at_summary = stats.buffers_mismatched;
+    stats.constants = 0;
+    stats.runs = 0;
+    stats.single_constant_runs = 0;
+  }
+}
