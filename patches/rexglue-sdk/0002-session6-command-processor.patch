+      key.fetch_constant = binding.fetch_constant;
+      key.generation = texture_cache.GetTextureBindingGeneration(binding.fetch_constant);
+      key.dimension = binding.dimension;
+      key.is_signed = binding.is_signed;
+    }
+  }
