+void VulkanCommandProcessor::TilingViewportFixStatsReport(const char* note) {
+  const TilingViewportFixStats& stats = tiling_viewport_fix_stats_;
+  if (!stats.draws) {
+    return;
+  }
+  std::string offsets;
+  for (uint32_t i = 0; i < stats.window_offset_count; ++i) {
+    const TilingViewportFixStats::WindowOffset& entry = stats.window_offsets[i];
+    reg::PA_SC_WINDOW_OFFSET window_offset;
+    window_offset.value = entry.window_offset;
+    fmt::format_to(std::back_inserter(offsets), "{}({}, {}){}: {} draws, {} differ", i ? "; " : "",
+                   int32_t(window_offset.window_x_offset), int32_t(window_offset.window_y_offset),
+                   entry.vtx_window_offset_enable ? "" : " not applied to vertices", entry.draws,
+                   entry.differ);
+  }
+  REXGPU_INFO(
+      "[s7][SEAMS] frames {}-{}{}: {} draws ({} of them with gpu_tiling_viewport_fix on), {} with clipping; "
+      "host viewport differs with the fix in {} draws with a window offset and {} without (plus {} that "
+      "only move an empty viewport, rendered the same); smallest origin with the fix ({}, {}); window "
+      "offsets: {}{}",
+      stats.window_first_frame, stats.last_frame, note, stats.draws, stats.draws_fix_on,
+      stats.draws_clip_enabled, stats.differ_window_offset, stats.differ_no_window_offset,
+      stats.differ_empty_only, stats.min_origin_with_fix[0], stats.min_origin_with_fix[1], offsets,
+      stats.window_offsets_dropped
+          ? fmt::format("; {} draws with further values not listed", stats.window_offsets_dropped)
+          : std::string());
+}
