+        "watch ({} in total), {} unwatch ({} in total); {} failed joined Protect calls (redone one "
+        "original run at a time) in total",
+        first_frame, last_frame, stats.verify_checks, stats.verify_mismatches, verify_mismatches_total,
+        stats.verify_gap_changed[0], verify_gap_changed_total[0], stats.verify_gap_changed[1],
+        verify_gap_changed_total[1], fallbacks_total);
+  }
