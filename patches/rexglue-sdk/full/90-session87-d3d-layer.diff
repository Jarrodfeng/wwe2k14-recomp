+      rb_copy_control.copy_command != xenos::CopyCommand::kConvert) {
+    REXGPU_ERROR("[d3d] resolve record with copy command {} (not raw / convert)", uint32_t(rb_copy_control.copy_command));
+    return false;
+  }
