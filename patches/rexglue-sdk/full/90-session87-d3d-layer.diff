+  region.srcSubresource = region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.extent = {w, h, 1};
+  cb.CmdVkCopyImage(s.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, d.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+  if (with_depth) {
+    region.srcSubresource = region.dstSubresource = {VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, 0, 0, 1};
+    cb.CmdVkCopyImage(s.depth, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, d.depth, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
