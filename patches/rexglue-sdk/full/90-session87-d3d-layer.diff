+  uint64_t parts[3] = {vertex_shader.ucode_data_hash(), 0, 0};
+  interp_memo_vs_ = parts[0];
+  const bool ok = InterpInputHashes(vertex_shader, true, parts[1], parts[2]);
+  key = ok ? (XXH3_64bits(parts, sizeof(parts)) | 1) : 0;
+  interp_memo_stats_.key_ns += uint64_t(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+  return ok;
+}
+
+void VulkanCommandProcessor::InterpMemoLog() {
+  InterpMemoStats& st = interp_memo_stats_;
+  if (st.first_frame == UINT64_MAX) {
+    st.first_frame = frame_current_;
+    return;
+  }
+  const uint64_t frames = frame_current_ - st.first_frame;
+  if (frames < 300) return;
+  uint64_t any = st.bounds_calls;
+  for (uint32_t u = 0; u < 4; ++u) any += st.calls[u] + st.no_key[u];
+  if (any) {
+    const double f = double(frames);
+    REXGPU_INFO(
+        "[s87][interp] frames {}-{} (memo {}, verify {}), per frame: cover {:.1f} runs (memo hits {:.1f}, misses {:.1f}, "
+        "no key {:.1f}), clear depth {:.1f} ({:.1f} / {:.1f} / {:.1f}), fast clear {:.1f} ({:.1f} / {:.1f} / {:.1f}); "
+        "key {:.3f} ms, interpreter on misses {:.3f} ms; verify mismatches {}, over-long runs {}; bounds {:.1f} lookups "
+        "({:.1f} found with the key in use; verify: all-constants key {:.1f}, shader-reads key {:.1f}; mismatches {}; "
+        "key {:.3f} ms)",
+        st.first_frame, frame_current_, REXCVAR_GET(gpu_interp_memo), REXCVAR_GET(gpu_interp_memo_verify),
+        st.calls[0] / f, st.hits[0] / f, st.misses[0] / f, st.no_key[0] / f, st.calls[1] / f, st.hits[1] / f,
+        st.misses[1] / f, st.no_key[1] / f, st.calls[2] / f, st.hits[2] / f, st.misses[2] / f, st.no_key[2] / f,
+        double(st.key_ns) / 1.0e6 / f, double(st.run_ns) / 1.0e6 / f, st.mismatches, st.overflow,
+        st.bounds_calls / f, st.bounds_hits / f, st.bounds_full_hits / f, st.bounds_used_hits / f,
+        st.bounds_mismatches, double(st.bounds_key_ns) / 1.0e6 / f);
+    std::string shaders;
+    for (uint32_t i = 0; i < st.by_vs_count; ++i) {
+      if (st.by_vs[i].misses * 20 < st.calls[0] + st.calls[1] + st.calls[2]) continue;  // under 5% of the runs
+      shaders += fmt::format("{}{:016X} {:.1f} runs, {:.1f} misses", shaders.empty() ? "" : "; ", st.by_vs[i].hash,
+                             st.by_vs[i].calls / f, st.by_vs[i].misses / f);
+    }
+    if (!shaders.empty()) REXGPU_INFO("[s87][interp] per frame, by vertex shader (the ones with the most misses): {}", shaders);
+  }
+  const uint64_t mismatches = st.mismatches, bounds_mismatches = st.bounds_mismatches;
+  st = InterpMemoStats();
+  st.first_frame = frame_current_;
+  st.mismatches = mismatches;  // (kept across windows)
+  st.bounds_mismatches = bounds_mismatches;
+}
+
+// One run of the interpreter for vertex_index (r0 and the other temporaries set by the caller to the same values for
+// the same index): from the memo when inputs_key (InterpMemoKey) has this index's exports, else run and kept. user:
+// 0 NativeCoverRect, 1 NativeClearDepth, 2 FastClearDetect.
+void VulkanCommandProcessor::InterpRun(ShaderInterpreter& interpreter, uint64_t inputs_key, uint32_t vertex_index,
+                                       uint32_t user) {
+  InterpMemoStats& st = interp_memo_stats_;
+  ShaderInterpreter::ExportSink* const real = interpreter.GetExportSink();
+  InterpMemoLog();
+  if (!inputs_key || !real) {
+    ++st.no_key[user];
+    interpreter.Execute();
+    return;
+  }
+  ++st.calls[user];
+  InterpMemoStats::VsCount* by_vs = nullptr;  // the per-shader census
+  for (uint32_t i = 0; i < st.by_vs_count; ++i) {
+    if (st.by_vs[i].hash == interp_memo_vs_) by_vs = &st.by_vs[i];
+  }
+  if (!by_vs && st.by_vs_count < 12) {
+    by_vs = &st.by_vs[st.by_vs_count++];
+    by_vs->hash = interp_memo_vs_;
+  }
+  if (by_vs) ++by_vs->calls;
+  const uint64_t two[2] = {inputs_key, vertex_index};
+  const uint64_t key = XXH3_64bits(two, sizeof(two)) | 1;
+  InterpMemoEntry& entry = interp_memo_[(key >> 7) & (interp_memo_.size() - 1)];
+  struct Recorder : ShaderInterpreter::ExportSink {
+    ShaderInterpreter::ExportSink* forward = nullptr;
+    InterpExport events[kInterpMemoMaxExports];
+    uint32_t count = 0;
+    bool overflow = false;
+    void AllocExport(ucode::AllocType type, uint32_t size) override {
+      if (forward) forward->AllocExport(type, size);
+    }
+    void Export(ucode::ExportRegister export_register, const float* value, uint32_t value_mask) override {
+      if (count < kInterpMemoMaxExports) {
+        InterpExport& e = events[count++];
+        e.export_register = uint32_t(export_register);
+        e.mask = value_mask;
+        for (uint32_t i = 0; i < 4; ++i) e.value[i] = (value_mask & (1u << i)) ? value[i] : 0.0f;
+      } else {
+        overflow = true;
+      }
+      if (forward) forward->Export(export_register, value, value_mask);
+    }
+  };
+  if (entry.key == key && entry.count != UINT32_MAX) {
+    ++st.hits[user];
+    if (!REXCVAR_GET(gpu_interp_memo_verify)) {
+      for (uint32_t i = 0; i < entry.count; ++i) {
+        const InterpExport& e = entry.exports[i];
+        real->Export(ucode::ExportRegister(e.export_register), e.value, e.mask);
+      }
+      return;
+    }
+    // Verify: the interpreter runs as well, its exports are the ones used, compared with the memo's.
+    Recorder rec;
+    interpreter.SetExportSink(&rec);
+    interpreter.Execute();
+    interpreter.SetExportSink(real);
+    bool same = !rec.overflow && rec.count == entry.count;
+    for (uint32_t i = 0; same && i < rec.count; ++i) {
+      same = rec.events[i].export_register == entry.exports[i].export_register &&
+             rec.events[i].mask == entry.exports[i].mask &&
+             std::memcmp(rec.events[i].value, entry.exports[i].value, sizeof(float) * 4) == 0;
+    }
+    if (!same) {
+      ++st.mismatches;
+      static uint32_t logged = 0;
+      if (logged < 8) {
+        ++logged;
+        REXGPU_WARN("[s87][interp] memo mismatch (frame {}, user {}, vs {:016X}, vertex {}): memo {} exports, fresh {}",
+                    frame_current_, user, uint64_t(inputs_key), vertex_index, entry.count, rec.count);
+      }
+    }
+    for (uint32_t i = 0; i < rec.count; ++i) {
+      real->Export(ucode::ExportRegister(rec.events[i].export_register), rec.events[i].value, rec.events[i].mask);
+    }
+    return;
+  }
+  ++st.misses[user];
+  if (by_vs) ++by_vs->misses;
+  Recorder rec;
+  rec.forward = real;
+  const auto t0 = std::chrono::steady_clock::now();
+  interpreter.SetExportSink(&rec);
+  interpreter.Execute();
+  interpreter.SetExportSink(real);
+  st.run_ns += uint64_t(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+  entry.key = key;
+  if (rec.overflow) {
+    ++st.overflow;
+    entry.count = UINT32_MAX;
+  } else {
+    entry.count = rec.count;
+    std::copy(rec.events, rec.events + rec.count, entry.exports);
+  }
+}
