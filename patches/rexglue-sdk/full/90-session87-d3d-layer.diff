diff --git a/include/rex/graphics/d3d_copy.h b/include/rex/graphics/d3d_copy.h
new file mode 100644
index 0000000000000000000000000000000000000000..7cca783454240733eabe435d49c3ac484e309d0e
--- /dev/null
+++ b/include/rex/graphics/d3d_copy.h
@@ -0,0 +1,101 @@
+// wwe2k14 patch (Session 87, D3D layer family F2): the private copy-family packet. The game's D3D device hooks (clear,
+// resolve, GPR split, tiling) write ONE small type-3 packet into the ring that carries a record built from the device
+// object's own state; the command processor hands it to the backend, which executes it into the owned frame's clear /
+// copy entry points. No register decode, no PM4 of the library's own writers.
+//
+// Shared by the SDK and the game exe (plain constants and field indexes only; no SDK types).
+//
+// Packet: type-3, opcode kD3dCopyOpcode (0x7D; F1's token is 0x7C), payload (count dwords after the header):
+//   [0] kD3dCopyMagic   [1] sequence (counts up, checked: a gap is logged loudly)   [2] kind   [3] sem_dwords
+//   [4 ...] the semantic block (kind-specific, dword indexes below)
+// All payload words are big-endian in guest memory like every ring word (the reader byte-swaps); floats travel as their
+// IEEE bit patterns.
+#pragma once
+
+#include <cstdint>
+
+namespace rex::memory {
+class RingBuffer;
+}
+
+namespace rex::graphics {
+
+inline constexpr uint32_t kD3dCopyOpcode = 0x7D;
+inline constexpr uint32_t kD3dCopyMagic = 0xD3D20001u;
+inline constexpr uint32_t kD3dCopyHeaderDwords = 4;
+inline constexpr uint32_t kD3dCopyMaxSemDwords = 64;
+
+// The layout version the capability cvar gpu_d3d_copy_abi reports (an int). The game exe keeps its own copy of this
+// layout (src\d3d_copy_layout.h) and takes the records only when the cvar equals the number it was written for - the
+// exe never includes this header, so a changed layout never forces a re-pin.
+inline constexpr int32_t kD3dCopyAbi = 3;
+
+enum D3dCopyKind : uint32_t {
+  kD3dCopyClear = 1,
+  kD3dCopyGprSplit = 2,  // census only: the 360's shader register split, dropped
+  kD3dCopyResolve = 3,
+  kD3dCopyKindCount
+};
+
+// Clear semantic block (kD3dCopyClear). One pass = one colour target (or depth only) and its final rectangle, clipped
+// exactly as the library's clear clips it (the surface or tile size, the viewport, the scissor when enabled).
+namespace d3d_clear_sem {
+inline constexpr uint32_t kFlags = 0;       // the call's flags: bits 0-3 colour targets, 0x10 depth, 0x20 stencil
+inline constexpr uint32_t kColor = 1;       // 4 floats r, g, b, a (words 1-4)
+inline constexpr uint32_t kDepth = 5;       // float
+inline constexpr uint32_t kStencil = 6;
+inline constexpr uint32_t kSurfaceInfo = 7;  // device+10368: RB_SURFACE_INFO shadow (pitch in pixels bits 0-13, MSAA 16-17)
+inline constexpr uint32_t kDepthInfo = 8;    // device+10376: RB_DEPTH_INFO shadow (0 when no depth surface)
+inline constexpr uint32_t kColorInfo = 9;    // the pass colour target's RB_COLOR_INFO (surface+28, format fixed as the clear does); 0: none
+inline constexpr uint32_t kRect = 10;        // x0 y0 x1 y1 in guest pixels (words 10-13)
+inline constexpr uint32_t kPassRt = 14;      // 0-3 the colour target, 0xFFFFFFFF depth only
+inline constexpr uint32_t kVtxCntl = 15;     // device+10688: PA_SU_VTX_CNTL (the half-pixel offset of the clear's vertices)
+// Appended (the framing is by count, so an older executor ignores them): the colour state a DEPTH-ONLY clear inherits - the library's
+// depth-only branch writes no RB_COLOR_MASK / RB_BLENDCONTROL0 / RB_COLORCONTROL, the draw runs with what the last flush left,
+// which is the device's shadow of them (device+10460 / +10552 / +10556).
+inline constexpr uint32_t kColorMask = 16;
+inline constexpr uint32_t kBlendControl = 17;
+inline constexpr uint32_t kColorControl = 18;
+inline constexpr uint32_t kDwords = 16;           // the required part; kDwordsFull with the inherited colour state
+inline constexpr uint32_t kDwordsFull = 19;
+}  // namespace d3d_clear_sem
+
+// Resolve semantic block (kD3dCopyResolve): the values the library's resolve (0x82CAEA30) leaves in its device object
+// as register images, computed by the game's record builder from the call's arguments and the destination texture
+// header, plus the surface words of the device and the rectangle (already clipped / aligned as the library does).
+namespace d3d_resolve_sem {
+inline constexpr uint32_t kFlags = 0;       // the call's flags (sample bits added as the library adds them)
+inline constexpr uint32_t kCopyControl = 1;  // RB_COPY_CONTROL image
+inline constexpr uint32_t kDestBase = 2;     // RB_COPY_DEST_BASE
+inline constexpr uint32_t kDestPitch = 3;    // RB_COPY_DEST_PITCH
+inline constexpr uint32_t kDestInfo = 4;     // RB_COPY_DEST_INFO
+inline constexpr uint32_t kDepthClear = 5;   // RB_DEPTH_CLEAR
+inline constexpr uint32_t kColorClear = 6;   // RB_COLOR_CLEAR
+inline constexpr uint32_t kColorClearLo = 7;  // RB_COLOR_CLEAR_LO
+inline constexpr uint32_t kSurfaceInfo = 8;  // device+10368
+inline constexpr uint32_t kColorInfo = 9;    // RB_COLOR_INFO of the copied target (device+10372 / 10376 + 4n)
+inline constexpr uint32_t kDepthInfo = 10;   // device+10376
+inline constexpr uint32_t kRect = 11;        // x0 y0 x1 y1 (words 11-14)
+inline constexpr uint32_t kVtxCntl = 15;     // device+10688: PA_SU_VTX_CNTL
+inline constexpr uint32_t kDwords = 16;
+}  // namespace d3d_resolve_sem
+
+// Hook-side counters the backend prints in its census (reasons the game side did not take a call are the game's own).
+struct D3dCopyCensus {
+  uint64_t packets = 0, clears = 0, clears_held = 0, clears_lost = 0, gpr_splits = 0, bad = 0;
+  uint64_t clears_stock = 0, clears_stock_hold_off = 0, clears_stock_refused = 0;
+  uint64_t resolves = 0, resolves_owned = 0, resolves_empty = 0, resolves_stock_clear = 0, resolves_stock_refused = 0,
+           resolves_stock_other = 0;
+  uint64_t resolves_issued = 0, resolves_det_skipped = 0;  // (Session 87 review: every resolve is IssueCopy's now)
+};
+
+class CommandProcessor;
+
+// The backend registers its executor once (a static initialiser in its own file); the base command processor's
+// type-3 dispatch calls D3dCopyPacket for opcode kD3dCopyOpcode (src/graphics/d3d_copy.cpp): it reads and checks the
+// payload (magic, sequence) and hands it to the registered handler. Only the command thread calls either.
+using D3dCopyHandler = bool (*)(CommandProcessor& cp, uint32_t kind, const uint32_t* sem, uint32_t sem_count);
+void D3dCopySetHandler(D3dCopyHandler handler);
+bool D3dCopyPacket(CommandProcessor& cp, rex::memory::RingBuffer* reader, uint32_t count);
+
+}  // namespace rex::graphics
diff --git a/include/rex/graphics/d3d_direct.h b/include/rex/graphics/d3d_direct.h
new file mode 100644
index 0000000000000000000000000000000000000000..eed8e0cf841280343d35c3b022d5ac17a5de35c4
--- /dev/null
+++ b/include/rex/graphics/d3d_direct.h
@@ -0,0 +1,42 @@
+// wwe2k14 patch (Session 87, D3D layer family F4): the token's draw item taken straight into the native renderer.
+//
+// The D3D layer's token (CommandProcessor::ExecutePacketType3_D3D_TOKEN) already carries the game's own knowledge of what
+// changed (register runs and shader loads, applied to the register file as before) and, per draw chunk, one DRAW item.
+// With --gpu_d3d_direct on, the DRAW item is not handed to the stock draw packet path (ExecutePacketType3_DRAW_INDX ->
+// ExecutePacketType3Draw -> IssueDrawLean / IssueDraw, whose first act is to infer from the register writes what the
+// record already said) but to the backend's handler registered here: it takes the library-draw knowledge from the record
+// (a token IS a library indexed draw: no Half 2 attribution needed), classifies the dirty state as the writes noted it,
+// and draws through a lean-draw variant with caches keyed by what the record says changed (vertex ranges stamped against
+// the shared memory's page-validity epoch). A draw it cannot take goes the stock way, counted per reason.
+//
+// Declarations only: the base command processor never names a backend type (the pattern of d3d_copy.h).
+#pragma once
+
+#include <cstdint>
+
+namespace rex::memory {
+class RingBuffer;
+}
+
+namespace rex::graphics {
+
+class CommandProcessor;
+
+// The handler consumes the DRAW item's four payload words (viz query word, VGT_DRAW_INITIATOR, DMA base, DMA size) and
+// returns true, or leaves the reader exactly where it was and returns false (the stock path then runs).
+using D3dDirectDrawHandler = bool (*)(CommandProcessor& cp, rex::memory::RingBuffer* reader);
+
+inline D3dDirectDrawHandler& D3dDirectDrawHandlerSlot() {
+  static D3dDirectDrawHandler handler = nullptr;
+  return handler;
+}
+inline void D3dDirectSetDrawHandler(D3dDirectDrawHandler handler) { D3dDirectDrawHandlerSlot() = handler; }
+
+// Called by the token handler for each DRAW item on the drawing side. False: not consumed (switch off, no backend handler,
+// or a draw the direct path leaves to the stock path).
+inline bool D3dDirectDrawItem(CommandProcessor& cp, rex::memory::RingBuffer* reader) {
+  const D3dDirectDrawHandler handler = D3dDirectDrawHandlerSlot();
+  return handler != nullptr && handler(cp, reader);
+}
+
+}  // namespace rex::graphics
diff --git a/include/rex/graphics/d3d_feed.h b/include/rex/graphics/d3d_feed.h
new file mode 100644
index 0000000000000000000000000000000000000000..e5ceddefb21d4745b440bb2c0e39fa5ce9e5de03
--- /dev/null
+++ b/include/rex/graphics/d3d_feed.h
@@ -0,0 +1,106 @@
+// wwe2k14 patch (Session 87, D3D layer stage 3: our renderer fed in its own terms; docs\native\d3d\S3_CONTRACT.md in the
+// game repository): the call points between the base command processor and the backend's record-fed state.
+//
+// With --gpu_d3d_own_input (needs --gpu_d3d_direct) the token's register runs are not written into the emulated register
+// file one register at a time (WriteRegister: per-register side effects, the register-diff of RepeatNoteRegisters). The
+// backend keeps the record's register image (native/d3d_feed.cpp): a run is stored into it in one copy and the block-level
+// notifications the writes would have made (dirty classes, constant buffers out of date, fetch constants written) are made
+// from the record's blocks. The taken draw's derivations (constants upload, system constants, primitive processing, the
+// texture / sampler / pipeline-key fetch-constant reads) read the image; the register file is NOT written for it.
+//
+// The register file then lags the image. It is brought up to date (the dirty ranges copied once, no notifications) only
+// when something that is not a taken draw is about to read or write it: any packet other than the token (the generic
+// check in CommandProcessor::ExecutePacket), a draw the fed path hands back, a run it does not model. After a packet that
+// is not the token the image is stale and is re-copied from the register file (the ranges the derivations read) before
+// the next run is applied.
+//
+// Declarations only: the base command processor never names a backend type (the pattern of d3d_direct.h).
+#pragma once
+
+#include <cstdint>
+
+namespace rex::memory {
+class RingBuffer;
+}
+
+namespace rex::graphics {
+
+class CommandProcessor;
+
+struct D3dFeedHandlers {
+  // A RUN item of the token: `n` values for registers first .. first + n - 1 follow in the reader. True = taken (the
+  // values consumed, the register file not written); false = the reader is where it was and the stock type-0 path runs
+  // (the handler has already brought the register file up to date and ended the image's validity).
+  bool (*run)(CommandProcessor& cp, rex::memory::RingBuffer* reader, uint32_t first, uint32_t n) = nullptr;
+  // Copies the image's pending ranges into the register file.
+  void (*flush)(CommandProcessor& cp) = nullptr;
+  // A packet other than the token (or a nop / indirect buffer) is about to run: flush, then the image is stale.
+  void (*foreign)(CommandProcessor& cp) = nullptr;
+  // gpu_d3d_own_crowd: inside a record-fed draw a register write (the crowd code writes c76-c78 for each member it replays) goes
+  // into the image as a run would (notified, pending for the register file), not into the register file. False = not taken
+  // (not a register the image models): the caller writes the register file as it did.
+  bool (*scoped_write)(CommandProcessor& cp, uint32_t index, uint32_t value) = nullptr;
+  // The image's registers for code that stores whole groups (AppendCrowdInstances), and the pending mark for what it stored.
+  // gpu_d3d_own_copy: the copy-family token (clear / resolve), the inline draw token and the ring's type-0 register packets run
+  // on the image. scope_wanted: the mode is on (the foreign check then leaves those packets alone). scope_begin opens the
+  // image scope for an executor (image valid, the derivations' register sources pointed at it; false = not opened, the stock
+  // way), scope_end closes it.
+  bool (*scope_wanted)(CommandProcessor& cp) = nullptr;
+  bool (*scope_begin)(CommandProcessor& cp) = nullptr;
+  void (*scope_end)(CommandProcessor& cp) = nullptr;
+  uint32_t* (*image_values)() = nullptr;
+  void (*image_dirty)(uint32_t first, uint32_t count) = nullptr;
+};
+
+inline D3dFeedHandlers& D3dFeedHandlerSlots() {
+  static D3dFeedHandlers handlers;
+  return handlers;
+}
+
+// bit 0: the register file lags the image (flush needed); bit 1: the image is valid (in step with the register file plus
+// its pending ranges). Zero = nothing to do for a foreign packet. Command processor thread only.
+inline constexpr uint32_t kD3dFeedPending = 1;
+inline constexpr uint32_t kD3dFeedValid = 2;
+inline uint32_t& D3dFeedState() {
+  static uint32_t state = 0;
+  return state;
+}
+
+// The register source of the record-fed draw in progress (the record's image), else null. See VulkanCommandProcessor::DrawRegs.
+class RegisterFile;
+inline const RegisterFile*& D3dFeedDrawRegs() {
+  static const RegisterFile* image = nullptr;
+  return image;
+}
+
+// The packet the foreign check last saw (type << 8 | opcode), for the flush census (which packets make the register file catch up).
+inline uint32_t& D3dFeedLastPacket() {
+  static uint32_t key = 0;
+  return key;
+}
+
+inline bool D3dFeedScopeWanted(CommandProcessor& cp) {
+  const auto h = D3dFeedHandlerSlots().scope_wanted;
+  return h != nullptr && h(cp);
+}
+inline bool D3dFeedScopeBegin(CommandProcessor& cp) {
+  const auto h = D3dFeedHandlerSlots().scope_begin;
+  return h != nullptr && h(cp);
+}
+inline void D3dFeedScopeEnd(CommandProcessor& cp) {
+  const auto h = D3dFeedHandlerSlots().scope_end;
+  if (h != nullptr) h(cp);
+}
+
+inline bool D3dFeedRun(CommandProcessor& cp, rex::memory::RingBuffer* reader, uint32_t first, uint32_t n) {
+  const auto handler = D3dFeedHandlerSlots().run;
+  return handler != nullptr && handler(cp, reader, first, n);
+}
+inline void D3dFeedFlush(CommandProcessor& cp) {
+  if (D3dFeedState() & kD3dFeedPending) D3dFeedHandlerSlots().flush(cp);
+}
+inline void D3dFeedForeign(CommandProcessor& cp) {
+  if (D3dFeedState()) D3dFeedHandlerSlots().foreign(cp);
+}
+
+}  // namespace rex::graphics
diff --git a/include/rex/graphics/d3d_inline_draw.h b/include/rex/graphics/d3d_inline_draw.h
new file mode 100644
index 0000000000000000000000000000000000000000..b73949f1ea82284e4bbc68c27f5866ef32faca36
--- /dev/null
+++ b/include/rex/graphics/d3d_inline_draw.h
@@ -0,0 +1,73 @@
+// wwe2k14 patch (Session 87, D3D LAYER F3): the inline-vertex draw record of the game's D3D layer.
+//
+// The game's D3D library draws immediate vertices (the HUD / 2D sprites, the titantron's YUV sprite, particles, every
+// post-effect quad) through one pair, BeginVertices 0x82CB1520 / EndVertices 0x82CB1510. With the layer on, the game side
+// (src\d3d_layer_inline.h) builds one InlineDrawRecord per call from the device object's shadows (the five dirty masks'
+// blocks, slot 31's shadow words, the call's arguments) plus the vertex bytes the game wrote, hands it to the command
+// processor inline in a private token packet (opcode kInlineTokenOpcode) into the
+// ring so the record keeps its place in the stream. The command thread's token handler looks the record up by sequence and
+// executes it (CommandProcessor::ExecuteD3dInlineDraw): the register values are stored, the shaders set, the vertex bytes
+// put into guest-addressable memory of ours, and the draw issued as an auto-indexed draw - no PM4 for any of it.
+//
+// A record is NOT consumed by its first execution: the library's tiling mode replays a recorded segment once per strip, and
+// a token executes again with it (the record is IN the token, in the guest command memory; the sequence only counts
+// the repeats). Data members only in this header's own types; CommandProcessor gets three non-virtual
+// member declarations (layout unchanged).
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace rex::graphics::d3d {
+
+inline constexpr uint32_t kInlineTokenOpcode = 0x7E;           // used by no packet of the SDK's tables nor by the library (F2: 0x7D, F1: 0x7C)
+inline constexpr uint32_t kInlineTokenMagic = 0xD3D30001u;     // token payload: magic, sequence, then the record (layout below)
+
+// A run of consecutive registers (host values, in register order) the flush would have written.
+struct RegisterRun {
+  uint32_t first_register = 0;
+  uint32_t count = 0;
+  uint32_t value_offset = 0;  // into InlineDrawRecord::values
+};
+
+// A shader the flush would have loaded: microcode in guest memory (guest_address != 0, the words are read from there when
+// the record executes) or carried (inline_words, guest byte order as the memory holds them: the patched vertex-shader copy
+// the library builds lives only in its command stream, so a layer that reads shadows carries it).
+struct ShaderBind {
+  uint32_t guest_address = 0;
+  uint32_t dword_count = 0;
+  std::vector<uint32_t> inline_words;
+  bool present() const { return dword_count != 0; }
+};
+
+enum InlineFlags : uint32_t {
+  kInlineTiled = 1u << 0,       // device+11068 bit 0 (the library's extents mode): the original wraps the draw in the deferred recording
+  kInlineHasPixelShader = 1u << 1,
+  kInlineHasVertexShader = 1u << 2,
+  kInlineUseGuestVertexMemory = 1u << 3,  // read the vertices at guest_vertex_address instead of staging the carried bytes
+};
+
+struct InlineDrawRecord {
+  uint32_t sequence = 0;
+  uint32_t flags = 0;
+  // The call: BeginVertices(device, primitive, vertex_count, stride_bytes).
+  uint32_t primitive_type = 0;  // Xenos numbering (13 quad list, 6 strip, 4 list)
+  uint32_t vertex_count = 0;
+  uint32_t stride_bytes = 0;
+  uint32_t viz_query_word = 0;  // the library's first draw word (viz query id / use), passed through
+  // The state the flush would have written: register runs (the main state blocks, the float constant groups, bool / loop,
+  // the fetch slots other than slot 31's override, the misc blocks), then the shaders.
+  std::vector<RegisterRun> runs;
+  std::vector<uint32_t> values;
+  ShaderBind vertex_shader;
+  ShaderBind pixel_shader;
+  // Stream 0 = fetch slot 31 for this draw only: shadow words 0-3 (registers 0x48BA-0x48BD) as the library writes them;
+  // words 4-5 (0x48BE-0x48BF) are formed at execution from where the vertex bytes are.
+  uint32_t slot31_words[4] = {};
+  // The vertex bytes the game wrote (count * stride, guest byte order). guest_vertex_address: where the library's own
+  // allocation holds them (kInlineUseGuestVertexMemory).
+  std::vector<uint8_t> vertices;
+  uint32_t guest_vertex_address = 0;
+};
+
+}  // namespace rex::graphics::d3d
diff --git a/include/rex/graphics/d3d_noring.h b/include/rex/graphics/d3d_noring.h
new file mode 100644
index 0000000000000000000000000000000000000000..4c1760b98bd9b3f4237c52f4ac93c74bd134521e
--- /dev/null
+++ b/include/rex/graphics/d3d_noring.h
@@ -0,0 +1,104 @@
+// wwe2k14 patch (Session 87, D3D layer STAGE 2 "no ring"): the typed host queue between the game's D3D layer hooks (the
+// producer: render thread, any guest thread) and the command processor thread (the consumer). Docs in the game repository:
+// docs\native\d3d\F_direct_and_noring.md sections 2.3-2.9, docs\native\d3d\F4_S2_CONTRACTS.md, docs\native\d3d\STAGE2_NORING.md.
+//
+// What it replaces: the ring. With the layer's no-ring mode on, the library's ring submit (0x82CB5EF0) writes nothing to the
+// ring and no WPTR; the segments (and the typed sync items) reach the command thread through this queue instead, strictly in
+// program order. The consumer (src\graphics\d3d_noring.cpp, CommandProcessor::D3dNoringDrain) is called from the SDK
+// command loop in front of the ring branch; with the cvar gpu_d3d_noring at 0 (default) the loop never looks at the queue.
+//
+// Shared by the SDK and the game exe as plain data: the exe keeps its OWN copy of this layout (src\d3d_noring.h), the SDK
+// never links to the exe and the exe calls no SDK function - the exe allocates a D3dNoringShared, fills it and hands its
+// address over in the cvar gpu_d3d_noring_shared (a uint64); the consumer reads it from there. The two are tied by the
+// int capability cvar gpu_d3d_noring_abi (= kD3dNoringAbi below): change a field or an item layout here -> bump it here AND
+// in the exe's copy.
+//
+// Entry in the storage ring (dwords, host byte order; an entry never wraps - a kNrPad entry fills the rest of the storage):
+//   [0] kind | (total dwords of the entry << 8)   [1-6] the item's six fields   [7 ...] payload (total - 7 dwords)
+// Items (field indexes below). All guest addresses are the GPU-form values the library itself would have put into the
+// packet ((((a >> 20) + 512) & 0x1000) + (a & 0x1FFFFFFF), then |2 for the endian bits where a memory poll / write has them).
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::graphics {
+
+inline constexpr int32_t kD3dNoringAbi = 2;
+inline constexpr uint32_t kD3dNoringMagic = 0xD3D40001u;
+inline constexpr uint32_t kD3dNoringHeaderDwords = 7;
+
+enum D3dNoringKind : uint32_t {
+  kNrPad = 0,
+  kNrSegment = 1,        // a piece of a library segment in guest memory, executed as an INDIRECT_BUFFER (stage 2a/2b)
+  kNrPackets = 2,        // packets by value (payload; the record tokens 0x7C / 0x7D / 0x7E - stage 2c)
+  kNrFence = 3,          // the segment-end fence pair, written by the consumer after every item before it
+  kNrFlipHandshake = 4,  // 0x82CB3300: the present's flip word handshake (scratch+4 = 1, interrupt, wait scratch+4 == 0)
+  kNrSceneTiming = 5,    // 0x82CB6510 with callback 0x82C16978 / 0x82C16980 (scene-timing slots)
+  kNrInterrupt = 6,      // 0x82CB6510 for any other callback
+  kNrPresent = 7,        // VdSwap's words (fetch constants + XE_SWAP), executed as ring-level packets
+  kNrBarrier = 8,        // the consumer publishes the ticket when it has executed everything before this item
+  kNrRegs = 9,           // plain register writes / read-modify-writes (the display registers of the present, the 0x5C8 flush)
+  kNrKindCount
+};
+
+// Field indexes (dwords 1-6 of the entry).
+namespace d3d_noring_field {
+// kNrSegment
+inline constexpr uint32_t kSegAddress = 0;  // GPU-form address of the first word (what the IB packet holds)
+inline constexpr uint32_t kSegLength = 1;   // length in dwords
+inline constexpr uint32_t kSegFlags = 2;    // bit 0: INDIRECT_BUFFER_PFD (0x37) instead of INDIRECT_BUFFER (0x3F): the ring submit's first-byte 0x8F variant
+// kNrPackets: payload = the packet words; field 0 = tag (diagnostics: the producer's family)
+inline constexpr uint32_t kPktTag = 0;
+// kNrFence
+inline constexpr uint32_t kFenceValue = 0;     // device+11036: the fence number
+inline constexpr uint32_t kFenceMarker = 1;    // (device+15324 & 3) | device+48: the heap progress marker
+inline constexpr uint32_t kFenceMarkerAt = 2;  // GPU-form address of fence block +4, |2
+inline constexpr uint32_t kFenceValueAt = 3;   // GPU-form address of fence block +0, |2
+inline constexpr uint32_t kFenceFlags = 4;     // bit 0: the segment end's 0x5C8 write (device byte 11072 bit 0x80)
+// kNrFlipHandshake / kNrSceneTiming / kNrInterrupt (the arguments of 0x82CB6510 + the handshake's own words)
+inline constexpr uint32_t kIntFlags = 0;       // r5: bits 24-29 cpu mask, bit 0 / 1 / 2 / 0x80 as the emitter reads them
+inline constexpr uint32_t kIntCallback = 1;    // r6: the guest callback
+inline constexpr uint32_t kIntArgument = 2;    // r7: its argument
+inline constexpr uint32_t kIntScratch = 3;     // GPU-form address of the scratch block (device+11028), no endian bits
+inline constexpr uint32_t kIntOptions = 4;     // bit 0: pre-arm (scratch+4 = 1), bit 1: wait scratch+4 == 0 afterwards,
+                                               // bit 2: the emitter's 0x5C8 write (misc flush) precedes the callback regs
+// kNrPresent: payload = VdSwap's words (host order, trailing type-2 NOPs trimmed); fields 0-2 = front buffer, width, height
+inline constexpr uint32_t kPresentFront = 0, kPresentWidth = 1, kPresentHeight = 2;
+// kNrRegs: payload = quads {op, register, a, b}: op 1 = write register := a; op 2 = register := (register & a) | b
+inline constexpr uint32_t kRegsOpWrite = 1, kRegsOpRmw = 2;
+// Capability gpu_d3d_noring_ops = 1: the tiling predication state (SET_BIN_MASK_LO / _HI, SET_BIN_SELECT_LO / _HI): a = the value, register unused
+inline constexpr uint32_t kRegsOpBinMaskLo = 3, kRegsOpBinMaskHi = 4, kRegsOpBinSelectLo = 5, kRegsOpBinSelectHi = 6;
+// kNrBarrier
+inline constexpr uint32_t kBarrierTicket = 0;
+}  // namespace d3d_noring_field
+
+// The shared block. Allocated and owned by the game exe; one producer lock (the exe's), one consumer (the command thread).
+struct D3dNoringShared {
+  uint32_t magic = kD3dNoringMagic;
+  uint32_t abi = kD3dNoringAbi;
+  uint32_t* storage = nullptr;  // capacity dwords
+  uint32_t capacity = 0;        // dwords, a power of two
+  alignas(64) std::atomic<uint32_t> tail{0};  // producer: dwords written so far (wraps at 2^32; position = tail & (capacity - 1))
+  alignas(64) std::atomic<uint32_t> head{0};  // consumer: dwords consumed
+  alignas(64) std::atomic<uint32_t> consumed_ticket{0};  // the last kNrBarrier ticket the consumer reached
+  // The consumer's census (relaxed; the exe prints it with its own).
+  std::atomic<uint64_t> items[kNrKindCount]{};
+  std::atomic<uint64_t> segment_dwords{0};   // dwords executed from kNrSegment items (stage 2c: should be 0 in the scene)
+  std::atomic<uint64_t> packet_dwords{0};    // dwords executed from kNrPackets / kNrPresent items
+  std::atomic<uint64_t> fences{0};           // fence values written
+  std::atomic<uint64_t> flip_waits{0};       // flip handshakes whose wait on the flip word really had to wait
+  std::atomic<uint64_t> flip_wait_us{0};     // microseconds spent in those waits
+  std::atomic<uint64_t> bad{0};              // framing / unknown-kind errors (loud)
+};
+
+// The worker loop's idle wait in milliseconds: 5 as before, 1 while the host queue is on (the exe cannot signal the loop's event, so
+// the idle wait polls the queue more often). d3d_noring.cpp.
+int D3dNoringIdleWaitMs();
+
+// Stage 2c: non-zero while the command thread executes a kNrPackets item (a record token by value): the library-draw kind its
+// draws are (1 = the indexed draw token 0x7C, 2 = the inline draw token 0x7E, 0xFF = a record with no draw, e.g. the copy token
+// 0x7D). Half2OnCpDraw reads it instead of matching the packet's address: the record knows what it is.
+uint32_t D3dNoringRecordKind();
+
+}  // namespace rex::graphics
diff --git a/include/rex/graphics/d3d_tex.h b/include/rex/graphics/d3d_tex.h
new file mode 100644
index 0000000000000000000000000000000000000000..4f505d97d3dd5d3f01d1bbd3327c93463dc847ea
--- /dev/null
+++ b/include/rex/graphics/d3d_tex.h
@@ -0,0 +1,194 @@
+// wwe2k14 patch (Session 87, D3D layer STAGE 4, textures in our own form; docs\native\d3d\S4_TEXTURES_CONTRACT.md in the game
+// repository): the id -> texture-object identity table the game's registry (src\d3d_textures.h) feeds through the no-ring queue's
+// Registers item, and the per-slot "bound object" state the texture cache reads in RequestTextures.
+//
+// SDK-internal: no game-exe header includes this file (the exe has its own copy of the op numbers, tied by the int capability cvar
+// gpu_d3d_tex_abi). Nothing here changes the layout of a public SDK class.
+//
+// The ops (quads {op, a, b, c} in a Registers item; the consumer applies them once, on the drawing side):
+//   16 Define0 {id, kind | flags << 8, word0}   17 Define1 {id, word1, word2}   18 Define2 {id, word3, word4}   19 Define3 {id, word5, 0}
+//   20 Destroy {id}   21 Changed {id}   22 Bind {slot, id}
+// Define carries an object's six header dwords as SetTexture would put them into a slot record (the image identity: base / mip
+// address in GPU form, size, format, pitch, tiled; the sampler / view bits are the slot's, kept in the fetch constant).
+// Bind says: the NEXT write of slot `slot`'s fetch constant comes from object `id`; the write consumes it (OnFetchWritten), so a slot
+// written without a Bind (a fallback writer, the present, a ring packet) has no object.
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace rex::graphics::d3d_tex {
+
+inline constexpr int32_t kAbi = 1;
+inline constexpr uint32_t kOpDefine0 = 16, kOpDefine1 = 17, kOpDefine2 = 18, kOpDefine3 = 19, kOpDestroy = 20, kOpChanged = 21,
+                          kOpBind = 22;
+
+// Set by the first op the consumer applies: the fetch-constant notification (TextureCache::TextureFetchConstantsWritten) calls
+// into the table only after that.
+inline std::atomic<bool> g_active{false};
+
+// Who is writing fetch constants right now (set by the packet handlers; the census of writes with no Bind names them).
+enum Writer : uint32_t { kWRing = 0, kWToken, kWInline, kWCopy, kWRegsItem, kWFeed, kWriterCount };
+inline constexpr const char* kWriterNames[kWriterCount] = {"ring packet / other", "record token 0x7C", "inline token 0x7E", "copy token 0x7D",
+                                                           "Registers item", "stage 3 feed"};
+inline thread_local Writer g_writer = kWRing;
+void EndTokenScope();  // d3d_tex.cpp: the end of a token that applied fetch writes (Table::EndToken)
+// The packet being executed (guest physical address of its header word) and the INDIRECT_BUFFER packet that called it (0: the ring),
+// set by CommandProcessor::ExecutePacket while the table is active: the census of fetch writes with no Bind names them.
+inline thread_local uint32_t g_packet_at = 0, g_ib_caller = 0;
+struct WriterScope {
+  Writer prev, mine;
+  bool ends_binds;  // false for the answers side of the native frame (it runs the same token; only the drawing side owns the Binds)
+  explicit WriterScope(Writer w, bool ends_binds_at_end = true) : prev(g_writer), mine(w), ends_binds(ends_binds_at_end) { g_writer = w; }
+  ~WriterScope() {
+    g_writer = prev;
+    // A Bind belongs to the token (draw) it was pushed for: whatever that token did not consume is dropped at its end and counted.
+    if (ends_binds && (mine == kWToken || mine == kWInline || mine == kWCopy) && g_active.load(std::memory_order_relaxed)) EndTokenScope();
+  }
+  WriterScope(const WriterScope&) = delete;
+  WriterScope& operator=(const WriterScope&) = delete;
+};
+
+enum Kind : uint32_t { kUnknown = 0, kRenderTarget = 1, kFileStatic = 2, kEngineDynamic = 3, kKindCount };
+inline constexpr const char* kKindNames[kKindCount] = {"unknown", "render_target", "file_static", "engine_dynamic"};
+
+// Why a draw's texture slot was bound from its fetch constant and not by its object.
+enum Fallback : uint32_t {
+  kFbNoId = 0,      // the slot was written without a Bind (no object known for it)
+  kFbUnknownId,     // the bound id is not in the table (retired, or never defined)
+  kFbKeyMismatch,   // the object's key and the fetch constant's key disagree (the fetch constant wins)
+  kFbBadObject,     // the object's words give no valid key
+  kFbNotTexture,    // the fetch constant is not a texture (the old path's own invalid handling)
+  kFbCount
+};
+inline constexpr const char* kFallbackNames[kFbCount] = {"no_id", "unknown_id", "key_mismatch", "bad_object", "not_texture"};
+
+struct Entry {
+  uint32_t id = 0;
+  uint32_t kind = kUnknown;
+  uint32_t words[6] = {};
+  uint32_t have_mask = 0;    // bit k: Define part k seen
+  bool key_known = false;    // key computed (valid or not)
+  bool key_valid = false;
+  alignas(8) uint8_t key[16] = {};  // a TextureCache::TextureKey (memcpy'd; the cache checks sizeof)
+  uint32_t key_w4 = 0;       // the slot's word 4 (view bits) the key was derived with
+  uint8_t key_requested[16] = {};  // the key FindOrCreateTexture was asked for when `texture` was found
+  void* texture = nullptr;   // the host image found for the key last time (valid while texture_epoch == the table's epoch)
+  uint64_t texture_epoch = 0;
+  uint64_t texture_marks = 0;   // the scaled-resolve marks version `texture` was found under (a tiled texture at a scaled resolution)
+  uint64_t binds = 0;
+  bool loaded = false;       // its texture has been requested to load once (the first bind)
+  bool changed_pending = false;
+};
+
+struct Census {
+  std::atomic<uint64_t> defines{0}, destroys{0}, changed{0}, changed_marked{0}, bind_items{0}, binds_consumed{0};
+  std::atomic<uint64_t> by_id{0}, by_id_kind[kKindCount] = {};
+  std::atomic<uint64_t> fallback[kFbCount] = {};
+  std::atomic<uint64_t> fallback_slot[32] = {};      // the same fallbacks by fetch slot
+  std::atomic<uint64_t> fallback_logged{0};          // detail lines written (the first few)
+  std::atomic<uint64_t> mismatch_logged{0};
+  std::atomic<uint64_t> first_binds[kKindCount] = {};     // the first bind of an object (its upload)
+  std::atomic<uint64_t> reuploads[kKindCount] = {};       // an object's texture marked outdated by the engine's flush
+  std::atomic<uint64_t> watch_fires[kKindCount] = {};     // memory watch fired on a registered object's texture
+  std::atomic<uint64_t> watch_fires_unregistered{0};
+  std::atomic<uint64_t> texture_hits{0}, texture_finds{0};
+  std::atomic<uint64_t> unknown_changed{0}, unknown_destroy{0};
+  // no_id fallbacks, named: recalled = the slot was rewritten with the SAME six dwords the last by-id bind had (a replay / re-write with no Bind: the
+  // id is kept); never = the slot has not been bound by id before; new_content = other dwords than the last by-id bind's
+  std::atomic<uint64_t> recalled{0}, no_id_never{0}, no_id_new_content{0};
+  std::atomic<uint64_t> watches_dropped{0}, destroyed_outdated{0}, shortcut_marks_miss{0};
+  std::atomic<uint64_t> pending_left{0};       // Binds a token ended without consuming (dropped)
+  std::atomic<uint64_t> shortcut_mismatch{0};  // verify: the remembered image is not what FindOrCreateTexture(key) returns now
+  std::atomic<uint64_t> drop_failed{0};        // watch drops that failed (not retried)
+  // Fetch constant writes that consumed no Bind, by who wrote them and whether the slot is a texture slot (< 26) or a vertex one.
+  std::atomic<uint64_t> unbound_writes[kWriterCount][2] = {};
+  std::atomic<uint64_t> unbound_logged{0};
+  std::atomic<uint32_t> unbound_logged_w[kWriterCount] = {};  // log lines per writer kind
+  std::atomic<uint64_t> no_id_by_writer[kWriterCount] = {};   // the fetch fallbacks (a texture-type fetch constant, no object) by the slot's last writer
+  std::atomic<uint64_t> plane_changed{0};   // Changed ops that came from the movie planes' flush
+};
+
+class Table {
+ public:
+  static Table& Get();
+
+  // The consumer's ops (command thread).
+  void Define(uint32_t part, uint32_t id, uint32_t a, uint32_t b, uint32_t c);
+  void Destroy(uint32_t id);
+  void Changed(uint32_t id);
+  void Bind(uint32_t slot, uint32_t id);
+  // A fetch constant range was written (TextureCache::TextureFetchConstantsWritten): bound[slot] = pending[slot], pending cleared.
+  // fetch_block (optional): dword 0 of fetch constant 0 in the register file the write went to (for the log line of a write with no Bind).
+  void OnFetchWritten(uint32_t first, uint32_t last, const uint32_t* fetch_block = nullptr);
+
+  // The texture cache's side. All of these take mu; none is called with the global critical region held except ForgetTexture
+  // (a texture's destructor) and NoteWatchFire (the watch callback), which only touch the table.
+  // Entry for id, copied out (false = unknown).
+  bool Find(uint32_t id, Entry& out);
+  // Stores what the cache derived/found for the entry.
+  void StoreKey(uint32_t id, const uint8_t key16[16], uint32_t w4, bool valid);
+  void StoreTexture(uint32_t id, void* texture, const uint8_t key16[16], uint64_t epoch, uint64_t marks);
+  // The slot's last by-id bind (cache thread): a rewrite with the same six dwords and no Bind keeps its object.
+  uint32_t Recall(uint32_t slot, const uint32_t words[6], bool& never) const;
+  void Remember(uint32_t slot, uint32_t id, const uint32_t words[6]);
+  // Statics whose first upload happened: their memory watch can go once the load is done (TakeDrops / the cache).
+  void TakeDrops(std::vector<std::pair<const void*, uint32_t>>& out);
+  void RequeueDrop(const void* texture, uint32_t kind);
+  void MarkWatchDropped(const void* texture);
+  // The texture was queued for a load: first load of the object = a first bind (upload); later = a re-upload.
+  void NoteLoad(const void* texture);
+  void NoteWatchFire(const void* texture);
+  // A token that applied fetch writes ended: Binds it left pending are dropped and counted (a Bind belongs to its draw).
+  void EndToken();
+  void ForgetTexture(const void* texture);
+  // Textures of the entries the engine flushed since the last call (changed_pending), cleared.
+  void TakeChanged(std::vector<std::pair<const void*, uint32_t>>& out);
+
+  // The slot's last writer, for naming a no_id fallback.
+  Writer LastWriter(uint32_t slot) const { return slot < 32 ? last_writer_[slot] : kWRing; }
+  bool LastHadBind(uint32_t slot) const { return slot < 32 && last_had_bind_[slot]; }
+  uint32_t BoundId(uint32_t slot) const { return slot < 32 ? bound_[slot] : 0; }
+  // A bump of this makes every slot's cached "object" decision stale (cleared by OnFetchWritten per slot; read by the cache).
+  uint64_t epoch() const { return epoch_.load(std::memory_order_relaxed); }
+  void BumpEpoch() { epoch_.fetch_add(1, std::memory_order_relaxed); }
+
+  std::mutex mu;
+  std::unordered_map<uint32_t, Entry> entries;   // guarded by mu
+  // texture (opaque host-image pointer) -> object id and kind, for the watch-fire census (any thread)
+  std::unordered_map<const void*, uint32_t> texture_to_id;  // guarded by mu
+  Census census;
+  std::atomic<bool> changed_any{false};   // a Changed op (or a destroyed watch-less static) is waiting for the cache (TakeChanged)
+  std::atomic<bool> drop_any{false};      // a first upload of a static is waiting for its watch to go (TakeDrops)
+  // Bumped whenever the scaled-resolve marks of the texture cache change (a range newly marked, or cleared by a CPU write): the answer of
+  // FindOrCreateTexture for a tiled texture at a scaled draw resolution is a function of the key AND of these marks.
+  std::atomic<uint64_t> marks_version{1};
+
+ private:
+  uint32_t pending_[32] = {};
+  uint32_t last_id_[32] = {};
+  Writer last_writer_[32] = {};     // who wrote each slot last (OnFetchWritten), with or without a Bind
+  bool last_had_bind_[32] = {};
+  uint32_t last_words_[32][6] = {};
+  std::vector<std::pair<const void*, uint32_t>> drop_pending_;   // guarded by mu
+  std::vector<std::pair<const void*, uint32_t>> outdate_pending_;   // guarded by mu (retired watch-less statics)
+  std::unordered_set<const void*> dropped_textures_;                // guarded by mu: host images whose memory watch was dropped
+  // The entry's image goes away (replaced, redefined, destroyed): a watch-less one is outdated, the id map forgets it. Lock held.
+  void RetireTexture(const void* texture, uint32_t kind);
+  uint32_t bound_[32] = {};
+  std::atomic<uint64_t> epoch_{1};
+};
+
+bool Enabled();         // cvar gpu_d3d_textures >= 1
+bool UseIds();          // cvar gpu_d3d_textures >= 2
+bool VerifyKeys();      // cvar gpu_d3d_textures_verify
+bool DropWatches();     // cvar gpu_d3d_textures_drop_watch
+void LogCensus(uint32_t frame);   // the [d3d][tex] line every gpu_d3d_layer_log_frames frames
+
+}  // namespace rex::graphics::d3d_tex
