+
+// The constants and the fetch constants a vertex shader's interpretation reads (ShaderInterpreter reads the register
+// file only through GetFloatConstant - the shader's float constants, at the SQ_VS_CONST base, none past its size -,
+// the bool / loop constants, and GetVertexFetch, plus guest memory inside the fetch constant's buffer).
+// constants_hash: SQ_VS_CONST, the float constants the shader reads (its bitmap), the 8 bool and 32 loop constants.
+// fetch_hash: the fetch constants the shader reads (their registers) and, with fetch_bytes, the bytes of their buffers
+// (a buffer over 4 KB: false). False too when the shader addresses its float constants dynamically.
+bool VulkanCommandProcessor::InterpInputHashes(const VulkanShader& vertex_shader, bool fetch_bytes,
+                                               uint64_t& constants_hash, uint64_t& fetch_hash) {
+  const RegisterFile& regs = DrawRegs();  // (Session 87, stage 3)
+  const Shader::ConstantRegisterMap& map = vertex_shader.constant_register_map();
+  if (map.float_dynamic_addressing) return false;
+  const auto vs_const = regs.Get<reg::SQ_VS_CONST>(XE_GPU_REG_SQ_VS_CONST);
+  constexpr uint32_t kBoolLoopWords = XE_GPU_REG_SHADER_CONSTANT_LOOP_31 + 1 - XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031;
+  uint32_t words[1 + 256 * 4 + kBoolLoopWords];
+  uint32_t n = 0;
+  words[n++] = regs[XE_GPU_REG_SQ_VS_CONST];
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t entry = map.float_bitmap[i];
+    uint32_t index;
+    while (bit_inline::bit_scan_forward(entry, &index)) {
+      entry &= ~(1ull << index);
+      const uint32_t reg_index = (i << 6) + index + vs_const.base;
+      if (reg_index >= 512) continue;  // (the interpreter reads zeros there)
+      std::memcpy(words + n, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * reg_index], sizeof(float) * 4);
+      n += 4;
+    }
+  }
+  std::memcpy(words + n, &regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], sizeof(uint32_t) * kBoolLoopWords);
+  n += kBoolLoopWords;
+  constants_hash = XXH3_64bits(words, sizeof(uint32_t) * n);
+  uint64_t parts[16];
+  uint32_t part_count = 0;
+  for (uint32_t i = 0; i < 96; ++i) {
+    if (!(map.vertex_fetch_bitmap[i >> 5] & (uint32_t(1) << (i & 31)))) continue;
+    if (part_count + 2 > 16) return false;
+    const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(i);
+    parts[part_count++] = XXH3_64bits(&fetch, sizeof(fetch));
+    if (!fetch_bytes) continue;
+    const uint32_t address = (uint32_t(fetch.address) << 2) & 0x1FFFFFFFu, bytes = uint32_t(fetch.size) << 2;
+    if (bytes > 4096 || uint64_t(address) + bytes > 0x20000000u) return false;
+    parts[part_count++] = bytes ? XXH3_64bits(memory_->TranslatePhysical(address), bytes) : 0;
+  }
+  fetch_hash = XXH3_64bits(parts, sizeof(uint64_t) * part_count);
+  return true;
