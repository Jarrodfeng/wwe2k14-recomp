+#!/usr/bin/env python3
+"""Session 87 stage 4: record the tfetch sampler filter overrides of the registered shaders, as the translator found them
+(the shader's sampler_bindings: a field other than "use the fetch constant" is a fact the microcode states), into
+src/graphics/vulkan/native/sampler_overrides.h.
+
+Source: the "[native][swap_skip][verify]" blocks of run logs made with gpu_native_swap_skip_verify=true on a build that lists the
+differences ("(by design) sampler of fetch constant N: the guest overrides the filters (mag a min b mip c aniso d)"). The
+table holds hashes, fetch constants and four small numbers - an annotation of the shaders, no microcode and no shader code.
+Rows already in the table are kept (the output is the union of the table and the logs).
+Usage: py record.py <log> [<log> ...]
+"""
+import os, re, sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+OUT = os.path.join(HERE, '..', '..', 'src', 'graphics', 'vulkan', 'native', 'sampler_overrides.h')
+
+rows = {}
+if os.path.exists(OUT):
+    for m in re.finditer(r'\{0x([0-9A-F]{16})ull, (\d), (\d+), (\d), (\d), (\d), (\d)\}', open(OUT, encoding='utf-8').read()):
+        rows[(int(m.group(1), 16), int(m.group(2)), int(m.group(3)))] = tuple(int(m.group(i)) for i in range(4, 8))
+for path in sys.argv[1:]:
+    cur = None
+    for line in open(path, encoding='utf-8', errors='replace'):
+        m = re.search(r'\[native\]\[swap_skip\]\[verify\] (vertex|pixel) shader ([0-9A-F]{16}):', line)
+        if m:
+            cur = (int(m.group(2), 16), 1 if m.group(1) == 'vertex' else 0)
+            continue
+        m = re.search(r'sampler of fetch constant (\d+): the guest overrides the filters \(mag (\d+) min (\d+) mip (\d+) aniso (\d+)\)', line)
+        if m and cur:
+            rows[(cur[0], cur[1], int(m.group(1)))] = tuple(int(m.group(i)) for i in range(2, 6))
+        # the verify difference line of a shader whose override is not in the table yet: "sampler filters of fetch constant N:
+        # registration 0x.., real 0xV" with V = mag | min << 2 | mip << 4 | aniso << 6
+        m = re.search(r'sampler filters of fetch constant (\d+): registration 0x[0-9a-f]+, real 0x([0-9a-f]+)', line)
+        if m and cur:
+            v = int(m.group(2), 16)
+            rows[(cur[0], cur[1], int(m.group(1)))] = (v & 3, (v >> 2) & 3, (v >> 4) & 3, (v >> 6) & 7)
+lines = ['#pragma once',
+         '// Session 87 stage 4: the tfetch sampler filter overrides of the registered shaders (the translator\'s sampler_bindings: mag, min,',
+         '// mip as xenos::TextureFilter, aniso as xenos::AnisoFilter; 3 / 3 / 3 / 7 = follow the fetch constant), recorded by',
+         '// tools/sampler_record/record.py. A replacement\'s sampler applies them (SpirvShader::SetReplacementBindings). Hashes and numbers',
+         '// only: an annotation of the shaders, no microcode.',
+         '#include <cstdint>', '',
+         'namespace rex::graphics::vulkan::shader_swap {', '',
+         'struct SamplerOverrideRow {',
+         '  uint64_t hash;',
+         '  uint8_t vertex;  // 1 = a vertex shader',
+         '  uint8_t fetch_constant;',
+         '  uint8_t mag_filter, min_filter, mip_filter, aniso_filter;',
+         '};', '',
+         'inline constexpr SamplerOverrideRow kSamplerOverrideRows[] = {']
+for (h, v, fc), f in sorted(rows.items()):
+    lines.append('    {0x%016Xull, %d, %d, %d, %d, %d, %d},' % (h, v, fc, f[0], f[1], f[2], f[3]))
+lines += ['};', '', '}  // namespace rex::graphics::vulkan::shader_swap', '']
+open(OUT, 'w', encoding='utf-8', newline='\n').write('\n'.join(lines))
+print('%d rows -> %s' % (len(rows), os.path.abspath(OUT)))
