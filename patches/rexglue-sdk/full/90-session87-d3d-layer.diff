+bool VertexSwapStale(uint64_t guest_hash, uint32_t recorded_vertex_ext) {
+  const bool recorded = (recorded_vertex_ext & SpirvShaderTranslator::kNativeExtVsSwap) != 0;
+  return recorded != VertexTakes(guest_hash);
+}
