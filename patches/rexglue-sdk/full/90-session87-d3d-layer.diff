+++ b/tools/restore_check/check.py
@@ -0,0 +1,188 @@
+#!/usr/bin/env python3
+"""Session 87 stage 4: arithmetic check of our restore shader (src/graphics/vulkan/native/restore/restore_color_depth.frag)
+against the SDK translator's NATIVE module of the game shader it replaces (9A836B68E3F8F0B0, the colour + depth restore).
+
+In the style of the game repo's tools/shaders/harness (mkharness.py + vkrun.cpp, Session 80): both shaders are turned into
+compute shaders that read their interpolator and the four fetch-constant dwords they use from a buffer, with the textures
+replaced by smooth fake functions of (texture id, coordinate, LOD bias), and are run over random inputs on the GPU; the
+colour and depth outputs are compared BIT FOR BIT. It proves the arithmetic and the channel mapping (the coordinate nudge, the
+LOD bias and exponent adjust fields, NClamp, the 8-bit epilogue); texture formats and sampling are checked by same-frame
+shots, as for every swap shader.
+
+Needs: the Vulkan SDK (glslangValidator, spirv-cross), LLVM's clang++ (to build the small runner once), numpy, and the
+translator's module as a SPIR-V file: --ref <module.spv> (a dump_shaders 'vk_native' module of the shader; local, never
+committed). Usage: py check.py --ref <module.spv> [--count 262144] [--work <dir>]
+"""
+import argparse, glob, os, re, subprocess, sys
+import numpy as np
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.abspath(os.path.join(HERE, '..', '..'))
+FRAG = os.path.join(ROOT, 'src', 'graphics', 'vulkan', 'native', 'restore', 'restore_color_depth.frag')
+VKRUN = os.path.join(ROOT, '..', '..', '..', 'tools', 'shaders', 'harness', 'vkrun.cpp')  # the game repo's runner (read only)
+
+def sdk_bin(name):
+    c = sorted(glob.glob(r'C:\VulkanSDK\*\Bin\%s' % name))
+    if not c: sys.exit('Vulkan SDK tool not found: ' + name)
+    return c[-1]
+
+PRELUDE = r'''#version 450
+#extension GL_EXT_scalar_block_layout : require
+#extension GL_EXT_spirv_intrinsics : require
+layout(local_size_x = 64) in;
+layout(std430, binding = 0) readonly buffer InBuf { float data[]; } inb;
+layout(std430, binding = 1) writeonly buffer OutBuf { vec4 col[]; } outb;
+vec4 loadVec(uint base, uint k) { return vec4(inb.data[base + k*4u], inb.data[base + k*4u + 1u], inb.data[base + k*4u + 2u], inb.data[base + k*4u + 3u]); }
+// fake textures: smooth, bounded, id- and bias-dependent
+vec4 fakeTexture(int id, vec3 p, float bias) {
+  float s = float(id) * 0.731;
+  vec4 a = vec4(2.3, 3.1, 1.7, 2.9) + s * 0.05;
+  vec4 b = vec4(1.9, 2.7, 3.3, 1.3) + s * 0.03;
+  vec4 ph = vec4(0.3, 1.1, 2.0, 2.9) + s;
+  return 0.5 + 0.5 * sin(a * p.x + b * p.y + ph + 0.4 * sin(p.x * 5.0 + s) + 0.01 * bias);
+}
+#define texture(t, c, b) fakeTexture(t, c, b)
+#define sampler2DArray(t, s) (t)
+'''
+
+def strip_common(text):
+    text = re.sub(r'#version 450\n', '', text)
+    text = re.sub(r'#extension [^\n]*\n', '', text)
+    text = re.sub(r'#if defined\(GL_EXT_control_flow_attributes\).*?#endif\n',
+                  '#define SPIRV_CROSS_FLATTEN\n#define SPIRV_CROSS_BRANCH\n#define SPIRV_CROSS_UNROLL\n#define SPIRV_CROSS_LOOP\n', text, flags=re.S)
+    return text
+
+def mine_text():
+    text = strip_common(open(FRAG, encoding='utf-8').read())
+    consts = []
+    def tex(m):
+        binding, kind, name = int(m.group(1)), m.group(2), m.group(3)
+        consts.append('const int %s = %d;' % (name, -1 if kind == 'sampler' else binding - 1000))
+        return ''
+    text = re.sub(r'layout\(set = 3, binding = (\d+)\) uniform (texture2DArray|sampler) (\w+);[^\n]*', tex, text)
+    text = re.sub(r'layout\(set = 1, binding = 0, std140\) uniform XeSystemConstants \{(.*?)\} xe_system;',
+                  lambda m: 'struct XeSys_ {' + re.sub(r'layout\(offset = \d+\) ', '', m.group(1)) + '}; XeSys_ xe_system;', text, flags=re.S)
+    text = re.sub(r'layout\(set = 1, binding = 4, std140\) uniform XeFetchConstants \{ uvec4 fetch_constants\[48\]; \} xe_fetch;',
+                  'struct XeFetch_ { uvec4 fetch_constants[48]; }; XeFetch_ xe_fetch;', text)
+    text = re.sub(r'layout\(location = 0\) in vec4 in_uv;[^\n]*', 'vec4 in_uv;', text)
+    text = re.sub(r'layout\(location = 0\) out vec4 out_color;', 'vec4 out_color;', text)
+    text = re.sub(r'layout\(constant_id = 0\) const uint kXeColorQuantize = 0u;', 'const uint kXeColorQuantize = 1u;  // (an 8-bit target)', text)
+    text = text.replace('gl_FragDepth', 'g_depth').replace('discard;', 'return;').replace('void main()', 'void shaderMain()')
+    return '\n'.join(consts) + '\nfloat g_depth;\n' + text
+
+def strip_relaxed(spv, work):
+    """The dumped module may carry the fp16 experiment's RelaxedPrecision decorations (the file name says 'relaxed'): GPUs that
+    honour them compute those operations in half precision, which the translator's own module does not. Replace each
+    OpDecorate %x RelaxedPrecision (3 words) with three OpNops, so the module is the translator's plain one."""
+    w = np.fromfile(spv, np.uint32).copy()
+    at, n = 5, 0
+    while at < len(w):
+        cnt, op = int(w[at]) >> 16, int(w[at]) & 0xFFFF
+        if op == 71 and cnt == 3 and int(w[at + 2]) == 0:
+            w[at:at + 3] = 0x00010000
+            n += 1
+        at += cnt
+    out = os.path.join(work, 'ref_plain.spv')
+    w.tofile(out)
+    print('stripped %d RelaxedPrecision decorations' % n)
+    return out
+
+def ref_text(spv, work):
+    spv = strip_relaxed(spv, work)
+    out = subprocess.run([sdk_bin('spirv-cross.exe'), '--vulkan-semantics', spv], capture_output=True, text=True, check=True).stdout
+    text = strip_common(re.sub(r'^//[^\n]*\n', '', out, flags=re.M))
+    consts = []
+    def tex(m):
+        kind, name = m.group(1), m.group(2)
+        mm = re.match(r'xe_texture(\d+)_2d_([us])', name)
+        consts.append('const int %s = %d;' % (name, -1 if kind == 'sampler' else int(mm.group(1)) + (100 if mm.group(2) == 's' else 0)))
+        return ''
+    text = re.sub(r'layout\(set = 3, binding = \d+\) uniform (texture2DArray|sampler) (\w+);', tex, text)
+    m = re.search(r'layout\(set = 1, binding = 0, scalar\) uniform XeSystemConstants\s*\{(.*?)\} xe_uniform_system_constants;', text, re.S)
+    text = text.replace(m.group(0), 'struct XeSys_ {' + re.sub(r'layout\(offset = \d+\) ', '', m.group(1)) + '}; XeSys_ xe_uniform_system_constants;')
+    text = re.sub(r'layout\(set = 1, binding = 3, std140\) uniform XeBoolLoopConstants\s*\{.*?\} xe_uniform_bool_loop_constants;', '', text, flags=re.S)
+    text = re.sub(r'layout\(set = 1, binding = 4, std140\) uniform XeFetchConstants\s*\{\s*uvec4 fetch_constants\[48\];\s*\} xe_uniform_fetch_constants;',
+                  'struct XeFetch_ { uvec4 fetch_constants[48]; }; XeFetch_ xe_uniform_fetch_constants;', text)
+    text = re.sub(r'layout\(set = 0, binding = 0, std430\) restrict readonly buffer XeSharedMemory\s*\{.*?\} xe_shared_memory;', '', text, flags=re.S)
+    text = re.sub(r'layout\(location = 0\) in vec4 xe_in_interpolator_0;', 'vec4 xe_in_interpolator_0;', text)
+    text = re.sub(r'layout\(location = 0\) invariant out vec4 xe_out_fragment_data_0;', 'vec4 xe_out_fragment_data_0;', text)
+    text = re.sub(r'gl_SampleMask\[0\] = [^;]*;', '', text)
+    text = text.replace('gl_FragDepth', 'g_depth').replace('void main()', 'void shaderMain()')
+    return '\n'.join(consts) + '\nfloat g_depth;\n' + text
+
+def glue(which, mode):
+    # The record: uv.xy, then the four fetch-constant dwords as uint bits: dword 2 of fetch constant 0 (fetch_constants[0].z),
+    # dword 4 of it (fetch_constants[1].x), dword 2 and dword 4 of fetch constant 1 (fetch_constants[2].x, [2].z).
+    fc = 'xe_fetch' if which == 'mine' else 'xe_uniform_fetch_constants'
+    sysv = 'xe_system' if which == 'mine' else 'xe_uniform_system_constants'
+    uv = 'in_uv' if which == 'mine' else 'xe_in_interpolator_0'
+    outv = 'out_color' if which == 'mine' else 'xe_out_fragment_data_0'
+    lines = ['void main() {', '  uint i = gl_GlobalInvocationID.x;', '  uint base = i * 8u;',
+             '  for (int k = 0; k < 48; ++k) %s.fetch_constants[k] = uvec4(0u);' % fc,
+             '  %s = vec4(inb.data[base], inb.data[base + 1u], 0.0, 0.0);' % uv,
+             '  %s.fetch_constants[0].z = floatBitsToUint(inb.data[base + 2u]);' % fc,
+             '  %s.fetch_constants[1].x = floatBitsToUint(inb.data[base + 3u]);' % fc,
+             '  %s.fetch_constants[2].x = floatBitsToUint(inb.data[base + 4u]);' % fc,
+             '  %s.fetch_constants[2].z = floatBitsToUint(inb.data[base + 5u]);' % fc,
+             '  %s.flags = 7u << 16;' % sysv, '  %s.alpha_test_reference = 0.0;' % sysv, '  %s.color_exp_bias = vec4(1.0);' % sysv,
+             '  g_depth = 0.0; %s = vec4(0.0);' % outv, '  shaderMain();']
+    lines.append('  outb.col[i] = %s;' % (outv if mode == 'color' else 'vec4(g_depth, 0.0, 0.0, 0.0)'))
+    lines.append('}')
+    return '\n'.join(lines) + '\n'
+
+def run(cmd):
+    r = subprocess.run(cmd, capture_output=True, text=True)
+    if r.returncode:
+        sys.exit('failed: %s\n%s%s' % (' '.join(cmd), r.stdout, r.stderr))
+    return r.stdout
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--ref', required=True)
+    ap.add_argument('--count', type=int, default=262144)
+    ap.add_argument('--work', default=os.path.join(ROOT, 'out', 'restore_check'))
+    a = ap.parse_args()
+    os.makedirs(a.work, exist_ok=True)
+    runner = os.path.join(a.work, 'vkrun.exe')
+    if not os.path.exists(runner):
+        sdk = os.path.dirname(os.path.dirname(sdk_bin('glslangValidator.exe')))
+        clang = r'C:\Program Files\LLVM\bin\clang++.exe'
+        run([clang, '-O1', '-I', os.path.join(sdk, 'Include'), os.path.abspath(VKRUN), os.path.join(sdk, 'Lib', 'vulkan-1.lib'), '-o', runner])
+    # inputs: uv (some outside 0..1), four dwords: sizes 13+13 bits (random), LOD bias / exponent fields random 10 bits at 12
+    rng = np.random.default_rng(87)
+    n = a.count
+    rec = np.zeros((n, 8), np.float32)
+    rec[:, 0] = rng.uniform(-0.25, 1.25, n); rec[:, 1] = rng.uniform(-0.25, 1.25, n)
+    def size_word(): return (rng.integers(0, 4096, n) | (rng.integers(0, 4096, n) << 13)).astype(np.uint32)
+    def bias_word(): return (rng.integers(0, 1024, n).astype(np.uint32) << 12).astype(np.uint32)
+    for col, w in ((2, size_word()), (3, bias_word()), (4, size_word()), (5, bias_word())):
+        rec[:, col] = w.view(np.float32)
+    inp = os.path.join(a.work, 'in.bin'); rec.tofile(inp)
+    results = {}
+    for which in ('mine', 'ref'):
+        body = mine_text() if which == 'mine' else ref_text(a.ref, a.work)
+        for mode in ('color', 'depth'):
+            comp = os.path.join(a.work, '%s_%s.comp' % (which, mode))
+            open(comp, 'w').write(PRELUDE + body + '\n' + glue(which, mode))
+            spv = comp[:-5] + '.spv'
+            run([sdk_bin('glslangValidator.exe'), '-V', '--target-env', 'vulkan1.2', '-S', 'comp', '-o', spv, comp])
+            out = comp[:-5] + '.out'
+            run([runner, spv, inp, out, str(n), '8'])
+            results[(which, mode)] = np.fromfile(out, np.uint32).reshape(-1, 4)
+    ok = True
+    for mode in ('color', 'depth'):
+        m, r = results[('mine', mode)], results[('ref', mode)]
+        both_nan = np.isnan(m.view(np.float32)) & np.isnan(r.view(np.float32))
+        diff = (m != r) & ~both_nan
+        bad = diff.any(1)
+        cols = 4 if mode == 'color' else 1
+        print('%s: %d of %d records differ (components compared: %d)' % (mode, int(bad[:].sum()), n, cols))
+        if bad.any():
+            ok = False
+            for i in np.nonzero(bad)[0][:5]:
+                print('  record %d: uv %s mine %s ref %s' % (i, rec[i, :2], m[i, :cols].view(np.float32), r[i, :cols].view(np.float32)))
+    print('RESULT', 'bit-identical on %d records' % n if ok else 'DIFFERS')
+    return 0 if ok else 1
+
+if __name__ == '__main__':
+    sys.exit(main())
