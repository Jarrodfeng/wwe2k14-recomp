+# Session 87 stage 4: compile src\graphics\vulkan\native\restore\restore_color_depth.frag (our own code) to the SPIR-V header
+# restore_color_depth.h next to it (a uint32_t array restore_color_depth_spv), as the game's tools\post\build_shaders.ps1 does
+# for the scene shaders. The header is committed: the SDK build needs no shader compiler.
+#   pwsh -File tools\restore_check\build.ps1
+$ErrorActionPreference = 'Stop'
+$root = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
+$glslang = Get-ChildItem 'C:\VulkanSDK\*\Bin\glslangValidator.exe' -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | Select-Object -First 1
+if (-not $glslang) { throw 'glslangValidator not found (Vulkan SDK)' }
+$dir = Join-Path $root 'src\graphics\vulkan\native\restore'
+$src = Join-Path $dir 'restore_color_depth.frag'
+$spv = Join-Path $env:TEMP 'restore_color_depth.spv'
+& $glslang.FullName -V --target-env vulkan1.0 -S frag -o $spv $src
+if ($LASTEXITCODE -ne 0) { throw 'glslangValidator failed' }
+$bytes = [IO.File]::ReadAllBytes($spv)
+$words = for ($i = 0; $i -lt $bytes.Length; $i += 4) { '0x{0:X8}' -f [BitConverter]::ToUInt32($bytes, $i) }
+$lines = for ($i = 0; $i -lt $words.Count; $i += 8) { '    ' + (($words[$i..([Math]::Min($i + 7, $words.Count - 1))]) -join ', ') + ',' }
+$header = @(
+  '#pragma once'
+  '// Session 87 stage 4: generated from restore_color_depth.frag by tools\restore_check\build.ps1'
+  '// (glslangValidator -V --target-env vulkan1.0 -S frag). Do not edit: edit the .frag and run the script.'
+  '#include <cstdint>'
+  ''
+  'inline constexpr uint32_t restore_color_depth_spv[] = {'
+) + $lines + @('};', '')
+Set-Content -Path (Join-Path $dir 'restore_color_depth.h') -Value ($header -join "`n") -NoNewline
+Remove-Item $spv
+"{0} words -> {1}" -f $words.Count, (Join-Path $dir 'restore_color_depth.h')
