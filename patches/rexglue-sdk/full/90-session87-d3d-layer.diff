+// ---------------------------------------------------------------------------------------------------------------------
+// The DRAW item: ExecutePacketType3Draw's work for a plain DMA draw, with the dispatch changed.
+bool D3dDirectAccess::DrawItem(CommandProcessor& base, rex::memory::RingBuffer* reader) {
+  using Feed = D3dFeedAccess;
+  if (!REXCVAR_GET(gpu_d3d_direct)) {
+    D3dFeedForeign(base);  // (runs the feed took while the switch was on: the stock draw reads the register file)
+    return false;
+  }
+  VCP& cp = static_cast<VCP&>(base);
+  DirectCensus& c = g_c;
+  ++c.items;
+  // The modes whose per-draw work only the stock wrapper does (frame-anatomy rows, the extents shadow, the det skip) or
+  // that have no native renderer to draw into.
+  if (cp.anatomy_active_ || cp.D3dDirectExtentsActive() || REXCVAR_GET(gpu_det_skip_host_draws) || !cp.native_ ||
+      !cp.native_->enabled()) {
+    ++c.fallback_mode;
+    D3dFeedLastPacket() = 0x37C; D3dFeedForeign(base);
+    return false;
+  }
+  cp.repeat_benign_ = true;  // (the record's shader loads / trailing flush registers are not state a template cares about)
+  const size_t saved = reader->read_offset();
+  const uintptr_t item_ptr = uintptr_t(reader->read_ptr());  // (crowd2 review B3: this item's address)
+  const uint64_t crowd_writes_before_item = cp.SceneCrowdRegisterWrites();
+  const uint32_t viz_query_condition = reader->ReadAndSwap<uint32_t>();
+  reg::VGT_DRAW_INITIATOR vgt_draw_initiator;
+  vgt_draw_initiator.value = reader->ReadAndSwap<uint32_t>();
+  const uint32_t vgt_dma_base = reader->ReadAndSwap<uint32_t>();
+  reg::VGT_DMA_SIZE vgt_dma_size;
+  vgt_dma_size.value = reader->ReadAndSwap<uint32_t>();
+  if (vgt_draw_initiator.source_select != xenos::SourceSelect::kDMA) {
+    reader->set_read_offset(saved);
+    ++c.fallback_source;
+    D3dFeedLastPacket() = 0x37C; D3dFeedForeign(base);
+    return false;
+  }
+  // (Session 87, stage 3) The record-fed variant: the register image feeds this draw (BeginDraw), the register file is
+  // not written for it. Verify mode keeps the stock draw and compares the image after it.
+  const D3dFeedItem feed_item{viz_query_condition, vgt_draw_initiator.value, vgt_dma_base, vgt_dma_size.value};
+  const Feed::Mode feed_mode = Feed::ModeNow(cp);
+  bool own = feed_mode == Feed::Mode::kOwn;
+  D3dFeedCensus& fc = Feed::Census();
+  // The register file brought up to date for a draw the record-fed path does not take.
+  const auto flush_for_draw = [&]() {
+    if (D3dFeedState() & kD3dFeedPending) {
+      if (feed_mode == Feed::Mode::kOff) ++fc.fb_mode;
+      ++fc.flush_by_draw;
+      D3dFeedFlush(base);
+    }
+  };
+  // Is this draw a crowd run's first member (its c76-c78 match a queued run)? The crowd code then reads the register file
+  // before the draw and writes c76-c78 into it after: the stock way, and the image is stale afterwards.
+  bool crowd_hit = false;
+  if (feed_mode != Feed::Mode::kOff) {
+    Feed::BeginDraw(cp, feed_item, feed_mode);
+    crowd_hit = Feed::CrowdMatch(cp);
+    ++fc.draws_seen;
+    fc.crowd_hits += crowd_hit ? 1 : 0;
+    if (own && crowd_hit) {
+      if (REXCVAR_GET(gpu_d3d_own_crowd)) {
+        // gpu_d3d_own_crowd: the crowd code runs on the image (its reads: the register source; its per-member c76-c78 writes:
+        // the image, pending for the register file), so the first member's draw is described from the record like any other.
+        ++fc.draws_crowd_image;
+      } else {
+        ++fc.fb_crowd;
+        Feed::EndDraw(cp);
+        own = false;
+      }
+    }
+  }
+  const bool crowd_on_image = own && crowd_hit;  // (the crowd code's writes go to the image: it stays valid)
+  bool scope_ended = false;                        // the draw was handed back below: the register file is the source after all
+  if (!own) flush_for_draw();
+  // (From here on the item is ours: the stock wrapper's own steps for this draw, in its order.)
+  if (!own) {
+    cp.WriteRegister(XE_GPU_REG_VGT_DRAW_INITIATOR, vgt_draw_initiator.value);
+    cp.WriteRegister(XE_GPU_REG_VGT_DMA_BASE, vgt_dma_base);
+    cp.WriteRegister(XE_GPU_REG_VGT_DMA_SIZE, vgt_dma_size.value);
+  }
+  const uint32_t index_size_bytes =
+      vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16 ? sizeof(uint16_t) : sizeof(uint32_t);
+  VCP::IndexBufferInfo index_buffer_info;
+  index_buffer_info.guest_base = vgt_dma_base & ~(index_size_bytes - 1);
+  index_buffer_info.endianness = vgt_dma_size.swap_mode;
+  index_buffer_info.format = vgt_draw_initiator.index_size;
+  index_buffer_info.length = vgt_dma_size.num_words * index_size_bytes;
+  index_buffer_info.count = vgt_draw_initiator.num_indices;
+
+  cp.half2_matched_kind_ = 0;
+  if (cp.half2_) {
+    cp.Half2OnCpDraw(cp.half2_packet_at_, false,
+                     {uint32_t(vgt_draw_initiator.prim_type), uint32_t(vgt_draw_initiator.num_indices),
+                      index_buffer_info.guest_base & 0x1FFFFFFF,
+                      vgt_draw_initiator.index_size == xenos::IndexFormat::kInt32});
+  }
+
+  const RegisterFile& regs = cp.DrawRegs();  // (the record's image while the record-fed variant runs; else the register file)
+  const auto viz_query = regs.Get<reg::PA_SC_VIZ_QUERY>();
+  ++(cp.native_ib_depth_ ? cp.native_census_.draws_in_ib : cp.native_census_.draws_in_ring);
+  if (viz_query.viz_query_ena) {
+    ++cp.native_census_.viz_query_draws;
+    cp.native_census_.viz_query_dropped += viz_query.kill_pix_post_hi_z ? 1 : 0;
+  }
+  if (!(viz_query.viz_query_ena && viz_query.kill_pix_post_hi_z)) {
+    const bool major_mode_explicit =
+        xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type);
+    ++cp.frame_counters_.issue_draw;
+    // (Session 80, own crowd: a crowd run's first member left to our own crowd renderer.)
+    // (A record-fed draw is no crowd run's first member - CrowdMatch above - and PreTake reads the lagging register file.)
+    // (Crowd2 review B3: this item's own address for the crowd code's predicated-tiling stand-down check, not the token's.)
+    cp.SceneCrowdItemAt(uint32_t(int64_t(item_ptr - uintptr_t(cp.memory_->TranslatePhysical(0))) + cp.half2_exec_bias_) | 1u);
+    cp.own_crowd_skip_draw_ = (!own || crowd_on_image) && (!cp.scene_crowd_local_.empty() || cp.scene_crowd_queued_.load(std::memory_order_relaxed)) &&
+                              cp.SceneCrowdPreTake();
+    // (Session 87, crowd2: the census, and with gpu_native_own_crowd_all a lone draw of the three instanced crowd shaders
+    // - a fed one too, its per-member c76-c78 from the record's image - as a run of one for our crowd program.)
+    if (cp.SceneCrowdCensusBegin(cp.own_crowd_skip_draw_)) cp.own_crowd_skip_draw_ = true;
+    bool draw_succeeded = true;
+    const xenos::PrimitiveType prim_type = vgt_draw_initiator.prim_type;
+    const uint32_t index_count = vgt_draw_initiator.num_indices;
+    const Result result =
+        Lean(cp, prim_type, index_count, &index_buffer_info, major_mode_explicit, draw_succeeded, own, feed_item);
+    if (result == Result::kTaken) {
+      ++c.taken;
+      if (own) ++fc.draws_direct;
+    } else {
+      if (own) {
+        // gpu_d3d_own_full: the full derivation reads the record's image too (the scope stays), unless the image says this
+        // draw is a copy (IssueCopy reads the register file) - then the draw is handed back by name.
+        const bool copy_mode = cp.DrawRegs().Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy;
+        if (REXCVAR_GET(gpu_d3d_own_full) && !copy_mode) {
+          ++fc.draws_full_image;
+          (result == Result::kPass ? fc.full_image_pass : fc.full_image_template)++;
+        } else {
+          (result == Result::kPass ? fc.fb_pass : fc.fb_template)++;
+          if (copy_mode) ++fc.fb_copy_mode;
+          scope_ended = true;  // (the crowd code, if any, runs on the register file below: the image is stale after it)
+          // Handed back to F4's path: the register file first (every pending run and the draw's words), then the stock
+          // derivations read it.
+          Feed::EndDraw(cp);
+          flush_for_draw();
+        }
+      }
+      bool lean_ok = false;
+      if (result == Result::kPass) {
+        ++c.to_stock_lean;
+        if (cp.IssueDrawLean(prim_type, index_count, &index_buffer_info, major_mode_explicit, 1u, lean_ok)) {
+          draw_succeeded = lean_ok;
+        } else {
+          draw_succeeded = cp.IssueDraw(prim_type, index_count, &index_buffer_info, major_mode_explicit);
+        }
+      } else {
+        ++c.to_full;
+        draw_succeeded = cp.IssueDraw(prim_type, index_count, &index_buffer_info, major_mode_explicit);
+      }
+    }
+    if (((!own || crowd_on_image) && (cp.scene_crowd_verify_active_ || !cp.scene_crowd_local_.empty() ||
+                 cp.scene_crowd_queued_.load(std::memory_order_relaxed))) || cp.own_crowd_skip_draw_) {
+      cp.SceneCrowdAfterDraw(prim_type, index_count, &index_buffer_info, major_mode_explicit, 1u);
+    }
+    cp.SceneCrowdCensusEnd();
+    cp.SceneCrowdItemAt(0);
+    if (!draw_succeeded) {
+      const RegisterFile& state = cp.DrawRegs();
+      REXGPU_ERROR(
+          "D3D token draw({}, {}): Failed in backend (major_mode={}, explicit_major={}, path_select={}, tess_mode={}, "
+          "edram_mode={})",
+          uint32_t(vgt_draw_initiator.num_indices), uint32_t(vgt_draw_initiator.prim_type),
+          uint32_t(vgt_draw_initiator.major_mode), uint32_t(major_mode_explicit),
+          uint32_t(state.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select), uint32_t(state.Get<reg::VGT_HOS_CNTL>().tess_mode),
+          uint32_t(state.Get<reg::RB_MODECONTROL>().edram_mode));
+    }
+  }
+  if (own) Feed::EndDraw(cp);
+  // (Crowd2 review B3: also when SceneCrowdAfterDraw wrote c76-c78 itself - our draw declined and the game drew the run.)
+  const bool crowd_wrote = own && cp.SceneCrowdRegisterWrites() != crowd_writes_before_item;
+  if ((crowd_hit && (!crowd_on_image || scope_ended)) || crowd_wrote) {
+    // The crowd code (batched members, SceneCrowdAfterDraw) writes vertex constants c76-c78 into the register file
+    // directly, not by a packet: the image is stale after such a draw (verify run: 39 of 299,008 draws differed, all in
+    // 0x4130-0x413B).
+    Feed::Foreign(cp);
+  } else if (feed_mode == Feed::Mode::kVerify) {
+    Feed::VerifyDraw(cp);
+  }
+  if (c.items >= c.next_print) {
+    c.next_print = c.items + kPrintEvery;
+    Print(cp);
+    Feed::Print(cp);
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// The lean variant. Structure and every check of VulkanCommandProcessor::IssueDrawLean for a draw it takes, with the
+// changes listed at the top of this file; the diagnostics of the stock one (draw census, dirty census, verify) make this
+// path stand down (kPass: the stock path owns them).
+D3dDirectAccess::Result D3dDirectAccess::Lean(VCP& cp, xenos::PrimitiveType prim_type, uint32_t index_count,
+                                              VCP::IndexBufferInfo* index_buffer_info, bool major_mode_explicit,
+                                              bool& succeeded, bool own, const D3dFeedItem& item) {
+  using R = Result;
+  DirectCensus& c = g_c;
+  if (!REXCVAR_GET(gpu_native_lean_draws) || REXCVAR_GET(gpu_native_lean_draws_verify) ||
+      REXCVAR_GET(gpu_native_lean_dirty_census) || REXCVAR_GET(gpu_debug_draw_census_count) > 0) {
+    return R::kPass;
+  }
+  VCP::LeanStats& stats = cp.lean_stats_;
+  const uint32_t dirty = cp.repeat_dirty_;
+  // The special draws the stock path sends to the full path by hash / register (the shadow caster and chain draws, the
+  // crowd density, the shadow half rate): the stock IssueDrawLean decides these.
+  if (wwe_shadow_chain::g.off || REXCVAR_GET(gpu_scene_crowd_density) < 100 || REXCVAR_GET(gpu_shadow_half_rate)) {
+    return R::kPass;
+  }
+  // State outside the compared block changed - earlier bases no longer hold.
+  const bool outside_written = (dirty & (VCP::kRepeatDirtyPacket | VCP::kRepeatDirtyOtherOutside)) != 0;
+  if (outside_written) ++cp.lean_outside_epoch_;
+  const bool multi_base = REXCVAR_GET(gpu_native_lean_multi_base);
+  bool restored = false;
+  cp.lean_restore_cross_ = false;
+  cp.lean_verify_cache_ = false;  // (a previous cross-frame verify whose full draw captured no base: not this draw's)
+  cp.repeat_census_regs_.clear();
+  const auto full = [&](VCP::LeanReason reason) {
+    ++stats.reasons[reason];
+    ++c.reasons[reason];
+    cp.repeat_dirty_ = dirty;
+    return R::kFull;
+  };
+  if (!cp.native_->truth() || !REXCVAR_GET(gpu_native_lean) ||
+      (cp.render_target_cache_->GetPath() != RenderTargetCache::Path::kPixelShaderInterlock &&
+       !REXCVAR_GET(gpu_native_truth_host_rt)) ||
+      cp.anatomy_active_ || cp.gpu_marks_active_ || cp.recstats_frames_ > 0 || cp.skip_frame_draws_ || cp.rename_.active ||
+      cp.hide_hud_after_pass_ || !cp.chain_probe_shaders_.empty() || cp.debug_skip_vertex_shader_hash_ ||
+      cp.DrawProbeActive() || cp.native_->CoverStatsActive() || !cp.lean_mode_ok_) {
+    return R::kPass;  // (the stock path logs which mode)
+  }
+  // A restore attempt, counted (why it did not happen: switch off, outside write, no base with this state / these shaders).
+  const auto try_restore = [&]() {
+    if (!multi_base) {
+      ++c.restore_off;
+      return false;
+    }
+    if (outside_written) {
+      ++c.restore_outside;
+      return false;
+    }
+    if (cp.LeanRestoreBase(uint32_t(prim_type), major_mode_explicit, /*allow_cross_frame=*/true)) return true;
+    ++c.restore_miss;
+    uint32_t held = 0;
+    for (const auto& e : cp.lean_bases_) held += (e.frame == cp.frame_current_ && e.draw) ? 1 : 0;
+    c.restore_ring_full += held == cp.lean_bases_.size() ? 1 : 0;
+    return false;
+  };
+  if (!cp.lean_.valid) {
+    if (!try_restore()) {
+      return full(VCP::kLeanNoBase);
+    }
+    restored = true;
+    ++c.restored;
+  }
+  // Only constants since the base: its render state holds - or the render state was re-sent with the base's values.
+  if (!restored && (dirty & (VCP::kRepeatDirtyOther | VCP::kRepeatDirtyPacket))) {
+    const uint32_t* now = cp.DrawRegs().values;  // (the record's image in the record-fed variant)
+    constexpr uint32_t kDma = 0x21FA - 0x2000, kAfter = 0x21FD - 0x2000;  // VGT_DMA_BASE .. VGT_DRAW_INITIATOR
+    if ((dirty & (VCP::kRepeatDirtyPacket | VCP::kRepeatDirtyOtherOutside)) ||
+        std::memcmp(now + 0x2000, cp.lean_regs_.data(), kDma * sizeof(uint32_t)) != 0 ||
+        std::memcmp(now + 0x2000 + kAfter, cp.lean_regs_.data() + kAfter, (0x400 - kAfter) * sizeof(uint32_t)) != 0) {
+      if (!try_restore()) {
+        // (Census, log only: which render-state registers differ from the base's - what the restore key is made of.)
+        ++c.dirty_misses;
+        if (dirty & (VCP::kRepeatDirtyPacket | VCP::kRepeatDirtyOtherOutside)) ++c.dirty_outside;
+        for (uint32_t r = 0; r < 0x400; ++r) {
+          if (r >= kDma && r < kAfter) continue;
+          if (now[0x2000 + r] != cp.lean_regs_[r]) ++c.diff_regs[r];
+        }
+        return full(VCP::kLeanDirty);
+      }
+      restored = true;
+      ++c.restored;
+    } else {
+      ++stats.same_values;
+      ++c.same_values;
+    }
+  }
+  auto vertex_shader = static_cast<VulkanShader*>(cp.active_vertex_shader());
+  if (!vertex_shader || vertex_shader != cp.lean_.active_vertex_shader ||
+      cp.active_pixel_shader() != cp.lean_.active_pixel_shader || uint32_t(prim_type) != cp.lean_.prim_type ||
+      major_mode_explicit != cp.lean_.major_mode_explicit) {
+    // (Session 87 stage 3) Other shaders / primitive with the same render state: an earlier base of this frame may hold
+    // exactly this pair (LeanRestoreBase compares the state, the shaders, the primitive and the mode).
+    if (restored || !vertex_shader || !try_restore()) {
+      return full(VCP::kLeanShader);
+    }
+    restored = true;
+    ++c.restored;
+    ++c.restored_for_shaders;
+  }
+  if ((cp.pipeline_cache_->NativeSpec().endian || cp.lean_.vertex_endian_key) &&
+      cp.pipeline_cache_->GetVertexFetchEndianKey(*vertex_shader) != cp.lean_.vertex_endian_key) {
+    return full(VCP::kLeanShader);
+  }
+  if (cp.pipeline_cache_->PixelSpecKeyChanged(cp.lean_.pixel_shader, cp.lean_.pixel_spec_key) ||
+      cp.pipeline_cache_->VertexMulKeyChanged(cp.lean_.vertex_mul_key) ||
+      cp.pipeline_cache_->NativeExtStale(cp.lean_.pixel_ext, cp.lean_.vertex_ext, cp.lean_.pixel_shader, vertex_shader)) {
+    return full(VCP::kLeanShader);
+  }
+  // (Session 87, stage 3, gpu_native_lean_state_cache) The base is an earlier frame's: its frame-independent description
+  // stands, its claim does not. Verify mode hands the draw to the full path and compares what that derives with it.
+  const bool cross_frame = restored && cp.lean_restore_cross_;
+  if (cross_frame) {
+    ++c.cross_restores;
+    if (REXCVAR_GET(gpu_native_lean_state_cache_verify)) {
+      cp.lean_verify_snapshot_ = cp.lean_;
+      if (!cp.native_lean_verify_draw_) cp.native_lean_verify_draw_ = std::make_unique<native::Draw>();
+      *cp.native_lean_verify_draw_ = *cp.native_repeat_draw_;
+      cp.lean_verify_pending_ = true;
+      cp.lean_verify_cache_ = true;
+      ++c.cache_verify_handbacks;
+      return full(VCP::kLeanVerify);
+    }
+  }
+  // The page-validity epoch of this draw: read before anything of it is requested (a later invalidation ends a stamp).
+  const uint64_t repeat_epoch = cp.shared_memory_->repeat_epoch();
+  // A repeat (only vertex float constants, the same draw parameters): the repeat path, as IssueDraw takes it.
+  if (REXCVAR_GET(vulkan_repeat_draw_fast) && cp.repeat_prev_.valid &&
+      !(dirty & ~uint32_t(VCP::kRepeatDirtyVsFloat)) &&
+      cp.RepeatIsSameDraw(vertex_shader, uint32_t(prim_type), index_count, index_buffer_info, major_mode_explicit,
+                          repeat_epoch)) {
+    cp.repeat_dirty_ = 0;
+    ++cp.repeat_fast_stats_.candidates;
+    cp.repeat_refusal_ = 0;
+    if (cp.RepeatDrawFast(vertex_shader, repeat_epoch)) {
+      if (cp.vertex_census_on_) [[unlikely]] {
+        cp.VertexCensusDraw(*vertex_shader, cp.repeat_prev_.spec_pixel_shader, VCP::kVertexCensusRepeat,
+                            cp.vertex_census_last_type_, 1);
+      }
+      ++stats.reasons[VCP::kLeanRepeat];
+      ++c.repeats;
+      succeeded = true;
+      return R::kTaken;
+    }
+    cp.repeat_prev_.valid = false;
+    ++c.repeat_refused[std::min<uint32_t>(cp.repeat_refusal_, 23)];
+    return full(VCP::kLeanRepeat);
+  }
+  if (!cp.native_repeat_draw_valid_ || !cp.native_repeat_draw_ || !cp.native_repeat_draw_->truth ||
+      !cp.native_repeat_draw_->owned || cp.native_repeat_draw_->pipeline == VK_NULL_HANDLE) {
+    return full(VCP::kLeanNoBase);
+  }
+  cp.repeat_dirty_ = 0;
+  VulkanShader* const pixel_shader = cp.lean_.pixel_shader;
+  const ui::vulkan::VulkanDevice::Properties& device_properties = cp.GetVulkanDevice()->properties();
+  cp.memexport_ranges_.clear();
+
+  if (!cp.BeginSubmission(true)) {
+    succeeded = false;
+    return R::kTaken;
+  }
+  VCP::CrashCheckpointRecord* crash_record = nullptr;
+  if (cp.crash_checkpoints_enabled()) {
+    crash_record = cp.BeginCrashCheckpointRecord();
+    cp.InsertCrashCheckpoint(*crash_record, VCP::CrashCheckpointPhase::kDrawPrepare);
+  }
+  PrimitiveProcessor::ProcessingResult primitive_processing_result;
+  if (own) {
+    // The record-fed variant: the draw's words from the DRAW item, the four render state registers from the image.
+    PrimitiveProcessor::DrawInput process_input = PrimitiveProcessor::DrawInput::FromRegisters(cp.DrawRegs());
+    process_input.draw_initiator.value = item.initiator;
+    process_input.dma_size.value = item.dma_size;
+    process_input.dma_base = item.dma_base;
+    if (!cp.primitive_processor_->Process(primitive_processing_result, process_input)) {
+      return full(VCP::kLeanPrimitive);
+    }
+  } else if (!cp.primitive_processor_->Process(primitive_processing_result)) {
+    return full(VCP::kLeanPrimitive);
+  }
+  if (!primitive_processing_result.host_draw_vertex_count) {
+    cp.anatomy_skip_reason_ = VCP::kAnatomySkipNoVertices;
+    cp.lean_.valid = false;
+    cp.repeat_prev_.valid = false;
+    ++stats.reasons[VCP::kLeanTaken];
+    succeeded = true;
+    return R::kTaken;
+  }
+  if (primitive_processing_result.host_vertex_shader_type != cp.lean_.host_vertex_shader_type ||
+      primitive_processing_result.host_primitive_reset_enabled != cp.lean_.host_primitive_reset_enabled ||
+      primitive_processing_result.host_primitive_type != cp.lean_.host_primitive_type) {
+    return full(VCP::kLeanPrimitive);
+  }
+  const bool shader_32bit_index_dma =
+      !device_properties.fullDrawIndexUint32 &&
+      primitive_processing_result.index_buffer_type == PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA &&
+      index_buffer_info->format == xenos::IndexFormat::kInt32 &&  // (the draw's VGT_DRAW_INITIATOR.index_size)
+      primitive_processing_result.host_vertex_shader_type == Shader::HostVertexShaderType::kVertex;
+  if (shader_32bit_index_dma) {
+    return full(VCP::kLeanPrimitive);
+  }
+
+  // Samplers: the parameters again only when fetch constants changed (they come from the texture fetch constants);
+  // UseSampler every time (the submission may be another one).
+  for (uint32_t j = 0; j < 2; ++j) {
+    std::vector<std::pair<VulkanTextureCache::SamplerParameters, VkSampler>>& shader_samplers =
+        j ? cp.current_samplers_pixel_ : cp.current_samplers_vertex_;
+    const VulkanShader* shader = j ? pixel_shader : vertex_shader;
+    if (!shader) {
+      continue;
+    }
+    // (Session 87, pixel skip: the list is the one of the translation the base draw's native ext picks; rebuilt too when the pixel
+    // samplers in hand were made from the other one.)
+    const bool replacement_list = j ? cp.pipeline_cache_->UsesReplacementBindings(pixel_shader, cp.lean_.pixel_ext)
+                                    : cp.pipeline_cache_->UsesReplacementBindings(vertex_shader, cp.lean_.vertex_ext);
+    bool& held_replacement = j ? shader_swap::PixelSamplersReplacement() : shader_swap::VertexSamplersReplacement();
+    if ((dirty & VCP::kRepeatDirtyFetch) || restored || held_replacement != replacement_list) {
+      const std::vector<VulkanShader::SamplerBinding>& bindings = shader->SamplerBindingsFor(replacement_list);
+      held_replacement = replacement_list;
+      shader_samplers.clear();
+      shader_samplers.reserve(bindings.size());
+      for (const VulkanShader::SamplerBinding& binding : bindings) {
+        ++cp.frame_counters_.sampler_parameters;
+        shader_samplers.emplace_back(cp.texture_cache_->GetSamplerParameters(binding), VK_NULL_HANDLE);
+      }
+    }
+    for (std::pair<VulkanTextureCache::SamplerParameters, VkSampler>& pair : shader_samplers) {
+      bool overflowed;
+      pair.second = cp.texture_cache_->UseSampler(pair.first, overflowed);
+      if (pair.second == VK_NULL_HANDLE) {
+        cp.lean_.valid = false;
+        return full(VCP::kLeanSampler);
+      }
+    }
+  }
+  cp.native_->TruthServeBegin();
+  cp.texture_cache_->RequestTextures(cp.lean_.used_texture_mask);
+  cp.native_->TruthServeEnd();
+  if (cp.native_->segment_log_active()) cp.NativeLogDrawTextures(cp.lean_.used_texture_mask);
+
+  const VCP::PipelineLayout* const pipeline_layout = cp.lean_.layout;
+  if (!pipeline_layout) {
+    return full(VCP::kLeanShader);
+  }
+  if (cp.current_guest_graphics_pipeline_layout_ != pipeline_layout) {
+    if (!cp.current_guest_graphics_pipeline_layout_) {
+      cp.current_graphics_descriptor_sets_bound_up_to_date_ = 0;
+    }
+    cp.current_guest_graphics_pipeline_layout_ = pipeline_layout;
+  }
+  cp.UpdateSystemConstantValues(cp.lean_.primitive_polygonal, primitive_processing_result, false, 0,
+                                cp.lean_.viewport_info, cp.lean_.used_texture_mask, cp.lean_.normalized_depth_control,
+                                cp.lean_.normalized_color_mask);
+  if (!cp.UpdateBindings(vertex_shader, pixel_shader)) {
+    succeeded = false;
+    cp.lean_.valid = false;
+    cp.repeat_prev_.valid = false;
+    ++stats.reasons[VCP::kLeanTaken];
+    return R::kTaken;
+  }
+
+  // The vertex buffers: the stock lean loop, with the stamp in front of RequestRange (row 8).
+  const Shader::ConstantRegisterMap& constant_map_vertex = vertex_shader->constant_register_map();
+  const RegisterFile& regs = cp.DrawRegs();  // (the record's image in the record-fed variant)
+  const bool verify = REXCVAR_GET(gpu_d3d_direct_verify);
+  for (uint32_t i = 0; i < rex::countof(constant_map_vertex.vertex_fetch_bitmap); ++i) {
+    uint32_t vfetch_bits_remaining = constant_map_vertex.vertex_fetch_bitmap[i];
+    uint32_t j;
+    while (bit_inline::bit_scan_forward(vfetch_bits_remaining, &j)) {
+      vfetch_bits_remaining &= ~(uint32_t(1) << j);
+      const uint32_t vfetch_index = i * 32 + j;
+      const uint64_t vfetch_bit = uint64_t(1) << (vfetch_index & 63);
+      if ((cp.vertex_buffers_in_sync_[vfetch_index >> 6] & vfetch_bit) && !cp.lean_residency_cache_off_) {
+        const VCP::VertexBufferState& in_sync_state = cp.vertex_buffer_states_[vfetch_index];
+        cp.shared_memory_->MarkHoistAccess(in_sync_state.address << 2, in_sync_state.size << 2);
+        continue;
+      }
+      const xenos::xe_gpu_vertex_fetch_t vfetch_constant = regs.GetVertexFetch(vfetch_index);
+      if (vfetch_constant.type != xenos::FetchConstantType::kVertex) {
+        cp.lean_.valid = false;
+        return full(VCP::kLeanMode);
+      }
+      VCP::VertexBufferState& state = cp.vertex_buffer_states_[vfetch_index];
+      if (state.address == vfetch_constant.address && state.size == vfetch_constant.size &&
+          !cp.lean_residency_cache_off_) {
+        cp.vertex_buffers_in_sync_[vfetch_index >> 6] |= vfetch_bit;
+        cp.shared_memory_->MarkHoistAccess(vfetch_constant.address << 2, vfetch_constant.size << 2);
+        cp.shared_memory_->CheckSkipped(vfetch_constant.address << 2, vfetch_constant.size << 2);
+        if (cp.shared_memory_->ram_stats_on()) {
+          SharedMemory::RamReaderScope ram_reader(*cp.shared_memory_, SharedMemory::RamReader::kVertex);
+          const std::pair<uint32_t, uint32_t> range(vfetch_constant.address << 2, vfetch_constant.size << 2);
+          cp.shared_memory_->RamCountRequest(&range, 1);
+        }
+        continue;
+      }
+      const uint32_t range_start = vfetch_constant.address << 2;
+      const uint32_t range_length = vfetch_constant.size << 2;
+      RangeStamp& stamp = g_stamps[vfetch_index];
+      if (stamp.epoch == repeat_epoch && stamp.address == vfetch_constant.address && stamp.size == vfetch_constant.size) {
+        // The fetch constant and the page-validity epoch equal what this range was last requested (successfully) under:
+        // no page stopped being valid and no watch fired since, so it still holds. Replayed: what the stock in-sync
+        // branch does for a range it knows is valid.
+        if (verify && !cp.shared_memory_->IsRangeUpToDate(range_start, range_length)) {
+          ++c.range_mismatches;
+          if (c.mismatch_logged < 16) {
+            ++c.mismatch_logged;
+            REXGPU_WARN("[d3d][direct] vertex range stamp mismatch (frame {}): fetch slot {} range 0x{:08X} + 0x{:X} is not "
+                        "up to date at epoch {}",
+                        cp.frame_current_, vfetch_index, range_start, range_length, repeat_epoch);
+          }
+          stamp.epoch = UINT64_MAX;  // (requested for real below)
+        } else {
+          ++c.range_hits;
+          state.address = vfetch_constant.address;
+          state.size = vfetch_constant.size;
+          cp.vertex_buffers_in_sync_[vfetch_index >> 6] |= vfetch_bit;
+          cp.shared_memory_->MarkHoistAccess(range_start, range_length);
+          cp.shared_memory_->CheckSkipped(range_start, range_length);
+          if (cp.shared_memory_->ram_stats_on()) {
+            SharedMemory::RamReaderScope ram_reader(*cp.shared_memory_, SharedMemory::RamReader::kVertex);
+            const std::pair<uint32_t, uint32_t> range(range_start, range_length);
+            cp.shared_memory_->RamCountRequest(&range, 1);
+          }
+          continue;
+        }
+      }
+      SharedMemory::RamReaderScope ram_reader(*cp.shared_memory_, SharedMemory::RamReader::kVertex);
+      ++c.range_requests;
+      if (!cp.shared_memory_->RequestRange(range_start, range_length)) {
+        REXGPU_ERROR("Failed to request vertex buffer at 0x{:08X} (size {}) in the shared memory", range_start,
+                     range_length);
+        stamp.epoch = UINT64_MAX;
+        succeeded = false;
+        cp.lean_.valid = false;
+        cp.repeat_prev_.valid = false;
+        ++stats.reasons[VCP::kLeanTaken];
+        return R::kTaken;
+      }
+      stamp.address = vfetch_constant.address;
+      stamp.size = vfetch_constant.size;
+      stamp.epoch = repeat_epoch;
+      state.address = vfetch_constant.address;
+      state.size = vfetch_constant.size;
+      cp.vertex_buffers_in_sync_[vfetch_index >> 6] |= vfetch_bit;
+    }
+  }
+  // A pixel shader's vertex fetches: every page counts as accessed in this submission.
+  if (cp.lean_.pixel_shader_vertex_fetches) {
+    cp.shared_memory_->MarkHoistAccess(0, SharedMemory::kBufferSize);
+  }
+  cp.shared_memory_->Use(VulkanSharedMemory::Usage::kRead, {}, cp.lean_.shared_memory_access_stages);
+
+  const bool emulated_indexed =
+      primitive_processing_result.index_buffer_type != PrimitiveProcessor::ProcessedIndexBufferType::kNone;
+  std::pair<VkBuffer, VkDeviceSize> index_buffer = {VK_NULL_HANDLE, 0};
+  switch (primitive_processing_result.index_buffer_type) {
+    case PrimitiveProcessor::ProcessedIndexBufferType::kNone:
+      break;
+    case PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA:
+      index_buffer.first = cp.shared_memory_->buffer();
+      index_buffer.second = primitive_processing_result.guest_index_base;
+      break;
+    case PrimitiveProcessor::ProcessedIndexBufferType::kHostConverted:
+      index_buffer =
+          cp.primitive_processor_->GetConvertedIndexBuffer(primitive_processing_result.host_index_buffer_handle);
+      break;
+    case PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForAuto:
+    case PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForDMA:
+      index_buffer =
+          cp.primitive_processor_->GetBuiltinIndexBuffer(primitive_processing_result.host_index_buffer_handle);
+      break;
+    default:
+      return full(VCP::kLeanPrimitive);
+  }
+  const VkIndexType index_type = primitive_processing_result.host_index_format == xenos::IndexFormat::kInt16
+                                     ? VK_INDEX_TYPE_UINT16
+                                     : VK_INDEX_TYPE_UINT32;
+
+  // The base's native draw with this draw's own bindings, buffers and counts, claimed as the base was.
+  if (!cp.native_lean_draw_) cp.native_lean_draw_ = std::make_unique<native::Draw>();
+  native::Draw& native_draw = *cp.native_lean_draw_;
+  native_draw = *cp.native_repeat_draw_;
+  native_draw.restore = false;
+  std::copy(std::begin(cp.current_graphics_descriptor_sets_), std::end(cp.current_graphics_descriptor_sets_),
+            native_draw.sets);
+  native_draw.sets_bound = cp.native_sets_needed_;
+  {
+    uint32_t offset_count = 0;
+    const uint32_t* offsets = cp.D3dDirectDynamicOffsets(offset_count);
+    if (offsets) {
+      std::copy(offsets, offsets + offset_count, native_draw.dynamic_offsets);
+      native_draw.dynamic_offset_count = offset_count;
+    }
+  }
+  native_draw.occlusion_query = cp.active_occlusion_query_.valid;
+  native_draw.vertex_count = primitive_processing_result.host_draw_vertex_count;
+  native_draw.instance_count = 1;
+  native_draw.indexed = emulated_indexed;
+  native_draw.index_buffer = index_buffer.first;
+  native_draw.index_offset = index_buffer.second;
+  native_draw.index_type = index_type;
+  std::fill(std::begin(native_draw.cover), std::end(native_draw.cover), 0);
+  const bool cover_owned_step = pixel_shader && cp.native_->OwnedWantsCover(pixel_shader->ucode_data_hash());
+  if ((prim_type == xenos::PrimitiveType::kQuadList || prim_type == xenos::PrimitiveType::kRectangleList ||
+       (cover_owned_step && prim_type == xenos::PrimitiveType::kTriangleStrip)) &&
+      (cp.native_->TruthWantsCover() || cover_owned_step) &&
+      !cp.NativeCoverRect(prim_type, *vertex_shader, pixel_shader, native_draw.cover, cover_owned_step,
+                          index_buffer_info)) {
+    std::fill(std::begin(native_draw.cover), std::end(native_draw.cover), 0);
+  }
+  std::fill(std::begin(native_draw.bounds), std::end(native_draw.bounds), 0);
+  if (!native_draw.fast_clear && native_draw.xfb_buffer == VK_NULL_HANDLE && !native_draw.occlusion_query &&
+      !native_draw.memexport && cp.native_->TruthWantsBounds(vertex_shader->ucode_data_hash())) {
+    cp.NativeBoundsRect(prim_type, *vertex_shader, index_count, index_buffer_info, native_draw.bounds);
+  }
+  bool claimed;
+  if (cross_frame) {
+    // The cached description carries no claim: the draw is claimed as a fresh one (the images, the epoch, the pipeline).
+    native_draw.truth = native_draw.owned = native_draw.post = native_draw.declined = false;
+    native_draw.pipeline = VK_NULL_HANDLE;
+    native_draw.truth_color = native_draw.truth_depth = -1;
+    native_draw.truth_class = 1;
+    native_draw.truth_sx = native_draw.truth_sy = 1;
+    native_draw.truth_epoch = 0;
+    claimed = cp.native_->Claim(native_draw) && native_draw.truth && native_draw.owned &&
+              native_draw.pipeline != VK_NULL_HANDLE;  // (what ClaimTruthLean demands of a base's draw)
+    if (claimed) ++c.cross_claimed;
+  } else {
+    claimed = cp.native_->ClaimTruthLean(native_draw);
+  }
+  if (!claimed) {
+    return full(VCP::kLeanClaim);
+  }
+  if (cp.native_->census_active()) {
+    cp.native_->CensusDraw(vertex_shader->ucode_data_hash(), pixel_shader ? pixel_shader->ucode_data_hash() : 0, false);
+  }
+  if (cp.in_render_pass_) cp.EndRenderPass();
+  cp.SubmitBarriers(false);
+  if (crash_record) {
+    crash_record->vertex_shader_hash = vertex_shader->ucode_data_hash();
+    crash_record->pixel_shader_hash = pixel_shader ? pixel_shader->ucode_data_hash() : 0;
+    crash_record->guest_primitive_type = uint32_t(prim_type);
+    crash_record->host_primitive_type = uint32_t(primitive_processing_result.host_primitive_type);
+    crash_record->guest_index_count = index_count;
+    crash_record->host_vertex_count = primitive_processing_result.host_draw_vertex_count;
+    crash_record->index_buffer_type = uint32_t(primitive_processing_result.index_buffer_type);
+    crash_record->guest_index_base = primitive_processing_result.guest_index_base;
+    crash_record->edram_mode = uint32_t(xenos::EdramMode::kColorDepth);
+    crash_record->memexport_vertex = false;
+    crash_record->memexport_pixel = false;
+    crash_record->memexport_extent_start = UINT32_MAX;
+    crash_record->memexport_extent_end = 0;
+    crash_record->rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>().value;
+    crash_record->rb_color_info = regs[XE_GPU_REG_RB_COLOR_INFO];
+    crash_record->rb_depth_info = regs[XE_GPU_REG_RB_DEPTH_INFO];
+    cp.InsertCrashCheckpoint(*crash_record, VCP::CrashCheckpointPhase::kDraw);
+  }
+  ++cp.frame_counters_.draws_issued;
+  native_draw.own_skip_call = cp.own_crowd_skip_draw_;
+  cp.native_->OnDrawPre(native_draw);
+  cp.native_->OnDraw(native_draw);
+  cp.NativeStateTouched(!cp.native_->TakeTruthForeignBind());
+  *cp.native_repeat_draw_ = native_draw;
+  cp.native_repeat_draw_valid_ = true;
+  cp.RepeatNoteRecorded(vertex_shader, pixel_shader, uint32_t(prim_type), index_count, index_buffer_info,
+                        major_mode_explicit, repeat_epoch, false, emulated_indexed,
+                        primitive_processing_result.host_draw_vertex_count);
+  cp.repeat_prev_.crash_valid = crash_record != nullptr;
+  if (crash_record) cp.repeat_prev_.crash = *crash_record;
+  cp.repeat_prev_.merge_stride = cp.lean_.merge_stride;
+  cp.repeat_prev_.float_count = cp.lean_.float_count;
+  cp.repeat_prev_.vertex_endian_key = cp.lean_.vertex_endian_key;
+  cp.repeat_prev_.spec_pixel_shader = pixel_shader;
+  cp.repeat_prev_.pixel_spec_key = cp.lean_.pixel_spec_key;
+  cp.repeat_prev_.vertex_mul_key = cp.lean_.vertex_mul_key;
+  cp.repeat_prev_.pixel_ext = cp.lean_.pixel_ext;
+  cp.repeat_prev_.vertex_ext = cp.lean_.vertex_ext;
+  if (cp.vertex_census_on_) [[unlikely]] {
+    cp.VertexCensusDraw(*vertex_shader, pixel_shader, VCP::kVertexCensusLean, uint32_t(cp.lean_.host_vertex_shader_type), 1);
+  }
+  cp.RepeatStartRun();
+  cp.AfterPostChainCheck(*vertex_shader);
+  ++stats.reasons[VCP::kLeanTaken];
+  succeeded = true;
+  return R::kTaken;
+}
