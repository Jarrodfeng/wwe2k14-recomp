+uint32_t GetNormalizedColorMask(reg::RB_MODECONTROL modecontrol, uint32_t color_mask, const reg::RB_COLOR_INFO color_info[4],
+                                uint32_t pixel_shader_writes_color_targets) {
+  if (modecontrol.edram_mode != xenos::EdramMode::kColorDepth) {
+    return 0;
+  }
+  uint32_t normalized_color_mask = 0;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!(pixel_shader_writes_color_targets & (uint32_t(1) << i))) {
+      continue;
+    }
+    uint32_t format_component_mask = (uint32_t(1) << xenos::GetColorRenderTargetFormatComponentCount(color_info[i].color_format)) - 1;
+    uint32_t rt_write_mask = (color_mask >> (4 * i)) & format_component_mask;
+    if (!rt_write_mask) {
+      continue;
+    }
+    rt_write_mask |= 0b1111 & ~format_component_mask;
+    normalized_color_mask |= rt_write_mask << (4 * i);
+  }
+  return normalized_color_mask;
+}
