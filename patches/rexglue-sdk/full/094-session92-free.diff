+                Scissor& scissor_out, bool clamp_to_surface_pitch) {
+  int32_t tl_x = int32_t(window_tl.tl_x);
+  int32_t tl_y = int32_t(window_tl.tl_y);
+  int32_t br_x = int32_t(window_br.br_x);
+  int32_t br_y = int32_t(window_br.br_y);
+  if (!window_tl.window_offset_disable) {
+    tl_x += window_offset.window_x_offset;
+    tl_y += window_offset.window_y_offset;
+    br_x += window_offset.window_x_offset;
+    br_y += window_offset.window_y_offset;
+  }
+  tl_x = std::max(tl_x, int32_t(screen_tl.tl_x));
+  tl_y = std::max(tl_y, int32_t(screen_tl.tl_y));
+  br_x = std::min(br_x, int32_t(screen_br.br_x));
+  br_y = std::min(br_y, int32_t(screen_br.br_y));
+  if (clamp_to_surface_pitch) {
+    tl_x = std::min(tl_x, int32_t(surface_pitch));
+    br_x = std::min(br_x, int32_t(surface_pitch));
+  }
+  tl_x = std::max(tl_x, int32_t(0));
+  tl_y = std::max(tl_y, int32_t(0));
+  br_x = std::max(br_x, tl_x);
+  br_y = std::max(br_y, tl_y);
+  scissor_out.offset[0] = uint32_t(tl_x);
+  scissor_out.offset[1] = uint32_t(tl_y);
+  scissor_out.extent[0] = uint32_t(br_x - tl_x);
