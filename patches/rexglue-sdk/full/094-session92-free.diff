+}  // namespace rex::graphics::vulkan
+
+// =================================================================================================================================
+// M4e (gpu_d3d_owned_front bit 4): the shadow compares of the clear / resolve / inline records.
+namespace rex::graphics::vulkan {
+
+namespace {
+
+CopyEntry* FindCopy(uint32_t kind, const uint32_t* sem, uint32_t count) {
+  // The executor is given the record's words only: matched by kind, size and content, the oldest unused first (the decoder ran ahead in order).
+  for (uint32_t i = 0; i < g_copy_n; ++i) {
+    CopyEntry& e = g_copy[i];
+    if (e.used || e.kind != kind || e.count != count) continue;
+    if (std::memcmp(e.sem, sem, size_t(count) * sizeof(uint32_t)) == 0) return &e;
+  }
+  return nullptr;
+}
+
+void NoteClear(const CopyEntry& e, uint32_t f, uint32_t old_v, uint32_t typed_v) {
+  ++g_e.clear_by_field[f];
+  if (!g_cf_logged[f] && g_e_logged < 48) {
+    g_cf_logged[f] = true;
+    ++g_e_logged;
+    REXGPU_INFO("[d3d][front] M4e clear mismatch #{}: {} old {:08X} typed {:08X} (record seq {}, flags {:X}, pass rt {:X})", g_e_logged, kCfNames[f], old_v,
+                typed_v, e.seq, e.sem[0], e.sem[d3d_clear_sem::kPassRt]);
+  }
+}
+void NoteResolve(const CopyEntry& e, uint32_t f, uint32_t old_v, uint32_t typed_v) {
+  ++g_e.resolve_by_field[f];
+  if (!g_rf_logged[f] && g_e_logged < 48) {
+    g_rf_logged[f] = true;
+    ++g_e_logged;
+    REXGPU_INFO("[d3d][front] M4e resolve mismatch #{}: {} M3 word {:08X} typed {:08X} (record seq {}, copy control {:08X})", g_e_logged, kRfNames[f], old_v,
+                typed_v, e.seq, e.sem[d3d_resolve_sem::kCopyControl]);
+  }
+}
+
+}  // namespace
+
+void OwnedRecordClearShadow(const uint32_t* sem, uint32_t count, const OwnedClearOld& o) {
+  using namespace d3d_clear_sem;
+  const uint64_t t0 = NowNs();
+  CopyEntry* e = FindCopy(kD3dCopyClear, sem, count);
+  if (!e || count < kDwords) {
+    ++g_e.clears_unpaired;
+    g_e.ns += NowNs() - t0;
+    return;
+  }
+  e->used = true;
+  ++g_e.clears_compared;
+  bool any = false;
+  const auto cmp = [&](uint32_t f, uint32_t old_v, uint32_t typed_v) {
+    if (old_v != typed_v) {
+      any = true;
+      NoteClear(*e, f, old_v, typed_v);
+    }
+  };
+  // The clear the typed state + the record describe (what NativeRenderer::D3dClear reads, and the fill the stock draw stands for).
+  const uint32_t flags = sem[kFlags];
+  const bool depth = (flags & 0x10) != 0, stencil = (flags & 0x20) != 0;
+  const bool colour = sem[kPassRt] != 0xFFFFFFFFu;
+  const uint32_t msaa = (sem[kSurfaceInfo] >> 16) & 3;
+  cmp(kCfSurface, o.surface_info, sem[kSurfaceInfo]);
+  // (the colour target is part of the effect only when colour is written: a depth-only clear's RB_COLOR_INFO is not a target)
+  const bool old_depth_only = (o.mode_control & 7u) == uint32_t(xenos::EdramMode::kDepthOnly);
+  const uint32_t old_colour_mask = old_depth_only ? 0u : (o.color_mask & 0xFu);
+  cmp(kCfColorWrite, old_colour_mask, colour ? 0xFu : 0u);
+  cmp(kCfColorInfo, old_colour_mask ? o.color_info : 0u, colour ? sem[kColorInfo] : 0u);
+  // (a clear that clears neither depth nor stencil leaves RB_DEPTH_INFO as the state had it: the typed state's, as of the record)
+  cmp(kCfDepthInfo, o.depth_info, (depth || stencil) ? sem[kDepthInfo] : e->depth_info);
+  cmp(kCfDepthControl, o.depth_control, (depth ? 0x76u : 0u) | (stencil ? 0x8701u : 0u));
+  cmp(kCfStencil, stencil ? (o.stencil_refmask & 0xFFu) : 0u, stencil ? (sem[kStencil] & 0xFFu) : 0u);
+  cmp(kCfMode, o.mode_control & 7u, uint32_t(colour ? xenos::EdramMode::kColorDepth : xenos::EdramMode::kDepthOnly));
+  cmp(kCfAa, o.aa_config, msaa == 0 ? 0u : msaa == 1 ? 0x8001u : 0xC003u);
+  cmp(kCfVtxCntl, o.vtx_cntl & 1u, sem[kVtxCntl] & 1u);
+  // The rectangle the three staged vertices stand for (l,t) (r,t) (r,b), less the half pixel the vertex rounding adds back.
+  {
+    const auto rounded = [&](uint32_t bits) {
+      float v;
+      std::memcpy(&v, &bits, sizeof(v));
+      return int32_t(std::lround(v + ((o.vtx_cntl & 1) ? 0.0f : 0.5f)));
+    };
+    const int32_t old_rect[4] = {rounded(o.vertex[0][0]), rounded(o.vertex[0][1]), rounded(o.vertex[1][0]), rounded(o.vertex[2][1])};
+    bool differs = false;
+    for (uint32_t i = 0; i < 4; ++i) differs |= uint32_t(old_rect[i]) != sem[kRect + i];
+    if (differs) {
+      any = true;
+      NoteClear(*e, kCfRect, uint32_t(old_rect[0]) ^ uint32_t(old_rect[1]) ^ uint32_t(old_rect[2]) ^ uint32_t(old_rect[3]),
+                sem[kRect] ^ sem[kRect + 1] ^ sem[kRect + 2] ^ sem[kRect + 3]);
+    }
+  }
+  cmp(kCfDepthValue, o.vertex[0][2], depth ? sem[kDepth] : 0u);
+  {
+    bool differs = false;
+    for (uint32_t v = 0; v < 3; ++v) {
+      for (uint32_t i = 0; i < 4; ++i) differs |= o.vertex[v][3 + i] != sem[kColor + i];
+    }
+    if (differs) {
+      any = true;
+      NoteClear(*e, kCfColorValue, o.vertex[0][3], sem[kColor]);
+    }
+  }
+  if (any) ++g_e.clear_mismatch_records;
+  g_e.ns += NowNs() - t0;
+}
+
+void OwnedRecordResolveShadow(const uint32_t* sem, uint32_t count, const OwnedResolveOld& o) {
+  namespace rs = d3d_resolve_sem;
+  const uint64_t t0 = NowNs();
+  CopyEntry* e = FindCopy(kD3dCopyResolve, sem, count);
+  if (!e || count < rs::kDwords) {
+    ++g_e.resolves_unpaired;
+    g_e.ns += NowNs() - t0;
+    return;
+  }
+  e->used = true;
+  ++g_e.resolves_compared;
+  bool any = false;
+  const auto cmp = [&](uint32_t f, uint32_t old_v, uint32_t typed_v) {
+    if (old_v != typed_v) {
+      any = true;
+      NoteResolve(*e, f, old_v, typed_v);
+    }
+  };
+  // The typed view of the words M3 feeds IssueCopyFrom: the surface / colour / depth info and the vertex rounding as the typed state holds them after
+  // the record; the copy registers (RB_COPY_*) are no state field: the record's own words; the mode is the library's copy mode.
+  const uint32_t src = sem[rs::kCopyControl] & 7u;
+  cmp(kRfCopyControl, o.copy_control, sem[rs::kCopyControl]);
+  cmp(kRfDestBase, o.dest_base, sem[rs::kDestBase]);
+  cmp(kRfDestPitch, o.dest_pitch, sem[rs::kDestPitch]);
+  cmp(kRfDestInfo, o.dest_info, sem[rs::kDestInfo]);
+  cmp(kRfSurface, o.surface_info, e->surface_info);
+  if (src < 4) {
+    cmp(kRfColorInfo, o.color_info, e->color_info);
+  } else {
+    ++g_e.resolve_depth_source;  // a depth resolve: the state holds no colour info for it (the old path writes none either)
+  }
+  cmp(kRfDepthInfo, o.depth_info, e->depth_info);
+  cmp(kRfMode, o.mode_control, uint32_t(xenos::EdramMode::kCopy));
+  cmp(kRfVtxCntl, o.vtx_cntl, e->su_vtx_cntl);
+  if (any) ++g_e.resolve_mismatch_records;
+  g_e.ns += NowNs() - t0;
+}
+
+void OwnedRecordInlineBegin(uint32_t sequence, uint32_t viz_query, uint32_t initiator, uint32_t fetch_word4, uint32_t fetch_word5) {
+  g_snap_cur = nullptr;
+  InlineSnap* hit = nullptr;
+  bool replay = false;
+  for (uint32_t i = g_inl_n; i-- > 0;) {
+    InlineSnap& is = g_inl[i];
+    if (is.seq != sequence) continue;
+    if (is.used) {
+      replay = true;
+    } else {
+      hit = &is;
+      break;
+    }
+  }
+  if (!hit) {
+    ++(replay ? g_e.inl_replays : g_e.inl_unpaired);
+    return;
+  }
+  hit->used = true;
+  if (hit->s.draw_viz_query != viz_query || hit->s.draw_initiator.value != initiator) {
+    ++g_e.inl_desync;
+    return;
+  }
+  hit->s.fetch[190] = fetch_word4;  // slot 31 words 4-5: the old path's own staging address and size, taken as an input
+  hit->s.fetch[191] = fetch_word5;
+  ++g_e.inl_paired;
+  g_snap_cur = &hit->s;
+}
+
+void OwnedRecordInlineEnd() { g_snap_cur = nullptr; }
+
+std::string OwnedRecordM4eSummary(uint64_t frames) {
+  const M4eWindow& w = g_e;
+  const auto top = [](const char* const* names, const uint64_t* counts, uint32_t n) {
+    std::string out;
+    uint32_t order[16];
+    for (uint32_t i = 0; i < n; ++i) order[i] = i;
+    std::sort(order, order + n, [&](uint32_t a, uint32_t b) { return counts[a] > counts[b]; });
+    for (uint32_t k = 0; k < 8 && k < n && counts[order[k]]; ++k) {
+      out += (out.empty() ? "" : ", ") + std::string(names[order[k]]) + " " + std::to_string(counts[order[k]]);
+    }
+    return out.empty() ? std::string("none") : out;
+  };
+  char buf[1600];
+  std::snprintf(buf, sizeof buf,
+                "clears paired %llu of %llu decoded (real tests: depth_info when no depth/stencil is cleared, colour written / color_info, mode compared; the other fields are the same record words on both sides; records with a mismatch %llu: %s; no pair %llu, executor never reached %llu); "
+                "resolves paired %llu of %llu decoded (coverage: the old fields are the record words the decoder stored; mismatches %llu: %s; no pair %llu, never reached %llu; depth-source resolves, colour info not compared %llu); "
+                "inline records decoded %llu, snapshots %llu (past the cap %llu), paired with the old path's draw %llu, tiling replays (snapshot already used) %llu, no snapshot %llu, "
+                "desync %llu; clear+resolve compare %.1f us a frame",
+                (unsigned long long)w.clears_compared, (unsigned long long)w.clears_decoded, (unsigned long long)w.clear_mismatch_records,
+                top(kCfNames, w.clear_by_field, kCfCount).c_str(), (unsigned long long)w.clears_unpaired, (unsigned long long)w.clears_never_run,
+                (unsigned long long)w.resolves_compared, (unsigned long long)w.resolves_decoded, (unsigned long long)w.resolve_mismatch_records,
+                top(kRfNames, w.resolve_by_field, kRfCount).c_str(), (unsigned long long)w.resolves_unpaired, (unsigned long long)w.resolves_never_run,
+                (unsigned long long)w.resolve_depth_source, (unsigned long long)w.inl_decoded, (unsigned long long)w.inl_taken,
+                (unsigned long long)w.inl_overflow, (unsigned long long)w.inl_paired, (unsigned long long)w.inl_replays, (unsigned long long)w.inl_unpaired,
+                (unsigned long long)w.inl_desync, double(w.ns) / 1000.0 / double(frames ? frames : 1));
+  g_e = M4eWindow{};
+  return buf;
+}
+
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/native/owned_record.h b/src/graphics/vulkan/native/owned_record.h
new file mode 100644
index 0000000000000000000000000000000000000000..4945a8c22102b460e3bfac8d99fe7be807b4407b
--- /dev/null
+++ b/src/graphics/vulkan/native/owned_record.h
@@ -0,0 +1,205 @@
+// wwe2k14 patch (Session 92, M4a; docs\native\d3d\S92_M3_M5_DESIGN.md section 2): the record decoder's typed state.
+//
+// The record-fed front end of the owned frame reads the D3D layer's record in host order straight from the queue storage and
+// decodes it into THIS state: typed fields (the `reg::` bit layouts are the data format of the game's words) plus the arrays our
+// shaders read as they are (the VS / PS float banks, bool / loop, the 32 fetch constants). Delta semantics: a record carries the
+// dirty blocks only, so the state persists across records.
+//
+// What this is NOT: a register file. There is no word array indexed by register number and no RegisterFile here; register numbers
+// appear in one place only, the decoder's table in owned_record.cpp (register -> field). M4a runs it as a SHADOW (the existing path
+// still draws and a compare at the end of each item counts the differences from the feed image); M4b..M4f read it to draw.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include <rex/graphics/registers.h>
+
+namespace rex::graphics {
+class CommandProcessor;
+}
+
+namespace rex::graphics::vulkan {
+
+struct OwnedRecordState {
+  // ---- surfaces
+  reg::RB_MODECONTROL modecontrol{};
+  reg::RB_SURFACE_INFO surface_info{};
+  reg::RB_COLOR_INFO color_info[4]{};
+  reg::RB_DEPTH_INFO depth_info{};
+  // ---- raster / clip / viewport / window / scissors
+  reg::PA_SU_SC_MODE_CNTL sc_mode_cntl{};
+  reg::PA_SU_VTX_CNTL su_vtx_cntl{};
+  reg::PA_SU_POINT_SIZE point_size{};
+  reg::PA_SU_POINT_MINMAX point_minmax{};
+  float poly_offset[4]{};  // front scale, front offset, back scale, back offset
+  reg::PA_CL_CLIP_CNTL clip_cntl{};
+  reg::PA_CL_VTE_CNTL vte_cntl{};
+  float vport[6]{};  // x scale, x offset, y scale, y offset, z scale, z offset
+  float user_clip[24]{};  // 6 planes x (x, y, z, w)
+  reg::PA_SC_WINDOW_OFFSET window_offset{};
+  reg::PA_SC_WINDOW_SCISSOR_TL window_scissor_tl{};
+  reg::PA_SC_WINDOW_SCISSOR_BR window_scissor_br{};
+  reg::PA_SC_SCREEN_SCISSOR_TL screen_scissor_tl{};
+  reg::PA_SC_SCREEN_SCISSOR_BR screen_scissor_br{};
+  reg::PA_SC_VIZ_QUERY viz_query_cntl{};
+  // ---- depth / stencil / colour / blend
+  reg::RB_DEPTHCONTROL depth_control{};
+  reg::RB_STENCILREFMASK stencil_front{};
+  reg::RB_STENCILREFMASK stencil_back{};
+  reg::RB_COLORCONTROL color_control{};
+  float alpha_ref = 0;
+  reg::RB_BLENDCONTROL blend[4]{};
+  float blend_color[4]{};  // red, green, blue, alpha
+  reg::RB_COLOR_MASK color_mask{};
+  // ---- primitive / VGT
+  reg::VGT_MIN_VTX_INDX min_vtx_indx{};
+  reg::VGT_MAX_VTX_INDX max_vtx_indx{};
+  reg::VGT_INDX_OFFSET indx_offset{};
+  reg::VGT_MULTI_PRIM_IB_RESET_INDX reset_indx{};
+  reg::VGT_OUTPUT_PATH_CNTL output_path_cntl{};
+  reg::VGT_HOS_CNTL hos_cntl{};
+  float hos_tess[2]{};  // max, min tessellation level
+  // ---- the draw item's own words
+  reg::VGT_DRAW_INITIATOR draw_initiator{};
+  uint32_t dma_base = 0;
+  reg::VGT_DMA_SIZE dma_size{};
+  // ---- shader control
+  reg::SQ_PROGRAM_CNTL program_cntl{};
+  reg::SQ_CONTEXT_MISC context_misc{};
+  reg::SQ_INTERPOLATOR_CNTL interpolator_cntl{};
+  reg::SQ_VS_CONST vs_const{};
+  reg::SQ_PS_CONST ps_const{};
+  // ---- the arrays our shaders read as they are (xenos_vs.glsl layout): words, 4 per vec4 constant
+  uint32_t vs_float[256 * 4]{};
+  uint32_t ps_float[256 * 4]{};
+  uint32_t bool_loop[8 + 32]{};  // bool constants (256 bits) then the 32 loop constants
+  uint32_t fetch[32 * 6]{};      // the 32 fetch constants, 6 words each
+  // ---- not registers: the draw item and the shader identities
+  uint32_t draw_viz_query = 0;
+  uint64_t crowd_id = 0;       // the draw's crowd identity: token sequence << 16 | item index (16 bits) (command_processor.cpp kD3dTokenMagic handler)
+  uint32_t token_seq = 0;      // the current token's sequence number
+  struct ShaderId {
+    uint32_t address = 0;      // as the record carries it (bit 31 = guest virtual)
+    uint32_t dwords = 0;
+    uint64_t hash = 0;         // XXH3 of the microcode words, as the pipeline cache keys its shaders
+  };
+  ShaderId shader[2]{};        // 0 vertex, 1 pixel
+  uint64_t bin_mask = 0;       // the tiling predication state (kNrRegs bin ops)
+  uint64_t bin_select = 0;
+  uint32_t banks_valid = 0;  // M4c: set in a snapshot taken with the constant banks (latch bit 2 at the time of the queue item)
+  uint32_t crowd_member = 0;  // M4d: set in the state OwnedRecordCrowdMemberState derives (a crowd member's draw: c76-c78 are the member's)
+  uint32_t inline_draw = 0;   // M4e: set in the snapshot of an inline (0x7E) draw
+};
+
+// The decoder's state (command thread only). M4b onwards read it.
+const OwnedRecordState& OwnedRecordStateNow();
+
+// M4b: the typed state AS OF each DRAW item of a queue item (a token holds several items; the decoder runs ahead of the old path, which
+// executes them one by one). Taken at every token DRAW item when gpu_d3d_owned_front bit 1 is set (all but the shader constant banks, which M4c reads: with
+// bit 2 of the latch the banks are copied too), in order, at most 512 per queue item. The old path's draw handler (d3d_direct.cpp D3dDirectDrawItem) pairs them
+// SEQUENTIALLY: OwnedRecordDrawAdvance() at the very top of every draw item it is given (killed, fallback or drawn), so draw N of the
+// queue item pairs with snapshot N; OwnedRecordDrawBegin() then checks the item's own words against it (a mismatch is a desync, counted,
+// and nothing is paired until the next queue item). OwnedRecordDrawNow() is the paired snapshot while the draw runs, else nullptr.
+void OwnedRecordDrawAdvance();
+const OwnedRecordState* OwnedRecordDrawBegin(uint32_t viz_query, uint32_t initiator, uint32_t dma_base, uint32_t dma_size);
+void OwnedRecordDrawEnd();
+const OwnedRecordState* OwnedRecordDrawNow();
+struct OwnedRecordSnapStats {
+  uint64_t taken = 0;           // snapshots stored
+  uint64_t overflow_items = 0;  // draw items past the 512 cap (no snapshot)
+  uint64_t advanced = 0;        // draw items the old path's handler was given
+  uint64_t paired = 0;          // ... that paired with a snapshot
+  uint64_t no_snapshot = 0;     // ... in a queue item with no such snapshot (a segment's replay, a draw the decoder did not see)
+  uint64_t overflow_draws = 0;  // ... that fell past the cap
+  uint64_t desync = 0;          // ... whose words differ from the snapshot's (the rest of the queue item is not paired)
+};
+OwnedRecordSnapStats& OwnedRecordSnapCounters();
+// M4d: counts every draw item the old path's handler is given (OwnedRecordDrawAdvance); a typed repeat needs consecutive numbers.
+uint64_t OwnedRecordDrawSeq();
+
+// M4d (latch bit 3): the typed state of a crowd member's draw. The crowd code (SceneCrowdAfterDraw) issues each member's draw after its run's
+// first member's item; the member differs from that item only in the constants c76-c78 (12 words, host order). Returns the last paired
+// snapshot of this queue item with c76-c78 replaced by `c76` (crowd_member set), or nullptr when there is none / it carries no banks.
+// Valid until the next call.
+const OwnedRecordState* OwnedRecordCrowdMemberState(const uint32_t* c76);
+
+// ---- M4e (gpu_d3d_owned_front bit 4, value 16): clears, resolves and inline draws built from the typed state, as a SHADOW.
+//
+// Inline draws: the decoder takes a snapshot of the typed state at each 0x7E record (needs bit 1, with bit 2 for the banks; kept per queue
+// item, at most 32). ExecuteD3dInlineDraw brackets its draw with OwnedRecordInlineBegin / End, which pairs the record's snapshot by sequence
+// number (once: a tiling replay of the same sequence finds it used, counted) and makes it OwnedRecordDrawNow() for the claim's shadow
+// (OwnedFrontShadowDraw / the bind shadow: built from the typed state, compared with the old path's description). The staged vertex
+// address (slot 31 words 4-5) is the old path's own, taken as an input. Nothing the old path sees changes.
+void OwnedRecordInlineBegin(uint32_t sequence, uint32_t viz_query, uint32_t initiator, uint32_t fetch_word4, uint32_t fetch_word5);
+void OwnedRecordInlineEnd();
+
+// Clears: what ClearStock did, read back at the point of its draw (the registers it wrote, the vertices it staged); compared with the clear the
+// typed state + the record describe (surface, rect, values, masks, modes). Resolves: M3's CopyWords against the typed state's view.
+struct OwnedClearOld {
+  uint32_t surface_info = 0, color_info = 0, depth_info = 0, color_mask = 0, depth_control = 0, stencil_refmask = 0, mode_control = 0, aa_config = 0,
+           vtx_cntl = 0;
+  uint32_t vertex[3][7] = {};  // x y z r g b a as float bits
+};
+void OwnedRecordClearShadow(const uint32_t* sem, uint32_t count, const OwnedClearOld& old);
+struct OwnedResolveOld {
+  uint32_t copy_control = 0, dest_base = 0, dest_pitch = 0, dest_info = 0, surface_info = 0, color_info = 0, depth_info = 0, mode_control = 0,
+           vtx_cntl = 0;
+};
+void OwnedRecordResolveShadow(const uint32_t* sem, uint32_t count, const OwnedResolveOld& old);
+// The decoder's part of the M4e window line (clears, resolves, inline pairing); resets its window.
+std::string OwnedRecordM4eSummary(uint64_t frames);
+
+// ---- M4f-C (gpu_d3d_owned_front bit 128, THE CUT): the decoder as the executor.
+//
+// With the cut on (read where the queue attaches) d3d_noring.cpp hands kNrPackets / kNrRegs items to the `run` hook (d3d_owned_record.h) instead of
+// the register-file machinery: the decoder walks the item IN ORDER and executes it on its live typed state (OwnedRecordStateNow()) - no snapshot, no
+// second parse, no ExecutePacket, no arena, no feed image. RUN items store into the typed state and make the notifications (D3dFeedAccess::Notify's);
+// SHADER items call LoadShader once; DRAW items, the 0x7D clear / resolve records and the 0x7E inline draw call the ENTRY POINTS below with the live state.
+//
+// An entry point that is not wired (nullptr: phase 1 of M4f-C) makes the executor refuse the WHOLE item before it touches anything (the item goes the
+// existing way, counted by reason in free_counters::g_cut.old_path); a wired one is final: its answer is true when it drew / cleared / resolved, or dropped
+// the work and counted it itself, false when the work failed (counted as a dropped item). Nothing falls back to the old path once an item has started.
+// `record` is the 0x7D / 0x7E record's payload from its magic word, in host order, `dwords` long.
+struct OwnedExecEntries {
+  bool (*draw)(CommandProcessor& cp, const OwnedRecordState& live, uint32_t item_index) = nullptr;
+  bool (*clear)(CommandProcessor& cp, const OwnedRecordState& live, const uint32_t* record, uint32_t dwords) = nullptr;
+  bool (*resolve)(CommandProcessor& cp, const OwnedRecordState& live, const uint32_t* record, uint32_t dwords) = nullptr;
+  bool (*inline_draw)(CommandProcessor& cp, const OwnedRecordState& live, const uint32_t* record, uint32_t dwords) = nullptr;
+};
+OwnedExecEntries& OwnedExecEntrySlots();
+
+// The decoder's dirty epochs: each is bumped when a stored field / bank changes VALUE (not on a rewrite of the same words). `render` covers every typed
+// field except the draw's own words (base vertex, initiator, DMA base / size) and the banks. Command thread only; the typed memo keys read them.
+struct OwnedRecordEpochs {
+  uint64_t render = 0, vs_float = 0, ps_float = 0, bool_loop = 0, fetch = 0;
+};
+const OwnedRecordEpochs& OwnedRecordEpochsNow();
+
+}  // namespace rex::graphics::vulkan
+
+namespace rex::graphics::vulkan {
+// ---- M4f-C: the targets a typed draw serves its textures against under the cut (NativeServeView): the typed RB words, set around the draw; nullptr = registers.
+struct OwnedServeTargets {
+  uint32_t surface_info = 0, color_info[4] = {}, color_mask = 0;
+};
+void OwnedServeTargetsSet(const OwnedServeTargets* targets);  // (vulkan/command_processor.cpp)
+
+// The executor's pieces the entry points (owned_front_own.cpp) reach: the live state (mutable: the inline entry marks it), a register-range store with the
+// notifications (the inline draw's staged address, slot 31 words 4-5), and the clear / resolve records run by the copy executor (d3d_copy_records.cpp).
+OwnedRecordState& OwnedRecordStateLive();
+void OwnedExecStore(uint32_t first, uint32_t n, const uint32_t* values);
+bool OwnedExecCopy(CommandProcessor& cp, uint32_t kind, const uint32_t* sem, uint32_t sem_dwords);
+}  // namespace rex::graphics::vulkan
+
+namespace rex::graphics::vulkan {
+// ---- M4f-C: the shadow chain / crowd density predicates of IssueDraw, from words (vulkan/command_processor.cpp), for the typed draw under the cut.
+bool OwnedCrowdDensityRejects(uint64_t vs_hash, uint32_t surface_info, const uint32_t* c76, int32_t density);
+uint32_t OwnedDynamicShadowKind(uint64_t ps_hash, uint64_t vs_hash);
+uint64_t OwnedShadowChainKey(uint32_t color_info, uint32_t depth_info);
+bool OwnedShadowChainPitchOk(uint32_t surface_info, uint64_t ps_hash, bool copy);
+bool OwnedShadowChainNotShadow(uint64_t ps_hash);
+bool OwnedShadowChainHas(const std::vector<uint64_t>& v, uint64_t key);
+void OwnedDynamicShadowsNoteSkip(uint32_t kind, uint64_t frame);
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/native/owned_resolve.cpp b/src/graphics/vulkan/native/owned_resolve.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7f8fc0ee8068dd051e1c951e9c55bc84e3cecb59
--- /dev/null
+++ b/src/graphics/vulkan/native/owned_resolve.cpp
@@ -0,0 +1,198 @@
+// wwe2k14 patch (Session 92, M3a): a resolve record reaches the owned frame without the register file or the render target cache.
+//
+// VulkanCommandProcessor::OwnedResolveRecord is what VulkanRenderTargetCache::Resolve does for a copy the owned frame serves
+// (render_target_cache.cpp, "Copying" and the owned_wb destination block), taken apart from the cache: OwnedTakeResolve (served from a pass,
+// a record, a defined fill, or dropped and counted), the page marks of a served copy, and - for a copy whose bytes the CPU reads back (an armed
+// write-back) - the destination (the 1x shared memory range or the scaled resolve buffer range, a transient descriptor) and the dispatch
+// (OwnedWriteBackRun), then the marks the cache made. Not here: the cache's stock copy paths (the truth images / the EDRAM), the cache's
+// clear (the owned images are cleared by the game's clear records; the cache's host render targets / EDRAM are not read under the owned-only
+// latch - counted as clears_skipped) and the texture-only record machinery.
+//
+// Called from IssueCopyFrom with the ResolveInfo that D3dCopyAccess::Resolve built from the record (draw_util::GetResolveInfoFromInput).
+#include <rex/graphics/vulkan/command_processor.h>
+#include <rex/graphics/vulkan/native/native_renderer.h>
+
+#include <rex/cvar.h>
+#include <rex/graphics/free_counters.h>
+#include <rex/graphics/shared_memory.h>
+#include <rex/logging.h>
+
+#include <algorithm>
+#include <cstdint>
+
+REXCVAR_DECLARE(bool, gpu_native_truth_defer_dest_use);         // (render_target_cache.cpp)
+REXCVAR_DECLARE(bool, gpu_native_truth_defer_dest_use_scaled);  // (render_target_cache.cpp)
+
+namespace rex::graphics::vulkan {
+
+bool VulkanCommandProcessor::OwnedResolveRecord(const draw_util::ResolveInfo& resolve_info, uint32_t& written_address_out,
+                                                uint32_t& written_length_out) {
+  namespace fc = rex::graphics::free_counters;
+  fc::OwnedResolveCounters& c = fc::g_or;
+  written_address_out = 0;
+  written_length_out = 0;
+  ++c.calls;
+  if (c.calls % 1200 == 0) {
+    REXGPU_INFO("[d3d][owned-resolve] {} record resolves: served from the owned frame {}, written into memory from our image {} (write-backs that "
+                "wrote nothing {}), dropped {} (the owned frame did not take them), nothing to copy {}, read back (queued or immediate) {}, "
+                "clearing resolves whose cache clear was skipped {}, EDRAM renames skipped {}, write-back without a copy shader {}, scaled range failures {}, "
+                "shadow-chain copy skips by source (0-3 colour, 4 depth) {}/{}/{}/{}/{}",
+                c.calls, c.served, c.written, c.wb_failed, c.not_taken, c.nothing, c.read_back, c.clears_skipped, c.rename_skipped,
+                c.wb_no_shader, c.range_failed, c.chain_by_src[0], c.chain_by_src[1], c.chain_by_src[2], c.chain_by_src[3], c.chain_by_src[4]);
+  }
+
+  // Nothing to copy / clear.
+  if (!resolve_info.coordinate_info.width_div_8 || !resolve_info.height_div_8) {
+    ++c.nothing;
+    return true;
+  }
+
+  const uint32_t scale_x = texture_cache_->draw_resolution_scale_x(), scale_y = texture_cache_->draw_resolution_scale_y();
+  const bool draw_resolution_scaled = texture_cache_->IsDrawResolutionScaled();
+  bool copied = false;
+  if (resolve_info.copy_dest_extent_length) {
+    draw_util::ResolveCopyShaderConstants copy_shader_constants;
+    uint32_t copy_group_count_x, copy_group_count_y;
+    const draw_util::ResolveCopyShaderIndex copy_shader =
+        resolve_info.GetCopyShader(scale_x, scale_y, copy_shader_constants, copy_group_count_x, copy_group_count_y);
+    const bool owned_taken = NativeOwnedResolve(resolve_info, copy_shader != draw_util::ResolveCopyShaderIndex::kUnknown);
+    const bool owned_wb = owned_taken && NativeOwnedWriteBackArmed();
+    if (owned_taken && !owned_wb) {
+      // A served copy: our image holds it, the page's samplers are given that image. (At a resolution scale its pages marked scaled as the game's
+      // copy marks them; the range's textures invalidated only when a page is newly marked. A derived cube's face at 1x marks its range resolved.)
+      ++c.served;
+      copied = true;
+      if (draw_resolution_scaled) {
+        texture_cache_->MarkRangeScaledResolved(resolve_info.copy_dest_extent_start, resolve_info.copy_dest_extent_length, true);
+      } else if (NativeOwnedMarkResolved()) {
+        texture_cache_->MarkRangeAsResolved(resolve_info.copy_dest_extent_start, resolve_info.copy_dest_extent_length);
+      }
+    } else if (!owned_taken) {
+      // The owned frame did not take the copy (no frame to serve it: the native renderer is not replacing). Under the owned-only latch there is no
+      // other way to run it (no stock copy from the EDRAM / the truth images): dropped, counted.
+      ++c.not_taken;
+      if (c.not_taken <= 12) {
+        REXGPU_ERROR("[d3d][owned-resolve] frame {}: a resolve record was NOT TAKEN by the owned frame (lost): source {} colour base {} depth base {} dest 0x{:08X}",
+                     frame_current_, uint32_t(resolve_info.rb_copy_control.copy_src_select), uint32_t(resolve_info.color_original_base),
+                     uint32_t(resolve_info.depth_original_base), resolve_info.copy_dest_base);
+      }
+      copied = true;
+    } else if (copy_shader == draw_util::ResolveCopyShaderIndex::kUnknown) {
+      // (Armed, but a copy shape the destination block cannot run: as the cache, nothing is written; OwnedTakeResolve's next call says so loudly.)
+      ++c.wb_no_shader;
+    } else {
+      // The write-back's destination block (the cache's, without the stock copy paths and the truth-image machinery).
+      const draw_util::ResolveCopyShaderInfo& copy_shader_info = draw_util::resolve_copy_shader_info[size_t(copy_shader)];
+      const uint32_t copy_dest_range_unscaled =
+          resolve_info.copy_dest_extent_start - resolve_info.copy_dest_base + resolve_info.copy_dest_extent_length;
+      uint64_t copy_dest_base = resolve_info.copy_dest_base;
+      uint64_t copy_dest_range_length = copy_dest_range_unscaled;
+      uint64_t copy_dest_use_start = resolve_info.copy_dest_extent_start;
+      uint64_t copy_dest_use_length = resolve_info.copy_dest_extent_length;
+      if (draw_resolution_scaled) {
+        if (!texture_cache_->GetScaledResolveRange(resolve_info.copy_dest_base, copy_dest_range_unscaled, copy_shader_info.dest_bpe_log2,
+                                                   copy_dest_base, copy_dest_range_length) ||
