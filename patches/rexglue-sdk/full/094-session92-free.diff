+bool IsPixelShaderNeededWithRasterization(const Shader& shader, reg::RB_MODECONTROL modecontrol, reg::RB_COLORCONTROL color_control,
+                                          uint32_t color_mask, const reg::RB_COLOR_INFO color_info[4],
+                                          bool include_memory_export) {
+  if (modecontrol.edram_mode != xenos::EdramMode::kColorDepth) {
+    return false;
+  }
+  if (shader.kills_pixels() || shader.writes_depth() || (include_memory_export && shader.memexport_eM_written()) ||
+      (shader.writes_color_target(0) && DoesCoverageDependOnAlpha(color_control))) {
+    return true;
+  }
+  uint32_t rts_remaining = shader.writes_color_targets();
+  uint32_t rt_index;
+  while (bit_inline::bit_scan_forward(rts_remaining, &rt_index)) {
+    rts_remaining &= ~(uint32_t(1) << rt_index);
+    uint32_t format_component_count = GetColorRenderTargetFormatComponentCount(color_info[rt_index].color_format);
+    if ((color_mask >> (rt_index * 4)) & ((uint32_t(1) << format_component_count) - 1)) {
+      return true;
+    }
+  }
+  return false;
+}
