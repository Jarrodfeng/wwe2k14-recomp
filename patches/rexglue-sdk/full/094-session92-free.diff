+void GetPreferredFacePolygonOffset(reg::PA_SU_SC_MODE_CNTL sc_mode_cntl, const float poly_offset[4], bool primitive_polygonal,
+                                   float& scale_out, float& offset_out) {
+  float scale = 0.0f, offset = 0.0f;
+  if (primitive_polygonal) {
+    if (sc_mode_cntl.poly_offset_front_enable && !sc_mode_cntl.cull_front) {
+      scale = poly_offset[0];
+      offset = poly_offset[1];
+    }
+    if (sc_mode_cntl.poly_offset_back_enable && !sc_mode_cntl.cull_back && !scale && !offset) {
+      scale = poly_offset[2];
+      offset = poly_offset[3];
+    }
+  } else if (sc_mode_cntl.poly_offset_para_enable) {
+    scale = poly_offset[0];
+    offset = poly_offset[1];
+  }
+  scale_out = scale;
+  offset_out = offset;
