+const char* StatName(uint32_t s) {
+  if (s < kFieldCount) return kFields[s].name;
+  switch (s) {
+    case kBankVsFloat: return "vs_float";
+    case kBankPsFloat: return "ps_float";
+    case kBankBoolLoop: return "bool_loop";
+    default: return "fetch";
