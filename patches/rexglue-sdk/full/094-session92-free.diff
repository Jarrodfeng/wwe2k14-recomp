+  config.max_storage_buffer_range = features_.max_storage_buffer_range;
+  config.features[0] = features_.full_draw_index_uint32;
+  config.features[1] = features_.vertex_pipeline_stores_and_atomics;
+  config.features[2] = features_.fragment_stores_and_atomics;
+  config.features[3] = features_.clip_distance;
+  config.features[4] = features_.cull_distance;
+  config.features[5] = features_.image_view_format_swizzle;
+  config.features[6] = features_.signed_zero_inf_nan_preserve_float32;
+  config.features[7] = features_.denorm_flush_to_zero_float32;
+  config.features[8] = features_.rounding_mode_rte_float32;
+  config.features[9] = features_.fragment_shader_sample_interlock;
+  config.features[10] = features_.demote_to_helper_invocation | (features_.sample_rate_shading ? 2 : 0);
+  config.msaa_with_attachments = native_2x_msaa_with_attachments_;
+  config.msaa_no_attachments = native_2x_msaa_no_attachments_;
+  config.fsi = edram_fragment_shader_interlock_;
+  config.depth_only = is_depth_only_fragment_shader_;
+  config.cvar_vertex_kill_log = REXCVAR_GET(gpu_debug_vertex_kill_log);
+  config.cvar_ignore_cull_clip = REXCVAR_GET(gpu_debug_ignore_cull_clip);
+  config.cvar_force_denorm_flush = REXCVAR_GET(gpu_debug_force_denorm_flush_to_zero);
+  config.cvar_kill_nan_xyzw = REXCVAR_GET(gpu_vertex_kill_nan_xyzw);
+  config.scale_x = draw_resolution_scale_x_;
+  config.scale_y = draw_resolution_scale_y_;
+  std::memcpy(&config.position_scale_x_bits, &pixel_position_scale_x_, 4);
+  std::memcpy(&config.position_scale_y_bits, &pixel_position_scale_y_, 4);
+  const uint64_t fingerprint = XXH3_64bits(&config, sizeof(config));
+  return fingerprint ? fingerprint : 1;
+}
+
+void SpirvShaderTranslator::StoreDescribeTranslation(bool& native, float& scale_x, float& scale_y) const {
+  if (is_vertex_shader()) {
+    native = current_translation().native_ext() != 0;
+  } else {
+    native = GetSpirvShaderModification().pixel.native_host_render_targets != 0;
+  }
+  scale_x = pixel_position_scale_x_;
+  scale_y = pixel_position_scale_y_;
+}
+
+namespace {
+void StoreAppendU32(std::vector<uint8_t>& out, uint32_t value) {
+  const size_t at = out.size();
+  out.resize(at + 4);
+  std::memcpy(out.data() + at, &value, 4);
+}
+}  // namespace
+
+// Extras: u32 texture count, {fetch_constant, dimension, is_signed} each; u32 sampler count, {fetch_constant, mag, min, mip,
+// aniso} each.
+void SpirvShaderTranslator::StoreExportExtras(std::vector<uint8_t>& out) const {
+  out.clear();
+  StoreAppendU32(out, uint32_t(texture_bindings_.size()));
+  for (const TextureBinding& binding : texture_bindings_) {
+    StoreAppendU32(out, binding.fetch_constant);
+    StoreAppendU32(out, uint32_t(binding.dimension));
+    StoreAppendU32(out, binding.is_signed ? 1u : 0u);
+  }
+  StoreAppendU32(out, uint32_t(sampler_bindings_.size()));
+  for (const SamplerBinding& binding : sampler_bindings_) {
+    StoreAppendU32(out, binding.fetch_constant);
+    StoreAppendU32(out, uint32_t(binding.mag_filter));
+    StoreAppendU32(out, uint32_t(binding.min_filter));
+    StoreAppendU32(out, uint32_t(binding.mip_filter));
+    StoreAppendU32(out, uint32_t(binding.aniso_filter));
+  }
+}
+
+bool SpirvShaderTranslator::StoreImportExtras(const std::vector<uint8_t>& in) {
+  size_t at = 0;
+  const auto read = [&](uint32_t& value) {
+    if (at + 4 > in.size()) return false;
+    std::memcpy(&value, in.data() + at, 4);
+    at += 4;
+    return true;
+  };
+  std::vector<TextureBinding> textures;
+  std::vector<SamplerBinding> samplers;
+  uint32_t count = 0;
+  bool ok = read(count) && count <= 4096;
+  for (uint32_t i = 0; ok && i < count; ++i) {
+    uint32_t fetch_constant, dimension, is_signed;
+    ok = read(fetch_constant) && read(dimension) && read(is_signed);
+    if (ok) {
+      TextureBinding binding = {};
+      binding.fetch_constant = fetch_constant;
+      binding.dimension = xenos::FetchOpDimension(dimension);
+      binding.is_signed = is_signed != 0;
+      binding.variable = spv::NoResult;
+      textures.push_back(binding);
+    }
+  }
+  ok = ok && read(count) && count <= 4096;
+  for (uint32_t i = 0; ok && i < count; ++i) {
+    uint32_t fetch_constant, mag, min, mip, aniso;
+    ok = read(fetch_constant) && read(mag) && read(min) && read(mip) && read(aniso);
+    if (ok) {
+      SamplerBinding binding = {};
+      binding.fetch_constant = fetch_constant;
+      binding.mag_filter = xenos::TextureFilter(mag);
+      binding.min_filter = xenos::TextureFilter(min);
+      binding.mip_filter = xenos::TextureFilter(mip);
+      binding.aniso_filter = xenos::AnisoFilter(aniso);
+      binding.variable = spv::NoResult;
+      samplers.push_back(binding);
+    }
+  }
+  if (!ok || at != in.size()) {
+    // (A record that passed its checksum but does not parse: never expected.)
+    REXGPU_ERROR("[m6][store] a stored translation's bindings did not parse: translating instead");
+    return false;
+  }
+  SetShaderBindingsFromTranslation(textures, samplers);
+  return true;
+}
