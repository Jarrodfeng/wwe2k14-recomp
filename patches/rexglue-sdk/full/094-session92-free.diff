+
+// ---------------------------------------------------------------------------------------------------------------------------------
+// M4f-A (latch bit 5, value 32): the typed state DRAWS the token draw items.
+//
+// OwnedFrontPrepare is Build in its own mode (modules / geometry shader / layout really made) over the paired snapshot, with the template memo
+// of M4d's shape: a key of (shader pair, primitive, mode, state hash, externals hash) finds an entry whose viewport / scissor / depth / stencil /
+// cull parts are taken (Build with `tmpl`); the rest - the fetch-dependent keys, the modifications, the modules, the primitive - is derived for
+// every draw, which is what the old lean's per-draw validity checks (endian key, spec key, ext stale) amount to. d3d_direct.cpp's DrawFromBase
+// then draws it: real primitive pass, samplers, textures, system constants, constants upload / descriptor sets, vertex ranges, claim.
+namespace {
+struct OwnWindow {
+  uint64_t counts[kTypedOutcomeCount] = {};
+  uint64_t memo_hits = 0, memo_misses = 0, hits_cross_frame = 0;
+  uint64_t build_skip[kSkipCount] = {};
+  uint64_t prepare_ns = 0;
+  std::map<const char*, uint64_t> fallbacks;  // (keyed by the literal's address: no string work per fallback)
+} g_own;
+Draw g_own_draw;
+Draw g_own_old_stub;  // (Build's `old` argument: only read by the shadow mode)
+OwnedTypedPrep g_own_prep;
+struct OwnMemo {
+  bool valid = false;
+  uint64_t vs = 0, ps = 0, state_hash = 0, ext_hash = 0, frame = 0;
+  uint32_t prim = 0, mode = 0;
+  TemplateOut out;
+  Draw draw;
+};
+OwnMemo g_own_memo[kMemoSlots];
+uint64_t g_own_first_frame = 0, g_own_last_print = 0;
+
+void PrintOwnWindow(uint64_t frame) {
+  const OwnWindow& w = g_own;
+  std::string fb, skips;
+  uint64_t fb_total = 0;
+  for (const auto& kv : w.fallbacks) {
+    fb += (fb.empty() ? "" : ", ") + std::string(kv.first) + " " + std::to_string(kv.second);
+    fb_total += kv.second;
+  }
+  if (fb.empty()) fb = "none";
+  for (uint32_t k = 1; k < kSkipCount; ++k) {
+    if (w.build_skip[k]) skips += (skips.empty() ? "" : ", ") + std::string(kSkipNames[k]) + " " + std::to_string(w.build_skip[k]);
+  }
+  if (skips.empty()) skips = "none";
+  const uint64_t frames = std::max<uint64_t>(frame - g_own_first_frame, 1);
+  REXGPU_INFO(
+      "[d3d][front] M4f-A frames {}-{}: token draw items offered {}, drawn by the typed front end {} (template memo: {} hits - {} from an earlier frame, {} misses), failed in the "
+      "backend {}, handed to the old path {} by reason: {}; of those, refused while building (Build skip reasons): {}; typed draws whose shadow compare was not run (typed vs typed would prove nothing) {}; of the drawn, restore draws {}, claimed but pipeline still compiling (dropped once) {}; M4f-B typed: crowd members {} (declined to the old way {}), inline draws {} (handed to the old path {}), cover rectangles {}, bounds rectangles {}, memexport draws {}; typed prepare {:.1f} us a frame, whole typed draw {:.1f} us a frame",
+      g_own_first_frame, frame, w.counts[kTypedItems], w.counts[kTypedDrawn], w.memo_hits, w.hits_cross_frame, w.memo_misses, w.counts[kTypedFailed],
+      fb_total, fb, skips, g_typed_shadow_skipped, w.counts[kTypedRestores], w.counts[kTypedPlaceholder], w.counts[kTypedCrowdMembers], w.counts[kTypedCrowdDeclined], w.counts[kTypedInline],
+      w.counts[kTypedInlineFallback], w.counts[kTypedCover], w.counts[kTypedBounds], w.counts[kTypedMemexport], double(w.prepare_ns) / 1000.0 / double(frames), double(w.counts[kTypedNs]) / 1000.0 / double(frames));
+  g_own = OwnWindow{};
+  g_typed_shadow_skipped = 0;
+  g_own_first_frame = frame;
+  g_own_last_print = frame;
+}
+}  // namespace
+
+OwnedTypedPrep* OwnedFrontPrepare(VulkanCommandProcessor& cp, const OwnedRecordState& s) {
+  using A = OwnedFrontAccess;
+  OwnedTypedPrep& p = g_own_prep;
+  p.refusal = nullptr;
+  const uint64_t frame = A::Frame(cp);
+  if (!g_own_first_frame) g_own_first_frame = g_own_last_print = frame;
+  if (frame - g_own_last_print >= 600) PrintOwnWindow(frame);
+  const uint64_t t0 = NowNs();
+  const uint64_t vs = s.shader[0].hash, ps = s.shader[1].hash;
+  const uint32_t prim = uint32_t(s.draw_initiator.prim_type);
+  const uint32_t mode = uint32_t(s.modecontrol.edram_mode) | (uint32_t(s.draw_initiator.major_mode) << 8);
+  const uint64_t state_hash = StateHash(s);
+  const uint64_t ext_hash = A::Externals(cp);
+  struct {
+    uint64_t vs, ps;
+    uint32_t prim, mode;
+  } slot_key{vs, ps, prim, mode};
+  OwnMemo& e = g_own_memo[XXH3_64bits(&slot_key, sizeof(slot_key)) % kMemoSlots];
+  const bool hit = e.valid && e.vs == vs && e.ps == ps && e.prim == prim && e.mode == mode && e.state_hash == state_hash && e.ext_hash == ext_hash;
+  Draw& d = g_own_draw;
+  d = Draw();
+  g_own_old_stub = Draw();
+  bool vs_absent = false, ps_absent = false, gs_skipped = false;
+  TemplateIn tin;
+  if (hit) {
+    static_cast<TemplateOut&>(tin) = e.out;
+    tin.draw = &e.draw;
+  }
+  g_scratch_out = TemplateOut();
+  const Skip sk = A::Build(cp, s, g_own_old_stub, d, vs_absent, ps_absent, gs_skipped, &p.bi, hit ? &tin : nullptr, hit ? nullptr : &g_scratch_out, &p);
+  g_own.prepare_ns += NowNs() - t0;
+  if (sk != kSkipNone) {
+    ++g_own.build_skip[sk];
+    p.refusal = kSkipNames[sk];
+    return nullptr;
+  }
+  if (hit) {
+    ++g_own.memo_hits;
+    if (e.frame != frame) ++g_own.hits_cross_frame;
+  } else {
+    ++g_own.memo_misses;
+    e.valid = true;
+    e.vs = vs;
+    e.ps = ps;
+    e.state_hash = state_hash;
+    e.ext_hash = ext_hash;
+    e.frame = frame;
+    e.prim = prim;
+    e.mode = mode;
+    e.out = g_scratch_out;
+    e.draw = d;
+  }
+  return &p;
+}
+
+// DrawFromBase's system constants step: the typed block into the processor's own system_constants_ (the old UpdateSystemConstantValues writes it
+// field by field; BuildSystemConstants is the same body over the typed fields - 0 mismatches in the M4c checks), the constant buffer marked out of
+// date when a byte changed (what the old function's `dirty` does), the skip cache's stored inputs dropped (it no longer describes the block).
+void OwnedFrontSystemConstants(VulkanCommandProcessor& cp, void* ctx, const PrimitiveProcessor::ProcessingResult& primitive) {
+  OwnedTypedPrep& p = *static_cast<OwnedTypedPrep*>(ctx);
+  OwnedBindInputs& bi = p.bi;
+  bi.primitive = primitive;
+  OwnedFrontAccess::SystemConstantsInto(cp, bi);
+}
+
+void OwnedFrontTypedNote(uint32_t outcome, uint64_t n) { g_own.counts[outcome] += n; }
+void OwnedFrontTypedFallback(const char* reason) {
+  ++g_own.fallbacks[reason];
+  if (rex::graphics::free_counters::g_cut.active) rex::graphics::free_counters::NoteCutDrop(reason);  // (M4f-C: under the cut a refusal is a DROPPED draw, counted by reason)
+}
+void OwnedFrontTypedAfter() { OwnedFrontRepeatBreak(); }
+void OwnedFrontTypedTick(VulkanCommandProcessor& cp) {  // the window line also prints when every draw is refused before OwnedFrontPrepare
+  const uint64_t frame = OwnedFrontAccess::Frame(cp);
+  if (!g_own_first_frame) g_own_first_frame = g_own_last_print = frame;
+  if (frame - g_own_last_print >= 600) PrintOwnWindow(frame);
+}
+void OwnedFrontTypedActive(bool on) { g_typed_draw_active = on; }
+const char* OwnedFrontPrepareRefusal() { return g_own_prep.refusal ? g_own_prep.refusal : "unknown"; }
+uint64_t OwnedFrontNowNs() { return NowNs(); }
+
+}  // namespace rex::graphics::vulkan
+
+// ---------------------------------------------------------------------------------------------------------------------------------
+// M4f-B (latch bit 6, value 64): the cover / bounds rectangle inputs from the typed state (NativeCoverRect / NativeBoundsRect take a CoverInputs).
+// Every field comes from the snapshot; the constant arrays are the snapshot's own (register layout), hashed in place. The ONE thing that is a register
+// file is the CPU shader interpreter's register source (it reads its float constants, bool / loop constants, the vertex fetch words and the SQ_VS_CONST
+// word): ShaderInterpreter::ConstantSource over the snapshot's arrays (CoverInputs::interp_regs null = the typed arrays); no register file is read.
+namespace rex::graphics::vulkan {
+namespace {
+uint64_t g_cover_typed = 0;
+}  // namespace
+
+void OwnedFrontCoverInputs(const OwnedRecordState& s, CoverInputs& in) {
+  static_assert(offsetof(OwnedRecordState, ps_float) == offsetof(OwnedRecordState, vs_float) + 1024 * sizeof(uint32_t), "banks contiguous");
+  in.interp_regs = nullptr;  // (the interpreter reads the arrays below through its constant source - no register file)
+  in.initiator = s.draw_initiator;
+  in.sc_mode = s.sc_mode_cntl;
+  in.reset_indx = s.reset_indx;
+  in.surface_info = s.surface_info;
+  in.color_control = s.color_control;
+  in.window_offset = s.window_offset;
+  in.vte = s.vte_cntl;
+  in.clip = s.clip_cntl;
+  in.su_vtx_cntl = s.su_vtx_cntl;
+  in.indx_offset = s.indx_offset;
+  in.min_indx = s.min_vtx_indx;
+  in.max_indx = s.max_vtx_indx;
+  in.vport[0] = s.vport[0];  // x scale
+  in.vport[1] = s.vport[1];  // x offset
+  in.vport[2] = s.vport[2];  // y scale
+  in.vport[3] = s.vport[3];  // y offset
+  draw_util::GetScissor(s.window_scissor_tl, s.window_scissor_br, s.window_offset, s.screen_scissor_tl, s.screen_scissor_br, s.surface_info.surface_pitch,
+                        in.scissor);
+  in.vs_const = s.vs_const.value;
+  in.floats = s.vs_float;
+  in.bool_loop = s.bool_loop;
+  in.fetch = s.fetch;
+  ++g_cover_typed;
+}
+uint64_t OwnedFrontCoverTypedCount() { return g_cover_typed; }
+
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/native/owned_front_draw.h b/src/graphics/vulkan/native/owned_front_draw.h
new file mode 100644
index 0000000000000000000000000000000000000000..a461cc1aa776aa6efc594b6b830b4c46bd2e8632
--- /dev/null
+++ b/src/graphics/vulkan/native/owned_front_draw.h
@@ -0,0 +1,86 @@
+// wwe2k14 patch (Session 92, M4b; docs\native\d3d\S92_M3_M5_DESIGN.md section 2, contract S92_M4B_CONTRACT.md): the draw description built
+// from the record decoder's typed state, as a SHADOW.
+//
+// At each claim the old path makes (the full description, a lean draw, a repeat), OwnedFrontShadowDraw builds the same native::Draw from the
+// typed state of the record's draw item (owned_record.h; the draw handler d3d_direct.cpp brackets the item with OwnedRecordDrawBegin / End)
+// and compares it with the one the old path built, field by field. The old path still draws. Latch: gpu_d3d_owned_front bit 1 (with bit 0,
+// the decoder).
+#pragma once
+
+#include <cstdint>
+
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/graphics/vulkan/native/native_renderer.h>
+#include <rex/graphics/vulkan/command_processor.h>
+
+#include "owned_front_bind.h"
+
+namespace rex::graphics::vulkan {
+
+class VulkanCommandProcessor;
+
+enum OwnedFrontClaimKind : uint32_t { kOwnedFrontFull = 0, kOwnedFrontLean = 1, kOwnedFrontRepeat = 2, kOwnedFrontKinds = 3 };
+
+void OwnedFrontShadowDraw(VulkanCommandProcessor& cp, const native::Draw& old_draw, uint32_t kind);
+
+// M4d (gpu_d3d_owned_front bit 3): the crowd shadow. The draw handler calls it for a draw item with the old path's crowd inputs (the member constants
+// c76-c78 it read, its packet id, whether PreTake was asked and what it answered); the typed state's are compared. OwnedFrontShadowDraw also reads
+// D3dFeedCrowd().member_c76 to build a crowd member's draw from the typed state.
+// (`ask` = the handler's SceneCrowdMatchLocal, a captureless lambda in its friend scope: the processor's member is protected.)
+void OwnedFrontRepeatBreak();  // M4d: ends the typed repeat chain (called by the decoder for items that are not draws)
+using OwnedFrontCrowdAsk = bool (*)(VulkanCommandProcessor&, const uint32_t*);
+void OwnedFrontCrowdItem(VulkanCommandProcessor& cp, const uint32_t* old_c76, uint32_t old_id, bool pre_called, bool pre_result, OwnedFrontCrowdAsk ask);
+
+// ---- M4f-A (gpu_d3d_owned_front bit 5, value 32): the typed state DRAWS the token draw items.
+//
+// OwnedFrontPrepare builds, from the paired snapshot, what the lean body (d3d_direct.cpp DrawFromBase) takes from a base: the native::Draw (modules
+// really created, the geometry shader made, the pipeline layout made), the fields of the lean base, and the inputs of this draw (the typed constant
+// banks and fetch words, the draw's primitive input, the system constants' inputs). Every refusal is a counted fallback reason (the old path draws).
+struct OwnedTypedPrep {
+  native::Draw* draw = nullptr;  // storage owned by the .cpp (valid until the next Prepare)
+  // the fields of the lean base (VulkanCommandProcessor::LeanState)
+  VulkanShader* vertex_shader = nullptr;
+  VulkanShader* pixel_shader = nullptr;
+  bool polygonal = false;
+  Shader::HostVertexShaderType host_vertex_shader_type = Shader::HostVertexShaderType::kVertex;
+  uint32_t used_texture_mask = 0;
+  reg::RB_DEPTHCONTROL depth_control{};
+  uint32_t color_mask = 0;
+  draw_util::ViewportInfo viewport_info{};
+  const void* layout = nullptr;  // VulkanCommandProcessor::PipelineLayout
+  uint32_t shared_memory_access_stages = 0;
+  uint32_t merge_stride = 0, float_count = 0;
+  bool pixel_shader_vertex_fetches = false;
+  bool host_primitive_reset_enabled = false;
+  xenos::PrimitiveType host_primitive_type = xenos::PrimitiveType::kNone;
+  uint32_t vertex_endian_key = 0, pixel_spec_key = 0, vertex_mul_key = 0, pixel_ext = 0, vertex_ext = 0;
+  // this draw's own inputs
+  PrimitiveProcessor::DrawInput input{};
+  const uint32_t* vs_float = nullptr;
+  const uint32_t* ps_float = nullptr;
+  const uint32_t* bool_loop = nullptr;
+  const uint32_t* fetch = nullptr;
+  uint32_t surface_info = 0, color_info = 0, depth_info = 0;
+  OwnedBindInputs bi;  // the system constants' inputs (the typed block builder)
+  const char* refusal = nullptr;  // set when OwnedFrontPrepare refuses: the reason name
+};
+// Returns the prepared draw (storage owned by the .cpp), or nullptr with p.refusal set.
+OwnedTypedPrep* OwnedFrontPrepare(VulkanCommandProcessor& cp, const OwnedRecordState& s);
+// DrawFromBase's system constants step for a typed draw (ctx = the OwnedTypedPrep).
+void OwnedFrontSystemConstants(VulkanCommandProcessor& cp, void* ctx, const PrimitiveProcessor::ProcessingResult& primitive);
+// Counters of the typed draws (window line `[d3d][front] M4f-A`).
+enum OwnedTypedOutcome : uint32_t { kTypedItems, kTypedDrawn, kTypedFailed, kTypedNs, kTypedRestores, kTypedPlaceholder,
+                                  kTypedCrowdMembers, kTypedCrowdDeclined, kTypedInline, kTypedInlineFallback, kTypedCover, kTypedBounds, kTypedMemexport, kTypedOutcomeCount };
+void OwnedFrontTypedNote(uint32_t outcome, uint64_t n = 1);
+void OwnedFrontTypedFallback(const char* reason);  // reason: a string literal (pointer-keyed)
+void OwnedFrontTypedAfter();                       // after a typed draw: the shadows' repeat chain ends
+const char* OwnedFrontPrepareRefusal();             // the last refusal of OwnedFrontPrepare (a Build skip name)
+uint64_t OwnedFrontNowNs();
+void OwnedFrontTypedTick(VulkanCommandProcessor& cp);
+// M4f-B: NativeCoverRect / NativeBoundsRect inputs from the typed state (see owned_front_draw.cpp).
+void OwnedFrontCoverInputs(const OwnedRecordState& s, CoverInputs& in);
+uint64_t OwnedFrontCoverTypedCount();
+void OwnedFrontTypedActive(bool on);  // typed draw running: the shadows (OwnedFrontShadowDraw) do not run for it
+
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/native/owned_front_notify.cpp b/src/graphics/vulkan/native/owned_front_notify.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..75e61146524aa926427c716a5a9a9b892c7daa2e
--- /dev/null
+++ b/src/graphics/vulkan/native/owned_front_notify.cpp
@@ -0,0 +1,172 @@
+// wwe2k14 patch (Session 87 stage 3 / Session 92 M4f-C): the notifications a stored block of constants makes (D3dFeedAccess::Notify) and the cut's processor-side
+// effects (D3dFeedAccess::Cut*). Moved out of d3d_feed.cpp (the old D3D feed, left out of the REX_TRUE_NATIVE_ONLY proof build) so the decoder-as-executor can
+// make them without it. SDK-internal.
+#include "d3d_feed.h"
+
+#include <rex/graphics/vulkan/native/native_renderer.h>
+
+#include <rex/cvar.h>
+#include <rex/graphics/d3d_feed.h>
+#include <rex/graphics/d3d_noring.h>
+#include <rex/graphics/free_counters.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/registers.h>
+
+#include <algorithm>
+#include <cstdint>
+
+REXCVAR_DECLARE(bool, gpu_native_frame_draw);
+
+namespace rex::graphics::vulkan {
+
+namespace {
+constexpr uint32_t kConstLo = 0x4000;  // floats start
+
+bool RangeHasUsage(const uint64_t* usage_map, uint32_t first_constant, uint32_t last_constant) {
+  // (WriteRegistersFromMem's lambda: any bit of [first, last] set in the 256-bit map.)
+  if (first_constant > last_constant) return false;
+  const uint32_t first_word = first_constant >> 6, last_word = last_constant >> 6;
+  const uint32_t first_bit = first_constant & 63, last_bit = last_constant & 63;
+  if (first_word == last_word) {
+    const uint32_t bit_count = last_bit - first_bit + 1;
+    const uint64_t mask = bit_count == 64 ? ~uint64_t(0) : ((uint64_t(1) << bit_count) - 1) << first_bit;
+    return (usage_map[first_word] & mask) != 0;
+  }
+  if (usage_map[first_word] & (~uint64_t(0) << first_bit)) return true;
+  for (uint32_t word = first_word + 1; word < last_word; ++word) {
+    if (usage_map[word]) return true;
+  }
+  const uint64_t last_mask = last_bit == 63 ? ~uint64_t(0) : ((uint64_t(1) << (last_bit + 1)) - 1);
+  return (usage_map[last_word] & last_mask) != 0;
+}
+}  // namespace
+
+// What VulkanCommandProcessor::WriteRegistersFromMem / WriteRegister notify for a piece of one class, made from the record's
+// block (the register file is not touched).
+void D3dFeedAccess::Notify(VCP& cp, Piece piece, uint32_t first, uint32_t count, bool changed) {
+  using SPT = SpirvShaderTranslator;
+  const uint32_t last = first + count - 1;
+  switch (piece) {
+    case Piece::kFloat: {
+      cp.RepeatNoteRegisters(first, count);  // (floats: any write counts)
+      if (cp.frame_open_) {
+        const uint32_t first_constant = (first - kConstLo) >> 2;
+        const uint32_t last_constant = (last - kConstLo) >> 2;
+        if (first_constant < 256 &&
+            RangeHasUsage(cp.current_float_constant_map_vertex_, first_constant, std::min(last_constant, 255u))) {
+          cp.current_constant_buffers_up_to_date_ &= ~(UINT32_C(1) << SPT::kConstantBufferFloatVertex);
+        }
+        if (last_constant >= 256 && RangeHasUsage(cp.current_float_constant_map_pixel_,
+                                                  first_constant >= 256 ? first_constant - 256 : 0, last_constant - 256)) {
+          cp.current_constant_buffers_up_to_date_ &= ~(UINT32_C(1) << SPT::kConstantBufferFloatPixel);
+        }
+      }
+    } break;
+    case Piece::kFetch: {
+      if (changed) cp.RepeatNoteRegisters(first, count);
+      cp.current_constant_buffers_up_to_date_ &= ~(UINT32_C(1) << SPT::kConstantBufferFetch);
+      const uint32_t first_dword = first - 0x4800, last_dword = last - 0x4800;
+      if (first_dword < 6) rex::graphics::free_counters::NoteFetch0Write();  // (Session 92, M3b review P5)
+      if (cp.texture_cache_) cp.texture_cache_->TextureFetchConstantsWritten(first_dword / 6, last_dword / 6);
+      cp.InvalidateVertexBufferResidencyRange(first_dword / 2, last_dword / 2);
+    } break;
+    case Piece::kBoolLoop:
+      if (changed) cp.RepeatNoteRegisters(first, count);
+      cp.current_constant_buffers_up_to_date_ &= ~(UINT32_C(1) << SPT::kConstantBufferBoolLoop);
+      break;
+    case Piece::kOther:
+      if (changed) cp.RepeatNoteRegisters(first, count);
+      break;
+  }
+}
+// ---- Session 92, M4f-C: the cut (see d3d_feed.h). The decoder stores a block into its typed state, then asks for the notifications: they are Notify's
+// own (the one body above), preceded by the fetch source (so the texture cache and the object table read the typed fetch words) and followed by the
+// census of what was really marked.
+void D3dFeedAccess::CutFetchSource(CommandProcessor& base, const uint32_t* words) {
+  VCP& cp = static_cast<VCP&>(base);
+  if (cp.texture_cache_) cp.texture_cache_->SetFetchSource(words);
+}
+
+void D3dFeedAccess::CutNotify(CommandProcessor& base, Piece piece, uint32_t first, uint32_t count, bool changed, const uint32_t* fetch_words) {
+  using SPT = SpirvShaderTranslator;
+  namespace fc = rex::graphics::free_counters;
+  VCP& cp = static_cast<VCP&>(base);
+  if (piece == Piece::kOther) return;  // (the old Notify's kOther made only RepeatNoteRegisters: the decoder's dirty epochs replace it)
+  if (fetch_words && cp.texture_cache_) cp.texture_cache_->SetFetchSource(fetch_words);
+  const uint32_t before = cp.current_constant_buffers_up_to_date_;
+  Notify(cp, piece, first, count, changed);
+  const uint32_t marked = before & ~cp.current_constant_buffers_up_to_date_;  // the buffers that were up to date and are not any more
+  fc::CutCounters& c = fc::g_cut;
+  switch (piece) {
+    case Piece::kFloat:
+      ++c.float_runs;
+      c.float_marks_vs += (marked >> SPT::kConstantBufferFloatVertex) & 1u;
+      c.float_marks_ps += (marked >> SPT::kConstantBufferFloatPixel) & 1u;
+      break;
+    case Piece::kFetch:
+      ++c.fetch_runs;
+      c.fetch_marks += (marked >> SPT::kConstantBufferFetch) & 1u;
+      c.fetch_texture_notes += cp.texture_cache_ ? 1u : 0u;  // (TextureFetchConstantsWritten(first, last) + the object table's OnFetchWritten)
+      ++c.fetch_vertex_ranges;                               // (InvalidateVertexBufferResidencyRange)
+      break;
+    case Piece::kBoolLoop:
+      ++c.bool_runs;
+      c.bool_marks += (marked >> SPT::kConstantBufferBoolLoop) & 1u;
+      break;
+    default:
+      break;
+  }
+}
+
+uint64_t D3dFeedAccess::CutLoadShader(CommandProcessor& base, uint32_t type, uint32_t address, const uint32_t* microcode, uint32_t dwords) {
+  VCP& cp = static_cast<VCP&>(base);
+  // (the token handler's SHADER item: LoadShader keyed by the microcode itself, the active shader of the stage)
+  Shader* shader = cp.LoadShader(type == 0 ? xenos::ShaderType::kVertex : xenos::ShaderType::kPixel, address, microcode, dwords);
+  if (type == 0) {
+    cp.active_vertex_shader_ = shader;
+  } else {
+    cp.active_pixel_shader_ = shader;
+  }
+  return shader ? shader->ucode_data_hash() : 0;
+}
+
+bool D3dFeedAccess::CutReady(CommandProcessor& base) {
+  VCP& cp = static_cast<VCP&>(base);
+  return cp.native_ && cp.native_->enabled();
+}
+
+void D3dFeedAccess::CutBinOp(CommandProcessor& base, uint32_t op, uint32_t a) {
+  VCP& cp = static_cast<VCP&>(base);
+  // The tiling predication state, as the four SET_BIN_* packet cases set it (each side has its own) - the Registers item's code in d3d_noring.cpp.
+  const auto apply = [&] {
+    if (op == d3d_noring_field::kRegsOpBinMaskLo) {
+      cp.bin_mask_ = (cp.bin_mask_ & 0xFFFFFFFF00000000ull) | a;
+      cp.BinMaskWritten("mask_lo");
+    } else if (op == d3d_noring_field::kRegsOpBinMaskHi) {
+      cp.bin_mask_ = (cp.bin_mask_ & 0xFFFFFFFFull) | (static_cast<uint64_t>(a) << 32);
+      cp.BinMaskWritten("mask_hi");
+    } else {
+      const uint64_t old_select = cp.bin_select_;
+      if (op == d3d_noring_field::kRegsOpBinSelectLo) {
+        cp.bin_select_ = (cp.bin_select_ & 0xFFFFFFFF00000000ull) | a;
+        cp.BinSelectWritten("sel_lo", old_select);
+      } else {
+        cp.bin_select_ = (cp.bin_select_ & 0xFFFFFFFFull) | (static_cast<uint64_t>(a) << 32);
+        cp.BinSelectWritten("sel_hi", old_select);
+      }
+    }
+  };
+  if (cp.nf_ && cp.nf_role_ == VCP::NfRole::kAnswers) {
+    if (REXCVAR_GET(gpu_native_frame_draw)) {  // (the drawing side's predication first, then the answers side's)
+      cp.NfEnterDraw();
+      apply();
+      cp.NfLeaveDraw();
+    }
+    apply();
+  } else {
+    apply();
+  }
+}
+
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/native/owned_front_own.cpp b/src/graphics/vulkan/native/owned_front_own.cpp
