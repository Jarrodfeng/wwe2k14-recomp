+// wwe2k14 patch (Session 92, M2d, Part 3): the pending value of a dead depth clear (owned_post.cpp OwnedDeadDepthClear) and the per-window order log
+// of {scene depth copy, dead depth clear, colour-only pass given depth}. File-level state shared by owned_post.cpp, owned_scene.cpp and
+// owned_steps.cpp (no header the game exe includes changes). Docs: docs\native\d3d\S92_M1A_BOX_READ.md section A.
+#include <cstdint>
+#include <string>
+
+namespace rex::graphics::vulkan::native {
+
+// Session 92, M4f-B (gpu_d3d_owned_front bit 64): the PENDING CLEAR of a surface slot - ONE mechanism. M2d's dead depth clear (a depth-only whole clear the
+// owned frame leaves undrawn: "dead", nothing of ours is cleared) is one origin of it; the others are the clears the owned frame could not begin a pass with
+// (a record clear D3dClear was refused, held clears dropped at a flush, pending depth-only clears flushed / dropped). One record per slot (a colour value, or
+// depth + stencil), the slot's content until a newer holder appears (E1: tick compare); consumed by the slot's next pass start (a colour clear is held again
+// just before the draw: OwnedPendClearMaterialize; a depth value is given to a colour-only pass by E1) or by a copy of the slot (the defined fill writer with
+// the value); never consumed = dropped at the frame's end, counted (the dead depth clear stays across frames, as M2d made it).
+// Docs: docs\native\d3d\S92_M4F_DESIGN.md section 2.
+enum OwnedPendOrigin : uint8_t { kPendDead = 0, kPendRefusal, kPendHeldDrop, kPendDepthFlush, kPendDepthDrop, kPendOriginCount };
+struct OwnedPendClearRec {
+  int32_t slot = -1;
+  bool colour = false;  // true: a colour clear (colour_value, rect); false: depth (+ stencil)
+  float colour_value[4] = {};
+  uint32_t colour_mask = 0;  // the clear's colour write mask (a copy fills only a whole 0xF)
+  float depth = 0.0f;
+  uint32_t stencil = 0;
+  bool stencil_written = false;
+  uint32_t box_w = 0, box_h = 0;                 // guest pixels, from the origin (0 = a clear that does not start at the origin: no box)
+  int32_t rect[4] = {};                          // host pixels (TruthDrawRect)
+  uint32_t base = 0, pitch_tiles = 0, kind = 0;  // a colour clear: the surface it clears (the copy's lookup)
+  uint64_t frame = 0;                            // the registry epoch (truth_claim_epoch_) it was made in
+  uint64_t tick = 0;                             // owned_tick_ then
+  uint8_t origin = kPendDead;
+  bool used = false;  // consumed at least once (E1 gave depth from it / a copy was filled from it)
+};
+using OwnedDeadDClearRec = OwnedPendClearRec;  // (M2d's name, still the type E1 reads)
+constexpr size_t kPendClearMax = 8;
+extern OwnedPendClearRec g_pend_clear[kPendClearMax];
+extern uint32_t g_m2d_draw_index;  // draws seen by OwnedTakeDrawImpl this frame (reset at the frame's end) - the order log's draw index
+
+// Part 4 (the 512x512 box copies written as a composite): the destination pages of those copies are watched - who samples them afterwards is logged
+// (a texture request of the page: its size and format; the draw that follows: its shaders). Logs the first 12, then stays silent.
+void M2dWatchAdd(uint32_t page);
+void M2dWatchRead(uint32_t page, uint64_t frame, uint32_t w, uint32_t h, uint32_t format);
+void M2dWatchDraw(uint64_t frame, uint64_t vs, uint64_t ps);
+
+// The pending DEPTH clear of the slot made in the registry epoch `epoch`, or null (colour pends are not answered here).
+const OwnedDeadDClearRec* DeadDClearFor(int32_t slot, uint64_t epoch);  // (epoch = NativeRenderer::truth_claim_epoch_)
+// Bit 64 of gpu_d3d_owned_front with bit 32 (M4f-B on): the hold is effective, refusals pend, the flush drops feed the pend table.
+bool OwnedPendBitOn();
+// D3dClear's (d3d_copy_records.cpp) own refusals, counted in the window line: 0-4 a clear that could not be pended (preconditions / stencil only / colour format
+// without a class / no surface slot / no value), 5 an empty rectangle (nothing to clear, handled).
+void OwnedPendNoteRefusal(int kind);
+// Monotonic count of empty-rectangle clears handled by D3dClear (Execute does not count those as held).
+uint32_t OwnedPendEmptyTotal();
+// The frame end flushes held clears / pending depth clears that nothing used: they are dropped there, not pended (counted on their own).
+void OwnedPendSetFrameEnd(bool on);
+// A re-held pended clear of this colour slot became a pass: it is no longer on the retry list.
+void OwnedPendRetryDone(int32_t slot);
+// E1 gave a colour-only pass depth from this pending clear (counted; the record is marked used).
+void PendNoteGivenDepth(const OwnedPendClearRec* r);
+// The `[native][pend]` window line (Session 92, M4f-B); resets its counters. Printed only when bit 64 is on or something was counted.
+void OwnedPendPrint(uint64_t first_frame, uint64_t frames);
+// One line of the order log ([native][owned-only][order]); the caller passes whether this is one of the window's first 4 frames.
+void M2dOrderLog(bool wanted, uint64_t frame, const char* what, const std::string& detail);
+
+}  // namespace rex::graphics::vulkan::native
+
+namespace rex::graphics::vulkan {
+// render_target_cache.cpp (M2d review E2 / E4 / E5): the cache made no EDRAM buffer; stock EDRAM paths asked for anyway (and those before the renderer's first frame boundary).
+bool M2dEdramLess();
+uint32_t M2dEdramLessDrops();
+uint32_t M2dEdramLessBootDrops();
+void M2dRendererFrameSeen();
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/native/owned_entry.cpp b/src/graphics/vulkan/native/owned_entry.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..aae584269d46e68d8df97c9838e0249cb2818ab3
--- /dev/null
+++ b/src/graphics/vulkan/native/owned_entry.cpp
@@ -0,0 +1,235 @@
+// wwe2k14 patch (Session 92, M2b; docs\native\d3d\S92_M2_DESIGN.md sections 2.2, 2.3 and 3 "M2b", contract docs\native\d3d\S92_M2BC_CONTRACT.md):
+// the owned entry and the surface registry of the owned-only latch (gpu_native_owned_only, owned_steps.cpp).
+//
+// Under the latch nothing is handed to a truth path - there is none to hand to. A draw the command processor offers is claimed by OwnedClaim (always
+// true: a draw it cannot record is claimed and dropped, counted by reason) and entered by OwnedEnter (OwnedTakeDraw, else OwnedDropDraw); the truth
+// claim (ClaimTruth) and the truth recorder (TruthRecordDraw) are not called. A surface is identified by the game's own surface words - base, pitch in
+// 80-sample tiles, class, format; what the bound surface object holds - never by the EDRAM tiles it would share with another surface on the console
+// (CLAUDE.md hard rule 6). The registry (owned_surfaces_) is a list of those keys: no image, no tile, no owner map. The slot stays an int16_t, so every
+// owned-code use of Draw::truth_color / truth_depth and OwnedPass::color_slot / depth_slot keeps its meaning; only the table behind it changes
+// (owned_surf_mode_: the whole frame reads one table).
+
+#include <rex/graphics/vulkan/native/native_renderer.h>
+#include "native_truth_reasons.h"
+
+#include <algorithm>
+#include <array>
+#include <vector>
+#include <string_view>
+
+#include <rex/cvar.h>
+#include <rex/graphics/vulkan/command_processor.h>
+#include <rex/logging.h>
+
+#include "owned_front_draw.h"
+
+REXCVAR_DECLARE(uint32_t, gpu_d3d_owned_front);
+REXCVAR_DECLARE(int32_t, gpu_native_truth_debug_draws);
+REXCVAR_DECLARE(bool, gpu_native_truth_async_pipelines);
+REXCVAR_DECLARE(bool, async_shader_compilation);
+REXCVAR_DECLARE(bool, gpu_native_truth_pipeline_wait_offscreen);
+REXCVAR_DECLARE(int32_t, gpu_native_truth_pipeline_skip_min_pitch);
+REXCVAR_DECLARE(int32_t, gpu_native_truth_pipeline_skip_max_pitch);
+
+namespace rex::graphics::vulkan::native {
+
+namespace {
+
+// (The reason codes are native_truth_reasons.h's.)
+constexpr size_t kMaxSurfaces = 512;  // (no image behind a key: far more than the truth images' 96)
+
+struct EntryStats {
+  uint64_t claims = 0, lean = 0, repeat = 0;
+  uint32_t surfaces_new = 0, would_alias = 0, table_full = 0;
+};
+EntryStats g_entry;
+
+}  // namespace
+
+// The window line's figures (owned_steps.cpp OwnedFrameSummary).
+void OwnedEntryCounters(uint64_t& claims, uint64_t& lean, uint64_t& repeat, uint32_t& surfaces_new, uint32_t& would_alias, uint32_t& table_full, bool reset) {
+  claims = g_entry.claims;
+  lean = g_entry.lean;
+  repeat = g_entry.repeat;
+  surfaces_new = g_entry.surfaces_new;
+  would_alias = g_entry.would_alias;
+  table_full = g_entry.table_full;
+  if (reset) g_entry = EntryStats();
+}
+
+int16_t NativeRenderer::OwnedFindSurface(uint32_t base, uint32_t pitch_tiles, uint32_t kind, uint32_t format) {
+  for (size_t i = 0; i < owned_surfaces_.size(); ++i) {
+    const OwnedSurface& s = owned_surfaces_[i];
+    if (s.base == base && s.pitch_tiles == pitch_tiles && s.kind == kind && s.format == format) return int16_t(i);
+  }
+  if (owned_surfaces_.size() >= kMaxSurfaces) {
+    // (review F3: "table full" counts keys refused, once each - a small set of the refused keys; the draws they drop are counted by OwnedNoteClaimDrop)
+    static std::vector<std::array<uint32_t, 4>> refused;
+    const std::array<uint32_t, 4> key = {base, pitch_tiles, kind, format};
+    if (std::find(refused.begin(), refused.end(), key) == refused.end() && refused.size() < 256) {
+      refused.push_back(key);
+      ++g_entry.table_full;
+    }
+    return -1;
+  }
+  // A new key. Diagnostic (design 2.3, last bullet): on the console a surface at this base with other words would have shared its pixels with this one;
+  // here they are two surfaces and the new one starts defined. Counted as an upper bound of "would-have-aliased" (a key sharing a base with an earlier key,
+  // whether or not its first use reads anything) - the first ones named. Unconfirmed which of them read before a write: judged by pictures.
+  for (const OwnedSurface& s : owned_surfaces_) {
+    if (s.base != base || s.base == kTruthScratchBase) continue;
+    ++g_entry.would_alias;
+    static uint32_t logged = 0;
+    if (logged < 12) {
+      ++logged;
+      REXGPU_INFO("[native][owned-only] frame {}: new surface key base {} pitch {} kind {} format {} shares its base with base {} pitch {} kind {} format {} "
+                  "(on the console they would share pixels; here two surfaces, the new one starts defined)",
+                  frame_, base, pitch_tiles, kind, format, s.base, s.pitch_tiles, s.kind, s.format);
+    }
+    break;  // (one count per new key)
+  }
+  OwnedSurface& added = owned_surfaces_.emplace_back();
+  added.base = base;
+  added.pitch_tiles = pitch_tiles;
+  added.kind = kind;
+  added.format = format;
+  added.first_frame = uint32_t(frame_);
+  ++g_entry.surfaces_new;
+  return int16_t(owned_surfaces_.size() - 1);
+}
+
+int16_t NativeRenderer::SurfaceSlot(uint32_t base, uint32_t pitch_tiles, uint32_t kind, uint32_t format) {
+  return owned_surf_mode_ ? OwnedFindSurface(base, pitch_tiles, kind, format) : TruthFindImage(base, pitch_tiles, kind, format);
+}
+
+NativeRenderer::OwnedSurface NativeRenderer::OwnedSlotKey(int16_t slot) const {
+  OwnedSurface key;
+  if (slot < 0) return key;
+  if (owned_surf_mode_) {
+    if (size_t(slot) < owned_surfaces_.size()) key = owned_surfaces_[slot];
+  } else if (size_t(slot) < truth_images_.size()) {
+    const TruthImage& t = truth_images_[slot];
+    key.base = t.base;
+    key.pitch_tiles = t.pitch_tiles;
+    key.kind = t.kind;
+    key.format = t.format;
+  }
+  return key;
+}
+
+int NativeRenderer::OwnedSourceDrawn(uint32_t base, uint32_t row_tiles, bool depth) const {
+  // Whether a pass of ours ever drew the surface a copy reads (the registry key: base and pitch, any class of the kind; M2c's "find out first").
+  int best = 0;
+  for (const OwnedSurface& s : owned_surfaces_) {
+    if (s.base != base || (s.kind == 3) != depth) continue;
+    if (s.row_tiles() != row_tiles && s.pitch_tiles != row_tiles) continue;
+    if (!s.last_draw_frame) best = std::max(best, 1);
+    else best = std::max(best, s.last_draw_frame == uint32_t(frame_) + 1 ? 3 : 2);
+  }
+  return best;
+}
+
+bool NativeRenderer::OwnedClaim(Draw& draw) {
+  ++g_entry.claims;
+  // Session 92, M4b (gpu_d3d_owned_front bit 1): the same description built from the record decoder's typed state, compared with this one.
+  if (REXCVAR_GET(gpu_d3d_owned_front) & 2u) OwnedFrontShadowDraw(command_processor_, draw, kOwnedFrontFull);
+  // Always claimed: a refusal (a TruthReason - the limits of our pipelines) claims the draw and OwnedEnter drops it, counted and named by the reason.
+  const auto refuse = [&](uint32_t reason) {
+    OwnedNoteClaimDrop(reason, draw);
+    draw.claim_refused = uint8_t(reason);
+    draw.truth = draw.post = draw.owned = true;
+    draw.truth_epoch = truth_claim_epoch_;
+    return true;
+  };
+  const uint32_t reason = TruthReason(draw, true);
+  if (reason) return refuse(reason);
+  if (const int32_t limit = REXCVAR_GET(gpu_native_truth_debug_draws); limit > 0 && truth_frame_draws_ >= limit) return refuse(kTruthDebug);
+  ++truth_frame_draws_;
+  const uint32_t msaa = (draw.surface_info >> 16) & 3;  // 0 1x, 1 2x, 2 4x
+  const uint32_t sx = msaa >= 2 ? 2 : 1, sy = msaa >= 1 ? 2 : 1;
+  const uint32_t pitch_tiles = std::max(1u, ((draw.surface_info & 0x3FFF) * sx + 79) / 80);
+  const bool writes_color = (draw.color_write_mask & 0xF) != 0;
+  const bool uses_depth = draw.raster.depth_test || draw.raster.depth_write || draw.raster.stencil;
+  int16_t color = -1, depth = -1;
+  if (writes_color) {
+    color = OwnedFindSurface(draw.color_info & 0xFFF, pitch_tiles, TruthClass(draw), (draw.color_info >> 16) & 0xF);
+    if (color < 0) return refuse(kTruthImages);
+    owned_surfaces_[color].last_draw_frame = uint32_t(frame_) + 1;
+  }
+  if (uses_depth) {
+    depth = OwnedFindSurface(draw.depth_info & 0xFFF, pitch_tiles, 3, (draw.depth_info >> 16) & 1);
+    if (depth < 0) return refuse(kTruthImages);
+    owned_surfaces_[depth].last_draw_frame = uint32_t(frame_) + 1;
+  }
+  // (No stencil tile proof: stencil is ours - kept in our depth images; a stencil draw on a surface whose stencil we never wrote starts from 0, counted by
+  // OwnedCountUnprovenStencil's successors in the pass code.)
+  draw.truth = true;
+  draw.post = true;
+  draw.truth_color = color;
+  draw.truth_depth = depth;
+  draw.truth_class = uint8_t(writes_color ? TruthClass(draw) : 1u);
+  draw.truth_sx = uint8_t(sx);
+  draw.truth_sy = uint8_t(sy);
+  // The async pipeline skip, as the truth claim has it (Session 47 / 55 / 57 / 58): a pipeline being made on the worker thread - the draw is claimed and
+  // skipped (OwnedDropDraw counts "skipped for no pipeline") - only for a screen-wide surface; a narrower one waits for its pipeline instead.
+  bool pending = false;
+  const bool async = REXCVAR_GET(gpu_native_truth_async_pipelines) && REXCVAR_GET(async_shader_compilation);
+  const bool may_skip = (pitch_tiles >= uint32_t(REXCVAR_GET(gpu_native_truth_pipeline_skip_min_pitch)) &&
+                         pitch_tiles <= uint32_t(REXCVAR_GET(gpu_native_truth_pipeline_skip_max_pitch))) ||
+                        !REXCVAR_GET(gpu_native_truth_pipeline_wait_offscreen);
+  const size_t pipelines_before = pipelines_.size();
+  draw.pipeline = GetPipeline(draw, async && may_skip ? &pending : nullptr);
+  if (async && !may_skip && pipelines_.size() != pipelines_before) ++truth_counts_.waited;
+  if (pending) {
+    ++truth_counts_.compiling;
+    draw.owned = true;
+    draw.truth_epoch = truth_claim_epoch_;
+    return true;
+  }
+  if (draw.pipeline == VK_NULL_HANDLE) {
+    draw.truth = draw.post = false;
+    return refuse(kTruthNoPipeline);  // (as the truth claim under the latch had it)
+  }
+  draw.owned = true;
+  draw.truth_epoch = truth_claim_epoch_;
+  return true;
+}
+
+// A repeat has its base's registers but for the constants (the command processor's repeat path): whatever OwnedClaim found for the base holds for it. The
+// registry only grows, so a slot never goes stale within a mode (the epoch is bumped when the mode changes). No allocation: this is hot (CPU).
+bool NativeRenderer::OwnedClaimRepeat(Draw& draw) {
+  if (!draw.truth || !draw.owned || !truth_ || !replacing_ || draw.truth_epoch != truth_claim_epoch_ || draw.occlusion_query ||
+      draw.pipeline == VK_NULL_HANDLE || REXCVAR_GET(gpu_native_truth_debug_draws) > 0 || (draw.raster.stencil && !draw.fast_clear)) {
+    return Claim(draw);
+  }
+  if (REXCVAR_GET(gpu_d3d_owned_front) & 2u) OwnedFrontShadowDraw(command_processor_, draw, kOwnedFrontRepeat);
+  ++g_entry.repeat;
+  declined_pending_ = false;
+  claim_retry_ = false;
+  draw.declined = false;
+  ++truth_frame_draws_;
+  return true;
+}
+
+bool NativeRenderer::OwnedClaimLean(Draw& draw) {
+  if (!draw.truth || !draw.owned || !truth_ || !replacing_ || draw.truth_epoch != truth_claim_epoch_ || draw.occlusion_query ||
+      draw.pipeline == VK_NULL_HANDLE || REXCVAR_GET(gpu_native_truth_debug_draws) > 0 || (draw.raster.stencil && !draw.fast_clear) || draw.fast_clear ||
+      draw.xfb_buffer != VK_NULL_HANDLE) {  // (Session 61: a captured draw's copy would capture into its range again)
+    return false;
+  }
+  if (REXCVAR_GET(gpu_d3d_owned_front) & 2u) OwnedFrontShadowDraw(command_processor_, draw, kOwnedFrontLean);
+  ++g_entry.lean;
+  declined_pending_ = false;
+  claim_retry_ = false;
+  draw.declined = false;
+  ++truth_frame_draws_;
+  return true;
+}
+
+void NativeRenderer::OwnedEnter(const Draw& draw) {
+  // TruthRecordDraw's latch branch, without the truth recorder: the owned frame takes the draw, else it is dropped (counted, named). A claim that was
+  // refused (a TruthReason) is a drop at once; a draw with no pipeline yet is skipped there, as ever.
+  if (!draw.claim_refused && OwnedTakeDraw(draw)) return;
+  OwnedDropDraw(draw);
+}
+
+}  // namespace rex::graphics::vulkan::native
diff --git a/src/graphics/vulkan/native/owned_front_bind.cpp b/src/graphics/vulkan/native/owned_front_bind.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7b5c6a0ec81af5859f57583454fb7b65efc9b262
--- /dev/null
+++ b/src/graphics/vulkan/native/owned_front_bind.cpp
@@ -0,0 +1,720 @@
+// wwe2k14 patch (Session 92, M4c; contract S92_M4C_CONTRACT.md): the shader constants and the binding contents from the record decoder's typed
+// state, as a SHADOW (owned_front_bind.h). Pure logic over plain data; the processor's private members are gathered by OwnedFrontAccess
+// (owned_front_draw.cpp).
+//
+// What is built, from which typed fields (OwnedRecordState):
+//   system constants   BuildSystemConstants = UpdateSystemConstantValuesFull restated over the typed fields (surface info, colour control,
+//                      depth info, VTE / clip control, point size, VGT words, user clip planes, tessellation levels, blend colour...) plus the
+//                      draw derivations M4b made (primitive result, viewport NDC, normalized masks); the texture part from the used fetch
+//                      constants (signs: texture_util::SwizzleSigns of the typed fetch words).
+//   float banks        GatherFloat: s.vs_float / s.ps_float through the shader's constant map (packed in register order, as the ring holds them).
+//   bool / loop, fetch s.bool_loop, s.fetch as they are.
+//   texture keys       TypedBinding: the fetch constant's texture key (and, with --gpu_d3d_textures=2, the bound game object's), compared with the
+//                      texture cache's active binding (GetActiveTextureInfo).
+//   vertex ranges      the vertex fetch words' (address, size), compared with the processor's vertex buffer states.
+// Compared with the old path's bytes / states; mismatches counted by block and field, the first of each logged (cap 96).
+//
+//   views, samplers    OwnedFrontAccess (owned_front_draw.cpp) derives the texture key and host swizzle of each used fetch constant, finds the texture and its
+//                      view find-only (FindTextureOnly / FindView) and the sampler by its typed parameters; compared with the raw views and the
+//                      samplers the old path bound.
+// NOT built here: the descriptor sets / dynamic offsets (they exist only by uploading into the ring and writing descriptors, which a shadow must not
+// do); M4b copies them, M4f builds them when it owns the draw.
+#include "owned_front_bind.h"
+
+#include <rex/cvar.h>
+#include <rex/graphics/d3d_tex.h>
+#include <rex/graphics/pipeline/render_target/cache.h>
+#include <rex/graphics/pipeline/texture/info.h>
+#include <rex/graphics/pipeline/texture/util.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/logging.h>
+
+#include <algorithm>
+#include <bit>
+#include <chrono>
+#include <cstddef>
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+REXCVAR_DECLARE(bool, gpu_depth_of_field);
+REXCVAR_DECLARE(bool, gpu_allow_invalid_fetch_constants);
+
+namespace rex::graphics::vulkan {
+
+namespace {
+
+using SC = SpirvShaderTranslator::SystemConstants;
+using ST = SpirvShaderTranslator;
+
+// ---------------------------------------------------------------------------------------------------------------------------------
+// the window
+struct Window {
+  uint64_t built = 0;     // draws the typed side built constants and bindings for
+  uint64_t compared = 0;  // ... and compared with the old path's
+  uint64_t mismatch_draws = 0;
+  std::map<std::string, uint64_t> by_field;       // "block.field" -> draws
+  std::map<std::string, uint64_t> not_built;      // reason -> draws
+  uint64_t bytes_sys = 0, bytes_float = 0;        // compared bytes (the bar's "built" evidence)
+  uint64_t textures_checked = 0, vfetch_checked = 0, views_checked = 0, samplers_checked = 0, skipped_3d_views = 0;
+  uint64_t scaled_from_cache = 0;                 // draws whose texture resolution-scaled bits came from the texture cache (scale > 1)
+  uint64_t fsi_masked = 0, crowd_c76_skipped = 0, banks_skipped = 0, native_views = 0;  // see the window line
+  uint64_t history_only = 0;                     // draws where only bytes the shaders do not read (gated out) differed from the ring
+  uint64_t layout_found = 0, layout_fallback = 0, layout_differs = 0;
+  uint64_t build_ns = 0;
+};
+Window g_w;
+Window g_winl;                // M4e: the inline draws' window (swapped with g_w around their claims)
+bool g_inline_bucket = false;  // ... and the log keys of their mismatches are their own
+std::set<std::string> g_logged_fields;
+uint32_t g_logged = 0;
+
+bool g_ds_enabled = false;  // BuildSystemConstants: depth_stencil_enabled (the FSI rule)
+SC g_sc{};  // the typed side's persistent block (the old path's system_constants_ is zeroed at setup and written field by field)
+
+inline uint64_t NowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+struct Cmp {
+  const OwnedBindInputs& in;
+  bool any = false;
+  void Note(const std::string& key, const char* what, uint64_t old_v, uint64_t typed_v) {
+    any = true;
+    ++g_w.by_field[key];
+    if (g_logged < 96 && g_logged_fields.insert(g_inline_bucket ? "inline " + key : key).second) {
+      ++g_logged;
+      REXGPU_INFO("[d3d][front] {} mismatch #{}: {} ({}) old {:X} typed {:X} (frame {}, claim {}, vertex shader {:016X}, pixel shader {:016X})",
+                  g_inline_bucket ? "M4e inline (M4c builders)" : "M4c", g_logged, key, what, old_v, typed_v, in.frame, in.kind == 0 ? "full" : in.kind == 1 ? "lean" : "repeat", in.vs_hash, in.ps_hash);
+    }
+  }
+};
