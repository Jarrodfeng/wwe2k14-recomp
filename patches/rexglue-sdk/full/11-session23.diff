   // for it) gets per-register writes instead of splitting again.
   bool type0_block_split_in_constant_block_ = false;
 
+  // wwe2k14 patch (Session 23, REPEAT): what the guest changed since the backend last recorded a draw, for
+  // repeat draws (a draw that only changes vertex shader float constants against the one before it). Set by every
+  // register write path (WriteRegister, the type-0 split / one-register stores, the backends' bulk constant
+  // writes) and by every type-3 packet other than draws, constant loads, NOPs and indirect buffers; the backend
+  // clears it when it records a draw. The draw packet's own VGT_DRAW_INITIATOR / VGT_DMA_BASE / VGT_DMA_SIZE are
+  // not counted (the backend compares the draw parameters itself). Only bits, so the cost while unused is a few
+  // compares per register write.
+  enum RepeatDirtyBits : uint32_t {
+    kRepeatDirtyVsFloat = 1u << 0,
+    kRepeatDirtyPsFloat = 1u << 1,
+    kRepeatDirtyFetch = 1u << 2,
+    kRepeatDirtyBoolLoop = 1u << 3,
+    kRepeatDirtyOther = 1u << 4,
+    kRepeatDirtyPacket = 1u << 5,
+  };
+  uint32_t repeat_dirty_ = UINT32_MAX;
+  // The first register (kRepeatDirtyOther) / type-3 opcode (kRepeatDirtyPacket) that set the bit, for statistics.
+  uint32_t repeat_first_other_register_ = 0;
+  uint32_t repeat_first_packet_opcode_ = 0;
+  void RepeatNoteRegisters(uint32_t first, uint32_t count) {
+    uint32_t last = first + count - 1;
+    if (first >= 0x4000 && last <= 0x47FF) {
+      // Float constants: 0x4000-0x43FF vertex, 0x4400-0x47FF pixel.
+      if (first <= 0x43FF) {
+        repeat_dirty_ |= kRepeatDirtyVsFloat;
+      }
+      if (last >= 0x4400) {
+        repeat_dirty_ |= kRepeatDirtyPsFloat;
+      }
+    } else if (first >= 0x4800 && last <= 0x48BF) {
+      repeat_dirty_ |= kRepeatDirtyFetch;
+    } else if (first >= 0x4900 && last <= 0x4927) {
+      repeat_dirty_ |= kRepeatDirtyBoolLoop;
+    } else if (count == 1 && (first == 0x21FC || first == 0x21FA || first == 0x21FB)) {
+      // VGT_DRAW_INITIATOR, VGT_DMA_BASE, VGT_DMA_SIZE: written by the draw packet itself.
+    } else {
+      if (!(repeat_dirty_ & kRepeatDirtyOther)) {
+        repeat_first_other_register_ = first;
+      }
+      repeat_dirty_ |= kRepeatDirtyOther;
+    }
+  }
+  void RepeatNotePacket(uint32_t opcode) {
+    if (!(repeat_dirty_ & kRepeatDirtyPacket)) {
+      repeat_first_packet_opcode_ = opcode;
+    }
+    repeat_dirty_ |= kRepeatDirtyPacket;
+  }
+
