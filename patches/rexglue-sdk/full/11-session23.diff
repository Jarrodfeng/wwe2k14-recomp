+bool VulkanCommandProcessor::RepeatIsSameDraw(const Shader* vertex_shader, uint32_t prim_type,
+                                              uint32_t index_count, const IndexBufferInfo* index_buffer_info,
+                                              bool major_mode_explicit, uint64_t epoch) const {
+  const RepeatPrev& prev = repeat_prev_;
+  return prev.valid && prev.vertex_shader == vertex_shader && prev.pixel_shader == active_pixel_shader() &&
+         prev.prim_type == prim_type && prev.index_count == index_count &&
+         prev.indexed == (index_buffer_info != nullptr) && prev.major_mode_explicit == major_mode_explicit &&
+         (!index_buffer_info || (prev.index_guest_base == index_buffer_info->guest_base &&
+                                 prev.index_length == uint32_t(index_buffer_info->length) &&
+                                 prev.index_format == uint32_t(index_buffer_info->format) &&
+                                 prev.index_endianness == uint32_t(index_buffer_info->endianness))) &&
+         prev.submission == GetCurrentSubmission() && prev.frame == frame_current_ && prev.epoch == epoch;
+}
+
+void VulkanCommandProcessor::RepeatFastStatsMaybeLog() {
+  RepeatFastStats& s = repeat_fast_stats_;
+  if (s.window_first_frame == UINT64_MAX) {
+    s.window_first_frame = frame_current_;
+    return;
+  }
+  if (frame_current_ - s.window_first_frame < 300) {
+    return;
+  }
+  double frames = double(frame_current_ - s.window_first_frame);
+  if (s.candidates) {
+    REXGPU_INFO(
+        "[s23][REPEATFAST] frames {}-{}, per frame: repeat draws {:.1f}, fast {:.1f}; full path because of: "
+        "mode {:.1f}, other constant buffers out of date {:.1f}, bindings changed {:.1f}, upload {:.1f}; "
+        "merged as instances {:.1f}",
+        s.window_first_frame, frame_current_ - 1, double(s.candidates) / frames, double(s.fast) / frames,
+        double(s.fallback_mode) / frames, double(s.fallback_buffers) / frames,
+        double(s.fallback_bound) / frames, double(s.fallback_upload) / frames, double(s.merged) / frames);
+  }
+  s = RepeatFastStats();
+  s.window_first_frame = frame_current_;
+}
+
+uint32_t VulkanCommandProcessor::RepeatMergeStrideVec4(const Shader& shader) const {
+  if (!repeat_merge_latched_ ||
+      std::find(repeat_merge_shaders_.begin(), repeat_merge_shaders_.end(), shader.ucode_data_hash()) ==
+          repeat_merge_shaders_.end()) {
+    return 0;
+  }
+  const Shader::ConstantRegisterMap& map = shader.constant_register_map();
+  if (map.float_dynamic_addressing || !map.float_count) {
+    return 0;
+  }
+  // The distance between two consecutive uploads of the shader's constants (UpdateBindings / RepeatDrawFast
+  // request float_count vec4s with this alignment from the same pool page).
+  uint32_t stride = uint32_t(rex::align(size_t(map.float_count) * 16, size_t(repeat_merge_alignment_)) / 16);
+  // At least two instances must fit in the 256-vec4 range.
+  return (stride <= 127 && stride + map.float_count <= 256) ? stride : 0;
+}
+
+void VulkanCommandProcessor::ChainProbeDraw(const Shader& vertex_shader, const Shader* pixel_shader) {
+  if (std::find(chain_probe_shaders_.begin(), chain_probe_shaders_.end(), vertex_shader.ucode_data_hash()) ==
+      chain_probe_shaders_.end()) {
+    return;
+  }
+  const RegisterFile& regs = *register_file_;
+  uint64_t h = UINT64_C(14695981039346656037);
+  auto mix = [&h](const void* data, size_t size) {
+    const uint8_t* bytes = static_cast<const uint8_t*>(data);
+    for (size_t i = 0; i < size; ++i) {
+      h = (h ^ bytes[i]) * UINT64_C(1099511628211);
+    }
+  };
+  const void* shader_ids[2] = {&vertex_shader, pixel_shader};
+  mix(shader_ids, sizeof(shader_ids));
+  for (uint32_t stage = 0; stage < 2; ++stage) {
+    const Shader* shader = stage ? pixel_shader : &vertex_shader;
+    if (!shader) {
+      continue;
+    }
+    const Shader::ConstantRegisterMap& map = shader->constant_register_map();
+    for (uint32_t i = 0; i < 4; ++i) {
+      uint64_t bits = map.float_bitmap[i];
+      uint32_t bit;
+      while (bit_inline::bit_scan_forward(bits, &bit)) {
+        bits &= ~(UINT64_C(1) << bit);
+        mix(&regs[XE_GPU_REG_SHADER_CONSTANT_000_X + (stage ? 1024 : 0) + ((i * 64 + bit) << 2)], 16);
+      }
+    }
+  }
+  mix(&regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], sizeof(uint32_t) * 6 * 32);
+  mix(&regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], sizeof(uint32_t) * (8 + 32));
+  chain_probe_cur_.push_back(h);
+}
+
+void VulkanCommandProcessor::ChainProbeSwap() {
+  // The list, parsed when it changes (read once per frame).
+  const std::string list = REXCVAR_GET(gpu_chain_probe_shaders);
+  if (list != chain_probe_list_) {
+    chain_probe_list_ = list;
+    chain_probe_shaders_.clear();
+    for (size_t pos = 0; pos < list.size();) {
+      const size_t end = std::min(list.find(',', pos), list.size());
+      const uint64_t hash = std::strtoull(list.substr(pos, end - pos).c_str(), nullptr, 16);
+      if (hash) {
+        chain_probe_shaders_.push_back(hash);
+      }
+      pos = end + 1;
+    }
+    chain_probe_cur_.clear();
+    chain_probe_prev_.clear();
+  }
+  if (chain_probe_shaders_.empty()) {
+    return;
+  }
+  if (chain_probe_window_first_ == UINT64_MAX) {
+    chain_probe_window_first_ = frame_current_;
+  }
+  if (!chain_probe_prev_.empty() && !chain_probe_cur_.empty()) {
+    ++chain_probe_frames_;
+    uint64_t same_pos = 0, same_any = 0;
+    for (size_t i = 0; i < chain_probe_cur_.size(); ++i) {
+      if (i < chain_probe_prev_.size() && chain_probe_prev_[i] == chain_probe_cur_[i]) {
+        ++same_pos;
+      }
+      if (std::find(chain_probe_prev_.begin(), chain_probe_prev_.end(), chain_probe_cur_[i]) !=
+          chain_probe_prev_.end()) {
+        ++same_any;
+      }
+    }
+    chain_probe_draws_ += chain_probe_cur_.size();
+    chain_probe_same_pos_ += same_pos;
+    chain_probe_same_any_ += same_any;
+    chain_probe_frames_all_same_ += same_pos == chain_probe_cur_.size() &&
+                                    chain_probe_cur_.size() == chain_probe_prev_.size();
+  }
+  if (!chain_probe_cur_.empty()) {
+    chain_probe_prev_.swap(chain_probe_cur_);
+  }
+  chain_probe_cur_.clear();
+  if (frame_current_ - chain_probe_window_first_ >= 300) {
+    if (chain_probe_frames_) {
+      double frames = double(chain_probe_frames_);
+      REXGPU_INFO(
+          "[s23][CHAIN] frames {}-{}: {} frames with listed draws (and a previous one); per such frame: draws "
+          "{:.1f}, same inputs as the same position last frame {:.1f}, as any of last frame's {:.1f}; frames "
+          "entirely the same {}",
+          chain_probe_window_first_, frame_current_ - 1, chain_probe_frames_,
+          double(chain_probe_draws_) / frames, double(chain_probe_same_pos_) / frames,
+          double(chain_probe_same_any_) / frames, chain_probe_frames_all_same_);
+    }
+    chain_probe_window_first_ = frame_current_;
+    chain_probe_frames_ = chain_probe_draws_ = chain_probe_same_pos_ = chain_probe_same_any_ = 0;
+    chain_probe_frames_all_same_ = 0;
+  }
+}
+
+void VulkanCommandProcessor::RepeatStartRun() {
+  RepeatPrev& prev = repeat_prev_;
+  prev.run_instances = 0;
+  const ConstantsDynamicOffsets* constants_dynamic = constants_dynamic_offsets_.get();
+  if (!prev.merge_stride || !constants_dynamic ||
+      !(current_graphics_descriptor_sets_bound_up_to_date_ &
+        (UINT32_C(1) << SpirvShaderTranslator::kDescriptorSetConstants))) {
+    return;
+  }
+  // The constants set is bound with these offsets (every PrepareSet is followed by a bind of them).
+  prev.run_set = current_graphics_descriptor_sets_[SpirvShaderTranslator::kDescriptorSetConstants];
+  static_assert(ConstantsDynamicOffsets::kBufferCount <= 8, "run_offsets size");
+  for (uint32_t i = 0; i < ConstantsDynamicOffsets::kBufferCount; ++i) {
+    prev.run_offsets[i] = constants_dynamic->dynamic_offsets[i];
+  }
+  prev.run_instances = 1;
+}
+
+void VulkanCommandProcessor::RepeatNoteRecorded(const Shader* vertex_shader, const Shader* used_pixel_shader,
+                                                uint32_t prim_type, uint32_t index_count,
+                                                const IndexBufferInfo* index_buffer_info,
+                                                bool major_mode_explicit, uint64_t epoch, bool stats,
+                                                bool host_indexed, uint32_t host_vertex_count) {
+  RepeatPrev& prev = repeat_prev_;
+  prev.valid = true;
+  prev.host_indexed = host_indexed;
+  prev.host_vertex_count = host_vertex_count;
+  prev.pipeline = current_guest_graphics_pipeline_;
+  prev.sets_bound = current_graphics_descriptor_sets_bound_up_to_date_;
+  prev.vertex_shader = vertex_shader;
+  prev.pixel_shader = active_pixel_shader();
+  prev.prim_type = prim_type;
+  prev.index_count = index_count;
+  prev.indexed = index_buffer_info != nullptr;
+  prev.major_mode_explicit = major_mode_explicit;
+  prev.index_guest_base = index_buffer_info ? index_buffer_info->guest_base : 0;
+  prev.index_length = index_buffer_info ? uint32_t(index_buffer_info->length) : 0;
+  prev.index_format = index_buffer_info ? uint32_t(index_buffer_info->format) : 0;
+  prev.index_endianness = index_buffer_info ? uint32_t(index_buffer_info->endianness) : 0;
+  prev.submission = GetCurrentSubmission();
+  prev.frame = frame_current_;
+  prev.epoch = epoch;
+  prev.ps_float_count = 0;
+  if (stats && used_pixel_shader) {
+    const Shader::ConstantRegisterMap& map = used_pixel_shader->constant_register_map();
+    const RegisterFile& regs = *register_file_;
+    for (uint32_t i = 0; i < 4; ++i) {
+      uint64_t bits = map.float_bitmap[i];
+      uint32_t bit;
+      while (bit_inline::bit_scan_forward(bits, &bit)) {
+        bits &= ~(UINT64_C(1) << bit);
+        std::memcpy(&prev.ps_float[prev.ps_float_count * 4],
+                    &regs[XE_GPU_REG_SHADER_CONSTANT_256_X + ((i * 64 + bit) << 2)], sizeof(float) * 4);
+        ++prev.ps_float_count;
+      }
+    }
+  }
+}
+
+void VulkanCommandProcessor::RepeatStatsClassify(uint32_t dirty, const Shader* vertex_shader,
+                                                 uint32_t prim_type, uint32_t index_count,
+                                                 const IndexBufferInfo* index_buffer_info,
+                                                 bool major_mode_explicit, uint64_t epoch) {
+  RepeatStats& stats = repeat_stats_;
+  if (stats.window_first_frame == UINT64_MAX) {
+    stats.window_first_frame = frame_current_;
+  } else if (frame_current_ - stats.window_first_frame >= 300) {
+    RepeatStatsLog();
+    stats = RepeatStats();
+    stats.window_first_frame = frame_current_;
+  }
+  ++stats.draws;
+  bool repeat = false;
+  const RepeatPrev& prev = repeat_prev_;
+  if (prev.valid) {
+    ++stats.prev_valid;
+    bool same_shader = prev.vertex_shader == vertex_shader && prev.pixel_shader == active_pixel_shader();
+    bool same_params =
+        prev.prim_type == prim_type && prev.index_count == index_count &&
+        prev.indexed == (index_buffer_info != nullptr) && prev.major_mode_explicit == major_mode_explicit &&
+        (!index_buffer_info ||
+         (prev.index_guest_base == index_buffer_info->guest_base &&
+          prev.index_length == uint32_t(index_buffer_info->length) &&
+          prev.index_format == uint32_t(index_buffer_info->format) &&
+          prev.index_endianness == uint32_t(index_buffer_info->endianness)));
+    bool same_submission = prev.submission == GetCurrentSubmission();
+    bool same_frame = prev.frame == frame_current_;
+    bool same_epoch = prev.epoch == epoch;
+    stats.diff_shader += !same_shader;
+    stats.diff_params += !same_params;
+    stats.diff_submission += !same_submission;
+    stats.diff_frame += !same_frame;
+    stats.diff_epoch += !same_epoch;
+    if (dirty & kRepeatDirtyFetch) ++stats.fetch;
+    if (dirty & kRepeatDirtyBoolLoop) ++stats.bool_loop;
+    if (dirty & kRepeatDirtyOther) {
+      ++stats.other;
+      RepeatStatsCount(stats.other_registers, repeat_first_other_register_);
+    }
+    if (dirty & kRepeatDirtyPacket) {
+      ++stats.packet;
+      ++stats.packet_opcodes[repeat_first_packet_opcode_ & 127];
+    }
+    if (same_shader && same_params && same_submission && same_frame && same_epoch) {
+      ++stats.same_draw;
+      if (!(dirty & ~uint32_t(kRepeatDirtyVsFloat | kRepeatDirtyPsFloat))) {
+        if (!dirty) {
+          ++stats.nothing;
+          repeat = true;
+        } else if (!(dirty & kRepeatDirtyPsFloat)) {
+          ++stats.vs_only;
+          repeat = true;
+          RepeatStatsCount(stats.vs_only_shaders,
+                           static_cast<const Shader*>(vertex_shader)->ucode_data_hash());
+        } else {
+          // The pixel float constants the previous draw used, as it uploaded them, against now.
+          bool ps_same = true;
+          uint32_t n = 0;
+          const Shader* ps = static_cast<const Shader*>(prev.pixel_shader);
+          if (ps && prev.ps_float_count) {
+            const Shader::ConstantRegisterMap& map = ps->constant_register_map();
+            const RegisterFile& regs = *register_file_;
+            for (uint32_t i = 0; i < 4 && ps_same; ++i) {
+              uint64_t bits = map.float_bitmap[i];
+              uint32_t bit;
+              while (bit_inline::bit_scan_forward(bits, &bit)) {
+                bits &= ~(UINT64_C(1) << bit);
+                if (n >= prev.ps_float_count ||
+                    std::memcmp(&prev.ps_float[n * 4],
+                                &regs[XE_GPU_REG_SHADER_CONSTANT_256_X + ((i * 64 + bit) << 2)],
+                                sizeof(float) * 4)) {
+                  ps_same = false;
+                  break;
+                }
+                ++n;
+              }
+            }
+          }
+          if (ps_same) {
+            ++stats.ps_same;
+            repeat = true;
+          } else {
+            ++stats.ps_changed;
+          }
+        }
+      }
+    }
+  }
+  if (repeat) {
+    stats.run_current = stats.run_current ? stats.run_current + 1 : 2;
+  } else if (stats.run_current) {
+    ++stats.run_count;
+    stats.run_draws += stats.run_current;
+    stats.run_max = std::max(stats.run_max, stats.run_current);
+    stats.run_current = 0;
+  }
+}
+
+void VulkanCommandProcessor::RepeatStatsLog() {
+  const RepeatStats& s = repeat_stats_;
+  if (s.window_first_frame == UINT64_MAX || !s.draws) {
+    return;
+  }
+  double frames = double(std::max<uint64_t>(frame_current_ - s.window_first_frame, 1));
+  std::string packets, others, shaders;
+  for (uint32_t i = 0; i < 128; ++i) {
+    if (s.packet_opcodes[i]) {
+      fmt::format_to(std::back_inserter(packets), " {:02X}:{:.1f}", i, double(s.packet_opcodes[i]) / frames);
+    }
+  }
+  for (const RepeatStats::Counted& c : s.other_registers) {
+    if (c.count) {
+      fmt::format_to(std::back_inserter(others), " {:04X}:{:.1f}", uint32_t(c.key), double(c.count) / frames);
+    }
+  }
+  for (const RepeatStats::Counted& c : s.vs_only_shaders) {
+    if (c.count) {
+      fmt::format_to(std::back_inserter(shaders), " {:016X}:{:.1f}", c.key, double(c.count) / frames);
+    }
+  }
+  REXGPU_INFO(
+      "[s23][REPEAT] frames {}-{}, per frame: draws {:.1f}, after a recorded draw {:.1f}, same draw {:.1f}: "
+      "nothing written {:.1f}, vertex constants only {:.1f}, + pixel constants same {:.1f} / changed {:.1f}; "
+      "written: fetch {:.1f}, bool/loop {:.1f}, other registers {:.1f} (first:{}), packets {:.1f} "
+      "(first:{}); differs: shader {:.1f}, params {:.1f}, submission {:.1f}, frame {:.1f}, memory epoch "
+      "{:.1f}; repeat runs {:.1f} per frame, {:.1f} draws each, longest {}; vertex-only shaders:{}",
+      s.window_first_frame, frame_current_, double(s.draws) / frames, double(s.prev_valid) / frames,
+      double(s.same_draw) / frames, double(s.nothing) / frames, double(s.vs_only) / frames,
+      double(s.ps_same) / frames, double(s.ps_changed) / frames, double(s.fetch) / frames,
+      double(s.bool_loop) / frames, double(s.other) / frames, others, double(s.packet) / frames, packets,
+      double(s.diff_shader) / frames, double(s.diff_params) / frames, double(s.diff_submission) / frames,
+      double(s.diff_frame) / frames, double(s.diff_epoch) / frames, double(s.run_count) / frames,
+      s.run_count ? double(s.run_draws) / double(s.run_count) : 0.0, s.run_max, shaders);
+}
