+// wwe2k14 patch (Session 37): see thread.h.
+void PreciseSleep(std::chrono::microseconds duration) {
+  thread_local HANDLE timer = [] {
+    HANDLE t = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    return t ? t : CreateWaitableTimerExW(nullptr, nullptr, 0, TIMER_ALL_ACCESS);  // before Windows 10 1803
+  }();
+  LARGE_INTEGER due;
+  due.QuadPart = -int64_t(duration.count() > 0 ? duration.count() : 1) * 10;  // relative, 100 ns units
+  if (timer && SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) {
+    WaitForSingleObject(timer, INFINITE);
+  } else {
+    MaybeYield();
+  }
+}
