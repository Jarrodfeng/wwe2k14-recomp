+void OwnedFrontRepeatRecord(VulkanCommandProcessor& cp, const OwnedRecordState& s) {
+  if (!rex::graphics::free_counters::g_cut.active || &s != &OwnedRecordStateNow()) {
+    g_trep.valid = false;
+    return;
+  }
+  FillTRep(g_trep, cp, s);
+}
