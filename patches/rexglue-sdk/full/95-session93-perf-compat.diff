+  ++g_rw.verify_compared;
+  if (sk != kSkipNone) {
+    ++g_rw.verify_mismatch_draws;
+    NotePrepMismatch(kSkipNames[sk], s);  // (the from-scratch build refused a draw the hit accepted)
+    return;
+  }
