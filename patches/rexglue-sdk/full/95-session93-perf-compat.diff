+    PutBits(blk, 25u, 8u, hi.x);
+    PutBits(blk, 33u, 8u, lo.y);
+    PutBits(blk, 41u, 8u, hi.y);
+    PutBits(blk, 49u, 8u, lo.z);
+    PutBits(blk, 57u, 8u, hi.z);
