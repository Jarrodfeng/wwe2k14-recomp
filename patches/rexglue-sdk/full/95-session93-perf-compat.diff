+        e = nullptr;
+      } else {
+        CopyPrepState(p, e->prep);
+        p.refusal = nullptr;
+        p.input = input;
+        p.vs_float = s.vs_float;
+        p.ps_float = s.ps_float;
+        p.bool_loop = s.bool_loop;
+        p.fetch = s.fetch;
