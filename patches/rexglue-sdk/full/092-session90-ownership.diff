+    cb.CmdVkPipelineBarrier(kStages, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &sb);
+    cb.CmdVkCopyImage(s.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, o.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &c.region);
