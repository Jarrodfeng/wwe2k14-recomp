+// wwe2k14 patch (Session 90): the D3D layer's share of guest memory (see xmemory.h).
+namespace {
+constexpr uint32_t kLayerReserveBytes = 0x340000;
+uint32_t g_layer_reserve_physical = 0, g_layer_reserve_used = 0;
+uint64_t g_layer_virtual_total = 0, g_layer_reserve_total = 0;
+std::mutex g_layer_mutex;
+Memory* g_layer_memory = nullptr;
+uint32_t g_layer_reserve_virtual = 0;
+bool g_layer_reserve_committed = false;
+}  // namespace
+
+bool D3dLayerTakePhysicalReserve(uint32_t bytes, uint32_t* physical_out) {
+  std::lock_guard<std::mutex> lock(g_layer_mutex);
+  bytes = (bytes + 15u) & ~15u;
+  if (!g_layer_reserve_physical || uint64_t(g_layer_reserve_used) + bytes > kLayerReserveBytes) return false;
+  if (!g_layer_reserve_committed) {  // (first use: commit the reserved block read-write; commit-only over the reservation)
+    if (!g_layer_memory || !g_layer_memory->LookupHeapByType(true, 64 * 1024)->AllocFixed(
+            g_layer_reserve_virtual, kLayerReserveBytes, 64 * 1024, memory::kMemoryAllocationCommit,
+            memory::kMemoryProtectRead | memory::kMemoryProtectWrite)) {
+      return false;
+    }
+    g_layer_reserve_committed = true;
+  }
+  *physical_out = g_layer_reserve_physical + g_layer_reserve_used;
+  g_layer_reserve_used += bytes;
+  return true;
+}
+
+void D3dLayerNoteGuestMemory(const char* what, uint32_t bytes, bool virtual_heap, uint32_t guest_address) {
+  std::lock_guard<std::mutex> lock(g_layer_mutex);
+  (virtual_heap ? g_layer_virtual_total : g_layer_reserve_total) += bytes;
+  REXSYS_INFO("[d3d][mem] {}: {} bytes at {} {:08X}; taken from the game's physical pool: 0 bytes; totals of the SDK-side layer "
+              "allocations only (the game exe's shader-bind region logs its own [d3d][mem] line; the exe's inline scratch is not "
+              "counted): guest virtual heap {} bytes, SDK system reserve {} of {} bytes",
+              what, bytes, virtual_heap ? "guest virtual" : "physical", guest_address, g_layer_virtual_total,
+              g_layer_reserve_total, kLayerReserveBytes);
+}
+
 uint32_t get_page_count(uint32_t value, uint32_t page_size, uint32_t page_size_shift) {
   return rex::round_up(value, page_size) >> page_size_shift;
