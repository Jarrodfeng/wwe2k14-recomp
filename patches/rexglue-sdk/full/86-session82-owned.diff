+    if (result == VK_SUCCESS) return result;
+    if (result != VK_ERROR_OUT_OF_POOL_MEMORY && result != VK_ERROR_FRAGMENTED_POOL) return result;
+    owned_pool_ = VK_NULL_HANDLE;  // (full: the next attempt makes another)
+  }
