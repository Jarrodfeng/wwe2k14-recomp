From 9871d92b7c62235fe4ccca90c93006b6ac7f091b Mon Sep 17 00:00:00 2001
From: Jarrod <230525910+Jarrodfeng@users.noreply.github.com>
Date: Tue, 10 Nov 2026 10:41:24 +1100
Subject: [PATCH 1/3] Session 100: RuntimeConfig::present_detached keeps the
 graphics system but leaves the window to the app's own renderer; no-presenter
 swap said once

---
 include/rex/runtime.h                     | 4 ++++
 src/graphics/vulkan/command_processor.cpp | 7 ++++++-
 src/ui/rex_app.cpp                        | 4 +++-
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/include/rex/runtime.h b/include/rex/runtime.h
index ed494af..67b9cca 100644
--- a/include/rex/runtime.h
+++ b/include/rex/runtime.h
@@ -72,6 +72,10 @@ struct RuntimeConfig {
   std::function<std::unique_ptr<system::IInputSystem>(bool tool_mode)> input_factory;
   std::function<void(Runtime*, system::KernelState*)> kernel_init;
   bool tool_mode = false;
+  // wwe2k14 patch (Session 100, docs\renderer\LIVE_ADAPTER.md stage B): keep the graphics system (its command processor answers the
+  // game's fences and interrupts) but never set up its presentation, so the window has no presenter and the app's own renderer owns it.
+  // The graphics system then builds its no-presentation provider in SetupGuestGpu.
+  bool present_detached = false;
 };
 
 /// Helper macros for populating RuntimeConfig with concrete backends.
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index bdbc770..db6bd13 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -6533,7 +6533,12 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
     return;
   ui::Presenter* presenter = graphics_system_->presenter();
   if (!presenter) {
-    REXGPU_ERROR("XELOG_GPU PRESENT: NO PRESENTER");
+    // wwe2k14 patch (Session 100): expected when the app detached presentation (RuntimeConfig::present_detached): said once.
+    static bool said = false;
+    if (!said) {
+      said = true;
+      REXGPU_ERROR("XELOG_GPU PRESENT: NO PRESENTER (presentation detached or not set up; said once)");
+    }
     return;
   }
 
diff --git a/src/ui/rex_app.cpp b/src/ui/rex_app.cpp
index 50936fa..652d5fa 100644
--- a/src/ui/rex_app.cpp
+++ b/src/ui/rex_app.cpp
@@ -364,7 +364,9 @@ bool ReXApp::SetupPresentation() {
     }
   }
 
-  if (config_.graphics) {
+  if (config_.graphics && config_.present_detached) {
+    REXLOG_INFO("Graphics presentation detached: the app's own renderer owns the window (wwe2k14 Session 100)");
+  } else if (config_.graphics) {
     X_STATUS status = config_.graphics->SetupPresentation(&app_context());
     if (XFAILED(status)) {
       REXLOG_ERROR("Graphics presentation setup failed: {:08X}", status);
-- 
2.52.0.windows.1


From f87f1531b1bebaaf7d17ddccd698b0e1b364e2f4 Mon Sep 17 00:00:00 2001
From: Jarrod <230525910+Jarrodfeng@users.noreply.github.com>
Date: Tue, 10 Nov 2026 10:54:41 +1100
Subject: [PATCH 2/3] Session 100: gpu_no_draw, the command processor issues no
 draws or copies (the app's renderer draws)

---
 src/graphics/vulkan/command_processor.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index db6bd13..f189987 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -94,6 +94,10 @@ static bool g_pixel_repl_mismatch_logged = false;
 #include <rex/ui/vulkan/presenter.h>
 #include <rex/ui/vulkan/util.h>
 
+// wwe2k14 patch (Session 100, docs\renderer\LIVE_ADAPTER.md stage B): the app's own renderer draws the game; this command processor
+// only answers the game's fences, interrupts and flips. Draws and copies report done without GPU work (the game never reads GPU
+// results back: no readback, no memexport in play).(gpu_no_draw, false, "GPU", "Session 100: issue no draws or copies (the app's own renderer draws; stage B)");
+
 // wwe2k14 patch (Session 8, FLIGHT): the app's flight recorder (src/flight_recorder.h) reads the newest crash
 // checkpoint records (needs vulkan_gpu_crash_diagnostics) into its hang / crash dumps via rex/perf/flight.h.
 REXCVAR_DEFINE_BOOL(vulkan_flight_gpu_records, false, "GPU/Vulkan",
@@ -10878,6 +10882,7 @@ Shader* VulkanCommandProcessor::LoadShader(xenos::ShaderType shader_type, uint32
 bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
                                        IndexBufferInfo* index_buffer_info,
                                        bool major_mode_explicit) {
+  if (REXCVAR_GET(gpu_no_draw)) return true;  // wwe2k14 patch (Session 100): the app's own renderer draws (stage B)
 #if XE_GPU_FINE_GRAINED_DRAW_SCOPES
   SCOPE_profile_cpu_f("gpu");
 #endif  // XE_GPU_FINE_GRAINED_DRAW_SCOPES
@@ -13574,6 +13579,10 @@ void VulkanCommandProcessor::NoopSkipLogWindow(const char* note) {
 bool VulkanCommandProcessor::IssueDrawLean(xenos::PrimitiveType prim_type, uint32_t index_count,
                                            IndexBufferInfo* index_buffer_info, bool major_mode_explicit,
                                            uint32_t library_kind, bool& succeeded) {
+  if (REXCVAR_GET(gpu_no_draw)) {  // wwe2k14 patch (Session 100): the app's own renderer draws (stage B)
+    succeeded = true;
+    return true;
+  }
 #if REX_TRUE_NATIVE_ONLY
   (void)prim_type; (void)index_count; (void)index_buffer_info; (void)major_mode_explicit; (void)library_kind; (void)succeeded;
   return false;  // (the TRUE NATIVE proof build: the old lean draw is out; nothing reaches it under the cut)
@@ -15139,6 +15148,7 @@ void VulkanCommandProcessor::NoteSkippedDraw(int64_t surface_info_word) {
 // path) fills CopyWords from the register source; the record path under gpu_d3d_owned_resolve (D3dCopyAccess::Resolve) fills them from the record
 // and passes the ResolveInfo it built, and the copy then goes to the owned frame (OwnedResolveRecord) instead of the render target cache.
 bool VulkanCommandProcessor::IssueCopy() {
+  if (REXCVAR_GET(gpu_no_draw)) return true;  // wwe2k14 patch (Session 100): nothing reads GPU results back (ADAPTER_CALLS item 4)
   const RegisterFile& regs = DrawRegs();
   CopyWords w;
   w.copy_control = regs[XE_GPU_REG_RB_COPY_CONTROL];
@@ -15155,6 +15165,7 @@ bool VulkanCommandProcessor::IssueCopy() {
 void PostLiteNoteCopy(uint32_t dest_base);  // wwe2k14 patch (Session 95, gpu_native_post_lite_near): owned_front_own.cpp
 
 bool VulkanCommandProcessor::IssueCopyFrom(const CopyWords& w, const draw_util::ResolveInfo* owned_info) {
+  if (REXCVAR_GET(gpu_no_draw)) return true;  // wwe2k14 patch (Session 100): nothing reads GPU results back (ADAPTER_CALLS item 4)
   const reg::RB_COPY_CONTROL copy_control_w = rex::memory::Reinterpret<reg::RB_COPY_CONTROL>(w.copy_control);
   WaitSiteScope wait_site(this, rex::perf::frame_events::kWaitCopy);  // b78
 #if XE_GPU_FINE_GRAINED_DRAW_SCOPES
-- 
