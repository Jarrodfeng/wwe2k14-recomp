+// wwe2k14 patch (Session 33, FSR): the same frame through AMD FSR 3 (submission thread).
+struct FsrCallbackData {
+  ui::vulkan::streamline::DlaaFrame frame;
+  float sharpness = 0.0f;
+};
+static void FsrEvaluateCallback(VkCommandBuffer command_buffer, const void* data) {
+  static std::atomic<uint32_t> failures_logged{0}, evaluations{0};
+  const auto& d = *static_cast<const FsrCallbackData*>(data);
+  const auto& frame = d.frame;
+  std::string reason;
+  if (!ui::vulkan::fsr::Evaluate(command_buffer, frame, d.sharpness, &reason)) {
+    if (failures_logged.fetch_add(1) < 5) REXGPU_WARN("[fsr] FSR evaluate failed: {}", reason);
+  } else if (evaluations.fetch_add(1) < 3) {
+    REXGPU_INFO("[fsr] FSR evaluated (mode {}, {}x{} -> {}x{}, frame index {}, jitter {:+.3f} {:+.3f}{})", frame.mode,
+                frame.width, frame.height, frame.out_width, frame.out_height, frame.frame_index, frame.jitter[0],
+                frame.jitter[1], frame.reset ? ", reset" : "");
+  }
+}
