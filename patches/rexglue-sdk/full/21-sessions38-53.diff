+void VulkanCommandProcessor::NativeRestoreDrawState(VkPipeline pipeline, const PipelineLayout* pipeline_layout) {
+  deferred_command_buffer_.CmdVkBindPipeline(VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
