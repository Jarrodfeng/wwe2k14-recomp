+VkDescriptorSet VulkanRenderTargetCache::RenameResolveSet(VkDeviceSize offset) {
+  auto found = rename_resolve_sets_.find(offset);
+  if (found != rename_resolve_sets_.end()) return found->second;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  constexpr uint32_t kMaxSets = 256;
+  if (rename_descriptor_pool_ == VK_NULL_HANDLE) {
+    VkDescriptorPoolSize size = {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, kMaxSets};
+    VkDescriptorPoolCreateInfo info = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    info.maxSets = kMaxSets;
+    info.poolSizeCount = 1;
+    info.pPoolSizes = &size;
+    if (dfn.vkCreateDescriptorPool(device, &info, nullptr, &rename_descriptor_pool_) != VK_SUCCESS) {
+      rename_descriptor_pool_ = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+    }
+  }
+  if (rename_resolve_sets_.size() >= kMaxSets) return VK_NULL_HANDLE;
+  VkDescriptorSetAllocateInfo alloc = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+  alloc.descriptorPool = rename_descriptor_pool_;
+  alloc.descriptorSetCount = 1;
+  alloc.pSetLayouts = &descriptor_set_layout_storage_buffer_;
+  VkDescriptorSet set = VK_NULL_HANDLE;
+  if (dfn.vkAllocateDescriptorSets(device, &alloc, &set) != VK_SUCCESS) return VK_NULL_HANDLE;
+  VkDescriptorBufferInfo buffer_info = {edram_buffer_, offset, VK_WHOLE_SIZE};
+  VkWriteDescriptorSet write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+  write.dstSet = set;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  write.pBufferInfo = &buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+  rename_resolve_sets_.emplace(offset, set);
+  return set;
+}
