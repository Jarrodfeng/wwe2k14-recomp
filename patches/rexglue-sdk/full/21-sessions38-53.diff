+// wwe2k14 patch (Session 46, NATIVE TRUTH): see the header (from the rename sets' pool).
+VkDescriptorSet VulkanRenderTargetCache::ResolveSetForBuffer(VkBuffer buffer) {
+  if (buffer == VK_NULL_HANDLE) return VK_NULL_HANDLE;
+  if (buffer == buffer_resolve_set_buffer_ && buffer_resolve_set_ != VK_NULL_HANDLE) return buffer_resolve_set_;
+  // A set over the EDRAM at offset 0 makes the pool; one more set from it for this buffer (kept for the session).
+  if (rename_descriptor_pool_ == VK_NULL_HANDLE && RenameResolveSet(0) == VK_NULL_HANDLE) return VK_NULL_HANDLE;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (buffer_resolve_set_ == VK_NULL_HANDLE) {
+    VkDescriptorSetAllocateInfo alloc = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    alloc.descriptorPool = rename_descriptor_pool_;
+    alloc.descriptorSetCount = 1;
+    alloc.pSetLayouts = &descriptor_set_layout_storage_buffer_;
+    if (dfn.vkAllocateDescriptorSets(device, &alloc, &buffer_resolve_set_) != VK_SUCCESS) {
+      buffer_resolve_set_ = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+    }
+  }
+  // (Rewritten only for a new buffer: the caller makes its buffer once.)
+  VkDescriptorBufferInfo buffer_info = {buffer, 0, VK_WHOLE_SIZE};
+  VkWriteDescriptorSet write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+  write.dstSet = buffer_resolve_set_;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  write.pBufferInfo = &buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+  buffer_resolve_set_buffer_ = buffer;
+  return buffer_resolve_set_;
+}
