+// ---------------------------------------------------------------------------------------------------------------
+// wwe2k14 patch (Session 40, RENAME): EDRAM renaming (see EdramRenameRun in the header).
+// ---------------------------------------------------------------------------------------------------------------
+
+bool VulkanCommandProcessor::EdramRenameClearRect(xenos::PrimitiveType prim_type, const VulkanShader& vertex_shader,
+                                                  const VulkanShader* pixel_shader,
+                                                  reg::RB_DEPTHCONTROL depth_control, uint32_t color_mask,
+                                                  bool memexport, int32_t rect[4]) {
+  const RegisterFile& regs = *register_file_;
+  if (prim_type != xenos::PrimitiveType::kRectangleList || memexport || !pixel_shader) return EdramRenameReject(__LINE__);
+  const auto initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (initiator.source_select != xenos::SourceSelect::kAutoIndex || initiator.num_indices != 3) return EdramRenameReject(__LINE__);
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  if (surface_info.msaa_samples != xenos::MsaaSamples::k1X || !surface_info.surface_pitch) return EdramRenameReject(__LINE__);
+  // Every bit of the depth / stencil dword: depth always written, stencil always replaced with a full write mask.
+  if (!depth_control.z_enable || !depth_control.z_write_enable ||
+      depth_control.zfunc != xenos::CompareFunction::kAlways || !depth_control.stencil_enable ||
+      depth_control.backface_enable || depth_control.stencilfunc != xenos::CompareFunction::kAlways ||
+      depth_control.stencilzpass != xenos::StencilOp::kReplace ||
+      regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask != 0xFF) {
+    return EdramRenameReject(__LINE__);
+  }
+  // Every bit of render target 0 (a 32bpp format, all channels, no blending, no alpha test), and no other target.
+  const auto color_info = regs.Get<reg::RB_COLOR_INFO>();
+  const auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  if (color_mask != 0xF || xenos::IsColorRenderTargetFormat64bpp(color_info.color_format) ||
+      regs[XE_GPU_REG_RB_BLENDCONTROL0] != 0x00010001 || color_control.alpha_test_enable ||
+      color_control.alpha_to_mask_enable || pixel_shader->kills_pixels()) {
+    return EdramRenameReject(__LINE__);
+  }
+  const auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (window_offset.window_x_offset || window_offset.window_y_offset || (!vte.vtx_xy_fmt && !vte.vtx_w0_fmt) ||
+      !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return EdramRenameReject(__LINE__);
+  }
+  // The three corners, from the vertex shader run on the CPU (the rectangle's fourth corner follows from them).
+  if (!rename_interpreter_) rename_interpreter_ = std::make_unique<ShaderInterpreter>(regs, *memory_);
+  struct PositionSink : ShaderInterpreter::ExportSink {
+    void Export(ucode::ExportRegister export_register, const float* value, uint32_t value_mask) override {
+      if (export_register != ucode::ExportRegister::kVSPosition) return;
+      for (uint32_t i = 0; i < 4; ++i) {
+        if (value_mask & (1u << i)) position[i] = value[i];
+      }
+      written |= value_mask;
+    }
+    float position[4] = {};
+    uint32_t written = 0;
+  } sink;
+  ShaderInterpreter& interpreter = *rename_interpreter_;
+  interpreter.SetShader(xenos::ShaderType::kVertex, vertex_shader.ucode_dwords());
+  interpreter.SetExportSink(&sink);
+  const double scale_x = vte.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0;
+  const double scale_y = vte.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0;
+  const double offset_x = vte.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0;
+  const double offset_y = vte.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0;
+  const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t index_min = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  const uint32_t index_max = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  double min_x = DBL_MAX, max_x = -DBL_MAX, min_y = DBL_MAX, max_y = -DBL_MAX;
+  bool ok = true;
+  for (uint32_t i = 0; i < 3 && ok; ++i) {
+    std::memset(interpreter.temp_registers(), 0, sizeof(float) * 4 * xenos::kMaxShaderTempRegisters);
+    const uint32_t index = std::min(std::max((i + index_offset) & xenos::kVertexIndexMask, index_min), index_max);
+    interpreter.temp_registers()[0] = float(index);
+    sink.written = 0;
+    interpreter.Execute();
+    // VTE vtx_xy_fmt 1: X and Y are not divided by W (screen-space rectangles; W is not needed then).
+    const double w = vte.vtx_xy_fmt ? 1.0 : double(sink.position[3]);
+    ok = (sink.written & 0b11) == 0b11 && (vte.vtx_xy_fmt || (sink.written & 0b1000)) && w > 0.0 &&
+         std::isfinite(w);
+    if (!ok) break;
+    const double px = double(sink.position[0]) / w * scale_x + offset_x;
+    const double py = double(sink.position[1]) / w * scale_y + offset_y;
+    min_x = std::min(min_x, px), max_x = std::max(max_x, px);
+    min_y = std::min(min_y, py), max_y = std::max(max_y, py);
+  }
+  interpreter.SetExportSink(nullptr);
+  if (!ok) return EdramRenameReject(__LINE__);
+  // The pixels whose centres the rectangle covers (PA_SU_VTX_CNTL pix_center: 0 = centres on whole coordinates, the
+  // Direct3D 9 convention, 1 = half-way): pixel p for lo <= p + centre < hi. An edge right on a centre is decided by
+  // the top-left rule (left / top in, right / bottom out); one within a thousandth of a centre without being on it
+  // is too close to call.
+  const double centre = regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero ? 0.0 : 0.5;
+  int32_t edges[4];
+  const double values[4] = {min_x, min_y, max_x, max_y};
+  for (uint32_t i = 0; i < 4; ++i) {
+    const double x = values[i] - centre;
+    const double distance = std::abs(x - std::round(x));
+    if ((distance > 1.0e-6 && distance < 1.0e-3) || x < -1.0 || x > 8192.0) return EdramRenameReject(__LINE__);
+    edges[i] = std::max(0, int32_t(std::ceil(x - 1.0e-6)));
+  }
+  // Within the scissor (the rasterizer clips to it).
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  rect[0] = std::max(edges[0], int32_t(scissor.offset[0]));
+  rect[1] = std::max(edges[1], int32_t(scissor.offset[1]));
+  rect[2] = std::min(edges[2], int32_t(scissor.offset[0] + scissor.extent[0]));
+  rect[3] = std::min(edges[3], int32_t(scissor.offset[1] + scissor.extent[1]));
+  if (!(rect[2] > rect[0] && rect[3] > rect[1] && uint32_t(rect[2]) <= surface_info.surface_pitch)) {
+    return EdramRenameReject(__LINE__);
+  }
+  return true;
+}
+
+// wwe2k14 patch (Session 43, NATIVE COVER): as EdramRenameClearRect, for any quad (4 vertices) or rectangle (3)
+// list draw, without the clear's depth / colour conditions: only what decides which pixels are written.
+// Session 43 (S0-pre): why a draw's coverage could not be proven, logged once per (line, vertex shader).
+bool VulkanCommandProcessor::NativeCoverReject(int line, const VulkanShader& vertex_shader) {
+  const uint64_t key = vertex_shader.ucode_data_hash() ^ (uint64_t(line) << 48);
+  if (native_cover_rejects_.size() < 32 &&
+      std::find(native_cover_rejects_.begin(), native_cover_rejects_.end(), key) == native_cover_rejects_.end()) {
+    native_cover_rejects_.push_back(key);
+    REXGPU_INFO("[native][cover] not proven: vs {:016X}, reason line {}", vertex_shader.ucode_data_hash(), line);
+  }
+  return false;
+}
+
+bool VulkanCommandProcessor::NativeCoverRect(xenos::PrimitiveType prim_type, const VulkanShader& vertex_shader,
+                                             const VulkanShader* pixel_shader, int32_t rect[4]) {
+  const RegisterFile& regs = *register_file_;
+  const bool quad = prim_type == xenos::PrimitiveType::kQuadList;
+  if ((!quad && prim_type != xenos::PrimitiveType::kRectangleList) || !pixel_shader) return NativeCoverReject(__LINE__, vertex_shader);
+  const uint32_t vertex_count = quad ? 4 : 3;
+  const auto initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (initiator.source_select != xenos::SourceSelect::kAutoIndex || initiator.num_indices != vertex_count) {
+    return NativeCoverReject(__LINE__, vertex_shader);
+  }
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  if (surface_info.msaa_samples != xenos::MsaaSamples::k1X || !surface_info.surface_pitch) return NativeCoverReject(__LINE__, vertex_shader);
+  const auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  if (color_control.alpha_test_enable || color_control.alpha_to_mask_enable || pixel_shader->kills_pixels()) {
+    return NativeCoverReject(__LINE__, vertex_shader);
+  }
+  const auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (window_offset.window_x_offset || window_offset.window_y_offset || (!vte.vtx_xy_fmt && !vte.vtx_w0_fmt) ||
+      !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return NativeCoverReject(__LINE__, vertex_shader);
+  }
+  // wwe2k14 patch (Session 45, review fix): a covering quad that face culling, user clip planes or the z clip could
+  // remove covers nothing (gpu_native_post_sync relies on the proof).
+  const auto mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  const auto clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  if (mode_cntl.cull_front || mode_cntl.cull_back || (clip_cntl.ucp_ena && !clip_cntl.clip_disable)) {
+    return NativeCoverReject(__LINE__, vertex_shader);
+  }
+  if (!rename_interpreter_) rename_interpreter_ = std::make_unique<ShaderInterpreter>(regs, *memory_);
+  struct PositionSink : ShaderInterpreter::ExportSink {
+    void Export(ucode::ExportRegister export_register, const float* value, uint32_t value_mask) override {
+      if (export_register != ucode::ExportRegister::kVSPosition) return;
+      for (uint32_t i = 0; i < 4; ++i) {
+        if (value_mask & (1u << i)) position[i] = value[i];
+      }
+      written |= value_mask;
+    }
+    float position[4] = {};
+    uint32_t written = 0;
+  } sink;
+  ShaderInterpreter& interpreter = *rename_interpreter_;
+  interpreter.SetShader(xenos::ShaderType::kVertex, vertex_shader.ucode_dwords());
+  interpreter.SetExportSink(&sink);
+  const double scale_x = vte.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0;
+  const double scale_y = vte.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0;
+  const double offset_x = vte.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0;
+  const double offset_y = vte.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0;
+  const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t index_min = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  const uint32_t index_max = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  double px[4] = {}, py[4] = {};
+  bool ok = true;
+  for (uint32_t i = 0; i < vertex_count && ok; ++i) {
+    std::memset(interpreter.temp_registers(), 0, sizeof(float) * 4 * xenos::kMaxShaderTempRegisters);
+    const uint32_t index = std::min(std::max((i + index_offset) & xenos::kVertexIndexMask, index_min), index_max);
+    interpreter.temp_registers()[0] = float(index);
+    sink.written = 0;
+    interpreter.Execute();
+    const double w = vte.vtx_xy_fmt ? 1.0 : double(sink.position[3]);
+    ok = (sink.written & 0b11) == 0b11 && (vte.vtx_xy_fmt || (sink.written & 0b1000)) && w > 0.0 &&
+         std::isfinite(w);
+    // Session 45 (review fix): every corner inside the z clip range (D3D 0...w, else -w...w), unless clipping is off.
+    if (ok && !clip_cntl.clip_disable) {
+      const double z = double(sink.position[2]), zw = double(sink.position[3]);
+      ok = (sink.written & 0b0100) && std::isfinite(z) && z <= zw && z >= (clip_cntl.dx_clip_space_def ? 0.0 : -zw);
+    }
+    if (!ok) break;
+    px[i] = double(sink.position[0]) / w * scale_x + offset_x;
+    py[i] = double(sink.position[1]) / w * scale_y + offset_y;
+  }
+  interpreter.SetExportSink(nullptr);
+  if (!ok) return NativeCoverReject(__LINE__, vertex_shader);
+  double min_x = DBL_MAX, max_x = -DBL_MAX, min_y = DBL_MAX, max_y = -DBL_MAX;
+  for (uint32_t i = 0; i < vertex_count; ++i) {
+    min_x = std::min(min_x, px[i]), max_x = std::max(max_x, px[i]);
+    min_y = std::min(min_y, py[i]), max_y = std::max(max_y, py[i]);
+  }
+  if (quad) {
+    // Every corner on the bounding box's corners, and consecutive corners adjacent (sharing x or y): a convex
+    // rectangle (the quad's two triangles cover it), not a bow-tie.
+    const auto on = [](double a, double b) { return std::abs(a - b) <= 1.0e-4; };
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (!(on(px[i], min_x) || on(px[i], max_x)) || !(on(py[i], min_y) || on(py[i], max_y))) return NativeCoverReject(__LINE__, vertex_shader);
+      const uint32_t j = (i + 1) & 3;
+      if (on(px[i], px[j]) == on(py[i], py[j])) return NativeCoverReject(__LINE__, vertex_shader);
+    }
+  } else {
+    // (Review fix) A rectangle list's three corners: each on a corner of the bounding box, no two the same corner -
+    // three corners of an axis-aligned rectangle, which is then the box (not a skewed parallelogram).
+    const auto on = [](double a, double b) { return std::abs(a - b) <= 1.0e-4; };
+    for (uint32_t i = 0; i < vertex_count; ++i) {
+      if (!(on(px[i], min_x) || on(px[i], max_x)) || !(on(py[i], min_y) || on(py[i], max_y))) return NativeCoverReject(__LINE__, vertex_shader);
+      for (uint32_t j = 0; j < i; ++j) {
+        if (on(px[i], px[j]) && on(py[i], py[j])) return NativeCoverReject(__LINE__, vertex_shader);
+      }
+    }
+  }
+  const double centre = regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero ? 0.0 : 0.5;
+  int32_t edges[4];
+  const double values[4] = {min_x, min_y, max_x, max_y};
+  for (uint32_t i = 0; i < 4; ++i) {
+    const double x = values[i] - centre;
+    const double distance = std::abs(x - std::round(x));
+    if ((distance > 1.0e-6 && distance < 1.0e-3) || x < -1.0 || x > 8192.0) return NativeCoverReject(__LINE__, vertex_shader);
+    edges[i] = std::max(0, int32_t(std::ceil(x - 1.0e-6)));
+  }
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  rect[0] = std::max(edges[0], int32_t(scissor.offset[0]));
+  rect[1] = std::max(edges[1], int32_t(scissor.offset[1]));
+  rect[2] = std::min(edges[2], int32_t(scissor.offset[0] + scissor.extent[0]));
+  rect[3] = std::min(edges[3], int32_t(scissor.offset[1] + scissor.extent[1]));
+  return (rect[2] > rect[0] && rect[3] > rect[1]) || NativeCoverReject(__LINE__, vertex_shader);
+}
