+  draw.host_primitive = uint8_t(primitive.host_primitive_type);
+  draw.host_vs_type = uint8_t(primitive.host_vertex_shader_type);
+  draw.polygonal = primitive_polygonal;
+  native::DrawRaster& raster = draw.raster;
+  const auto mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  raster.supported = primitive.host_vertex_shader_type == Shader::HostVertexShaderType::kVertex &&
+                     primitive_polygonal &&
+                     (primitive.host_primitive_type == xenos::PrimitiveType::kTriangleList ||
+                      primitive.host_primitive_type == xenos::PrimitiveType::kTriangleStrip);
