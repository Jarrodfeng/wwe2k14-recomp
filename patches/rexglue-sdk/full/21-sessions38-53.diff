+        back ? regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF) : front_mask;
+    draw.stencil_refs[0] = uint8_t(front_mask.stencilref);
+    draw.stencil_refs[1] = uint8_t(back_mask.stencilref);
+    draw.stencil_read_masks[0] = uint8_t(front_mask.stencilmask);
+    draw.stencil_read_masks[1] = uint8_t(back_mask.stencilmask);
+    draw.stencil_write_masks[0] = uint8_t(front_mask.stencilwritemask);
+    draw.stencil_write_masks[1] = uint8_t(back_mask.stencilwritemask);
