+  return true;
+}
+
+void VulkanCommandProcessor::LeanCaptureBase(const VulkanShader* vertex_shader, VulkanShader* pixel_shader,
+                                             uint32_t prim_type, bool major_mode_explicit, bool primitive_polygonal,
+                                             Shader::HostVertexShaderType host_vertex_shader_type,
+                                             uint32_t used_texture_mask, reg::RB_DEPTHCONTROL normalized_depth_control,
+                                             uint32_t normalized_color_mask,
+                                             const draw_util::ViewportInfo& viewport_info,
+                                             const PipelineLayout* layout,
+                                             VkPipelineStageFlags shared_memory_access_stages, uint32_t merge_stride,
+                                             uint32_t float_count, bool pixel_shader_vertex_fetches,
+                                             bool host_primitive_reset_enabled,
+                                             xenos::PrimitiveType host_primitive_type) {
+  LeanState now;
+  now.valid = true;
+  now.active_vertex_shader = active_vertex_shader();
+  now.active_pixel_shader = active_pixel_shader();
+  now.pixel_shader = pixel_shader;
+  now.prim_type = prim_type;
+  now.major_mode_explicit = major_mode_explicit;
+  now.primitive_polygonal = primitive_polygonal;
+  now.host_vertex_shader_type = host_vertex_shader_type;
+  now.used_texture_mask = used_texture_mask;
+  now.normalized_depth_control = normalized_depth_control;
+  now.normalized_color_mask = normalized_color_mask;
+  now.viewport_info = viewport_info;
+  now.layout = layout;
+  now.shared_memory_access_stages = shared_memory_access_stages;
+  now.merge_stride = merge_stride;
+  now.float_count = float_count;
+  now.pixel_shader_vertex_fetches = pixel_shader_vertex_fetches;
+  now.host_primitive_reset_enabled = host_primitive_reset_enabled;
+  now.host_primitive_type = host_primitive_type;
+  (void)vertex_shader;
+  if (lean_verify_pending_) {
+    lean_verify_pending_ = false;
+    if (native_repeat_draw_) LeanVerifyCompare(now, *native_repeat_draw_);
+  }
+  lean_ = now;
+}
+
+void VulkanCommandProcessor::LeanVerifyCompare(const LeanState& now, const native::Draw& d) {
+  // What the full path derived for a draw the lean path would have taken, against the base it would have used.
+  const LeanState& b = lean_verify_snapshot_;
+  const native::Draw& bd = *native_lean_verify_draw_;
+  LeanStats& stats = lean_stats_;
+  ++stats.verify_checked;
+  std::string what;
+  const auto check = [&](bool same, const char* name) {
+    if (!same) what += what.empty() ? name : fmt::format(", {}", name);
+  };
+  check(b.pixel_shader == now.pixel_shader, "pixel shader use");
+  check(b.host_vertex_shader_type == now.host_vertex_shader_type, "host vs type");
+  check(b.used_texture_mask == now.used_texture_mask, "textures");
+  check(b.normalized_depth_control.value == now.normalized_depth_control.value, "depth control");
+  check(b.normalized_color_mask == now.normalized_color_mask, "colour mask");
+  check(std::memcmp(&b.viewport_info, &now.viewport_info, sizeof(now.viewport_info)) == 0, "viewport info");
+  check(b.layout == now.layout, "layout");
+  check(b.shared_memory_access_stages == now.shared_memory_access_stages, "stages");
+  check(b.merge_stride == now.merge_stride && b.float_count == now.float_count, "merge");
+  check(b.host_primitive_reset_enabled == now.host_primitive_reset_enabled &&
+            b.host_primitive_type == now.host_primitive_type,
+        "primitive restart / type");
+  check(bd.pipeline == d.pipeline, "pipeline");
+  check(bd.vertex_shader == d.vertex_shader && bd.pixel_shader == d.pixel_shader, "modules");
+  check(bd.layout == d.layout, "native layout");
+  check(bd.truth_color == d.truth_color && bd.truth_depth == d.truth_depth && bd.truth_class == d.truth_class &&
+            bd.truth_sx == d.truth_sx && bd.truth_sy == d.truth_sy,
+        "truth images");
+  check(std::memcmp(&bd.viewport, &d.viewport, sizeof(d.viewport)) == 0, "viewport");
+  check(bd.raster.topology == d.raster.topology && bd.raster.cull_mode == d.raster.cull_mode &&
+            bd.raster.front_face_clockwise == d.raster.front_face_clockwise &&
+            bd.raster.depth_test == d.raster.depth_test && bd.raster.depth_write == d.raster.depth_write &&
+            bd.raster.depth_compare == d.raster.depth_compare && bd.raster.stencil == d.raster.stencil &&
+            bd.raster.stencil_ops == d.raster.stencil_ops && bd.raster.geometry_shader == d.raster.geometry_shader &&
+            bd.raster.expanded == d.raster.expanded && bd.raster.supported == d.raster.supported &&
+            bd.raster.clip_disable == d.raster.clip_disable &&
+            bd.raster.primitive_restart == d.raster.primitive_restart &&
+            std::memcmp(&bd.raster.depth_bias_constant, &d.raster.depth_bias_constant, sizeof(float)) == 0 &&
+            std::memcmp(&bd.raster.depth_bias_slope, &d.raster.depth_bias_slope, sizeof(float)) == 0,
+        "raster");
+  check(bd.color_mask_all == d.color_mask_all && bd.color_write_mask == d.color_write_mask &&
+            bd.blend_control == d.blend_control &&
+            std::memcmp(bd.blend_constants, d.blend_constants, sizeof(d.blend_constants)) == 0,
+        "blend");
+  check(bd.surface_info == d.surface_info && bd.color_info == d.color_info && bd.depth_info == d.depth_info,
+        "surfaces");
+  check(bd.stencil_ref == d.stencil_ref, "stencil ref");
+  check(bd.vertex_shader_hash == d.vertex_shader_hash && bd.pixel_shader_hash == d.pixel_shader_hash, "shaders");
+  if (what.empty()) return;
+  ++stats.verify_mismatches;
+  if (stats.verify_logged < 24) {
+    ++stats.verify_logged;
+    REXGPU_WARN("[native][lean] verify mismatch (frame {}): vs {:016X} ps {:016X}: {}", frame_current_,
+                d.vertex_shader_hash, d.pixel_shader_hash, what);
+  }
+}
+
+void VulkanCommandProcessor::LeanFrameEnd() {
+  lean_.valid = false;
+  lean_verify_pending_ = false;
+  // The settings whose per-draw work only the full path does (latched for the next frame).
+  lean_mode_ok_ = !REXCVAR_GET(gpu_draw_repeat_stats) && !REXCVAR_GET(gpu_hide_hud) &&
+                  !(REXCVAR_GET(gpu_wide_factor) > 1.001) && !REXCVAR_GET(gpu_dlss) &&
+                  !REXCVAR_GET(gpu_tiling_viewport_fix_stats) && !REXCVAR_GET(vulkan_vertex_residency_check) &&
+                  !REXCVAR_GET(gpu_native_truth_debug_flush_each) && !REXCVAR_GET(gpu_edram_rename);
+  lean_residency_cache_off_ = REXCVAR_GET(vulkan_vertex_residency_cache_off);
+  LeanStats& stats = lean_stats_;
+  if (stats.first_frame == UINT64_MAX) {
+    stats.first_frame = frame_current_;
+    return;
+  }
+  const uint64_t frames = frame_current_ - stats.first_frame;
+  if (frames < 300) return;
+  uint64_t considered = 0;
+  for (uint64_t n : stats.reasons) considered += n;
+  if (considered) {
+    const double f = double(frames);
+    REXGPU_INFO("[native][lean] frames {}-{}, per frame: lean {:.1f}, repeats {:.1f}; to IssueDraw: not a library draw "
+                "{:.1f}, mode {:.1f}, no base {:.1f}, state written {:.1f}, shaders {:.1f}, primitive {:.1f}, sampler "
+                "{:.1f}, claim {:.1f}, verify {:.1f}; verify: {} compared, {} mismatches, {} not truth",
+                stats.first_frame, frame_current_, stats.reasons[kLeanTaken] / f, stats.reasons[kLeanRepeat] / f,
+                stats.reasons[kLeanNotLibrary] / f, stats.reasons[kLeanMode] / f, stats.reasons[kLeanNoBase] / f,
+                stats.reasons[kLeanDirty] / f, stats.reasons[kLeanShader] / f, stats.reasons[kLeanPrimitive] / f,
+                stats.reasons[kLeanSampler] / f, stats.reasons[kLeanClaim] / f, stats.reasons[kLeanVerify] / f,
+                stats.verify_checked, stats.verify_mismatches, stats.verify_not_truth);
+  }
+  const uint32_t logged = stats.verify_logged, mode_logged = stats.mode_logged;
+  stats = LeanStats();
+  stats.first_frame = frame_current_;
+  stats.verify_logged = logged;
+  stats.mode_logged = mode_logged;
+}
