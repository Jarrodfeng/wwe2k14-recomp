+// wwe2k14 patch (Session 41, FASTCLEAR): see the header.
+uint32_t VulkanRenderTargetCache::EdramSampleDword(uint32_t base_tiles, uint32_t pitch_tiles, bool depth, uint32_t sx,
+                                                   uint32_t sy, bool is_64bpp) const {
+  const uint32_t tile_w = xenos::kEdramTileWidthSamples * draw_resolution_scale_x();
+  const uint32_t tile_h = xenos::kEdramTileHeightSamples * draw_resolution_scale_y();
+  const uint32_t tile_dwords = tile_w * tile_h;
+  const uint32_t half_w = tile_w >> 1;
+  if (is_64bpp) {  // wwe2k14 patch (Session 45, NATIVE ALL): as the fill shader's 64bpp path
+    const uint64_t offset64 = uint64_t(sy / tile_h) * pitch_tiles * 2 * tile_dwords + uint64_t(sx / half_w) * tile_dwords +
+                              (sy % tile_h) * tile_w + (sx % half_w) * 2;
+    const uint64_t wrap64 = uint64_t(xenos::kEdramTileCount) * tile_dwords;
+    return uint32_t((uint64_t(base_tiles % xenos::kEdramTileCount) * tile_dwords + offset64) % wrap64);
+  }
+  const uint32_t half_index = sx / half_w;
+  const bool second_half = (half_index & 1) != 0;
+  const uint64_t offset = uint64_t(sy / tile_h) * pitch_tiles * tile_dwords + uint64_t(half_index >> 1) * tile_dwords +
+                          (sy % tile_h) * tile_w + sx % half_w + ((second_half != depth) ? half_w : 0);
+  const uint64_t wrap = uint64_t(xenos::kEdramTileCount) * tile_dwords;
+  return uint32_t((uint64_t(base_tiles % xenos::kEdramTileCount) * tile_dwords + offset) % wrap);
+}
