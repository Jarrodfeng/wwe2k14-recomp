+bool VulkanRenderTargetCache::EdramFill(const EdramFillSurface* surfaces, uint32_t surface_count, uint32_t x0,
+                                        uint32_t y0, uint32_t width, uint32_t height) {
+  if (GetPath() != Path::kPixelShaderInterlock || edram_fill_failed_ || edram_buffer_ == VK_NULL_HANDLE || !width ||
+      !height || !surface_count) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (edram_fill_pipeline_ == VK_NULL_HANDLE) {
+    VkPushConstantRange push = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 48};
+    VkPipelineLayoutCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    info.setLayoutCount = 1;
+    info.pSetLayouts = &descriptor_set_layout_storage_buffer_;
+    info.pushConstantRangeCount = 1;
+    info.pPushConstantRanges = &push;
+    if (dfn.vkCreatePipelineLayout(device, &info, nullptr, &edram_fill_layout_) != VK_SUCCESS) {
+      REXGPU_ERROR("[fastclear] EDRAM fill: pipeline layout failed");
+      edram_fill_failed_ = true;
+      return false;
+    }
+    edram_fill_pipeline_ = ui::vulkan::util::CreateComputePipeline(vulkan_device, edram_fill_layout_,
+                                                                   shaders::edram_fill_cs, sizeof(shaders::edram_fill_cs));
+    if (edram_fill_pipeline_ == VK_NULL_HANDLE) {
+      REXGPU_ERROR("[fastclear] EDRAM fill: pipeline failed");
+      edram_fill_failed_ = true;
+      return false;
+    }
+  }
+  const uint32_t tile_w = xenos::kEdramTileWidthSamples * draw_resolution_scale_x();
+  const uint32_t tile_h = xenos::kEdramTileHeightSamples * draw_resolution_scale_y();
+  const uint32_t tile_dwords = tile_w * tile_h;
+  // The clear's draw (FSI writes) -> the fill's reads of the drawn pixel and its read-modify-writes (compute), as two
+  // usage switches: fragment read / write -> compute read -> compute write. The next draw's switch back to fragment
+  // read / write waits for the fill, as after a resolve's clear.
