+void NoteWatchFault(uint64_t pc, uint64_t ns, bool raced) {
+  const uint32_t tid = rex::thread::current_thread_id();
+  std::lock_guard<std::mutex> lock(watch_fault_mutex);
+  WatchFaultStats& s = watch_fault_stats;
+  ++s.faults;
+  s.raced += raced ? 1 : 0;
+  s.ns += ns;
+  s.max_ns = std::max(s.max_ns, ns);
+  for (auto& t : s.threads) {
+    if (t.second && t.first != tid) continue;
+    t.first = tid;
+    ++t.second;
+    break;
+  }
+  bool placed = false;
+  for (auto& p : s.pcs) {
+    if (p.second && p.first != pc) continue;
+    p.first = pc;
+    ++p.second;
+    placed = true;
+    break;
+  }
