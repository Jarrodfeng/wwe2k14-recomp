+
+void VulkanRenderTargetCache::RenameCopyIn(VkDeviceSize span_start, VkDeviceSize span_bytes) {
+  // Everything earlier that read or wrote the EDRAM buffer (draws, resolves, clears, copies, the slots' last run)
+  // -> these copies.
+  constexpr VkPipelineStageFlags kStages =
+      VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+  constexpr VkAccessFlags kAccesses = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+                                      VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+  command_processor_.PushBufferMemoryBarrier(edram_buffer_, 0, VK_WHOLE_SIZE, kStages, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                             kAccesses, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+  command_processor_.SubmitBarriers(true);
+  VkBufferCopy regions[kRenameSlots];
+  for (uint32_t i = 0; i < kRenameSlots; ++i) {
+    regions[i].srcOffset = span_start;
+    regions[i].dstOffset = edram_size_bytes() + VkDeviceSize(i) * rename_slot_bytes_;
+    regions[i].size = span_bytes;
+  }
+  command_processor_.deferred_command_buffer().CmdVkCopyBuffer(edram_buffer_, edram_buffer_, kRenameSlots, regions);
+  edram_buffer_usage_ = EdramBufferUsage::kTransferWrite;
+  edram_buffer_modification_status_ = EdramBufferModificationStatus::kUnmodified;
+}
+
+void VulkanRenderTargetCache::RenameEnterFreshSlot() {
+  // The EDRAM buffer was last used by the previous pass's resolve (compute read of its slot) or draws (its slot):
+  // this pass's draws touch another slot, written by the run's copy, which the first pass's draws already waited
+  // for. So no barrier: the usage just becomes the draws' (the next resolve's barrier waits for them as always).
+  if (edram_buffer_usage_ == EdramBufferUsage::kComputeRead ||
+      edram_buffer_usage_ == EdramBufferUsage::kFragmentReadWrite) {
+    edram_buffer_usage_ = EdramBufferUsage::kFragmentReadWrite;
+    edram_buffer_modification_status_ = EdramBufferModificationStatus::kUnmodified;
+  }
+}
+
+void VulkanRenderTargetCache::RenameCopyBack(uint32_t slot, VkDeviceSize span_start, VkDeviceSize span_bytes) {
+  constexpr VkPipelineStageFlags kStages =
+      VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT;
+  constexpr VkAccessFlags kAccesses = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+                                      VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+  command_processor_.PushBufferMemoryBarrier(edram_buffer_, 0, VK_WHOLE_SIZE, kStages, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                             kAccesses, VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+  command_processor_.SubmitBarriers(true);
+  VkBufferCopy region;
+  region.srcOffset = edram_size_bytes() + VkDeviceSize(slot) * rename_slot_bytes_;
+  region.dstOffset = span_start;
+  region.size = span_bytes;
+  command_processor_.deferred_command_buffer().CmdVkCopyBuffer(edram_buffer_, edram_buffer_, 1, &region);
+  edram_buffer_usage_ = EdramBufferUsage::kTransferWrite;
+  edram_buffer_modification_status_ = EdramBufferModificationStatus::kUnmodified;
+}
