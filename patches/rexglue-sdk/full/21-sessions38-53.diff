+// ---------------------------------------------------------------------------------------------------------------
+// wwe2k14 patch (Session 41, FASTCLEAR): exact cheap clears (see FastClear in the header).
+// ---------------------------------------------------------------------------------------------------------------
+
+bool VulkanCommandProcessor::FastClearDetect(xenos::PrimitiveType prim_type, const VulkanShader& vertex_shader,
+                                             const VulkanShader* pixel_shader, reg::RB_DEPTHCONTROL depth_control,
+                                             uint32_t color_mask, bool memexport) {
+  fast_clear_.active = false;
+  const RegisterFile& regs = *register_file_;
+  // wwe2k14 patch (Session 45, NATIVE ALL): with gpu_native_all, also depth / stencil clears without a pixel shader
+  // (no colour written: the emulated draw's depth comes from the vertex shader, checked constant below).
+  const bool no_pixel_shader_ok = !pixel_shader && !color_mask && native_ &&
+                                  native_->all_native(native::NativeRenderer::kAllFastClears);
+  if (prim_type != xenos::PrimitiveType::kRectangleList || memexport || (!pixel_shader && !no_pixel_shader_ok)) {
+    return FastClearReject(__LINE__);
+  }
+  if (render_target_cache_->GetPath() != RenderTargetCache::Path::kPixelShaderInterlock || rename_.active ||
+      DlaaJitterOn()) {
+    return FastClearReject(__LINE__);
+  }
+  const auto initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (initiator.source_select != xenos::SourceSelect::kAutoIndex || initiator.num_indices != 3) {
+    return FastClearReject(__LINE__);
+  }
+  const xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (edram_mode != xenos::EdramMode::kColorDepth && edram_mode != xenos::EdramMode::kDepthOnly) {
+    return FastClearReject(__LINE__);
+  }
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  if (!surface_info.surface_pitch) return FastClearReject(__LINE__);
+  const uint32_t samples_x = surface_info.msaa_samples >= xenos::MsaaSamples::k4X ? 2 : 1;
+  const uint32_t samples_y = surface_info.msaa_samples >= xenos::MsaaSamples::k2X ? 2 : 1;
+
+  // Depth / stencil: what the clear writes in the depth / stencil dword (depth in bits 8-31, stencil in 0-7:
+  // spirv_translator_rb.cpp FSI_DepthStencilTest), with tests that always pass. The keep mask = the bits left alone.
+  uint32_t depth_keep = 0xFFFFFFFFu;
+  if (depth_control.z_enable) {
+    if (depth_control.zfunc != xenos::CompareFunction::kAlways) return FastClearReject(__LINE__);
+    if (depth_control.z_write_enable) depth_keep &= 0x000000FFu;
+  }
+  if (depth_control.stencil_enable) {
+    if (depth_control.backface_enable || depth_control.stencilfunc != xenos::CompareFunction::kAlways) {
+      return FastClearReject(__LINE__);
+    }
+    if (depth_control.stencilzpass == xenos::StencilOp::kReplace) {
+      depth_keep &= ~uint32_t(regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask);
+    } else if (depth_control.stencilzpass != xenos::StencilOp::kKeep) {
+      return FastClearReject(__LINE__);
+    }
+  }
+  // Colour: render target 0 only, all of a 32bpp format, no blending, no alpha test / alpha to mask, no kill.
+  const auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  if (color_mask & ~uint32_t(0xF)) return FastClearReject(__LINE__);
+  const bool color_written = color_mask == 0xF;
+  if (color_mask && !color_written) return FastClearReject(__LINE__);
+  const auto color_info = regs.Get<reg::RB_COLOR_INFO>();
+  const auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  // wwe2k14 patch (Session 45, NATIVE ALL): 64bpp colour too in a frame the native renderer draws all of.
+  const bool color_64bpp = xenos::IsColorRenderTargetFormat64bpp(color_info.color_format);
+  if (color_written &&
+      ((color_64bpp && !(native_ && native_->all_native(native::NativeRenderer::kAllFastClears))) ||
+       regs[XE_GPU_REG_RB_BLENDCONTROL0] != 0x00010001 || color_control.alpha_test_enable ||
+       color_control.alpha_to_mask_enable || color_info.color_base_bit_11)) {
+    return FastClearReject(__LINE__);
+  }
+  const bool depth_written = depth_keep != 0xFFFFFFFFu;
+  if (!color_written && !depth_written) return FastClearReject(__LINE__);
+  if (depth_written && depth_info.depth_base_bit_11) return FastClearReject(__LINE__);
+  if (pixel_shader && (pixel_shader->kills_pixels() || !pixel_shader->texture_bindings().empty() ||
+                       !pixel_shader->vertex_bindings().empty())) {
+    return FastClearReject(__LINE__);
+  }
+  // The pixel shader's inputs: none that vary (no position / face, interpolators only if constant, checked below).
+  uint32_t param_gen = UINT32_MAX;
+  const uint32_t interpolators =
+      pixel_shader ? pixel_shader->GetInterpolatorInputMask(regs.Get<reg::SQ_PROGRAM_CNTL>(),
+                                                            regs.Get<reg::SQ_CONTEXT_MISC>(), param_gen)
+                   : 0u;
+  if (param_gen != UINT32_MAX) return FastClearReject(__LINE__);
+  const auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (window_offset.window_x_offset || window_offset.window_y_offset || (!vte.vtx_xy_fmt && !vte.vtx_w0_fmt) ||
+      !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return FastClearReject(__LINE__);
+  }
+
+  // The three corners from the vertex shader run on the CPU (as EdramRenameClearRect): the position, and the depth and
+  // interpolators, which must be the same at every corner (then every sample gets the same values).
+  if (!rename_interpreter_) rename_interpreter_ = std::make_unique<ShaderInterpreter>(regs, *memory_);
+  struct Sink : ShaderInterpreter::ExportSink {
+    void Export(ucode::ExportRegister export_register, const float* value, uint32_t value_mask) override {
+      const uint32_t r = uint32_t(export_register);
+      float* dest = nullptr;
+      if (export_register == ucode::ExportRegister::kVSPosition) {
+        dest = position, written_position |= value_mask;
+      } else if (r < 16) {
+        dest = interpolators[r], written_interpolators |= 1u << r;
+      }
+      if (!dest) return;
+      for (uint32_t i = 0; i < 4; ++i) {
+        if (value_mask & (1u << i)) dest[i] = value[i];
+      }
+    }
+    float position[4] = {};
+    float interpolators[16][4] = {};
+    uint32_t written_position = 0, written_interpolators = 0;
+  } sink;
+  ShaderInterpreter& interpreter = *rename_interpreter_;
+  interpreter.SetShader(xenos::ShaderType::kVertex, vertex_shader.ucode_dwords());
+  interpreter.SetExportSink(&sink);
+  const double scale_x = vte.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0;
+  const double scale_y = vte.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0;
+  const double offset_x = vte.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0;
+  const double offset_y = vte.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0;
+  const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t index_min = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  const uint32_t index_max = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  double min_x = DBL_MAX, max_x = -DBL_MAX, min_y = DBL_MAX, max_y = -DBL_MAX;
+  float first_z = 0.0f, first_w = 0.0f, first_interpolators[16][4] = {};
+  bool ok = true, constant = true;
+  for (uint32_t i = 0; i < 3 && ok; ++i) {
+    std::memset(interpreter.temp_registers(), 0, sizeof(float) * 4 * xenos::kMaxShaderTempRegisters);
+    const uint32_t index = std::min(std::max((i + index_offset) & xenos::kVertexIndexMask, index_min), index_max);
+    interpreter.temp_registers()[0] = float(index);
+    sink.written_position = 0, sink.written_interpolators = 0;
+    interpreter.Execute();
+    const double w = vte.vtx_xy_fmt ? 1.0 : double(sink.position[3]);
+    ok = (sink.written_position & 0b11) == 0b11 && (vte.vtx_xy_fmt || (sink.written_position & 0b1000)) &&
+         w > 0.0 && std::isfinite(w) && (sink.written_interpolators & interpolators) == interpolators;
+    if (!ok) break;
+    const double px = double(sink.position[0]) / w * scale_x + offset_x;
+    const double py = double(sink.position[1]) / w * scale_y + offset_y;
+    min_x = std::min(min_x, px), max_x = std::max(max_x, px);
+    min_y = std::min(min_y, py), max_y = std::max(max_y, py);
+    if (i == 0) {
+      first_z = sink.position[2], first_w = sink.position[3];
+      std::memcpy(first_interpolators, sink.interpolators, sizeof(first_interpolators));
+    } else {
+      // Bit for bit: the same depth (z, and w unless X / Y / Z are not divided by it) and the same interpolators.
+      constant &= std::memcmp(&first_z, &sink.position[2], sizeof(float)) == 0 &&
+                  (vte.vtx_xy_fmt || std::memcmp(&first_w, &sink.position[3], sizeof(float)) == 0);
+      for (uint32_t j = 0; j < 16; ++j) {
+        if (interpolators & (1u << j)) {
+          constant &= std::memcmp(first_interpolators[j], sink.interpolators[j], sizeof(float) * 4) == 0;
+        }
+      }
+    }
+  }
+  interpreter.SetExportSink(nullptr);
+  if (!ok) return FastClearReject(__LINE__);
+  if (!constant) return FastClearReject(__LINE__);
+  // The pixels covered. With MSAA every sample of a covered pixel must be covered and no sample of another: each edge
+  // on a pixel boundary (pixel p spans [p + centre - 0.5, p + centre + 0.5)) or outside the scissor (clipped there).
+  // Without MSAA, the pixel-centre rule (EdramRenameClearRect).
+  const double centre = regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero ? 0.0 : 0.5;
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  const int32_t scissor_edges[4] = {int32_t(scissor.offset[0]), int32_t(scissor.offset[1]),
+                                    int32_t(scissor.offset[0] + scissor.extent[0]),
+                                    int32_t(scissor.offset[1] + scissor.extent[1])};
+  const double values[4] = {min_x, min_y, max_x, max_y};
+  int32_t* rect = fast_clear_.rect;
+  for (uint32_t i = 0; i < 4; ++i) {
+    const double x = values[i] - centre;
+    if (x < -8192.0 || x > 16384.0) return FastClearReject(__LINE__);
+    int32_t edge;
+    if (samples_x == 1 && samples_y == 1) {
+      const double distance = std::abs(x - std::round(x));
+      if (distance > 1.0e-6 && distance < 1.0e-3) return FastClearReject(__LINE__);
+      edge = int32_t(std::ceil(x - 1.0e-6));
+    } else {
+      const double boundary = x + 0.5;
+      const bool low = i < 2;
+      const int32_t s = scissor_edges[i];
+      // Outside the scissor by at least a pixel: the scissor is the edge.
+      if (low ? boundary <= double(s) - 1.0 : boundary >= double(s) + 1.0) {
+        edge = s;
+      } else {
+        if (std::abs(boundary - std::round(boundary)) > 1.0e-6) return FastClearReject(__LINE__);
+        edge = int32_t(std::round(boundary));
+      }
+    }
+    rect[i] = i < 2 ? std::max(std::max(edge, 0), scissor_edges[i]) : std::min(edge, scissor_edges[i]);
+  }
+  if (!(rect[2] > rect[0] && rect[3] > rect[1] && uint32_t(rect[2]) <= surface_info.surface_pitch)) {
+    return FastClearReject(__LINE__);
+  }
+  // wwe2k14 patch (Session 45, NATIVE ALL): any size in a frame the native renderer draws all of (no emulated draws).
+  const int32_t min_size = native_ && native_->all_native(native::NativeRenderer::kAllFastClears)
+                               ? 1
+                               : REXCVAR_GET(gpu_fast_clear_min_size);
+  if (rect[2] - rect[0] < min_size || rect[3] - rect[1] < min_size) {
+    ++fast_clear_stats_.too_small;
+    return FastClearReject(__LINE__);
+  }
+
+  // The surfaces and the drawn pixel's sample 0 in each (the rectangle's first pixel).
+  const uint32_t pitch_tiles = (surface_info.surface_pitch * samples_x + xenos::kEdramTileWidthSamples - 1) /
+                               xenos::kEdramTileWidthSamples;
+  const uint32_t scale_x_int = texture_cache_->draw_resolution_scale_x();
+  const uint32_t scale_y_int = texture_cache_->draw_resolution_scale_y();
+  const uint32_t src_x = uint32_t(rect[0]) * scale_x_int * samples_x;
+  const uint32_t src_y = uint32_t(rect[1]) * scale_y_int * samples_y;
+  fast_clear_.surface_count = 0;
+  if (color_written) {
+    auto& s = fast_clear_.surfaces[fast_clear_.surface_count++];
+    s.base_tiles = color_info.color_base, s.pitch_tiles = pitch_tiles, s.keep_mask = 0, s.depth = false;
+    s.is_64bpp = color_64bpp;
+    s.src_dword = render_target_cache_->EdramSampleDword(s.base_tiles, pitch_tiles, false, src_x, src_y, color_64bpp);
+  }
+  if (depth_written) {
+    auto& s = fast_clear_.surfaces[fast_clear_.surface_count++];
+    s.base_tiles = depth_info.depth_base, s.pitch_tiles = pitch_tiles, s.keep_mask = depth_keep, s.depth = true;
+    s.is_64bpp = false;
+    s.src_dword = render_target_cache_->EdramSampleDword(s.base_tiles, pitch_tiles, true, src_x, src_y);
+  }
+  // Colour and depth over the same tiles: the order would matter; left as a draw.
+  if (fast_clear_.surface_count == 2) {
+    const uint32_t rows = (uint32_t(rect[3]) * samples_y + xenos::kEdramTileHeightSamples - 1) /
+                          xenos::kEdramTileHeightSamples;
+    const uint32_t first_row = uint32_t(rect[1]) * samples_y / xenos::kEdramTileHeightSamples;
+    const uint32_t span = (rows - first_row) * pitch_tiles;
+    const uint32_t color_span = span * (color_64bpp ? 2u : 1u);  // (Session 45: 64bpp rows twice as long)
+    const uint32_t c0 = color_info.color_base + first_row * pitch_tiles * (color_64bpp ? 2u : 1u),
+                   d0 = depth_info.depth_base + first_row * pitch_tiles;
+    if (c0 < d0 + span && d0 < c0 + color_span) return FastClearReject(__LINE__);
+  }
+  fast_clear_.samples_x = samples_x, fast_clear_.samples_y = samples_y;
+  fast_clear_.active = true;
+  return true;
+}
+
+void VulkanCommandProcessor::FastClearFrameEnd() {
+  FastClearStats& s = fast_clear_stats_;
+  if (!s.rect_draws || ++s.frames < 600) return;
+  const double f = double(s.frames);
+  std::string rejects;
+  for (const auto& [line, count] : s.rejects) rejects += fmt::format(" {}:{:.1f}", line, count / f);
+  REXGPU_INFO("[fastclear] {} frames: rectangle draws {:.1f}/frame, filled {:.1f} ({:.2f} Mpixels/frame), too small "
+              "{:.1f}; rejects by line{}",
+              s.frames, s.rect_draws / f, s.fills / f, s.fill_pixels / f / 1.0e6, s.too_small / f, rejects);
+  fast_clear_stats_ = {};
+}
+
+VkDescriptorSet VulkanCommandProcessor::EdramRenameDrawSet(VkDeviceSize offset) {
+  auto found = rename_draw_sets_.find(offset);
+  if (found != rename_draw_sets_.end()) return found->second;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  constexpr uint32_t kMaxSets = 256;
+  if (rename_draw_set_pool_ == VK_NULL_HANDLE) {
+    VkDescriptorPoolSize size = {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, kMaxSets * (rename_shared_memory_binding_count_ + 1)};
+    VkDescriptorPoolCreateInfo info = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    info.maxSets = kMaxSets;
+    info.poolSizeCount = 1;
+    info.pPoolSizes = &size;
+    if (dfn.vkCreateDescriptorPool(device, &info, nullptr, &rename_draw_set_pool_) != VK_SUCCESS) {
+      rename_draw_set_pool_ = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+    }
+  }
+  if (rename_draw_sets_.size() >= kMaxSets) return VK_NULL_HANDLE;
+  VkDescriptorSetAllocateInfo alloc = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+  alloc.descriptorPool = rename_draw_set_pool_;
+  alloc.descriptorSetCount = 1;
+  alloc.pSetLayouts = &descriptor_set_layout_shared_memory_and_edram_;
+  VkDescriptorSet set = VK_NULL_HANDLE;
+  if (dfn.vkAllocateDescriptorSets(device, &alloc, &set) != VK_SUCCESS) return VK_NULL_HANDLE;
+  // As shared_memory_and_edram_descriptor_set_ (SetupContext), with the EDRAM binding at the slot's offset.
+  VkDescriptorBufferInfo shared_memory_infos[SharedMemory::kBufferSize / (128 << 20)];
+  const uint32_t range = SharedMemory::kBufferSize / rename_shared_memory_binding_count_;
+  for (uint32_t i = 0; i < rename_shared_memory_binding_count_; ++i) {
+    shared_memory_infos[i] = {shared_memory_->buffer(), VkDeviceSize(range) * i, range};
+  }
+  VkDescriptorBufferInfo edram_info = {render_target_cache_->edram_buffer(), offset, VK_WHOLE_SIZE};
+  VkWriteDescriptorSet writes[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = set;
+    writes[i].dstBinding = i;
+    writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  }
+  writes[0].descriptorCount = rename_shared_memory_binding_count_;
+  writes[0].pBufferInfo = shared_memory_infos;
+  writes[1].descriptorCount = 1;
+  writes[1].pBufferInfo = &edram_info;
+  dfn.vkUpdateDescriptorSets(device, 2, writes, 0, nullptr);
+  rename_draw_sets_.emplace(offset, set);
+  return set;
+}
+
+bool VulkanCommandProcessor::EdramRenameBindSlot() {
+  const VkDeviceSize offset = render_target_cache_->RenameSlotOffset(rename_.slot, rename_.span_start);
+  const VkDescriptorSet draw_set = EdramRenameDrawSet(offset);
+  if (draw_set == VK_NULL_HANDLE || render_target_cache_->RenameResolveSet(offset) == VK_NULL_HANDLE) return false;
+  current_graphics_descriptor_sets_[SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram] = draw_set;
+  current_graphics_descriptor_sets_bound_up_to_date_ &=
+      ~(UINT32_C(1) << SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram);
+  return true;
+}
+
+void VulkanCommandProcessor::EdramRenameEnd(EdramRenameEndReason reason) {
+  if (!rename_.active) return;
+  rename_.active = false;
+  ++rename_stats_.ends[reason];
+  // The last pass's slot holds what the EDRAM would after the whole run.
+  render_target_cache_->RenameCopyBack(rename_.slot, rename_.span_start, rename_.span_bytes);
+  render_target_cache_->SetResolveEdramSet(VK_NULL_HANDLE);
+  current_graphics_descriptor_sets_[SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram] =
+      shared_memory_and_edram_descriptor_set_;
+  current_graphics_descriptor_sets_bound_up_to_date_ &=
+      ~(UINT32_C(1) << SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram);
+}
+
+void VulkanCommandProcessor::EdramRenameOnDraw(xenos::PrimitiveType prim_type, const VulkanShader& vertex_shader,
+                                               const VulkanShader* pixel_shader, reg::RB_DEPTHCONTROL depth_control,
+                                               uint32_t color_mask, bool memexport) {
+  const RegisterFile& regs = *register_file_;
+  const uint32_t surface_info = regs.Get<reg::RB_SURFACE_INFO>().value;
+  const uint32_t color_info = regs[XE_GPU_REG_RB_COLOR_INFO];
+  const uint32_t depth_info = regs[XE_GPU_REG_RB_DEPTH_INFO];
+  const bool enabled = REXCVAR_GET(gpu_edram_rename);
+  int32_t rect[4];
+  rename_reject_line_ = 0;
+  const bool clear = enabled && EdramRenameClearRect(prim_type, vertex_shader, pixel_shader, depth_control,
+                                                     color_mask, memexport, rect);
+  // gpu_edram_rename_log N: the next N rectangle draws, and what the detection said about them.
+  if (enabled && prim_type == xenos::PrimitiveType::kRectangleList) {
+    if (const int32_t n = REXCVAR_GET(gpu_edram_rename_log); n > 0) {
+      rex::cvar::SetFlagByName("gpu_edram_rename_log", std::to_string(n - 1));
+      REXGPU_INFO("[rename] rect draw vs {:016X}: {} (reject line {}), rect {} {} {} {}, surface 0x{:08X} color 0x{:08X} "
+                  "depth 0x{:08X} depthcontrol 0x{:08X} stencilrefmask 0x{:08X} color mask 0x{:X} blend 0x{:08X} "
+                  "colorcontrol 0x{:08X} vte 0x{:08X} window offset 0x{:08X} indices {} source {}",
+                  vertex_shader.ucode_data_hash(), clear ? "clear" : "no", rename_reject_line_,
+                  clear ? rect[0] : 0, clear ? rect[1] : 0, clear ? rect[2] : 0, clear ? rect[3] : 0, surface_info,
+                  color_info, depth_info, depth_control.value, regs[XE_GPU_REG_RB_STENCILREFMASK], color_mask,
+                  regs[XE_GPU_REG_RB_BLENDCONTROL0], regs[XE_GPU_REG_RB_COLORCONTROL],
+                  regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+                  regs.Get<reg::VGT_DRAW_INITIATOR>().num_indices,
+                  uint32_t(regs.Get<reg::VGT_DRAW_INITIATOR>().source_select));
+    }
+  }
+  const bool same_shape = rename_.active && surface_info == rename_.surface_info &&
+                          color_info == rename_.color_info && depth_info == rename_.depth_info;
+  if (clear) {
+    if (same_shape && rect[0] == rename_.x0 && rect[1] == rename_.y0 && rect[2] == rename_.x1 &&
+        rect[3] == rename_.y1) {
+      if (rename_.slot + 1 < VulkanRenderTargetCache::kRenameSlots) {
+        // The next pass of the run, in the next slot.
+        ++rename_.slot;
+        if (EdramRenameBindSlot()) {
+          render_target_cache_->RenameEnterFreshSlot();
+          ++rename_stats_.passes;
+          return;
+        }
+        --rename_.slot;
+        EdramRenameEnd(kRenameEndOther);
+      } else {
+        EdramRenameEnd(kRenameEndSlots);
+      }
+    } else if (rename_.active) {
+      EdramRenameEnd(kRenameEndShape);
+    }
+    // A new run: its EDRAM span (the tiles of the rectangle's rows in the colour and depth surfaces, 32bpp).
+    if (native_ && native_->HasUnwrittenNative()) return;
+    const auto si = regs.Get<reg::RB_SURFACE_INFO>();
+    const auto ci = regs.Get<reg::RB_COLOR_INFO>();
+    const auto di = regs.Get<reg::RB_DEPTH_INFO>();
+    if (ci.color_base_bit_11 || di.depth_base_bit_11) return;
+    const uint32_t pitch_tiles = (si.surface_pitch + xenos::kEdramTileWidthSamples - 1) / xenos::kEdramTileWidthSamples;
+    const uint32_t first = uint32_t(rect[1]) / xenos::kEdramTileHeightSamples * pitch_tiles +
+                           uint32_t(rect[0]) / xenos::kEdramTileWidthSamples;
+    const uint32_t last = uint32_t(rect[3] - 1) / xenos::kEdramTileHeightSamples * pitch_tiles +
+                          uint32_t(rect[2] - 1) / xenos::kEdramTileWidthSamples;
+    const uint32_t span_first = std::min(ci.color_base, di.depth_base) + first;
+    const uint32_t span_end = std::max(ci.color_base, di.depth_base) + last + 1;
+    const VkDeviceSize tile_bytes = VkDeviceSize(xenos::kEdramTileWidthSamples * xenos::kEdramTileHeightSamples * 4) *
+                                    (texture_cache_->draw_resolution_scale_x() *
+                                     texture_cache_->draw_resolution_scale_y());
+    if (span_end > xenos::kEdramTileCount ||
+        VkDeviceSize(span_end - span_first) * tile_bytes > render_target_cache_->edram_rename_slot_bytes()) {
+      return;
+    }
+    rename_.surface_info = surface_info;
+    rename_.color_info = color_info;
+    rename_.depth_info = depth_info;
+    rename_.x0 = rect[0], rename_.y0 = rect[1], rename_.x1 = rect[2], rename_.y1 = rect[3];
+    rename_.span_start = VkDeviceSize(span_first) * tile_bytes;
+    rename_.span_bytes = VkDeviceSize(span_end - span_first) * tile_bytes;
+    rename_.slot = 0;
+    if (!EdramRenameBindSlot()) return;
+    render_target_cache_->RenameCopyIn(rename_.span_start, rename_.span_bytes);
+    rename_.active = true;
+    ++rename_stats_.runs;
+    ++rename_stats_.passes;
+    return;
+  }
+  if (!rename_.active) return;
+  // A draw of the current pass: the same targets, nothing but render target 0 and depth, inside the rectangle.
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  const bool inside = int32_t(scissor.offset[0]) >= rename_.x0 && int32_t(scissor.offset[1]) >= rename_.y0 &&
+                      int32_t(scissor.offset[0] + scissor.extent[0]) <= rename_.x1 &&
+                      int32_t(scissor.offset[1] + scissor.extent[1]) <= rename_.y1;
+  if (!enabled || !same_shape || memexport || (color_mask & ~uint32_t(0xF)) || !inside) {
+    EdramRenameEnd(kRenameEndDraw);
+  }
+}
+
+void VulkanCommandProcessor::EdramRenameOnResolve() {
+  const RegisterFile& regs = *register_file_;
+  draw_util::ResolveInfo info;
+  bool fits = REXCVAR_GET(gpu_edram_rename) && regs.Get<reg::RB_SURFACE_INFO>().value == rename_.surface_info &&
+              regs[XE_GPU_REG_RB_COLOR_INFO] == rename_.color_info &&
+              regs[XE_GPU_REG_RB_DEPTH_INFO] == rename_.depth_info &&
+              draw_util::GetResolveInfo(regs, *memory_, texture_cache_->draw_resolution_scale_x(),
+                                        texture_cache_->draw_resolution_scale_y(),
+                                        render_target_cache_->IsFixedRG16TruncatedToMinus1To1(),
+                                        render_target_cache_->IsFixedRGBA16TruncatedToMinus1To1(), info) &&
