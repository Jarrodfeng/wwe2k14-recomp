+  raster.clip_disable = regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable;  // wwe2k14 patch (Session 43, review)
+  draw.color_mask_all = color_mask;
+  draw.blend_constants[0] = regs.Get<float>(XE_GPU_REG_RB_BLEND_RED);
+  draw.blend_constants[1] = regs.Get<float>(XE_GPU_REG_RB_BLEND_GREEN);
+  draw.blend_constants[2] = regs.Get<float>(XE_GPU_REG_RB_BLEND_BLUE);
+  draw.blend_constants[3] = regs.Get<float>(XE_GPU_REG_RB_BLEND_ALPHA);
+  draw.occlusion_query = active_occlusion_query_.valid;
+  draw.surface_info = regs.Get<reg::RB_SURFACE_INFO>().value;
+  draw.color_info = regs[XE_GPU_REG_RB_COLOR_INFO];
+  draw.depth_info = regs[XE_GPU_REG_RB_DEPTH_INFO];
+  draw.vertex_count = primitive.host_draw_vertex_count;  // IssueDraw sets 0 for draws it leaves out
+  draw.screen_space =
+      guest_primitive == xenos::PrimitiveType::kRectangleList || !regs.Get<reg::PA_CL_VTE_CNTL>().vport_x_scale_ena;
+  draw.memexport = memexport;
+  draw.color_write_mask = color_mask & 0xF;
+  draw.blend_control = regs[XE_GPU_REG_RB_BLENDCONTROL0];
+  // The game's pixel shader for host render targets, translated once per shader and modification.
+  if (pixel_shader && native_->WantsPixelShader(draw)) {
+    // wwe2k14 patch (Session 43, NATIVE DEPTH): a post draw that tests or writes depth gets its depth rounded to 20e4
+    // by the shader (exact depth tests in post targets).
+    draw.float24_depth = native_->WantsFloat24Depth(draw);
+    // wwe2k14 patch (Session 43, NATIVE QUANTIZE): a post draw into an 8-bit / 16-bit post target rounds its colour.
+    draw.color_quantize = native_->WantsColorQuantize(draw);
+    // wwe2k14 patch (Session 44, measurement only): gpu_native_post_depth_unrounded_debug drops the rounding (and so
+    // the shader's depth write, which turns the early depth test off) - not exact.
+    const bool float24 = draw.float24_depth && !REXCVAR_GET(gpu_native_post_depth_unrounded_debug);
+    // wwe2k14 patch (Session 47, NATIVE TRUTH CPU): in a truth frame, the last translation again where the shader and
+    // its modification are the last draw's (dropped when the caches are cleared).
+    NativeTranslationCache& c = native_ps_cache_;
+    const bool cacheable = native_->truth();
+    if (cacheable && c.valid && c.shader == pixel_shader && c.modification == pixel_modification.value &&
+        c.float24 == float24 && c.quantize == draw.color_quantize) {
+      draw.pixel_shader = c.module;
+    } else {
+      VulkanShader::VulkanTranslation* translation = pipeline_cache_->GetNativePixelShaderTranslation(
+          const_cast<VulkanShader&>(*pixel_shader), pixel_modification, float24, draw.color_quantize);
+      draw.pixel_shader = translation ? translation->shader_module() : VK_NULL_HANDLE;
+      c.valid = cacheable && draw.pixel_shader != VK_NULL_HANDLE;
+      c.shader = pixel_shader;
+      c.modification = pixel_modification.value;
+      c.float24 = float24;
+      c.quantize = draw.color_quantize;
+      c.module = draw.pixel_shader;
+    }
+  }
+}
