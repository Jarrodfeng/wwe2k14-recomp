+// wwe2k14 patch (Session 48, HALF2): the command processor's side of the game's library draws (half2.cpp).
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
