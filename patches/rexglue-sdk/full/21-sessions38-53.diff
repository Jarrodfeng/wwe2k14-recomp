+                                         &edram_storage_buffer_descriptor_set_, 0, nullptr);
+  command_processor_.SubmitBarriers(true);
+  for (uint32_t i = 0; i < surface_count; ++i) {
+    const EdramFillSurface& s = surfaces[i];
+    const uint32_t pc[12] = {(s.base_tiles % xenos::kEdramTileCount) * tile_dwords,
+                             s.pitch_tiles * (s.is_64bpp ? 2u : 1u) * tile_dwords,
+                             tile_w,
+                             tile_h,
+                             x0,
+                             y0,
+                             width,
+                             height,
+                             s.src_dword,
+                             s.keep_mask,
+                             xenos::kEdramTileCount * tile_dwords,
+                             (s.depth ? 1u : 0u) | (s.is_64bpp ? 2u : 0u)};
+    command_buffer.CmdVkPushConstants(edram_fill_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pc), pc);
+    command_buffer.CmdVkDispatch((width + 63) / 64, height, 1);
+    ++edram_counters_.fills;  // wwe2k14 patch (Session 46, NATIVE TRUTH M0)
+  }
