+// (Jarrod's b76 log); work through the stretch keeps the clock up. The game decides when and how much.
+void VulkanCommandProcessor::KeepWarmWork() {
+  auto& events = rex::perf::frame_events::Get();
+  uint64_t kb = events.warm_kb.exchange(0, std::memory_order_relaxed);
+  if (!kb || warm_failed_) return;
+  constexpr VkDeviceSize kWarmBufferBytes = VkDeviceSize(32) << 20;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  if (warm_buffer_ == VK_NULL_HANDLE) {
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(vulkan_device, kWarmBufferBytes,
+                                                           VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                                                           ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+                                                           warm_buffer_, warm_buffer_memory_)) {
+      REXGPU_ERROR("[warm] the keep-warm buffer ({} MB) failed: no keep-warm work", kWarmBufferBytes >> 20);
+      warm_failed_ = true;
+      return;
+    }
+    REXGPU_INFO("[warm] keep-warm buffer made ({} MB)", kWarmBufferBytes >> 20);
+  }
+  if (in_render_pass_) EndRenderPass();
+  SubmitBarriers(true);
+  kb = std::min<uint64_t>(kb, uint64_t(1) << 20);  // 1 GB a frame at most
+  const PFN_vkCmdFillBuffer fill = vulkan_device->functions().vkCmdFillBuffer;
+  const VkDeviceSize total = VkDeviceSize(kb) << 10;
+  for (VkDeviceSize done = 0; done < total; done += kWarmBufferBytes) {
+    const ObjmvFillData fd = {fill, warm_buffer_, std::min(kWarmBufferBytes, total - done) & ~VkDeviceSize(3)};
+    deferred_command_buffer_.CmdHostCallback(&ObjmvFill, &fd, sizeof(fd));
+  }
+  events.warm_kb_done.fetch_add(kb, std::memory_order_relaxed);
+}
