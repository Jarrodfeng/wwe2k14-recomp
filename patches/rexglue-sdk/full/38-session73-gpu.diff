+// wwe2k14 patch (Session 73): a fault no handler owns (a real crash) goes on to the handler that was there before this
+// one (the app's crash recorder, else Android's debuggerd, else the default action), by putting it back and returning:
+// the instruction runs again and faults into it. Before, the callback just returned, so the instruction faulted again
+// forever - a crash on Android / Linux became a silent hang at full CPU (Windows chains: EXCEPTION_CONTINUE_SEARCH).
+static void PassOnUnhandledSignal(int signal_number) {
+  const struct sigaction* original = signal_number == SIGSEGV ? &original_sigsegv_handler_
+                                     : signal_number == SIGILL ? &original_sigill_handler_
+#if REX_PLATFORM_MAC
+                                     : signal_number == SIGBUS ? &original_sigbus_handler_
+#endif
+                                                               : nullptr;
+  if (original) {
+    sigaction(signal_number, original, nullptr);
+  } else {
+    signal(signal_number, SIG_DFL);
+  }
+}
