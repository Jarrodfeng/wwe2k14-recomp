+// wwe2k14 patch (Session 58, problem reports): the [s58][gpu] summary line (s58_stats.h).
+static void S58GpuSummary(uint64_t frame, const ui::vulkan::VulkanDevice* device) {
+  const int32_t every = REXCVAR_GET(gpu_session_stats_frames);
+  if (every <= 0) return;
+  static uint64_t last_frame = 0, last_line = 0;
+  static uint64_t last[5] = {};  // stock count / us, native count / us, skipped draws
+  if (frame < last_frame + uint64_t(every)) return;
+  const uint64_t now[5] = {s58::g_stock_pipelines.count.load(), s58::g_stock_pipelines.total_us.load(),
+                           s58::g_native_pipelines.count.load(), s58::g_native_pipelines.total_us.load(),
+                           s58::g_skipped_draws.load()};
+  const bool changed = now[0] != last[0] || now[2] != last[2] || now[4] != last[4];
+  if (!changed && frame < last_line + 3600) {
+    last_frame = frame;
+    return;
+  }
+  std::string vram = "n/a";
+  if (device && device->extensions().ext_EXT_memory_budget) {
+    const ui::vulkan::VulkanInstance::Functions& ifn = device->vulkan_instance()->functions();
+    if (ifn.vkGetPhysicalDeviceMemoryProperties2) {
+      VkPhysicalDeviceMemoryBudgetPropertiesEXT budget = {};
+      budget.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT;
+      VkPhysicalDeviceMemoryProperties2 props = {};
+      props.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2;
+      props.pNext = &budget;
+      ifn.vkGetPhysicalDeviceMemoryProperties2(device->physical_device(), &props);
+      uint64_t used = 0, total = 0;
+      for (uint32_t i = 0; i < props.memoryProperties.memoryHeapCount; ++i) {
+        if (!(props.memoryProperties.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)) continue;
+        used += budget.heapUsage[i], total += budget.heapBudget[i];
+      }
+      vram = fmt::format("{} of {} MB (device-local heaps)", used >> 20, total >> 20);
+    }
+  }
+  auto avg = [](uint64_t us, uint64_t n) { return n ? double(us) / double(n) / 1000.0 : 0.0; };
+  const uint64_t d[5] = {now[0] - last[0], now[1] - last[1], now[2] - last[2], now[3] - last[3], now[4] - last[4]};
+  REXGPU_INFO("[s58][gpu] frames {}-{}: pipelines made {} (avg {:.1f} ms) + native {} (avg {:.1f} ms), slowest so far "
+              "{:.1f} / {:.1f} ms; draws skipped while compiling {} ({} in all); VRAM {}",
+              last_frame, frame, d[0], avg(d[1], d[0]), d[2], avg(d[3], d[2]),
+              double(s58::g_stock_pipelines.max_us.load()) / 1000.0,
+              double(s58::g_native_pipelines.max_us.load()) / 1000.0, d[4], now[4], vram);
+  for (int i = 0; i < 5; ++i) last[i] = now[i];
+  last_frame = frame, last_line = frame;
+}
