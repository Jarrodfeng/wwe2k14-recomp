+namespace {
+struct ObjmvXfbBeginData {
+  PFN_vkCmdBindTransformFeedbackBuffersEXT bind;
+  PFN_vkCmdBeginTransformFeedbackEXT begin;
+  VkBuffer buffer;
+  VkDeviceSize offset, size;
+};
+struct ObjmvXfbEndData {
+  PFN_vkCmdEndTransformFeedbackEXT end;
+};
+void ObjmvXfbBegin(VkCommandBuffer command_buffer, const void* data) {
+  const auto& d = *static_cast<const ObjmvXfbBeginData*>(data);
+  d.bind(command_buffer, 0, 1, &d.buffer, &d.offset, &d.size);
+  d.begin(command_buffer, 0, 0, nullptr, nullptr);
+}
+void ObjmvXfbEnd(VkCommandBuffer command_buffer, const void* data) {
+  static_cast<const ObjmvXfbEndData*>(data)->end(command_buffer, 0, 0, nullptr, nullptr);
+}
+struct ObjmvFillData {
+  PFN_vkCmdFillBuffer fill;
+  VkBuffer buffer;
+  VkDeviceSize size = VK_WHOLE_SIZE;
+};
+void ObjmvFill(VkCommandBuffer command_buffer, const void* data) {
+  const auto& d = *static_cast<const ObjmvFillData*>(data);
+  d.fill(command_buffer, d.buffer, 0, d.size, 0);
+}
