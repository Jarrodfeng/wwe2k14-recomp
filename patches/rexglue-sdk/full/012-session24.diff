+// wwe2k14 patch (Session 24, DLSS): DLSS Super Resolution at the swap.
+static double DlssFactor(int mode) {
+  switch (mode) {
+    case 2: return 1.0 / 0.58;  // balanced
+    case 3: return 1.5;         // quality
+    case 4: return 3.0;         // ultra performance
+    case 5: return 1.0 / 0.77;  // ultra quality
+    default: return 2.0;        // performance
+  }
+}
+
+bool VulkanCommandProcessor::DlssOutputSize(uint32_t width, uint32_t height, uint32_t& out_width,
+                                            uint32_t& out_height) {
+  if (!REXCVAR_GET(gpu_dlss) || dlss_failed_ || !width || !height) return false;
+  const double factor = DlssFactor(std::clamp(REXCVAR_GET(gpu_dlss_mode), 1, 5));
+  out_width = std::min(16384u, uint32_t(std::lround(double(width) * factor)));
+  out_height = std::min(16384u, uint32_t(std::lround(double(height) * factor)));
+  const bool dlss = ui::vulkan::streamline::Active() && ui::vulkan::streamline::DlssAvailable();
+  if (!DlssEnsureComposite() ||
+      !DlaaEnsureImage(dlss_in_, ui::vulkan::VulkanPresenter::kGuestOutputFormat, false, width, height) ||
+      (dlss && !DlaaEnsureImage(dlss_out_, ui::vulkan::VulkanPresenter::kGuestOutputFormat, false, out_width,
+                                out_height))) {
+    REXGPU_ERROR("[dlss] resources for {}x{} -> {}x{} failed: DLSS off", width, height, out_width, out_height);
+    dlss_failed_ = true;
+    return false;
+  }
+  return true;
+}
+
+bool VulkanCommandProcessor::DlssEnsureComposite() {
+  if (dlss_composite_pipeline_ != VK_NULL_HANDLE) return true;
+  if (dlss_failed_) return false;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  dlss_failed_ = true;  // until everything below exists
+  const VkDescriptorSetLayout layouts[6] = {
+      swap_descriptor_set_layout_storage_image_, swap_descriptor_set_layout_combined_image_sampler_,
+      swap_descriptor_set_layout_combined_image_sampler_, swap_descriptor_set_layout_combined_image_sampler_,
+      swap_descriptor_set_layout_combined_image_sampler_, swap_descriptor_set_layout_combined_image_sampler_};
+  VkPushConstantRange push = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 56};
+  VkPipelineLayoutCreateInfo layout_info = {};
+  layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  layout_info.setLayoutCount = 6;
+  layout_info.pSetLayouts = layouts;
+  layout_info.pushConstantRangeCount = 1;
+  layout_info.pPushConstantRanges = &push;
+  if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &dlss_composite_layout_) != VK_SUCCESS) {
+    REXGPU_ERROR("[dlss] composite pipeline layout failed");
+    return false;
+  }
+  const VkPipeline pipeline = ui::vulkan::util::CreateComputePipeline(
+      vulkan_device, dlss_composite_layout_, shaders::dlss_composite_cs, sizeof(shaders::dlss_composite_cs));
+  if (pipeline == VK_NULL_HANDLE) {
+    REXGPU_ERROR("[dlss] composite pipeline failed");
+    return false;
+  }
+  VkDescriptorPoolSize sizes[3] = {{VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 2 * kMaxFramesInFlight},
+                                   {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 5 * kMaxFramesInFlight},
+                                   {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, kMaxFramesInFlight}};
+  VkDescriptorPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+  pool_info.maxSets = 8 * kMaxFramesInFlight;
+  pool_info.poolSizeCount = 3;
+  pool_info.pPoolSizes = sizes;
+  if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &dlss_descriptor_pool_) != VK_SUCCESS) {
+    REXGPU_ERROR("[dlss] descriptor pool failed");
+    dfn.vkDestroyPipeline(device, pipeline, nullptr);
+    return false;
+  }
+  for (uint32_t i = 0; i < kMaxFramesInFlight; ++i) {
+    const VkDescriptorSetLayout set_layouts[8] = {
+        layouts[0], layouts[1], layouts[2], layouts[3], layouts[4], layouts[5],
+        swap_descriptor_set_layout_sampled_image_, swap_descriptor_set_layout_storage_image_};
+    VkDescriptorSet sets[8];
+    VkDescriptorSetAllocateInfo alloc = {};
+    alloc.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+    alloc.descriptorPool = dlss_descriptor_pool_;
+    alloc.descriptorSetCount = 8;
+    alloc.pSetLayouts = set_layouts;
+    if (dfn.vkAllocateDescriptorSets(device, &alloc, sets) != VK_SUCCESS) {
+      REXGPU_ERROR("[dlss] descriptor sets failed");
+      dfn.vkDestroyPipeline(device, pipeline, nullptr);
+      return false;
+    }
+    for (int k = 0; k < 6; ++k) dlss_sets_[i][k] = sets[k];
+    dlss_gamma_sets_[i][0] = sets[6], dlss_gamma_sets_[i][1] = sets[7];
+  }
+  dlss_composite_pipeline_ = pipeline;
+  dlss_failed_ = false;
+  REXGPU_INFO("[dlss] composite pass ready");
+  return true;
+}
+
+// Runs on the submission thread when the deferred command buffer is executed.
+static void DlssEvaluateCallback(VkCommandBuffer command_buffer, const void* data) {
+  static std::atomic<uint32_t> failures_logged{0}, evaluations{0};
+  const auto& frame = *static_cast<const ui::vulkan::streamline::DlaaFrame*>(data);
+  std::string reason;
+  if (!ui::vulkan::streamline::EvaluateDlss(command_buffer, frame, &reason)) {
+    if (failures_logged.fetch_add(1) < 5) REXGPU_WARN("[dlss] DLSS evaluate failed: {}", reason);
+  } else if (evaluations.fetch_add(1) < 3) {
+    REXGPU_INFO("[dlss] DLSS evaluated (mode {}, {}x{} -> {}x{}, frame index {}, jitter {:+.3f} {:+.3f}{})",
+                frame.mode, frame.width, frame.height, frame.out_width, frame.out_height, frame.frame_index,
+                frame.jitter[0], frame.jitter[1], frame.reset ? ", reset" : "");
+  }
+}
+
+void VulkanCommandProcessor::DlssMaybeSnapshot(const Shader& vertex_shader) {
+  if (!REXCVAR_GET(gpu_dlss_hud) || !dlaa_scene_done_ || !dlss_pending_.valid || dlss_pending_.frame != dlaa_frame_ ||
+      dlss_snap_frame_ == dlaa_frame_) {
+    return;
+  }
+  const std::string vs_text = REXCVAR_GET(gpu_dlss_hud_after_vs);
+  if (vs_text != dlss_hud_vs_text_) {
+    dlss_hud_vs_text_ = vs_text;
+    dlss_hud_vs_ = std::strtoull(vs_text.c_str(), nullptr, 16);
+  }
+  if (vertex_shader.ucode_data_hash() != dlss_hud_vs_) return;
+  const RegisterFile& regs = *register_file_;
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto color_info = reg::RB_COLOR_INFO{regs[XE_GPU_REG_RB_COLOR_INFO]};
+  const uint32_t width = dlss_pending_.width, height = dlss_pending_.height;
+  const bool format_ok = color_info.color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+                         color_info.color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA;
+  if (surface_info.msaa_samples != xenos::MsaaSamples::k1X || !format_ok ||
+      !DlaaEnsureImage(dlss_snap_[dlaa_frame_ & 1], VK_FORMAT_R8G8B8A8_UNORM, true, width, height)) {
+    if (dlss_snap_log_left_) {
+      --dlss_snap_log_left_;
+      REXGPU_WARN("[dlss] HUD step: frame {}: surface 0x{:08X} colour 0x{:08X} not a 1x 8_8_8_8 target, or no image",
+                  dlaa_frame_, surface_info.value, color_info.value);
+    }
+    return;
+  }
+  const VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  DlaaImage& snap = dlss_snap_[dlaa_frame_ & 1];
+  PushImageMemoryBarrier(snap.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+                         VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+  const uint32_t pitch_tiles = (uint32_t(surface_info.surface_pitch) + xenos::kEdramTileWidthSamples - 1) /
+                               xenos::kEdramTileWidthSamples;
+  if (!render_target_cache_->DlssSnapshotColor32(color_info.color_base, pitch_tiles, width, height,
+                                                 REXCVAR_GET(gpu_dlss_hud_rb_swap),
+                                                 texture_cache_->dlaa_storage_set_layout(), snap.set)) {
+    if (dlss_snap_log_left_) {
+      --dlss_snap_log_left_;
+      REXGPU_WARN("[dlss] HUD step: frame {}: no EDRAM snapshot (not the fsi render target path?)", dlaa_frame_);
+    }
+    return;
+  }
+  PushImageMemoryBarrier(snap.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  dlss_snap_frame_ = dlaa_frame_;
+  dlss_snap_frames_[dlaa_frame_ & 1] = dlaa_frame_;
+  repeat_prev_.valid = false;  // wwe2k14 patch (Session 23, REPEAT): the render pass has ended
+  if (dlss_snap_log_left_) {
+    --dlss_snap_log_left_;
+    REXGPU_INFO("[dlss] HUD step: frame {}: pre-HUD copy of colour base {} tiles, pitch {} tiles, {}x{}",
+                dlaa_frame_, uint32_t(color_info.color_base), pitch_tiles, width, height);
+  }
+}
+
+bool VulkanCommandProcessor::DlssPrehudGamma(uint32_t width, uint32_t height, uint32_t swap_frame_index) {
+  const uint64_t want = dlss_pending_.frame - uint64_t(std::clamp(REXCVAR_GET(gpu_dlss_hud_delay), 0, 1));
+  const DlaaImage& snap = dlss_snap_[want & 1];
+  if (!dlss_pending_.valid || dlss_snap_frames_[want & 1] != want || snap.width != width || snap.height != height ||
+      !DlaaEnsureImage(dlss_prehud_, ui::vulkan::VulkanPresenter::kGuestOutputFormat, false, width, height)) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  PushImageMemoryBarrier(dlss_prehud_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+                         VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+  VkDescriptorImageInfo infos[2] = {{VK_NULL_HANDLE, snap.view, VK_IMAGE_LAYOUT_GENERAL},
+                                    {VK_NULL_HANDLE, dlss_prehud_.view, VK_IMAGE_LAYOUT_GENERAL}};
+  VkWriteDescriptorSet writes[2] = {};
+  for (int i = 0; i < 2; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = dlss_gamma_sets_[swap_frame_index][i];
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType = i ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    writes[i].pImageInfo = &infos[i];
+  }
+  dfn.vkUpdateDescriptorSets(device, 2, writes, 0, nullptr);
+  // The swap's gamma pipeline, its ramp set and push constants (the same size) are still bound: new source / dest.
+  static_assert(kSwapApplyGammaComputeDescriptorSetDestination == kSwapApplyGammaComputeDescriptorSetSource + 1,
+                "source and destination sets are consecutive");
+  SubmitBarriers(true);
+  deferred_command_buffer_.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                                   swap_apply_gamma_compute_pipeline_layout_,
+                                                   kSwapApplyGammaComputeDescriptorSetSource, 2,
+                                                   dlss_gamma_sets_[swap_frame_index], 0, nullptr);
+  deferred_command_buffer_.CmdVkDispatch((width + 15) / 16, (height + 7) / 8, 1);
+  PushImageMemoryBarrier(dlss_prehud_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  return true;
+}
+
+void VulkanCommandProcessor::DlssRecord(VkImageView guest_output_view, uint32_t width, uint32_t height,
+                                        uint32_t out_width, uint32_t out_height, uint32_t swap_frame_index,
+                                        bool have_prehud) {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  DeferredCommandBuffer& cb = deferred_command_buffer();
+  const VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  const int view = std::clamp(REXCVAR_GET(gpu_dlss_view), 0, 7);
+  const DlssPending& pending = dlss_pending_;
+  // pending.frame + 1: DlaaOnSwap has already counted this swap.
+  const DlaaImage& mv = dlss_mv_[pending.frame & 1];
+  const DlaaImage& dz = dlss_depth_[pending.frame & 1];
+  const bool can_dlss = pending.valid && pending.frame + 1 == dlaa_frame_ && pending.width == width &&
+                        pending.height == height && mv.width == width && dz.width == width &&
+                        dlss_out_.image != VK_NULL_HANDLE && dlss_out_.width == out_width &&
+                        dlss_out_.height == out_height && ui::vulkan::streamline::Active() &&
+                        ui::vulkan::streamline::DlssAvailable();
+  const bool run_dlss = can_dlss && (view == 0 || view == 3);
+  uint32_t mode = view == 2 ? 1u : view >= 4 ? uint32_t(view) : 0u;
+  if (view >= 5 && !(mv.image != VK_NULL_HANDLE && mv.width == width && dz.width == width)) mode = 0;
+  if (view == 7 && dlss_mask_[pending.frame & 1].width != width) mode = 0;
+  if (run_dlss) mode = (view == 0 && have_prehud) ? 3u : 2u;
+  // The gamma pass's output -> compute reads (DLSS, the composite).
+  PushImageMemoryBarrier(dlss_in_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  bool reset = false;
+  if (run_dlss) {
+    // The frame's depth and motion copies (made at the motion pass) are already readable by compute.
+    PushImageMemoryBarrier(dlss_out_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                           VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+    SubmitBarriers(true);
+    ui::vulkan::streamline::DlaaFrame f;
+    f.frame_index = uint32_t(pending.frame);
+    // The HUD step: DLSS without the HUD (view 0); view 3 = DLSS on the final picture, HUD included (review fix).
+    DlaaSetImage(f.color_in, have_prehud && view == 0 ? dlss_prehud_ : dlss_in_);
+    DlaaSetImage(f.depth, dz);
+    DlaaSetImage(f.color_out, dlss_out_);
+    DlaaSetImage(f.motion, mv);
+    const DlaaImage& mk = dlss_mask_[pending.frame & 1];
+    if (REXCVAR_GET(gpu_dlss_bias_mask) && objmv_latched_ && mk.image != VK_NULL_HANDLE && mk.width == width &&
+        mk.height == height) {
+      DlaaSetImage(f.bias, mk);
+      f.has_bias = true;
+    }
+    const double angle = DlaaFillFrame(f, width, height, pending.rep, pending.view_now, pending.fov_degrees,
+                                       pending.near_z, pending.far_z, pending.jitter);
+    f.mode = std::clamp(REXCVAR_GET(gpu_dlss_mode), 1, 5);
+    f.preset = REXCVAR_GET(gpu_dlss_preset);
+    f.out_width = out_width, f.out_height = out_height;
+    reset = pending.reset || angle > REXCVAR_GET(gpu_dlaa_reset_degrees) ||
+            dlss_last_eval_frame_ + 1 != pending.frame;
+    f.reset = reset;
+    cb.CmdHostCallback(&DlssEvaluateCallback, &f, sizeof(f));
+    current_external_compute_pipeline_ = VK_NULL_HANDLE;  // Streamline bound its own compute state
+    dlss_last_eval_frame_ = pending.frame;
+    PushImageMemoryBarrier(dlss_out_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+                           VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+    ++dlss_frames_;
+  }
+  // The composite: descriptors for this frame slot.
+  const VkImageView dlss_view = dlss_out_.view != VK_NULL_HANDLE ? dlss_out_.view : dlss_in_.view;
+  const VkImageView prehud_view = have_prehud ? dlss_prehud_.view : dlss_in_.view;
+  const bool have_debug_inputs = mv.image != VK_NULL_HANDLE && dz.image != VK_NULL_HANDLE;
+  // Session 24 rung 2a: the manual bias (DLSS ignores its bias-current-colour hint: runs 1684 / 1691 identical).
+  const DlaaImage& mask = dlss_mask_[pending.frame & 1];
+  const bool mask_ok = objmv_latched_ && mask.image != VK_NULL_HANDLE && mask.width == width && mask.height == height;
+  const float bias = (mode == 2 || mode == 3) && mask_ok && REXCVAR_GET(gpu_dlss_bias_mask)
+                         ? float(REXCVAR_GET(gpu_dlss_bias_strength))
+                         : 0.0f;
+  VkDescriptorImageInfo infos[6] = {
+      {VK_NULL_HANDLE, guest_output_view, VK_IMAGE_LAYOUT_GENERAL},
+      {swap_sampler_linear_clamp_, dlss_view, VK_IMAGE_LAYOUT_GENERAL},
+      {swap_sampler_linear_clamp_, dlss_in_.view, VK_IMAGE_LAYOUT_GENERAL},
+      {swap_sampler_linear_clamp_, prehud_view, VK_IMAGE_LAYOUT_GENERAL},
+      {swap_sampler_linear_clamp_, have_debug_inputs ? mv.view : dlss_in_.view, VK_IMAGE_LAYOUT_GENERAL},
+      {swap_sampler_linear_clamp_,
+       (view == 7 || bias > 0.0f) && mask_ok ? mask.view
+       : have_debug_inputs                    ? dz.view
+                                              : dlss_in_.view,
+       VK_IMAGE_LAYOUT_GENERAL}};
+  VkWriteDescriptorSet writes[6] = {};
+  for (int i = 0; i < 6; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = dlss_sets_[swap_frame_index][i];
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType = i ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    writes[i].pImageInfo = &infos[i];
+  }
+  dfn.vkUpdateDescriptorSets(device, 6, writes, 0, nullptr);
+  struct {
+    uint32_t out_size[2];
+    uint32_t low_size[2];
+    float low_scale[2];
+    float pre_scale[2];
+    uint32_t mode;
+    float hud_gain;
+    float bias;
+    float pad;
+    float motion_bias[2];
+  } pc = {{out_width, out_height}, {width, height}, {1.0f, 1.0f}, {1.0f, 1.0f}, mode,
+          mode == 5 ? float(std::max(1, REXCVAR_GET(gpu_dlaa_debug_scale))) : 1.0f, bias, 0.0f, {0.0f, 0.0f}};
+  static_assert(sizeof(pc) == 56, "push constants");
+  // Session 24: the fast-motion blend (gpu_dlss_motion_bias = "FROM,TO" render pixels per frame; empty = off).
+  if ((mode == 2 || mode == 3) && have_debug_inputs) {
+    float from = 0.0f, to = 0.0f;
+    const std::string mb = REXCVAR_GET(gpu_dlss_motion_bias);
+    if (std::sscanf(mb.c_str(), "%f,%f", &from, &to) == 2 && to > from) {
+      pc.motion_bias[0] = from, pc.motion_bias[1] = to;
+    }
+  }
+  SubmitBarriers(true);
+  BindExternalComputePipeline(dlss_composite_pipeline_);
+  cb.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, dlss_composite_layout_, 0, 6,
+                             dlss_sets_[swap_frame_index], 0, nullptr);
+  cb.CmdVkPushConstants(dlss_composite_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pc), &pc);
+  cb.CmdVkDispatch((out_width + 7) / 8, (out_height + 7) / 8, 1);
+  if (dlss_log_left_ || (run_dlss && dlss_frames_ % 600 == 0)) {
+    if (dlss_log_left_) --dlss_log_left_;
+    REXGPU_INFO("[dlss] swap: {}x{} -> {}x{}, view {} -> composite mode {}{}{}{}; DLSS frames {} (pending {} frame "
+                "{} {}x{})", width, height, out_width, out_height, view, mode, run_dlss ? ", DLSS" : "",
+                have_prehud ? ", pre-HUD" : "",
+                reset ? " (reset)" : "", dlss_frames_, pending.valid ? "yes" : "no", pending.frame, pending.width,
+                pending.height);
+  }
+}
