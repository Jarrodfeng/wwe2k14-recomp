+uint32_t VulkanCommandProcessor::DlssLodBiasQuarters() const {
+  if (!REXCVAR_GET(gpu_dlss) || dlaa_scene_done_) return 0;
+  const double bias = REXCVAR_GET(gpu_dlss_lod_bias);
+  return uint32_t(std::clamp(int(std::lround(-bias * 4.0)), 0, 15));
+}
