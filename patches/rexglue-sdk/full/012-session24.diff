diff --git a/src/graphics/shaders/dlss_composite.cs.glsl b/src/graphics/shaders/dlss_composite.cs.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..05214598fca108324a0d5fc2764e75347b931688
--- /dev/null
+++ b/src/graphics/shaders/dlss_composite.cs.glsl
@@ -0,0 +1,111 @@
+// wwe2k14 patch (Session 24, DLSS): the last pass of a DLSS frame at the swap. Writes the presenter's guest output
+// image (output size) from:
+//   set 0: the guest output image (storage, A2B10G10R10);
+//   set 1: DLSS's output (output size);
+//   set 2: the frame's final picture after the swap's gamma ramp (render size: what DLSS would otherwise get);
+//   set 3: the frame's picture before the HUD, after the same gamma ramp (render size; = set 2 without a HUD image).
+// Modes:
+//   0: plain bilinear upscale of the final picture (the comparison "without DLSS", and frames DLSS can't take);
+//   1: Catmull-Rom (bicubic) upscale of the final picture;
+//   2: DLSS's output as is;
+//   (2 and 3 with bias > 0: inside the character mask in set 5, blended toward the current frame's Catmull-Rom
+//    upscale: the manual "bias current colour", Session 24 rung 2a)
+//   3: DLSS's output + the HUD: the difference between the final picture and the pre-HUD picture, both upscaled with
+//      Catmull-Rom (0 where there is no HUD, so the scene is pure DLSS; the HUD never goes through DLSS's history);
+//   4: debug: the HUD difference as grey (black = no HUD) over a dimmed bilinear picture;
+//   5: debug: the motion vectors DLSS gets (render pixels; 0.5 grey = still, red / green = x / y, hud_gain px =
+//      full colour);
+//   6: debug: the depth DLSS gets (the reversed hardware depth: white = near);
+//   7: debug: the character mask (set 5 holds it then) in red over the dimmed picture.
+//
+// Generated header: glslangValidator -V --target-env vulkan1.0 -S comp (glslang from the SDK's submodule, built out
+// of tree: out\glslang-build), see vulkan_spirv/dlss_composite_cs.h.
+
+#version 460
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(set = 0, binding = 0, rgb10_a2) uniform writeonly image2D out_image;
+layout(set = 1, binding = 0) uniform sampler2D dlss_image;
+layout(set = 2, binding = 0) uniform sampler2D final_image;
+layout(set = 3, binding = 0) uniform sampler2D prehud_image;
+layout(set = 4, binding = 0) uniform sampler2D motion_image;  // render size, RG16F (debug views)
+layout(set = 5, binding = 0) uniform sampler2D depth_image;   // render size, R32F (debug views)
+
+layout(push_constant) uniform Constants {
+  uvec2 out_size;   // output pixels
+  uvec2 low_size;   // render pixels (the final / pre-HUD images; may be smaller than their allocation)
+  vec2 low_scale;   // low_size / the final image's allocated size (UV scale)
+  vec2 pre_scale;   // low_size / the pre-HUD image's allocated size (UV scale)
+  uint mode;
+  float hud_gain;   // multiplies the HUD difference (1 = as drawn)
+  float bias;       // modes 2 / 3 (Session 24 rung 2a): blend toward this frame's own upscale by mask x bias
+  float pad;
+  vec2 motion_bias; // modes 2 / 3: also blend where |motion| (render px) goes from .x to .y (0, 0 = off)
+} c;
+
+// Catmull-Rom from 16 texel fetches; uv in render pixels (texel centres at +0.5).
+vec3 Cubic(sampler2D s, vec2 p, uvec2 size) {
+  vec2 t = p - 0.5;
+  vec2 f = fract(t);
+  ivec2 b = ivec2(floor(t)) - 1;
+  vec2 f2 = f * f, f3 = f2 * f;
+  vec2 w0 = -0.5 * f3 + f2 - 0.5 * f;
+  vec2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
+  vec2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
+  vec2 w3 = 0.5 * f3 - 0.5 * f2;
+  vec2 w[4] = vec2[4](w0, w1, w2, w3);
+  ivec2 hi = ivec2(size) - 1;
+  vec3 sum = vec3(0.0);
+  for (int j = 0; j < 4; ++j) {
+    for (int i = 0; i < 4; ++i) {
+      ivec2 q = clamp(b + ivec2(i, j), ivec2(0), hi);
+      sum += texelFetch(s, q, 0).rgb * (w[i].x * w[j].y);
+    }
+  }
+  return sum;
+}
+
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  if (any(greaterThanEqual(p, c.out_size))) return;
+  vec2 uv = (vec2(p) + 0.5) / vec2(c.out_size);  // 0..1 over the output
+  vec2 lp = uv * vec2(c.low_size);              // render pixels
+  vec3 rgb;
+  if (c.mode == 0u) {
+    rgb = texture(final_image, uv * c.low_scale).rgb;
+  } else if (c.mode == 1u) {
+    rgb = Cubic(final_image, lp, c.low_size);
+  } else if (c.mode == 2u || c.mode == 3u) {
+    // DLSS's output; with bias (set 5 holds the character mask then), its history is traded for this frame's
+    // own upscale on the characters (no smearing, less smoothing).
+    rgb = texelFetch(dlss_image, ivec2(p), 0).rgb;
+    float m = c.bias > 0.0 ? clamp(texture(depth_image, uv).r * c.bias, 0.0, 1.0) : 0.0;
+    if (c.motion_bias.y > 0.0) {
+      // Fast-moving pixels (the game's own motion blur is in DLSS's input there): this frame's upscale.
+      m = max(m, smoothstep(c.motion_bias.x, c.motion_bias.y, length(texture(motion_image, uv).rg)));
+    }
+    {
+      if (m > 0.0) {
+        vec3 cur = c.mode == 3u ? Cubic(prehud_image, lp, c.low_size) : Cubic(final_image, lp, c.low_size);
+        rgb = mix(rgb, cur, m);
+      }
+    }
+    if (c.mode == 3u) {
+      rgb += (Cubic(final_image, lp, c.low_size) - Cubic(prehud_image, lp, c.low_size)) * c.hud_gain;
+    }
+  } else if (c.mode == 5u) {
+    vec2 mv = texelFetch(motion_image, ivec2(lp), 0).rg;
+    rgb = vec3(clamp(0.5 + mv / (2.0 * c.hud_gain), 0.0, 1.0), 0.5);  // hud_gain = pixels for full colour
+  } else if (c.mode == 7u) {
+    float m = texelFetch(depth_image, ivec2(lp), 0).r;
+    rgb = texture(final_image, uv * c.low_scale).rgb * 0.5 + vec3(0.5 * m, 0.0, 0.0);
+  } else if (c.mode == 6u) {
+    float dev = texelFetch(depth_image, ivec2(lp), 0).r;
+    rgb = vec3(1.0 - clamp(-log2(max(dev, 1e-7)) / 16.0, 0.0, 1.0));
+  } else {
+    vec3 hud = abs(texture(final_image, uv * c.low_scale).rgb - texture(prehud_image, uv * c.pre_scale).rgb);
+    rgb = texture(final_image, uv * c.low_scale).rgb * 0.25 + vec3(min(1.0, 4.0 * max(hud.r, max(hud.g, hud.b))));
+  }
+  imageStore(out_image, ivec2(p), vec4(clamp(rgb, 0.0, 1.0), 1.0));
+}
diff --git a/src/graphics/shaders/dlss_edram_snapshot.cs.glsl b/src/graphics/shaders/dlss_edram_snapshot.cs.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..9808bc6432fa7ca4e178e4beb72c81c1d89d9047
--- /dev/null
+++ b/src/graphics/shaders/dlss_edram_snapshot.cs.glsl
@@ -0,0 +1,41 @@
+// wwe2k14 patch (Session 24, DLSS): a copy of a 32bpp single-sample colour surface straight from the EDRAM buffer
+// (render_target_path_vulkan=fsi: the EDRAM buffer is the render target). Used right after the post chain's last
+// full-screen pass, before the HUD draws: the frame's picture without the HUD, for DLSS.
+//
+// The address of host pixel (x, y) of the surface, in dwords (spirv_translator_rb.cpp FSI_LoadEdramOffsets, colour,
+// 32bpp, 1 sample): tiles of tile_w x tile_h pixels (80 x 16 samples x the resolution scale), row-major at the
+// surface's pitch in tiles; inside a tile row-major; + the surface base, wrapped at the EDRAM size.
+//   set 0: the EDRAM buffer (storage buffer);
+//   set 1: the output, R32_UINT storage view (the dword as stored: k_8_8_8_8 = R | G << 8 | B << 16 | A << 24).
+//
+// Generated header: glslangValidator -V --target-env vulkan1.0 -S comp (glslang from the SDK's submodule, built out
+// of tree: out\glslang-build), see vulkan_spirv/dlss_edram_snapshot_cs.h.
+
+#version 460
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer EdramBuffer { uint edram[]; };
+layout(set = 1, binding = 0, r32ui) uniform writeonly uimage2D dest_image;
+
+layout(push_constant) uniform Constants {
+  uint base_dwords;        // surface base (tiles) x tile size (dwords)
+  uint pitch_tile_dwords;  // the surface pitch in tiles x tile size (one row of tiles)
+  uint tile_w;             // 80 x resolution scale x
+  uint tile_h;             // 16 x resolution scale y
+  uint width;              // host pixels to copy
+  uint height;
+  uint wrap_dwords;        // 2048 tiles x tile size
+  uint flags;              // bit 0: swap the red and blue bytes
+} c;
+
+void main() {
+  uvec2 p = gl_GlobalInvocationID.xy;
+  if (p.x >= c.width || p.y >= c.height) return;
+  uint tile_x = p.x / c.tile_w, tile_y = p.y / c.tile_h;
+  uint offset = tile_y * c.pitch_tile_dwords + tile_x * (c.tile_w * c.tile_h) + (p.y % c.tile_h) * c.tile_w +
+                p.x % c.tile_w;
+  uint v = edram[(c.base_dwords + offset) % c.wrap_dwords];
+  if ((c.flags & 1u) != 0u) v = (v & 0xFF00FF00u) | ((v >> 16) & 0xFFu) | ((v & 0xFFu) << 16);
+  imageStore(dest_image, ivec2(p), uvec4(v, 0u, 0u, 0u));
+}
diff --git a/src/graphics/shaders/dlss_objmv.cs.glsl b/src/graphics/shaders/dlss_objmv.cs.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..26b457b6a54413043794d1f1345fac4627c35f46
--- /dev/null
+++ b/src/graphics/shaders/dlss_objmv.cs.glsl
@@ -0,0 +1,90 @@
+// wwe2k14 patch (Session 24, OBJMV): motion vectors for the characters (wrestlers, referee), for DLSS / DLAA.
+//
+// The character draws' vertex shaders run with their gl_Position captured by transform feedback (one vec4 per
+// vertex of every triangle, in primitive order), this frame's draw into `cur`, the same draw of last frame (matched by
+// shader and order) into `prev`. One workgroup of 64 threads per triangle rasterizes it over the scene's pixels (the
+// threads share the bounding box's pixels: big close-up triangles stay fast; no graphics pipeline:
+// nothing of the emulated render state is touched): where the triangle covers a pixel's (unjittered) sample and its
+// view depth there matches the scene depth (the visible surface), the pixel's motion becomes the screen-space move of
+// that surface point from last frame (perspective-correct, the camera included) and the mask gets 1.
+//   set 0: this frame's captured positions (storage buffer, vec4 per vertex);
+//   set 1: last frame's (same layout);
+//   set 2: the scene depth DLSS gets (R32_UINT view: the float bits of the reversed hardware depth, 1 = near);
+//   set 3: the motion image (RG16F, host pixels, current -> previous, as the camera pass writes it);
+//   set 4: the character mask (R8: 1 where a character surface was found).
+//
+// Generated header: glslangValidator -V --target-env vulkan1.0 -S comp (glslang from the SDK's submodule, built out
+// of tree: out\glslang-build), see vulkan_spirv/dlss_objmv_cs.h.
+
+#version 460
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer CurPositions { vec4 cur[]; };
+layout(set = 1, binding = 0, std430) readonly buffer PrevPositions { vec4 prev[]; };
+layout(set = 2, binding = 0, r32ui) uniform readonly uimage2D depth_image;
+layout(set = 3, binding = 0, rg16f) uniform writeonly image2D motion_image;
+layout(set = 4, binding = 0, r8) uniform writeonly image2D mask_image;
+
+layout(push_constant) uniform Constants {
+  vec4 viewport;    // the draw's host viewport without the jitter: x, y, width, height (host pixels)
+  vec2 jitter;      // this frame's jitter (host pixels)
+  vec2 near_far;    // the camera's near / far (for the scene depth -> view z)
+  uint cur_first;   // the draw's first vertex in cur[]
+  uint prev_first;  // and in prev[]
+  uint triangles;
+  uint size;        // render width | height << 16
+  float tolerance;  // accepted |view z - scene z| / scene z
+  uint flags;       // bit 0: write motion, bit 1: write the mask
+  uint max_pixels;  // triangles with a larger pixel bounding box are skipped
+  uint groups_x;    // workgroups per dispatch row (triangle = row * groups_x + column)
+} c;
+
+float Edge(vec2 a, vec2 b, vec2 p) { return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x); }
+
+vec2 ToScreen(vec4 clip) { return c.viewport.xy + (clip.xy / clip.w * 0.5 + 0.5) * c.viewport.zw; }
+
+void main() {
+  uint t = gl_WorkGroupID.y * c.groups_x + gl_WorkGroupID.x;
+  if (t >= c.triangles) return;
+  uint ci = c.cur_first + 3u * t, pi = c.prev_first + 3u * t;
+  vec4 a = cur[ci], b = cur[ci + 1u], d = cur[ci + 2u];
+  vec4 pa = prev[pi], pb = prev[pi + 1u], pd = prev[pi + 2u];
+  // Near-plane crossings: skip (the camera pass keeps those pixels).
+  if (a.w <= 1e-3 || b.w <= 1e-3 || d.w <= 1e-3) return;
+  vec2 sa = ToScreen(a), sb = ToScreen(b), sd = ToScreen(d);
+  float area = Edge(sa, sb, sd);
+  if (abs(area) < 1e-8) return;
+  uvec2 size = uvec2(c.size & 0xFFFFu, c.size >> 16);
+  // Pixel p samples the unjittered position p + 0.5 - jitter.
+  vec2 lo = min(sa, min(sb, sd)) - 0.5 + c.jitter, hi = max(sa, max(sb, sd)) - 0.5 + c.jitter;
+  ivec2 p0 = max(ivec2(ceil(lo)), ivec2(0));
+  ivec2 p1 = min(ivec2(floor(hi)), ivec2(size) - 1);
+  if (p1.x < p0.x || p1.y < p0.y) return;
+  if (uint(p1.x - p0.x + 1) * uint(p1.y - p0.y + 1) > c.max_pixels) return;
+  float n = c.near_far.x, f = c.near_far.y;
+  uint bw = uint(p1.x - p0.x + 1), area_px = bw * uint(p1.y - p0.y + 1);
+  for (uint i = gl_LocalInvocationIndex; i < area_px; i += 64u) {
+    {
+      int x = p0.x + int(i % bw), y = p0.y + int(i / bw);
+      vec2 u = vec2(x, y) + 0.5 - c.jitter;
+      float w0 = Edge(sb, sd, u) / area, w1 = Edge(sd, sa, u) / area;
+      float w2 = 1.0 - w0 - w1;
+      if (w0 < -1e-5 || w1 < -1e-5 || w2 < -1e-5) continue;
+      // Perspective-correct weights; the surface's view depth is the interpolated clip w.
+      vec3 pw = vec3(w0 / a.w, w1 / b.w, w2 / d.w);
+      float inv_w = pw.x + pw.y + pw.z;
+      float z = 1.0 / inv_w;
+      pw *= z;
+      // The scene's visible surface here (the same decode as the camera pass).
+      float dev = uintBitsToFloat(imageLoad(depth_image, ivec2(x, y)).r);
+      float dd = clamp(1.0 - dev, 0.0, 1.0);
+      float z_scene = n * f / (f - dd * (f - n));
+      if (abs(z - z_scene) > c.tolerance * z_scene) continue;
+      vec4 pp = pw.x * pa + pw.y * pb + pw.z * pd;
+      if (pp.w <= 1e-3) continue;
+      if ((c.flags & 1u) != 0u) imageStore(motion_image, ivec2(x, y), vec4(ToScreen(pp) - u, 0.0, 0.0));
+      if ((c.flags & 2u) != 0u) imageStore(mask_image, ivec2(x, y), vec4(1.0));
+    }
+  }
+}
