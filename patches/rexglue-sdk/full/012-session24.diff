+bool VulkanCommandProcessor::ObjmvEnsureBuffers() {
+  if (objmv_buffers_[0] != VK_NULL_HANDLE && objmv_buffers_[1] != VK_NULL_HANDLE) return true;
+  if (objmv_failed_) return false;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  for (int i = 0; i < 2; ++i) {
+    VkBufferCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    info.size = VkDeviceSize(kObjmvMaxVertices) * 16;
+    info.usage = VK_BUFFER_USAGE_TRANSFORM_FEEDBACK_BUFFER_BIT_EXT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                 VK_BUFFER_USAGE_TRANSFER_DST_BIT;  // the per-frame clear (review fix)
+    info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(vulkan_device, info.size, info.usage,
+                                                           ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+                                                           objmv_buffers_[i], objmv_buffer_memory_[i])) {
+      REXGPU_ERROR("[objmv] transform feedback buffers ({} MB) failed: object motion off",
+                   info.size >> 20);
+      objmv_failed_ = true;
+      return false;
+    }
+  }
+  return true;
+}
+
+// IssueDraw, right before the host draw: begin the capture of a character draw (false: not captured).
+bool VulkanCommandProcessor::ObjmvBeginCapture(const Shader& vertex_shader,
+                                               const PrimitiveProcessor::ProcessingResult& primitive) {
+  // Room for every triangle the draw can produce (a strip with primitive restart produces fewer: the rest of its
+  // range stays zero from the frame's clear, w = 0, and the rasterizer skips it).
+  uint32_t vertices = 0;
+  const uint32_t n = primitive.host_draw_vertex_count;
+  if (primitive.host_primitive_type == xenos::PrimitiveType::kTriangleList) {
+    vertices = n - n % 3;
+  } else if (primitive.host_primitive_type == xenos::PrimitiveType::kTriangleStrip && n >= 3) {
+    vertices = (n - 2) * 3;
+  }
+  const uint32_t k = uint32_t(dlaa_frame_ & 1);
+  if (objmv_frames_[k] != dlaa_frame_) {  // the frame's first character draw
+    objmv_frames_[k] = dlaa_frame_;
+    objmv_draws_[k].clear();
+    objmv_cursor_ = 0;
+  }
+  // The buffers are made (and cleared) by the motion pass, outside a render pass.
+  if (!vertices || objmv_cursor_ + vertices > kObjmvMaxVertices || objmv_buffers_[0] == VK_NULL_HANDLE ||
+      objmv_buffers_[1] == VK_NULL_HANDLE) {
+    ++objmv_skipped_;
+    return false;
+  }
+  uint32_t ordinal = 0;
+  for (const ObjmvDraw& d : objmv_draws_[k]) ordinal += d.vs_hash == vertex_shader.ucode_data_hash();
+  ObjmvDraw draw;
+  draw.vs_hash = vertex_shader.ucode_data_hash();
+  draw.ordinal = ordinal;
+  draw.first = objmv_cursor_;
+  draw.vertices = vertices;
+  std::memcpy(draw.viewport, objmv_viewport_, sizeof(draw.viewport));
+  objmv_draws_[k].push_back(draw);
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  ObjmvXfbBeginData begin = {dfn.vkCmdBindTransformFeedbackBuffersEXT, dfn.vkCmdBeginTransformFeedbackEXT,
+                             objmv_buffers_[k], VkDeviceSize(objmv_cursor_) * 16, VkDeviceSize(vertices) * 16};
+  deferred_command_buffer_.CmdHostCallback(&ObjmvXfbBegin, &begin, sizeof(begin));
+  objmv_cursor_ += vertices;
+  objmv_used_[k] = std::max(objmv_used_[k], objmv_cursor_);
+  ++objmv_captured_;
+  return true;
+}
+
+void VulkanCommandProcessor::ObjmvEndCapture() {
+  ObjmvXfbEndData end = {GetVulkanDevice()->functions().vkCmdEndTransformFeedbackEXT};
+  deferred_command_buffer_.CmdHostCallback(&ObjmvXfbEnd, &end, sizeof(end));
+  repeat_prev_.valid = false;  // wwe2k14 patch (Session 23, REPEAT): no fast-path repeat of a captured draw
+}
+
+// The motion pass, after the camera vectors: the characters' own motion into the motion image + the mask.
+void VulkanCommandProcessor::ObjmvPass(uint32_t width, uint32_t height, const float jitter[2], float near_z,
+                                       float far_z) {
+  const uint32_t k = uint32_t(dlaa_frame_ & 1);
+  const bool have_cur = objmv_frames_[k] == dlaa_frame_ && !objmv_draws_[k].empty();
+  const bool have_prev = dlaa_frame_ > 0 && objmv_frames_[k ^ 1] == dlaa_frame_ - 1;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  DeferredCommandBuffer& cb = deferred_command_buffer();
+  const VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  if (!DlaaEnsureImage(objmv_mask_, VK_FORMAT_R8_UNORM, false, width, height)) return;
+  if (objmv_buffers_[0] == VK_NULL_HANDLE || objmv_buffers_[1] == VK_NULL_HANDLE) {
+    if (!ObjmvEnsureBuffers()) return;
+    // Both start zeroed (w = 0: nothing rasterized from slots a draw left unwritten); the first captures come next
+    // frame.
+    SubmitBarriers(true);
+    for (VkBuffer b : objmv_buffers_) {
+      const ObjmvFillData fd = {dfn.vkCmdFillBuffer, b};
+      cb.CmdHostCallback(&ObjmvFill, &fd, sizeof(fd));
+      PushBufferMemoryBarrier(b, 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                              VK_PIPELINE_STAGE_TRANSFORM_FEEDBACK_BIT_EXT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                              VK_ACCESS_TRANSFER_WRITE_BIT,
+                              VK_ACCESS_TRANSFORM_FEEDBACK_WRITE_BIT_EXT | VK_ACCESS_SHADER_READ_BIT);
+    }
+  }
+  if (objmv_mask_set_ == VK_NULL_HANDLE || objmv_mask_set_view_ != objmv_mask_.view) {
+    objmv_mask_set_ = texture_cache_->DlaaStorageSetForView(objmv_mask_.view);
+    objmv_mask_set_view_ = objmv_mask_.view;
+  }
+  // The mask starts empty every frame.
+  PushImageMemoryBarrier(objmv_mask_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT,
+                         VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+  const VkClearColorValue zero = {};
+  cb.CmdVkClearColorImage(objmv_mask_.image, VK_IMAGE_LAYOUT_GENERAL, &zero, 1, &range);
+  PushImageMemoryBarrier(objmv_mask_.image, range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                         VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  uint32_t matched = 0, dispatched_triangles = 0;
+  if (have_cur) {
+    // This frame's captures (transform feedback writes) -> compute reads, here or as next frame's previous
+    // (review fix: also when nothing matches this frame).
+    PushBufferMemoryBarrier(objmv_buffers_[k], 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFORM_FEEDBACK_BIT_EXT,
+                            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFORM_FEEDBACK_WRITE_BIT_EXT,
+                            VK_ACCESS_SHADER_READ_BIT);
+  }
+  if (have_cur && have_prev && objmv_mask_set_ != VK_NULL_HANDLE && dlaa_depthf_.set != VK_NULL_HANDLE) {
+    if (objmv_pipeline_ == VK_NULL_HANDLE && !objmv_failed_) {
+      const VkDescriptorSetLayout buffer_layout =
+          GetSingleTransientDescriptorLayout(SingleTransientDescriptorLayout::kStorageBufferCompute);
+      const VkDescriptorSetLayout image_layout = texture_cache_->dlaa_storage_set_layout();
+      const VkDescriptorSetLayout layouts[5] = {buffer_layout, buffer_layout, image_layout, image_layout,
+                                                image_layout};
+      VkPushConstantRange push = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 64};
+      VkPipelineLayoutCreateInfo info = {};
+      info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+      info.setLayoutCount = 5;
+      info.pSetLayouts = layouts;
+      info.pushConstantRangeCount = 1;
+      info.pPushConstantRanges = &push;
+      if (dfn.vkCreatePipelineLayout(device, &info, nullptr, &objmv_layout_) != VK_SUCCESS ||
+          (objmv_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+               vulkan_device, objmv_layout_, shaders::dlss_objmv_cs, sizeof(shaders::dlss_objmv_cs))) ==
+              VK_NULL_HANDLE) {
+        REXGPU_ERROR("[objmv] rasterizer pipeline failed: object motion off");
+        objmv_failed_ = true;
+      }
+    }
+    if (objmv_pipeline_ != VK_NULL_HANDLE) {
+      // The camera pass wrote every motion pixel; the characters' overwrite theirs.
+      PushImageMemoryBarrier(dlaa_motion_image_, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+                             VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+      VkDescriptorSet buffer_sets[2];
+      for (int i = 0; i < 2; ++i) {
+        buffer_sets[i] = AllocateSingleTransientDescriptor(SingleTransientDescriptorLayout::kStorageBufferCompute);
+        if (buffer_sets[i] == VK_NULL_HANDLE) return;
+        VkDescriptorBufferInfo bi = {objmv_buffers_[i ? (k ^ 1) : k], 0, VK_WHOLE_SIZE};
+        VkWriteDescriptorSet w = {};
+        w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        w.dstSet = buffer_sets[i];
+        w.descriptorCount = 1;
+        w.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        w.pBufferInfo = &bi;
+        dfn.vkUpdateDescriptorSets(device, 1, &w, 0, nullptr);
+      }
+      SubmitBarriers(true);
+      BindExternalComputePipeline(objmv_pipeline_);
+      const VkDescriptorSet sets[5] = {buffer_sets[0], buffer_sets[1], dlaa_depthf_.set, dlaa_motion_set_,
+                                       objmv_mask_set_};
+      cb.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, objmv_layout_, 0, 5, sets, 0, nullptr);
+      const uint32_t flags = (REXCVAR_GET(gpu_dlss_objmv_vectors) ? 1u : 0u) | 2u;
+      for (const ObjmvDraw& d : objmv_draws_[k]) {
+        const ObjmvDraw* p = nullptr;
+        for (const ObjmvDraw& q : objmv_draws_[k ^ 1]) {
+          if (q.vs_hash == d.vs_hash && q.ordinal == d.ordinal && q.vertices == d.vertices) {
+            p = &q;
+            break;
+          }
+        }
+        if (!p) continue;
+        struct {
+          float viewport[4];
+          float jitter[2];
+          float near_far[2];
+          uint32_t cur_first, prev_first, triangles, size;
+          float tolerance;
+          uint32_t flags, max_pixels, groups_x;
+        } pc;
+        static_assert(sizeof(pc) == 64, "push constants");
+        std::memcpy(pc.viewport, d.viewport, sizeof(pc.viewport));
+        pc.jitter[0] = jitter[0], pc.jitter[1] = jitter[1];
+        pc.near_far[0] = near_z, pc.near_far[1] = far_z;
+        pc.cur_first = d.first, pc.prev_first = p->first, pc.triangles = d.vertices / 3;
+        pc.size = width | (height << 16);
+        pc.tolerance = float(REXCVAR_GET(gpu_dlss_objmv_tolerance));
+        pc.flags = flags;
+        pc.max_pixels = uint32_t(std::max(1, REXCVAR_GET(gpu_dlss_objmv_max_pixels)));
+        // One workgroup per triangle (rows of at most 65535).
+        pc.groups_x = std::min(pc.triangles, 65535u);
+        cb.CmdVkPushConstants(objmv_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pc), &pc);
+        if (pc.triangles) cb.CmdVkDispatch(pc.groups_x, (pc.triangles + pc.groups_x - 1) / pc.groups_x, 1);
+        ++matched;
+        dispatched_triangles += pc.triangles;
+      }
+    }
+  }
+  // Last frame's buffer (read above) is the next frame's capture buffer: cleared to zero first.
+  PushBufferMemoryBarrier(objmv_buffers_[k ^ 1], 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+  SubmitBarriers(true);
+  // Only the range last written (the rest is still zero).
+  if (objmv_used_[k ^ 1]) {
+    const ObjmvFillData fill_next = {dfn.vkCmdFillBuffer, objmv_buffers_[k ^ 1],
+                                     VkDeviceSize(objmv_used_[k ^ 1]) * 16};
+    cb.CmdHostCallback(&ObjmvFill, &fill_next, sizeof(fill_next));
+    objmv_used_[k ^ 1] = 0;
+  }
+  PushBufferMemoryBarrier(objmv_buffers_[k ^ 1], 0, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_TRANSFORM_FEEDBACK_BIT_EXT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_TRANSFORM_FEEDBACK_WRITE_BIT_EXT);
+  // The mask -> its readers (the SR copy / DLSS / the composite's debug view).
+  PushImageMemoryBarrier(objmv_mask_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  ++objmv_passes_;
+  if (objmv_log_left_ || objmv_passes_ % 600 == 0) {
+    if (objmv_log_left_) --objmv_log_left_;
+    REXGPU_INFO("[objmv] frame {}: {} character draw(s) captured ({} vertices), {} matched last frame's, {} "
+                "triangles rasterized; totals: captured {}, not captured {}", dlaa_frame_,
+                have_cur ? objmv_draws_[k].size() : 0, objmv_cursor_, matched, dispatched_triangles,
+                objmv_captured_, objmv_skipped_);
+  }
+}
