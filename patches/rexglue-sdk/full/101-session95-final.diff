+      SlotOwnWords(s, live.own);
+      live.fetch = s.fetch;
+      why = DrawSlotCompare(slot, live);
+    }
+  }
+  if (why == kSlotHit) {
+    next->frame = A::Frame(cp);
+    ++t.hits;
+    return next;
+  }
+  ++t.misses;
+  ++t.why[why];
+  return nullptr;
+}
