+void VulkanCommandProcessor::AsyncSubmitDrain() {
+  if (!async_submit_thread_.joinable()) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  async_submit_idle_cv_.wait(lock,
+                             [this] { return async_submit_queue_.empty() && !async_submit_busy_; });
+  // wwe2k14 patch (Session 7, SUBMITFIX): every swap job's ticket has been retired (MarkSubmitted).
+  async_swap_unretired_ticket_ = 0;
+}
+
+bool VulkanCommandProcessor::AsyncSubmitRetryWait(uint32_t retry) {
+  // wwe2k14 patch (Session 7, SUBMITFIX): 1, 2, 4 ... 64, then 100 ms (16 retries = about 1 s); woken early by
+  // AsyncSubmitStop.
+  const std::chrono::milliseconds delay(
+      std::min(uint32_t(1) << std::min(retry - 1, uint32_t(7)), uint32_t(100)));
+  std::unique_lock<std::mutex> lock(async_submit_mutex_);
+  return !async_submit_work_cv_.wait_for(lock, delay, [this] { return async_submit_stop_; });
+}
