+// wwe2k14 patch (Session 7, SEAMS): gpu_tiling_viewport_fix_stats. Both results are computed here, not taken
+// from IssueDraw (which may come from the viewport info cache), so the comparison doesn't depend on the cache.
+void VulkanCommandProcessor::TilingViewportFixStatsDraw(
+    const RegisterFile& regs, uint32_t draw_resolution_scale_x, uint32_t draw_resolution_scale_y,
+    uint32_t x_max, uint32_t y_max, reg::RB_DEPTHCONTROL normalized_depth_control,
+    bool convert_z_to_float24, bool full_float24_in_0_to_1, bool pixel_shader_writes_depth) {
+  TilingViewportFixStats& stats = tiling_viewport_fix_stats_;
+  // A new window: the first draw since the setting was turned on, or frame_current_ went back (the context
+  // was recreated; ShutdownContext resets it to 1). Otherwise close the window every 300 frames.
+  if (!stats.active || frame_current_ < stats.last_frame) {
+    if (stats.active) {
+      TilingViewportFixStatsReport(" (partial window: context recreated)");
+    }
+    uint32_t no_window_offset_logged = stats.no_window_offset_logged;
+    stats = TilingViewportFixStats();
+    stats.no_window_offset_logged = no_window_offset_logged;
+    stats.active = true;
+    stats.window_first_frame = frame_current_;
+  } else if (frame_current_ - stats.window_first_frame >= 300) {
+    TilingViewportFixStatsReport("");
+    uint32_t no_window_offset_logged = stats.no_window_offset_logged;
+    stats = TilingViewportFixStats();
+    stats.no_window_offset_logged = no_window_offset_logged;
+    stats.active = true;
+    stats.window_first_frame = frame_current_;
+  }
+  stats.last_frame = frame_current_;
+  ++stats.draws;
+  if (tiling_viewport_fix_) {
+    ++stats.draws_fix_on;
+  }
+
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  auto pa_sc_window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  bool vtx_window_offset_enable = pa_su_sc_mode_cntl.vtx_window_offset_enable != 0;
+  bool window_offset_applied =
+      vtx_window_offset_enable &&
+      (pa_sc_window_offset.window_x_offset != 0 || pa_sc_window_offset.window_y_offset != 0);
+  TilingViewportFixStats::WindowOffset* window_offset_entry = nullptr;
+  for (uint32_t i = 0; i < stats.window_offset_count; ++i) {
+    TilingViewportFixStats::WindowOffset& entry = stats.window_offsets[i];
+    if (entry.window_offset == pa_sc_window_offset.value &&
+        entry.vtx_window_offset_enable == vtx_window_offset_enable) {
+      window_offset_entry = &entry;
+      break;
+    }
+  }
+  if (!window_offset_entry && stats.window_offset_count < TilingViewportFixStats::kMaxWindowOffsets) {
+    window_offset_entry = &stats.window_offsets[stats.window_offset_count++];
+    window_offset_entry->window_offset = pa_sc_window_offset.value;
+    window_offset_entry->vtx_window_offset_enable = vtx_window_offset_enable;
+  }
+  if (window_offset_entry) {
+    ++window_offset_entry->draws;
+  } else {
+    ++stats.window_offsets_dropped;
+  }
+
+  // Draws with clipping disabled take the other branch of GetHostViewportInfo, which the fix doesn't touch.
+  if (regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+    return;
+  }
+  ++stats.draws_clip_enabled;
+  draw_util::ViewportInfo without_fix{};
+  draw_util::ViewportInfo with_fix{};
+  draw_util::GetHostViewportInfo(regs, draw_resolution_scale_x, draw_resolution_scale_y, false, x_max,
+                                 y_max, true, normalized_depth_control, convert_z_to_float24,
+                                 full_float24_in_0_to_1, pixel_shader_writes_depth, without_fix, false);
+  draw_util::GetHostViewportInfo(regs, draw_resolution_scale_x, draw_resolution_scale_y, false, x_max,
+                                 y_max, true, normalized_depth_control, convert_z_to_float24,
+                                 full_float24_in_0_to_1, pixel_shader_writes_depth, with_fix, true);
+  if (!std::memcmp(&without_fix, &with_fix, sizeof(with_fix))) {
+    return;
+  }
+  // A host viewport that is empty on either axis renders nothing either way: UpdateDynamicState then ignores
+  // xy_offset and sets its 1x1 viewport outside the framebuffer. The fix still changes such a viewport's
+  // origin (its start is no longer cropped at 0 - for example a guest viewport left of the strip, or NaN
+  // registers, which clamp to -max), so count it apart and keep it out of the differ counts and the
+  // smallest origin.
+  auto viewport_empty = [](const draw_util::ViewportInfo& info) {
+    return !info.xy_extent[0] || !info.xy_extent[1];
+  };
+  if (viewport_empty(without_fix) && viewport_empty(with_fix)) {
+    ++stats.differ_empty_only;
+    return;
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    stats.min_origin_with_fix[i] = std::min(stats.min_origin_with_fix[i], with_fix.xy_offset[i]);
+  }
+  if (window_offset_entry) {
+    ++window_offset_entry->differ;
+  }
+  if (window_offset_applied) {
+    ++stats.differ_window_offset;
+    return;
+  }
+  ++stats.differ_no_window_offset;
+  // Outside predicated tiling: a guest viewport that itself starts left of or above 0. Log the first few.
+  if (stats.no_window_offset_logged < 8) {
+    ++stats.no_window_offset_logged;
+    REXGPU_INFO(
+        "[s7][SEAMS] frame {}: draw without a window offset gets a different host viewport with the fix: "
+        "PA_CL_VPORT X/Y scale/offset {}/{} {}/{} (VTE_CNTL {:08X}, VTX_CNTL {:08X}, SC_MODE_CNTL {:08X}, "
+        "WINDOW_OFFSET {:08X}); without the fix origin ({}, {}) extent ({}, {}) ndc scale ({}, {}) offset "
+        "({}, {}); with it origin ({}, {}) extent ({}, {}) ndc scale ({}, {}) offset ({}, {})",
+        frame_current_, regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE),
+        regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET), regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+        regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET), regs[XE_GPU_REG_PA_CL_VTE_CNTL],
+        regs[XE_GPU_REG_PA_SU_VTX_CNTL], pa_su_sc_mode_cntl.value, pa_sc_window_offset.value,
+        without_fix.xy_offset[0], without_fix.xy_offset[1], without_fix.xy_extent[0],
+        without_fix.xy_extent[1], without_fix.ndc_scale[0], without_fix.ndc_scale[1],
+        without_fix.ndc_offset[0], without_fix.ndc_offset[1], with_fix.xy_offset[0], with_fix.xy_offset[1],
+        with_fix.xy_extent[0], with_fix.xy_extent[1], with_fix.ndc_scale[0], with_fix.ndc_scale[1],
+        with_fix.ndc_offset[0], with_fix.ndc_offset[1]);
+  }
+}
