+bool VulkanCommandProcessor::GpuTimestampsInitialize() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkPhysicalDevice physical_device = vulkan_device->physical_device();
+  const VkDevice device = vulkan_device->device();
+
+  uint32_t queue_family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count, nullptr);
+  std::vector<VkQueueFamilyProperties> queue_families(queue_family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count,
+                                               queue_families.data());
+  const uint32_t queue_family = vulkan_device->queue_family_graphics_compute();
+  const uint32_t valid_bits =
+      queue_family < queue_family_count ? queue_families[queue_family].timestampValidBits : 0;
+  VkPhysicalDeviceProperties physical_device_properties;
+  ifn.vkGetPhysicalDeviceProperties(physical_device, &physical_device_properties);
+  const float period_ns = physical_device_properties.limits.timestampPeriod;
+  // wwe2k14 patch (Session 7b, GPUMARKS): both are in the device function table now (device_1_0.inc).
+  gpu_timestamps_cmd_write_ = dfn.vkCmdWriteTimestamp;
+  gpu_timestamps_get_results_ = dfn.vkGetQueryPoolResults;
+  if (!valid_bits || !(period_ns > 0.0f) || !gpu_timestamps_cmd_write_ || !gpu_timestamps_get_results_) {
+    REXGPU_WARN(
+        "[s6][COUNTERS] GPU timestamps unavailable (queue family {} timestampValidBits {}, timestampPeriod "
+        "{}); vulkan_gpu_timestamps disabled",
+        queue_family, valid_bits, period_ns);
+    gpu_timestamps_unsupported_ = true;
+    return false;
+  }
+  VkQueryPoolCreateInfo query_pool_create_info = {};
+  query_pool_create_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  query_pool_create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  query_pool_create_info.queryCount = kGpuTimestampSlots * 2;
+  if (dfn.vkCreateQueryPool(device, &query_pool_create_info, nullptr, &gpu_timestamps_pool_) !=
+      VK_SUCCESS) {
+    REXGPU_WARN("[s6][COUNTERS] GPU timestamps: failed to create a query pool; vulkan_gpu_timestamps disabled");
+    gpu_timestamps_pool_ = VK_NULL_HANDLE;
+    gpu_timestamps_unsupported_ = true;
+    return false;
+  }
+  gpu_timestamps_period_ns_ = double(period_ns);
+  gpu_timestamps_mask_ = valid_bits >= 64 ? UINT64_MAX : (uint64_t(1) << valid_bits) - 1;
+  gpu_timestamps_slot_submission_.fill(0);
+  gpu_timestamps_read_up_to_ = submission_completed_;
+  REXGPU_INFO("[s6][COUNTERS] GPU timestamps on: {} valid bits, {} ns per tick", valid_bits, period_ns);
+  return true;
+}
+
+void VulkanCommandProcessor::GpuTimestampsWriteBegin(VkCommandBuffer command_buffer,
+                                                     uint32_t slot) const {
+  // At the start of the command buffer: outside any render pass, and before the first command of the
+  // submission. Query commands execute in submission order, so the reset precedes the write.
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  dfn.vkCmdResetQueryPool(command_buffer, gpu_timestamps_pool_, slot * 2, 2);
+  gpu_timestamps_cmd_write_(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, gpu_timestamps_pool_,
+                            slot * 2);
+}
+
+void VulkanCommandProcessor::GpuTimestampsWriteEnd(VkCommandBuffer command_buffer, uint32_t slot) const {
+  gpu_timestamps_cmd_write_(command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_timestamps_pool_,
+                            slot * 2 + 1);
+}
+
+void VulkanCommandProcessor::GpuTimestampsRead() {
+  // Only submissions whose fence has been seen signaled (submission_completed_), so the results are available
+  // and this never waits.
+  const VkDevice device = GetVulkanDevice()->device();
+  uint64_t first = gpu_timestamps_read_up_to_ + 1;
+  if (submission_completed_ >= kGpuTimestampSlots &&
+      first + kGpuTimestampSlots <= submission_completed_) {
+    first = submission_completed_ - kGpuTimestampSlots + 1;
+  }
+  for (uint64_t submission = first; submission <= submission_completed_; ++submission) {
+    const uint32_t slot = uint32_t(submission % kGpuTimestampSlots);
+    if (gpu_timestamps_slot_submission_[slot] != submission) {
+      continue;
+    }
+    gpu_timestamps_slot_submission_[slot] = 0;
+    uint64_t ticks[2];
+    if (gpu_timestamps_get_results_(device, gpu_timestamps_pool_, slot * 2, 2, sizeof(ticks), ticks,
+                                    sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      continue;
+    }
+    const uint64_t delta_ticks = (ticks[1] - ticks[0]) & gpu_timestamps_mask_;
+    const double gpu_us = double(delta_ticks) * gpu_timestamps_period_ns_ / 1000.0;
+    perf::timeline::Record("gpu_ts", uint32_t(submission),
+                           uint32_t(std::min(gpu_us + 0.5, double(UINT32_MAX))),
+                           gpu_timestamps_slot_is_swap_[slot] ? 1 : 0);
+  }
+  gpu_timestamps_read_up_to_ = submission_completed_;
+}
+
+void VulkanCommandProcessor::GpuTimestampsShutdown() {
+  if (gpu_timestamps_pool_ != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), gpu_timestamps_pool_, nullptr);
+    gpu_timestamps_pool_ = VK_NULL_HANDLE;
+  }
+  gpu_timestamps_slot_submission_.fill(0);
+}
+
+// wwe2k14 patch (Session 7b, GPUMARKS): GPU timestamps per frame-anatomy row (gpu_anatomy_gpu_marks). Measurement
+// only: timestamp writes into a query pool of their own and resets of those queries at the start of command
+// buffers; nothing that is emulated, drawn or presented changes. Pool layout: see GpuMarks.
+// The marks (bottom-of-pipe, so written once all of the queue's earlier work has completed, except cb_begin):
+//   cb_begin   top-of-pipe, the command buffer's first command (after the query resets)
+//   pre        IssueDraw, right after SubmitBarriersAndEnterRenderTargetCacheRenderPass: the draw's uploads,
+//              texture loads, barriers and render pass changes are all recorded before it
+//   post       right after the draw call
+//   before / after   IssueCopy, around the whole resolve (no `after` if the readback path ended the submission:
+//              then the submission's cb_end, right after the copy's commands, is the copy's end)
+//   cb_end     the command buffer's last command
+//   texload_begin / texload_dispatch / texload_convert / texload_copy   (Session 7c, TEXLOAD) inside each texture
+//              load (VulkanTextureCache::LoadTextureDataFromResidentMemoryImpl, recorded in the row's prep): before
+//              its first command, after its untiling dispatches, after the float conversion pass (only for formats
+//              that need it), after the copy into the image. So texload_dispatch's interval holds the load's barriers
+//              (and any pending ones they flush, ending the render pass) and its dispatches, texload_copy's the
+//              scratch-to-copy and image layout barrier and the copy; texload_begin's what was recorded before the
+//              load. The draw's own pre mark then measures only what follows the last load.
+// A submission still open at an anatomy frame boundary (IssueSwap returned early, or its EndSubmission failed)
+// gets a bottom-of-pipe cb_end for the ending frame and a bottom-of-pipe cb_begin for the next marked frame
+// there, between its commands, so each frame has its own part of it.
+// <anatomy>_gpu.csv: one row per anatomy row (pre/post or before/after pair) and per cb_begin / cb_end, in
+// recording order (a row is written at its post / after mark):
+//   frame        capture frame (the anatomy CSV's frame column)
+//   idx          anatomy row index (cb_begin / cb_end: the next row's index, = rows recorded before the mark)
+//   kind         draw | copy | cb_begin | cb_end | texload_begin | texload_dispatch | texload_convert | texload_copy
+//                (texload_*: idx = the row whose prep holds the load; gpu_prep_us = gpu_row_us = the time since
+//                the previous mark, gpu_exec_us empty)
+//   submission   host submission number (as in the gpu_ts timeline events)
+//   gpu_t_us     the pre / before mark (cb rows: the mark), us since the frame's first cb_begin
+//   gpu_prep_us  pre / before minus the previous mark of the same submission (cb_end: the submission's tail,
+//                cb_end minus its last mark; 0 when a copy ended at it). For a submission's first row, the
+//                previous mark is its cb_begin or, when later, the previous submission's cb_end (a top-of-pipe
+//                cb_begin can be written while the previous submission still runs; known when that submission's
+//                cb_end is in the same frame or the frame written before), so prep never includes the previous
+//                submission's work
+//   gpu_exec_us  post minus pre (the draw), after minus before (the whole resolve)
+//   gpu_row_us   prep + exec (cb_end: the tail)
+//   rows_covered, first_idx   (Session 7c, CAUSES) the anatomy rows the interval since the previous mark of the
+//                same submission overlaps (draw / copy: their prep), first_idx .. first_idx + rows_covered - 1;
+//                empty without that interval. Mode 0: 1 for a draw (more if skipped rows came before it).
+//   With gpu_anatomy_gpu_marks_mode 1 (Session 7c, CAUSES; see GpuMarksPosition) unmarked draws have no row, and
+//   two more kinds of rows: block (a block mark after row idx's draw call) and prep_begin (a mark right before
+//   the first event command of row idx, or after row idx's draw call). Their gpu_prep_us and gpu_row_us are the
+//   interval since the previous mark (whole unmarked rows), gpu_exec_us is empty.
+// <anatomy>_gpu_frames.csv: one row per marked frame: frame, submissions (with both cb marks in this frame),
+// cb_sum_us (cb_end - cb_begin summed over them; may count the overlap of consecutive submissions twice),
+// busy_union_us (the union of those intervals), idle_gap_us (first cb_begin to last cb_end minus busy_union_us),
+// marks, marks_dropped (frame slot full), marks_unavailable (no result: the command never ran, or its
+// submission's command buffer wasn't submitted - those queries aren't read), marks_mode (Session 7c, CAUSES:
+// gpu_anatomy_gpu_marks_mode the frame was marked with).
+// Empty columns: a mark is missing. Bottom-of-pipe timestamps between draws may keep the GPU from overlapping
+// consecutive draws, so a marked frame can take longer than an unmarked one; compare cb_sum_us with the gpu_ts
+// events of unmarked frames.
+
+namespace {
+
+std::FILE* GpuMarksOpenFile(const std::filesystem::path& path) {
+#ifdef _WIN32
+  // Shared, so the file can be read while the capture runs.
+  return _wfsopen(path.c_str(), L"wb", _SH_DENYNO);
+#else
+  return std::fopen(path.c_str(), "wb");
+#endif
+}
+
+}  // namespace
+
+void VulkanCommandProcessor::AnatomyGpuFrameBoundary(const std::string& rows_path, int64_t frame) {
+  // wwe2k14 patch (Session 7c, TEXLOAD): the capture's texture load CSV (with or without GPU marks).
+  if (texture_cache_) {
+    texture_cache_->TexLoadAnatomyFrameBoundary(rows_path, frame);
+  }
+  // End the frame being marked. The swap has ended the submission holding its last commands, unless IssueSwap
+  // returned early or its EndSubmission failed: then the submission still open holds some of its marks, and the
+  // frame is written after it.
+  if (gpu_marks_active_) {
+    GpuMarks& marks = *gpu_marks_;
+    GpuMarksSubmission& open = marks.open;
+    // Review fix: such a submission's part in this frame ends here, with a cb_end written between its commands
+    // (bottom-of-pipe, like at a command buffer's end), so the frame counts it as one of its submissions; the
+    // next marked frame's part of it starts with a cb_begin at the same point (below). anatomy_gpu_row_ is still
+    // this frame's row count here.
+    if (submission_open_) {
+      if (open.cb_end != UINT32_MAX) {
+        // Allocated in this frame by an EndSubmission that failed: written here instead of at the end.
+        deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, marks.pool,
+                                                     open.cb_end);
+        open.cb_end = UINT32_MAX;
+      } else if (open.cb_begin_tried) {
+        uint32_t query;
+        if (GpuMarksAllocate(GpuMarkKind::kCbEnd, query)) {
+          deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, marks.pool, query);
+        }
+      }
+    }
+    marks.frames[marks.current].ended = true;
+    gpu_marks_active_ = false;
+    // wwe2k14 patch (Session 7c, CAUSES): mode 1 ends with the frame.
+    gpu_marks_sparse_ = false;
+    deferred_command_buffer_.SetEventHook(nullptr);
+  }
+  if (frame < 0 || !REXCVAR_GET(gpu_anatomy_gpu_marks)) {
+    if (gpu_marks_) {
+      if (frame < 0) {
+        // The capture is over; its frames still waiting for their results keep the files open.
+        gpu_marks_->files.reset();
+      }
+      GpuMarksRead();
+    }
+    return;
+  }
+  if (!gpu_marks_) {
+    gpu_marks_ = std::make_unique<GpuMarks>();
+  }
+  GpuMarks& marks = *gpu_marks_;
+  if (marks.pool == VK_NULL_HANDLE && (marks.unsupported || !GpuMarksInitialize())) {
+    return;
+  }
+  if (!marks.files || marks.files->rows_path != rows_path) {
+    // A new capture: anatomy_NNN_K.csv -> anatomy_NNN_K_gpu.csv and anatomy_NNN_K_gpu_frames.csv.
+    auto files = std::make_shared<GpuMarks::Files>();
+    files->rows_path = rows_path;
+    const std::filesystem::path path(rows_path);
+    std::filesystem::path gpu_path = path;
+    std::filesystem::path frames_path = path;
+    gpu_path.replace_filename(path.stem().string() + "_gpu" + path.extension().string());
+    frames_path.replace_filename(path.stem().string() + "_gpu_frames" + path.extension().string());
+    files->gpu_path = gpu_path.string();
+    files->rows = GpuMarksOpenFile(gpu_path);
+    files->frames = GpuMarksOpenFile(frames_path);
+    if (files->rows && files->frames) {
+      // wwe2k14 patch (Session 7c, CAUSES): rows_covered, first_idx and marks_mode appended.
+      std::fputs(
+          "frame,idx,kind,submission,gpu_t_us,gpu_prep_us,gpu_exec_us,gpu_row_us,rows_covered,first_idx\n",
+          files->rows);
+      std::fputs(
+          "frame,submissions,cb_sum_us,busy_union_us,idle_gap_us,marks,marks_dropped,marks_unavailable,"
+          "marks_mode\n",
+          files->frames);
+      REXGPU_INFO("[s7][GPUMARKS] GPU marks for this capture -> {}", files->gpu_path);
+    } else {
+      REXGPU_WARN("[s7][GPUMARKS] Can't open {} / {}; this capture gets no GPU marks", files->gpu_path,
+                  frames_path.string());
+      files->write_failed = true;
+    }
+    marks.files = std::move(files);
+  }
+  if (marks.files->write_failed) {
+    return;
+  }
+  // The frame kFrameSlots back must have been written (normally long done, fewer frames are in flight).
+  GpuMarksRead();
+  GpuMarks::Frame& slot_frame = marks.frames[marks.next_slot];
+  if (slot_frame.in_use) {
+    ++marks.log_frames_not_marked;
+    return;
+  }
+  marks.current = marks.next_slot;
+  marks.next_slot = (marks.next_slot + 1) % GpuMarks::kFrameSlots;
+  slot_frame.in_use = true;
+  slot_frame.ended = false;
+  slot_frame.frame = uint32_t(frame);
+  slot_frame.dropped = 0;
+  slot_frame.last_submission = 0;
+  slot_frame.marks.clear();
+  slot_frame.marks.reserve(8192);
+  slot_frame.files = marks.files;
+  gpu_marks_active_ = true;
+  anatomy_gpu_row_ = 0;
+  // wwe2k14 patch (Session 7c, CAUSES): gpu_anatomy_gpu_marks_mode for this frame, and mode 1's state.
+  slot_frame.mode = REXCVAR_GET(gpu_anatomy_gpu_marks_mode) == 1 ? 1 : 0;
+  gpu_marks_sparse_ = slot_frame.mode == 1;
+  marks.sparse_every = uint32_t(std::max(REXCVAR_GET(gpu_anatomy_gpu_marks_every), int32_t(1)));
+  marks.sparse_event_sum = CausesEventSum();
+  marks.sparse_first_row = 0;
+  marks.sparse_row_marked = false;
+  marks.sparse_post_pending = false;
+  deferred_command_buffer_.SetEventHook(nullptr);
+  // Review fix: a submission still open (see above) starts this frame's part of it here, bottom-of-pipe, so after
+  // the earlier frame's part (its top-of-pipe cb_begin at the command buffer's start, if any, stays the earlier
+  // frame's).
+  if (submission_open_) {
+    marks.open.begin_pos = 0;  // wwe2k14 patch (Session 7c, CAUSES): before this frame's first row
+    marks.open.cb_begin_tried = true;
+    uint32_t query;
+    if (GpuMarksAllocate(GpuMarkKind::kCbBegin, query)) {
+      deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, marks.pool, query);
+    }
+  }
+}
+
+bool VulkanCommandProcessor::GpuMarksInitialize() {
+  GpuMarks& marks = *gpu_marks_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkPhysicalDevice physical_device = vulkan_device->physical_device();
+  uint32_t queue_family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count, nullptr);
+  std::vector<VkQueueFamilyProperties> queue_families(queue_family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count,
+                                               queue_families.data());
+  const uint32_t queue_family = vulkan_device->queue_family_graphics_compute();
+  const uint32_t valid_bits =
+      queue_family < queue_family_count ? queue_families[queue_family].timestampValidBits : 0;
+  VkPhysicalDeviceProperties physical_device_properties;
+  ifn.vkGetPhysicalDeviceProperties(physical_device, &physical_device_properties);
+  const float period_ns = physical_device_properties.limits.timestampPeriod;
+  if (!valid_bits || !(period_ns > 0.0f)) {
+    REXGPU_WARN(
+        "[s7][GPUMARKS] GPU timestamps unavailable (queue family {} timestampValidBits {}, timestampPeriod {}); "
+        "gpu_anatomy_gpu_marks has no effect",
+        queue_family, valid_bits, period_ns);
+    marks.unsupported = true;
+    return false;
+  }
+  VkQueryPoolCreateInfo query_pool_create_info = {};
+  query_pool_create_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  query_pool_create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  query_pool_create_info.queryCount = GpuMarks::kFrameSlots * GpuMarks::kMarksPerFrame;
+  if (dfn.vkCreateQueryPool(vulkan_device->device(), &query_pool_create_info, nullptr, &marks.pool) !=
+      VK_SUCCESS) {
+    REXGPU_WARN("[s7][GPUMARKS] Failed to create a timestamp query pool; gpu_anatomy_gpu_marks has no effect");
+    marks.pool = VK_NULL_HANDLE;
+    marks.unsupported = true;
+    return false;
+  }
+  marks.period_ns = double(period_ns);
+  marks.mask = valid_bits >= 64 ? UINT64_MAX : (uint64_t(1) << valid_bits) - 1;
+  REXGPU_INFO("[s7][GPUMARKS] GPU marks on: {} frame slots of {} timestamps, {} valid bits, {} ns per tick",
+              GpuMarks::kFrameSlots, GpuMarks::kMarksPerFrame, valid_bits, period_ns);
+  return true;
+}
+
+bool VulkanCommandProcessor::GpuMarksAllocate(GpuMarkKind kind, uint32_t& query_out) {
+  GpuMarks& marks = *gpu_marks_;
+  GpuMarks::Frame& frame = marks.frames[marks.current];
+  GpuMarksSubmission& open = marks.open;
+  const uint32_t index = uint32_t(frame.marks.size());
+  const uint32_t query = marks.current * GpuMarks::kMarksPerFrame + index;
+  // The submission's queries to reset: consecutive ones extend the last range.
+  const bool extend = open.reset_count &&
+                      open.reset_first[open.reset_count - 1] + open.reset_size[open.reset_count - 1] == query;
+  if (index >= GpuMarks::kMarksPerFrame || (!extend && open.reset_count >= GpuMarksSubmission::kMaxResets)) {
+    ++frame.dropped;
+    ++marks.counter_dropped;
+    return false;
+  }
+  if (extend) {
+    ++open.reset_size[open.reset_count - 1];
+  } else {
+    open.reset_first[open.reset_count] = query;
+    open.reset_size[open.reset_count] = 1;
+    ++open.reset_count;
+  }
+  const uint64_t submission = GetCurrentSubmission();
+  // wwe2k14 patch (Session 7c, CAUSES): the mark's position among the anatomy rows (Mark::pos).
+  uint32_t pos;
+  switch (kind) {
+    case GpuMarkKind::kCbBegin:
+      // Top-of-pipe at the command buffer's start (or this frame's part of it, see AnatomyGpuFrameBoundary).
+      pos = open.begin_pos;
+      break;
+    case GpuMarkKind::kPrepBegin:
+      pos = GpuMarksPosition(true);
+      break;
+    case GpuMarkKind::kCbEnd:
+      pos = GpuMarksPosition(false);
+      break;
+    case GpuMarkKind::kDrawPre:
+    case GpuMarkKind::kCopyBefore:
+      pos = 2 * anatomy_gpu_row_ + 1;
+      break;
+    default:  // kDrawPost, kCopyAfter, kBlockEnd
+      pos = 2 * anatomy_gpu_row_ + 2;
+      break;
+  }
+  frame.marks.push_back({submission, anatomy_gpu_row_, kind, pos});
+  frame.last_submission = submission;
+  ++marks.counter_marks;
+  query_out = query;
+  return true;
+}
+
+void VulkanCommandProcessor::GpuMark(GpuMarkKind kind) {
+  // Only inside a submission: the mark is one of its deferred commands, and its query is in the ranges its
+  // command buffer resets first.
+  if (!submission_open_) {
+    return;
+  }
+  GpuMarks& marks = *gpu_marks_;
+  uint32_t query;
+  if (!marks.open.cb_begin_tried) {
+    // The submission's first mark in a marked frame: its cb_begin comes first in the frame's order.
+    marks.open.cb_begin_tried = true;
+    if (GpuMarksAllocate(GpuMarkKind::kCbBegin, query)) {
+      marks.open.cb_begin = query;
+    }
+  }
+  if (GpuMarksAllocate(kind, query)) {
+    deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, marks.pool, query);
+  }
+  // wwe2k14 patch (Session 7c, CAUSES): mode 1 bookkeeping (also for a dropped mark: the intervals of the marks
+  // that were recorded still chain, see Mark::pos).
+  if (gpu_marks_sparse_) {
+    GpuMarksSparseNoteMark(kind);
+  }
+}
+
+// wwe2k14 patch (Session 7c, CAUSES): gpu_anatomy_gpu_marks_mode 1 (sparse marks) and the rows_covered column.
+// Measurement only, like the marks themselves.
+// Mode 1 marks a draw (pre + post, as mode 0) only if something was recorded for it since the last mark that
+// ended a row (CausesEventSum changed: an upload, a texture load, a dispatch, a barrier batch, a render pass begin,
+// a pipeline bind or creation). Every resolve keeps its before / after marks. A draw that isn't marked and has no
+// event leaves its time in a block, which ends at the next mark of any kind; to keep a marked draw's preparation
+// free of the unmarked draws before it, an unmarked row's end arms the deferred command buffer's event hook, and the
+// first event command recorded after it gets a prep_begin mark right before it (GpuMarksSparseBeforeEvent). After
+// gpu_anatomy_gpu_marks_every rows without a mark, an event-free draw gets a block mark after its draw call.
+// So: a "block" row's interval holds whole event-free rows; a "prep_begin" row's interval holds the rows from the
+// last mark up to the event that follows it; a marked draw's prep starts at its own first event (or the previous
+// row's end). Each _gpu.csv row says which anatomy rows its interval overlaps (rows_covered from first_idx; see
+// Mark::pos). The marks still chain from cb_begin to cb_end in each submission.
+
+uint32_t VulkanCommandProcessor::GpuMarksPosition(bool interval_start) const {
+  const uint32_t row = anatomy_gpu_row_;
+  if (!anatomy_in_draw_) {
+    // Between rows: the start of the next one.
+    return 2 * row;
+  }
+  if (causes_row_cut_valid_) {
+    // In a draw, after its draw call (CausesCut): the row's end.
+    return 2 * row + 2;
+  }
+  // In a draw or a resolve: an interval starting here holds the row's commands from here on (its start, for the
+  // first event command or a submission begun by the row), one ending here holds part of the row.
+  return 2 * row + (interval_start ? 0 : 1);
+}
+
+void VulkanCommandProcessor::GpuMarksBeginSubmission() {
+  GpuMarks& marks = *gpu_marks_;
+  // Bookkeeping only (meaningful while gpu_marks_active_): where the new command buffer's cb_begin will be.
+  marks.open.begin_pos = GpuMarksPosition(true);
+  if (gpu_marks_active_ && gpu_marks_sparse_) {
+    // The cb_begin starts the next interval: no block is open, and the previous submission's tail (after its last
+    // mark, up to its cb_end) doesn't make this submission's first draw eventful.
+    deferred_command_buffer_.SetEventHook(nullptr);
+    marks.sparse_event_sum = CausesEventSum();
+    marks.sparse_first_row = marks.open.begin_pos / 2;
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksSparseDrawPre() {
+  GpuMarks& marks = *gpu_marks_;
+  marks.sparse_post_pending = false;
+  if (CausesEventSum() != marks.sparse_event_sum) {
+    GpuMark(GpuMarkKind::kDrawPre);
+    marks.sparse_post_pending = true;
+    marks.sparse_post_kind = GpuMarkKind::kDrawPost;
+  } else if (int64_t(anatomy_gpu_row_) + 1 - int64_t(marks.sparse_first_row) >= int64_t(marks.sparse_every)) {
+    // Event-free: a block mark after the draw call ends the block of rows sparse_first_row...this one.
+    marks.sparse_post_pending = true;
+    marks.sparse_post_kind = GpuMarkKind::kBlockEnd;
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksSparseDrawPost() {
+  GpuMarks& marks = *gpu_marks_;
+  if (marks.sparse_post_pending) {
+    marks.sparse_post_pending = false;
+    GpuMark(marks.sparse_post_kind);
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksSparseNoteMark(GpuMarkKind kind) {
+  GpuMarks& marks = *gpu_marks_;
+  // Any mark starts a new interval, so the block (if one was open) ends here.
+  deferred_command_buffer_.SetEventHook(nullptr);
+  switch (kind) {
+    case GpuMarkKind::kDrawPost:
+    case GpuMarkKind::kCopyAfter:
+    case GpuMarkKind::kBlockEnd:
+      // The row's end: what is recorded from here on counts for the next row's decision.
+      marks.sparse_event_sum = CausesEventSum();
+      marks.sparse_first_row = anatomy_gpu_row_ + 1;
+      marks.sparse_row_marked = true;
+      break;
+    case GpuMarkKind::kPrepBegin:
+      // The rows before here are in the block that ends here; sparse_event_sum is kept, so the events recorded
+      // from here on (and any since the last row end) still mark the next draw.
+      marks.sparse_first_row = GpuMarksPosition(true) / 2;
+      break;
+    default:
+      break;
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksSparseRowEnd() {
+  GpuMarks& marks = *gpu_marks_;
+  if (!marks.sparse_row_marked && submission_open_) {
+    // An unmarked row: its time stays in a block; the first event command recorded from here on gets a
+    // prep_begin mark. (Without an open submission, the next one's cb_begin starts the next interval.)
+    deferred_command_buffer_.SetEventHook(this);
+  }
+  marks.sparse_row_marked = false;
+  marks.sparse_post_pending = false;
+}
+
+void VulkanCommandProcessor::GpuMarksSparseBeforeEvent() {
+  // The event hook is only armed while marking in mode 1, and cleared at every frame boundary.
+  if (gpu_marks_active_ && gpu_marks_sparse_) {
+    GpuMark(GpuMarkKind::kPrepBegin);
+  }
+}
+
+// wwe2k14 patch (Session 7c, CAUSES): the frame-anatomy cause columns and the per-frame counters. Measurement only:
+// the counters are plain increments at the recording sites (CauseCounts, DeferredCommandBuffer::
+// dispatches_recorded / rendering_begins_recorded); this reads differences.
+// A row's cause window runs from the end of the previous row's window (or the start of the capture frame, or, when
+// later, the start of the current submission's command buffer) to:
+//   - a draw that reached its draw call: right after the draw call (CausesCut), like its GPU marks - what IssueDraw
+//     records after it in the same submission (memexport readback) is the next row's (on the GPU it falls into the
+//     next row's prep);
+//   - a resolve: right after its before mark (CausesCut), so its columns are its preparation, like its GPU prep
+//     interval; the resolve's own commands (from there to the end of the row) are its exec on the GPU, between its
+//     before / after marks, and are counted for no row (review fix);
+//   - any other row (skipped or failed draws, a resolve that couldn't begin a submission): the end of its IssueDraw
+//     call.
+// Review fix: a new submission's command buffer starts a new window (BeginSubmission): what was recorded before it
+// (a submission's end - EndSubmission's barriers -, a memexport readback that waits for the GPU) ran in the earlier
+// submission, after its last mark (its tail up to cb_end), not in the next row's preparation.
+// So a draw's columns are what was recorded for its preparation (plus any between-packet work before it in the same
+// submission; the commands of skipped rows are in their own rows). Not in any row: the resolves' own commands,
+// submission tails and the swap. The cpf_sync / cpf_sync2 events and the [s7][CAUSES] summary count everything.
+
+VulkanCommandProcessor::CauseSnapshot VulkanCommandProcessor::CausesNow() const {
+  CauseSnapshot now;
+  now.counts = cause_counts_;
+  now.dispatches = deferred_command_buffer_.dispatches_recorded();
+  now.rendering_begins = deferred_command_buffer_.rendering_begins_recorded();
+  return now;
+}
+
+uint64_t VulkanCommandProcessor::CausesEventSum() const {
+  const CauseCounts& counts = cause_counts_;
+  return uint64_t(counts.up_calls) + counts.tex_loads + counts.barrier_batches + counts.pipeline_binds +
+         counts.pipelines_created + deferred_command_buffer_.dispatches_recorded() +
+         deferred_command_buffer_.rendering_begins_recorded();
+}
+
+void VulkanCommandProcessor::CausesCloseWindow(AnatomyCauses& out) {
+  const CauseSnapshot end = CausesNow();
+  const CauseSnapshot& start = causes_row_start_;
+  const CauseCounts& e = end.counts;
+  const CauseCounts& s = start.counts;
+  out.up_calls = e.up_calls - s.up_calls;
+  out.up_pages = e.up_pages - s.up_pages;
+  out.tex_loads = e.tex_loads - s.tex_loads;
+  out.tex_loads_scaled = e.tex_loads_scaled - s.tex_loads_scaled;
+  out.tex_load_kib = uint32_t(std::min((e.tex_load_bytes - s.tex_load_bytes + 1023) >> 10, uint64_t(UINT32_MAX)));
+  out.dispatches = end.dispatches - start.dispatches;
+  out.barrier_batches = e.barrier_batches - s.barrier_batches;
+  out.barrier_src_stages = cause_counts_.barrier_src_stages;
+  out.barrier_dst_stages = cause_counts_.barrier_dst_stages;
+  out.rendering_restarts = end.rendering_begins - start.rendering_begins;
+  out.fsi_edram_barriers = e.fsi_edram_barriers - s.fsi_edram_barriers;
+  out.desc_writes = e.desc_writes - s.desc_writes;
+  out.pipeline_created = e.pipelines_created - s.pipelines_created;
+  out.pipeline_pending = e.pipelines_pending - s.pipelines_pending;
+  // The stage masks are ORed since the window's start: the next window's start from here.
+  cause_counts_.barrier_src_stages = 0;
+  cause_counts_.barrier_dst_stages = 0;
+  causes_row_start_ = end;
+}
+
+void VulkanCommandProcessor::CausesRestartWindow() {
+  causes_row_start_ = CausesNow();
+  cause_counts_.barrier_src_stages = 0;
+  cause_counts_.barrier_dst_stages = 0;
+}
+
+void VulkanCommandProcessor::CausesCut(bool copy) {
+  CausesCloseWindow(causes_row_cut_result_);
+  if (copy) {
+    // A resolve: the row (and its mode 1 bookkeeping) ends at AnatomyRowCauses, after its after mark.
+    causes_copy_cut_valid_ = true;
+    return;
+  }
+  causes_row_cut_valid_ = true;
+  // The row's end for mode 1 too (after its post / block mark, if it got one).
+  if (gpu_marks_active_ && gpu_marks_sparse_) {
+    GpuMarksSparseRowEnd();
+  }
+}
+
+bool VulkanCommandProcessor::AnatomyRowCauses(AnatomyCauses* out) {
+  const bool draw_cut = causes_row_cut_valid_;
+  const bool copy_cut = causes_copy_cut_valid_;
+  causes_row_cut_valid_ = false;
+  causes_copy_cut_valid_ = false;
+  if (!out) {
+    // A capture frame starts (or a row is dropped): discard what was counted since the last row.
+    CausesRestartWindow();
+    return true;
+  }
+  if (draw_cut || copy_cut) {
+    *out = causes_row_cut_result_;
+    if (copy_cut) {
+      // Review fix: the resolve's own commands since its before point are its exec, no row's preparation.
+      CausesRestartWindow();
+    }
+    // After a draw's cut, what was recorded since stays counted for the next row.
+  } else {
+    // A row without a draw call or a resolve (a skipped or failed draw) ends here.
+    CausesCloseWindow(*out);
+  }
+  // A row without a draw call (a resolve or a skipped draw) ends here for mode 1 (a draw's ended at its cut).
+  if (!draw_cut && gpu_marks_active_ && gpu_marks_sparse_) {
+    GpuMarksSparseRowEnd();
+  }
+  return true;
+}
+
+// Every frame boundary (CollectFrameCounters, right before the cpf* events and cp_swap). With the timeline on:
+//   cpf_sync   a = pipeline barrier batches recorded, b = render pass / dynamic rendering instances begun (the
+//              rendering restarts), c = compute dispatches recorded
+//   cpf_sync2  a = texture loads recorded, b = of those, from the resolution-scaled resolve buffer, c = full-EDRAM
+//              barriers placed by EDRAM write commits (fragment shader interlock barriers)
+// and, about every 300 frames while the timeline is on, an [s7][CAUSES] summary of all the cause counters.
+void VulkanCommandProcessor::CausesFrameBoundary() {
+  const CauseSnapshot now = CausesNow();
+  const bool timeline = perf::timeline::Enabled();
+  if (timeline) {
+    const CauseSnapshot& start = causes_frame_start_;
+    perf::timeline::Record("cpf_sync", now.counts.barrier_batches - start.counts.barrier_batches,
+                           now.rendering_begins - start.rendering_begins, now.dispatches - start.dispatches);
+    perf::timeline::Record("cpf_sync2", now.counts.tex_loads - start.counts.tex_loads,
+                           now.counts.tex_loads_scaled - start.counts.tex_loads_scaled,
+                           now.counts.fsi_edram_barriers - start.counts.fsi_edram_barriers);
+  }
+  causes_frame_start_ = now;
+  if (!causes_log_frames_) {
+    causes_log_first_frame_ = frame_current_;
+  }
+  causes_log_timeline_ = causes_log_timeline_ && timeline;
+  if (++causes_log_frames_ < 300) {
+    return;
+  }
+  if (causes_log_timeline_) {
+    const CauseSnapshot& first = causes_log_start_;
+    const CauseCounts& e = now.counts;
+    const CauseCounts& s = first.counts;
+    const double frames = double(causes_log_frames_);
+    auto per_frame = [frames](uint64_t value) { return double(value) / frames; };
+    REXGPU_INFO(
+        "[s7][CAUSES] frames {}-{}, per frame: barrier batches {:.1f}, rendering begins {:.1f}, dispatches "
+        "{:.1f}, uploads {:.1f} ({:.1f} pages), texture loads {:.1f} ({:.1f} scaled, {:.0f} KiB), FSI EDRAM "
+        "barriers {:.1f}, descriptor sets {:.1f}, pipeline binds {:.1f}, pipelines created {:.2f}, draws skipped "
+        "for pending pipelines {:.2f}",
+        causes_log_first_frame_, frame_current_, per_frame(e.barrier_batches - s.barrier_batches),
+        per_frame(uint32_t(now.rendering_begins - first.rendering_begins)),
+        per_frame(uint32_t(now.dispatches - first.dispatches)), per_frame(uint32_t(e.up_calls - s.up_calls)),
+        per_frame(uint32_t(e.up_pages - s.up_pages)), per_frame(uint32_t(e.tex_loads - s.tex_loads)),
+        per_frame(uint32_t(e.tex_loads_scaled - s.tex_loads_scaled)),
+        per_frame((e.tex_load_bytes - s.tex_load_bytes) >> 10),
+        per_frame(uint32_t(e.fsi_edram_barriers - s.fsi_edram_barriers)),
+        per_frame(uint32_t(e.desc_writes - s.desc_writes)), per_frame(uint32_t(e.pipeline_binds - s.pipeline_binds)),
+        per_frame(uint32_t(e.pipelines_created - s.pipelines_created)),
+        per_frame(uint32_t(e.pipelines_pending - s.pipelines_pending)));
+  }
+  causes_log_start_ = now;
+  causes_log_frames_ = 0;
+  causes_log_timeline_ = true;
+}
+
+// wwe2k14 patch (Session 7c, TEXLOAD): marks inside a texture load, attributed to the anatomy row being prepared
+// (anatomy_gpu_row_). They chain with the row's other marks like any mark: each one's interval is the time since
+// the previous mark of the submission, so the draw's pre mark then measures only what is recorded after the load.
+void VulkanCommandProcessor::GpuMarkTextureLoad(TextureLoadMark mark) {
+  if (!gpu_marks_active_) {
+    return;
+  }
+  switch (mark) {
+    case TextureLoadMark::kBegin:
+      GpuMark(GpuMarkKind::kTexLoadBegin);
+      break;
+    case TextureLoadMark::kDispatch:
+      GpuMark(GpuMarkKind::kTexLoadDispatch);
+      break;
+    case TextureLoadMark::kConvert:
+      GpuMark(GpuMarkKind::kTexLoadConvert);
+      break;
+    case TextureLoadMark::kCopy:
+      GpuMark(GpuMarkKind::kTexLoadCopy);
+      break;
+  }
+}
+
+VulkanCommandProcessor::GpuMarksSubmission VulkanCommandProcessor::GpuMarksEndSubmission() {
+  GpuMarks& marks = *gpu_marks_;
+  GpuMarksSubmission& open = marks.open;
+  // Once per submission (if EndSubmission fails after this, it's called again for the same submission; `open`
+  // is cleared only once the submission is closed).
+  if (gpu_marks_active_ && open.cb_end == UINT32_MAX) {
+    uint32_t query;
+    if (!open.cb_begin_tried) {
+      open.cb_begin_tried = true;
+      if (GpuMarksAllocate(GpuMarkKind::kCbBegin, query)) {
+        open.cb_begin = query;
+      }
+    }
+    if (GpuMarksAllocate(GpuMarkKind::kCbEnd, query)) {
+      open.cb_end = query;
+    }
+  }
+  GpuMarksSubmission submission = open;
+  submission.pool = open.reset_count ? marks.pool : VK_NULL_HANDLE;
+  return submission;
+}
+
+void VulkanCommandProcessor::GpuMarksWriteBegin(VkCommandBuffer command_buffer,
+                                                const GpuMarksSubmission& marks) const {
+  if (marks.pool == VK_NULL_HANDLE) {
+    return;
+  }
+  // First in the command buffer: outside any render pass, and query commands on the same queries execute in
+  // submission order, so the resets precede every write of these queries.
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  for (uint32_t i = 0; i < marks.reset_count; ++i) {
+    dfn.vkCmdResetQueryPool(command_buffer, marks.pool, marks.reset_first[i], marks.reset_size[i]);
+  }
+  if (marks.cb_begin != UINT32_MAX) {
+    dfn.vkCmdWriteTimestamp(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, marks.pool, marks.cb_begin);
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksWriteEnd(VkCommandBuffer command_buffer,
+                                              const GpuMarksSubmission& marks) const {
+  if (marks.pool != VK_NULL_HANDLE && marks.cb_end != UINT32_MAX) {
+    GetVulkanDevice()->functions().vkCmdWriteTimestamp(command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                                       marks.pool, marks.cb_end);
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksNotRun(uint64_t submission) {
+  // Submit thread, before the vkQueueSubmit that signals the job's fence: in the list by the time the command
+  // processor sees the submission completed (and reads the frames holding its marks).
+  std::lock_guard<std::mutex> lock(gpu_marks_not_run_mutex_);
+  gpu_marks_not_run_.push_back(submission);
+}
+
+void VulkanCommandProcessor::GpuMarksRead() {
+  GpuMarks& marks = *gpu_marks_;
+  if (marks.pool == VK_NULL_HANDLE) {
+    return;
+  }
+  // Oldest first (from the slot the next frame would take), and in order: stop at the first frame that isn't
+  // over or whose last submission hasn't completed (submission_completed_: fences seen signaled, so the results
+  // are there and nothing waits).
+  bool wrote = false;
+  bool pending = false;
+  for (uint32_t i = 0; i < GpuMarks::kFrameSlots; ++i) {
+    const uint32_t slot = (marks.next_slot + i) % GpuMarks::kFrameSlots;
+    GpuMarks::Frame& frame = marks.frames[slot];
+    if (!frame.in_use) {
+      continue;
+    }
+    if (pending || !frame.ended || frame.last_submission > submission_completed_) {
+      pending = true;
+      continue;
+    }
+    GpuMarksWriteFrame(slot);
+    wrote = true;
+  }
+  if (wrote && (marks.log_frames >= GpuMarks::kLogFrames || (!pending && !gpu_marks_active_))) {
+    GpuMarksLogSummary();
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksWriteFrame(uint32_t slot) {
+  GpuMarks& marks = *gpu_marks_;
+  GpuMarks::Frame& frame = marks.frames[slot];
+  const uint32_t count = uint32_t(frame.marks.size());
+  // (timestamp, availability) per query; the availability stays 0 for a query without a result.
+  marks.results.assign(size_t(count) * 2, 0);
+  // Review fix: the submissions whose command buffers didn't run (GpuMarksNotRun) never reset or wrote their
+  // marks' queries for this use: they would read as the slot's previous results, or as uninitialized queries.
+  // Not read (no result). A submission's marks are consecutive in a frame, so the others are read in runs. Entries
+  // older than this frame's last submission are no longer needed (frames are written in order; the last one may
+  // also hold marks of the next frame).
+  std::vector<uint64_t>& not_run = marks.not_run;
+  not_run.clear();
+  {
+    std::lock_guard<std::mutex> lock(gpu_marks_not_run_mutex_);
+    if (!gpu_marks_not_run_.empty()) {
+      const uint64_t first_submission = count ? frame.marks.front().submission : frame.last_submission;
+      for (uint64_t submission : gpu_marks_not_run_) {
+        if (submission >= first_submission && submission <= frame.last_submission) {
+          not_run.push_back(submission);
+        }
+      }
+      gpu_marks_not_run_.erase(std::remove_if(gpu_marks_not_run_.begin(), gpu_marks_not_run_.end(),
+                                              [&frame](uint64_t submission) {
+                                                return submission < frame.last_submission;
+                                              }),
+                               gpu_marks_not_run_.end());
+    }
+  }
+  auto ran = [&not_run](uint64_t submission) {
+    return std::find(not_run.begin(), not_run.end(), submission) == not_run.end();
+  };
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  for (uint32_t run_begin = 0; run_begin < count;) {
+    if (!ran(frame.marks[run_begin].submission)) {
+      ++run_begin;
+      continue;
+    }
+    uint32_t run_end = run_begin + 1;
+    while (run_end < count && ran(frame.marks[run_end].submission)) {
+      ++run_end;
+    }
+    const uint32_t run_count = run_end - run_begin;
+    uint64_t* const run_results = marks.results.data() + size_t(run_begin) * 2;
+    const VkResult result = vulkan_device->functions().vkGetQueryPoolResults(
+        vulkan_device->device(), marks.pool, slot * GpuMarks::kMarksPerFrame + run_begin, run_count,
+        sizeof(uint64_t) * 2 * run_count, run_results, sizeof(uint64_t) * 2,
+        VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    // VK_NOT_READY: some queries have no result (their commands never ran); the others are valid.
+    if (result != VK_SUCCESS && result != VK_NOT_READY) {
+      std::fill(run_results, run_results + size_t(run_count) * 2, uint64_t(0));
+    }
+    run_begin = run_end;
+  }
+  auto available = [&](uint32_t i) { return marks.results[size_t(i) * 2 + 1] != 0; };
+  auto ticks = [&](uint32_t i) { return marks.results[size_t(i) * 2]; };
+  const uint64_t mask = marks.mask;
+  auto delta = [mask](uint64_t later, uint64_t earlier) -> int64_t {
+    const uint64_t d = (later - earlier) & mask;
+    if (mask != UINT64_MAX && d > (mask >> 1)) {
+      return int64_t(d) - int64_t(mask) - 1;
+    }
+    return int64_t(d);
+  };
+  const double us_per_tick = marks.period_ns / 1000.0;
+  auto us = [&](uint64_t later, uint64_t earlier) { return double(delta(later, earlier)) * us_per_tick; };
+
+  // Times are relative to the frame's first cb_begin with a result (else its first mark with one).
+  bool base_found = false;
+  uint64_t base = 0;
+  for (int pass = 0; pass < 2 && !base_found; ++pass) {
+    for (uint32_t i = 0; i < count; ++i) {
+      if (available(i) && (pass || frame.marks[i].kind == GpuMarkKind::kCbBegin)) {
+        base = ticks(i);
+        base_found = true;
+        break;
+      }
+    }
+  }
+
+  fmt::memory_buffer& text = marks.text;
+  text.clear();
+  auto append_us = [&](bool valid, double value) {
+    if (valid) {
+      fmt::format_to(std::back_inserter(text), ",{:.2f}", value);
+    } else {
+      text.push_back(',');
+    }
+  };
+  // wwe2k14 patch (Session 7c, CAUSES): rows_covered and first_idx end each row: the anatomy rows the row's
+  // interval overlaps (draw / copy: its prep; block, prep_begin, cb_end: the whole interval), from Mark::pos.
+  struct Covered {
+    bool valid = false;
+    uint32_t first = 0;
+    uint32_t count = 0;
+  };
+  auto append_row = [&](uint32_t row, const char* kind, uint64_t submission, bool t_valid, double t_us,
+                        bool prep_valid, double prep_us, bool exec_valid, double exec_us, bool row_valid,
+                        double row_us, const Covered& covered) {
+    fmt::format_to(std::back_inserter(text), "{},{},{},{}", frame.frame, row, kind, submission);
+    append_us(t_valid, t_us);
+    append_us(prep_valid, prep_us);
+    append_us(exec_valid, exec_us);
+    append_us(row_valid, row_us);
+    if (covered.valid) {
+      fmt::format_to(std::back_inserter(text), ",{},{}", covered.count, covered.first);
+    } else {
+      text.push_back(',');
+      text.push_back(',');
+    }
+    text.push_back('\n');
+  };
+
+  // A pre / before mark waiting for its post / after.
+  struct OpenRow {
+    bool valid = false;
+    bool copy = false;
+    uint32_t row = 0;
+    uint64_t submission = 0;
+    bool t_valid = false;
+    uint64_t t = 0;
+    bool prep_valid = false;
+    double prep_us = 0.0;
+    Covered covered;  // wwe2k14 patch (Session 7c, CAUSES)
+  } open_row;
+  double prep_sum_us = 0.0;
+  double exec_sum_us = 0.0;
+  // wwe2k14 patch (Session 7c, CAUSES): block / prep_begin rows (mode 1).
+  uint32_t blocks = 0;
+  uint64_t block_rows = 0;
+  double block_sum_us = 0.0;
+  // wwe2k14 patch (Session 7c, TEXLOAD): texload_dispatch / _convert / _copy intervals, and loads (copy marks).
+  double texload_sum_us = 0.0;
+  uint32_t texload_marks = 0;
+  auto flush_open_row = [&](bool post_valid, uint64_t post_t) {
+    const bool exec_valid = open_row.t_valid && post_valid;
+    const double exec_us = exec_valid ? us(post_t, open_row.t) : 0.0;
+    append_row(open_row.row, open_row.copy ? "copy" : "draw", open_row.submission, open_row.t_valid && base_found,
+               open_row.t_valid ? us(open_row.t, base) : 0.0, open_row.prep_valid, open_row.prep_us, exec_valid,
+               exec_us, open_row.prep_valid && exec_valid, open_row.prep_us + exec_us, open_row.covered);
+    if (open_row.prep_valid) {
+      prep_sum_us += open_row.prep_us;
+    }
+    if (exec_valid) {
+      exec_sum_us += exec_us;
+    }
+    open_row.valid = false;
+  };
+
+  std::vector<std::pair<int64_t, int64_t>>& intervals = marks.intervals;
+  intervals.clear();
+  uint32_t unavailable = 0;
+  bool prev_valid = false;
+  uint64_t prev_t = 0;
+  uint64_t prev_submission = 0;
+  uint32_t prev_pos = 0;  // wwe2k14 patch (Session 7c, CAUSES): Mark::pos of the mark prev_t is from
+  bool cb_begin_valid = false;
+  uint64_t cb_begin_t = 0;
+  uint64_t cb_begin_submission = 0;
+  // The last cb_end with a result (carried over from the frames written before).
+  bool last_cb_end_valid = marks.last_cb_end_valid;
+  uint64_t last_cb_end_t = marks.last_cb_end_t;
+  uint64_t last_cb_end_submission = marks.last_cb_end_submission;
+  for (uint32_t i = 0; i < count; ++i) {
+    const GpuMarks::Mark& mark = frame.marks[i];
+    const bool valid = available(i);
+    const uint64_t t = valid ? ticks(i) : 0;
+    if (!valid) {
+      ++unavailable;
+    }
+    // The time since the previous mark of the same submission (after a cb_begin: see kCbBegin).
+    const bool since_prev_valid = valid && prev_valid && prev_submission == mark.submission;
+    const double since_prev_us = since_prev_valid ? us(t, prev_t) : 0.0;
+    // wwe2k14 patch (Session 7c, CAUSES): the anatomy rows that interval overlaps.
+    Covered since_prev_covered;
+    if (since_prev_valid) {
+      since_prev_covered.valid = true;
+      since_prev_covered.first = prev_pos / 2;
+      const uint32_t end_row = (mark.pos + 1) / 2;
+      since_prev_covered.count = end_row > since_prev_covered.first ? end_row - since_prev_covered.first : 0;
+    }
+    // Where the next mark of this submission measures from.
+    uint64_t next_prev_t = t;
+    switch (mark.kind) {
+      case GpuMarkKind::kCbBegin:
+        append_row(mark.row, "cb_begin", mark.submission, valid && base_found, valid ? us(t, base) : 0.0, false,
+                   0.0, false, 0.0, false, 0.0, Covered());
+        cb_begin_valid = valid;
+        cb_begin_t = t;
+        cb_begin_submission = mark.submission;
+        // Review fix: a top-of-pipe cb_begin may be written while the previous submission's work is still
+        // running, and the bottom-of-pipe mark after it waits for that work. So the submission's first row
+        // measures its prep from the previous submission's cb_end when that is later (known when the previous
+        // submission is the one right before and its cb_end is in this frame or the frame written before).
+        if (valid && last_cb_end_valid && last_cb_end_submission + 1 == mark.submission &&
+            delta(last_cb_end_t, t) > 0) {
+          next_prev_t = last_cb_end_t;
+        }
+        break;
+      case GpuMarkKind::kCbEnd: {
+        // Review fix: a copy still waiting for its after mark here is one whose readback path ended the
+        // submission inside the copy (so it has no after mark): the submission's cb_end, bottom-of-pipe right
+        // after the copy's commands, ends it, and leaves no tail.
+        const bool copy_ended = open_row.valid && open_row.copy && open_row.submission == mark.submission;
+        if (copy_ended) {
+          flush_open_row(valid, t);
+        }
+        const double tail_us = copy_ended ? 0.0 : since_prev_us;
+        append_row(mark.row, "cb_end", mark.submission, valid && base_found, valid ? us(t, base) : 0.0,
+                   since_prev_valid, tail_us, false, 0.0, since_prev_valid, tail_us,
+                   copy_ended ? Covered() : since_prev_covered);
+        if (valid && cb_begin_valid && cb_begin_submission == mark.submission) {
+          intervals.emplace_back(delta(cb_begin_t, base), delta(t, base));
+        }
+        if (valid) {
+          last_cb_end_valid = true;
+          last_cb_end_t = t;
+          last_cb_end_submission = mark.submission;
+        }
+      } break;
+      case GpuMarkKind::kDrawPre:
+      case GpuMarkKind::kCopyBefore:
+        if (open_row.valid) {
+          flush_open_row(false, 0);
+        }
+        open_row.valid = true;
+        open_row.copy = mark.kind == GpuMarkKind::kCopyBefore;
+        open_row.row = mark.row;
+        open_row.submission = mark.submission;
+        open_row.t_valid = valid;
+        open_row.t = t;
+        open_row.prep_valid = since_prev_valid;
+        open_row.prep_us = since_prev_us;
+        open_row.covered = since_prev_covered;  // wwe2k14 patch (Session 7c, CAUSES)
+        break;
+      case GpuMarkKind::kDrawPost:
+      case GpuMarkKind::kCopyAfter: {
+        const bool copy = mark.kind == GpuMarkKind::kCopyAfter;
+        if (open_row.valid && open_row.row == mark.row && open_row.copy == copy) {
+          flush_open_row(valid, t);
+        } else {
+          // Its pre / before mark was dropped.
+          if (open_row.valid) {
+            flush_open_row(false, 0);
+          }
+          append_row(mark.row, copy ? "copy" : "draw", mark.submission, false, 0.0, false, 0.0, false, 0.0, false,
+                     0.0, Covered());
+        }
+      } break;
+      // wwe2k14 patch (Session 7c, CAUSES): mode 1 block marks. The interval since the previous mark (in prep and
+      // row) holds whole unmarked rows (block: after the draw call of row idx; prep_begin: before the first event
+      // command of row idx, or after row idx's draw call when recorded after it).
+      case GpuMarkKind::kPrepBegin:
+      case GpuMarkKind::kBlockEnd:
+        if (open_row.valid) {
+          // Its post mark was dropped.
+          flush_open_row(false, 0);
+        }
+        append_row(mark.row, mark.kind == GpuMarkKind::kBlockEnd ? "block" : "prep_begin", mark.submission,
+                   valid && base_found, valid ? us(t, base) : 0.0, since_prev_valid, since_prev_us, false, 0.0,
+                   since_prev_valid, since_prev_us, since_prev_covered);
+        ++blocks;
+        if (since_prev_valid) {
+          block_rows += since_prev_covered.count;
+          block_sum_us += since_prev_us;
+        }
+        break;
+      // wwe2k14 patch (Session 7c, TEXLOAD): marks inside a texture load (in the prep of row idx): the interval
+      // since the previous mark (in prep and row). They are part of the rows' prep in the summary.
+      case GpuMarkKind::kTexLoadBegin:
+      case GpuMarkKind::kTexLoadDispatch:
+      case GpuMarkKind::kTexLoadConvert:
+      case GpuMarkKind::kTexLoadCopy: {
+        if (open_row.valid) {
+          // Its post mark was dropped (loads are recorded before a draw's pre mark, outside resolves).
+          flush_open_row(false, 0);
+        }
+        const char* texload_kind = mark.kind == GpuMarkKind::kTexLoadBegin      ? "texload_begin"
+                                   : mark.kind == GpuMarkKind::kTexLoadDispatch ? "texload_dispatch"
+                                   : mark.kind == GpuMarkKind::kTexLoadConvert  ? "texload_convert"
+                                                                                : "texload_copy";
+        append_row(mark.row, texload_kind, mark.submission, valid && base_found, valid ? us(t, base) : 0.0,
+                   since_prev_valid, since_prev_us, false, 0.0, since_prev_valid, since_prev_us,
+                   since_prev_covered);
+        if (since_prev_valid) {
+          prep_sum_us += since_prev_us;
+          if (mark.kind != GpuMarkKind::kTexLoadBegin) {
+            texload_sum_us += since_prev_us;
+          }
+        }
+        texload_marks += mark.kind == GpuMarkKind::kTexLoadCopy ? 1 : 0;
+      } break;
+    }
+    if (valid) {
+      prev_valid = true;
+      prev_t = next_prev_t;
+      prev_submission = mark.submission;
+      prev_pos = mark.pos;  // wwe2k14 patch (Session 7c, CAUSES)
+    }
+  }
+  if (open_row.valid) {
+    flush_open_row(false, 0);
+  }
+  marks.last_cb_end_valid = last_cb_end_valid;
+  marks.last_cb_end_t = last_cb_end_t;
+  marks.last_cb_end_submission = last_cb_end_submission;
+
+  // Submissions: their cb intervals summed, and their union (submissions may overlap on the GPU).
+  std::sort(intervals.begin(), intervals.end());
+  int64_t cb_sum = 0;
+  int64_t busy = 0;
+  int64_t run_begin = 0;
+  int64_t run_end = 0;
+  int64_t span_end = 0;
+  for (size_t i = 0; i < intervals.size(); ++i) {
+    const auto [begin, end] = intervals[i];
+    cb_sum += end - begin;
+    if (!i) {
+      run_begin = begin;
+      run_end = end;
+    } else if (begin <= run_end) {
+      run_end = std::max(run_end, end);
+    } else {
+      busy += run_end - run_begin;
+      run_begin = begin;
+      run_end = end;
+    }
+    span_end = i ? std::max(span_end, end) : end;
+  }
+  if (!intervals.empty()) {
+    busy += run_end - run_begin;
+  }
+  const int64_t idle = intervals.empty() ? 0 : (span_end - intervals.front().first) - busy;
+  const double cb_sum_us = double(cb_sum) * us_per_tick;
+  const double busy_us = double(busy) * us_per_tick;
+  const double idle_us = double(idle) * us_per_tick;
+
+  GpuMarks::Files* files = frame.files.get();
+  if (files && !files->write_failed && files->rows && files->frames) {
+    bool write_ok = !text.size() || std::fwrite(text.data(), 1, text.size(), files->rows) == text.size();
+    // wwe2k14 patch (Session 7c, CAUSES): marks_mode appended.
+    write_ok = std::fprintf(files->frames, "%u,%u,%.2f,%.2f,%.2f,%u,%u,%u,%u\n", frame.frame,
+                            uint32_t(intervals.size()), cb_sum_us, busy_us, idle_us, count, frame.dropped,
+                            unavailable, frame.mode) > 0 &&
+               write_ok;
+    if (!write_ok) {
+      files->write_failed = true;
+      REXGPU_WARN("[s7][GPUMARKS] Write error on {}; no more GPU marks for this capture", files->gpu_path);
+    }
+    marks.log_path = files->gpu_path;
+  }
+
+  ++marks.log_frames;
+  marks.log_marks += count;
+  marks.log_dropped += frame.dropped;
+  marks.log_unavailable += unavailable;
+  marks.log_submissions += intervals.size();
+  marks.log_cb_sum_us += cb_sum_us;
+  marks.log_busy_us += busy_us;
+  marks.log_idle_us += idle_us;
+  marks.log_prep_us += prep_sum_us;
+  marks.log_exec_us += exec_sum_us;
+  // wwe2k14 patch (Session 7c, CAUSES).
+  marks.log_blocks += blocks;
+  marks.log_block_rows += block_rows;
+  marks.log_block_us += block_sum_us;
+  marks.log_frames_sparse += frame.mode == 1 ? 1 : 0;
+  marks.log_texload_us += texload_sum_us;  // wwe2k14 patch (Session 7c, TEXLOAD)
+  marks.log_texloads += texload_marks;
+  ++marks.counter_frames_written;
+
+  frame.in_use = false;
+  frame.files.reset();
+}
+
+void VulkanCommandProcessor::GpuMarksLogSummary() {
+  GpuMarks& marks = *gpu_marks_;
+  if (!marks.log_frames && !marks.log_frames_not_marked) {
+    return;
+  }
+  const double frames = double(std::max(marks.log_frames, uint32_t(1)));
+  REXGPU_INFO(
+      "[s7][GPUMARKS] {} frame(s) written (last to {}), per frame: {:.0f} marks ({:.1f} dropped, {:.1f} without a "
+      "result), {:.1f} submissions, cb sum {:.2f} ms, busy {:.2f} ms, idle gaps {:.2f} ms, rows: prep {:.2f} ms, "
+      "draw/resolve {:.2f} ms; {} frame(s) not marked (query slot still in use)",
+      marks.log_frames, marks.log_path, double(marks.log_marks) / frames, double(marks.log_dropped) / frames,
+      double(marks.log_unavailable) / frames, double(marks.log_submissions) / frames,
+      marks.log_cb_sum_us / frames / 1000.0, marks.log_busy_us / frames / 1000.0,
+      marks.log_idle_us / frames / 1000.0, marks.log_prep_us / frames / 1000.0,
+      marks.log_exec_us / frames / 1000.0, marks.log_frames_not_marked);
+  // wwe2k14 patch (Session 7c, CAUSES): gpu_anatomy_gpu_marks_mode 1 frames.
+  if (marks.log_frames_sparse) {
+    REXGPU_INFO(
+        "[s7][GPUMARKS] {} of them sparse (gpu_anatomy_gpu_marks_mode 1), per frame: {:.1f} block / prep_begin "
+        "marks covering {:.1f} rows, {:.2f} ms in blocks",
+        marks.log_frames_sparse, double(marks.log_blocks) / frames, double(marks.log_block_rows) / frames,
+        marks.log_block_us / frames / 1000.0);
+  }
+  marks.log_blocks = 0;
+  marks.log_block_rows = 0;
+  marks.log_block_us = 0.0;
+  marks.log_frames_sparse = 0;
+  // wwe2k14 patch (Session 7c, TEXLOAD).
+  if (marks.log_texloads) {
+    REXGPU_INFO(
+        "[s7][GPUMARKS] texture loads per frame: {:.1f}, their dispatch + convert + copy intervals {:.2f} ms "
+        "(part of the rows' prep; texload_* rows in the _gpu.csv)",
+        double(marks.log_texloads) / frames, marks.log_texload_us / frames / 1000.0);
+  }
+  marks.log_texloads = 0;
+  marks.log_texload_us = 0.0;
+  marks.log_frames = 0;
+  marks.log_frames_not_marked = 0;
+  marks.log_marks = 0;
+  marks.log_dropped = 0;
+  marks.log_unavailable = 0;
+  marks.log_submissions = 0;
+  marks.log_cb_sum_us = 0.0;
+  marks.log_busy_us = 0.0;
+  marks.log_idle_us = 0.0;
+  marks.log_prep_us = 0.0;
+  marks.log_exec_us = 0.0;
+}
+
+void VulkanCommandProcessor::GpuMarksShutdown() {
+  if (!gpu_marks_) {
+    return;
+  }
+  GpuMarks& marks = *gpu_marks_;
+  // ShutdownContext has awaited all queue operations: write every marked frame that can be.
+  if (gpu_marks_active_) {
+    marks.frames[marks.current].ended = true;
+    gpu_marks_active_ = false;
+  }
+  // wwe2k14 patch (Session 7c, CAUSES).
+  gpu_marks_sparse_ = false;
+  deferred_command_buffer_.SetEventHook(nullptr);
+  marks.files.reset();
+  GpuMarksRead();
+  uint32_t abandoned = 0;
+  for (const GpuMarks::Frame& frame : marks.frames) {
+    abandoned += frame.in_use ? 1 : 0;
+  }
+  if (abandoned) {
+    REXGPU_WARN("[s7][GPUMARKS] {} marked frame(s) not written (their GPU work didn't complete)", abandoned);
+  }
+  GpuMarksLogSummary();
+  if (marks.pool != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), marks.pool, nullptr);
+    marks.pool = VK_NULL_HANDLE;
+  }
+  {
+    std::lock_guard<std::mutex> lock(gpu_marks_not_run_mutex_);
+    gpu_marks_not_run_.clear();
+  }
+  gpu_marks_.reset();
+}
+
 }  // namespace rex::graphics::vulkan
