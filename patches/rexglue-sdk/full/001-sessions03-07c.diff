+                (heap.flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) ? " DEVICE_LOCAL" : "",
+                (heap.flags & VK_MEMORY_HEAP_MULTI_INSTANCE_BIT) ? " MULTI_INSTANCE" : "");
+  }
+  for (uint32_t i = 0; i < memory_properties.memoryTypeCount; ++i) {
