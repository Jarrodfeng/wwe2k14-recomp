+// wwe2k14 patch (Session 6, COUNTERS): per-frame counters and GPU timestamps. Measurement only: nothing here
+// changes what is emulated, recorded into the command stream for the guest, or presented.
+
+void VulkanCommandProcessor::CollectFrameCounters(FrameCounters& counters) {
+  if (shared_memory_) {
+    SharedMemory::RequestStats request_stats = shared_memory_->TakeRequestStats();
+    counters.request_ranges = request_stats.calls;
+    counters.request_ranges_all_valid = request_stats.calls - request_stats.upload_calls;
+    counters.upload_kib = uint32_t(request_stats.upload_bytes >> 10);
+    // wwe2k14 patch (Session 7b, UPSKIP): recorded here, right before the cpf events and cp_swap (so they belong
+    // to the same CP frame). Fixed layout (for the report tool):
+    //   cpf_up   a = UploadRanges calls (uploads that record copies), b = pages made valid without a copy by
+    //            gpu_upload_skip_unchanged, c = uploaded pages whose bytes changed while only the frame-end clear
+    //            had invalidated them (what clear_memory_page_state=false would have read stale; needs
+    //            gpu_upload_skip_unchanged or gpu_upload_skip_unchanged_stats, 0 otherwise)
+    //   cpf_up2  a = pages uploaded, b = KiB hashed, c = microseconds in the hashing loops (skip checks: hash;
+    //            hashed uploads: snapshot copy + hash + copy to the upload buffer)
+    SharedMemory::UploadSkipStats upload_skip_stats = shared_memory_->TakeUploadSkipStats(frame_current_);
+    perf::timeline::Record("cpf_up", upload_skip_stats.upload_calls, upload_skip_stats.pages_skipped,
+                           upload_skip_stats.pages_c1_stale);
+    perf::timeline::Record("cpf_up2", upload_skip_stats.pages_uploaded,
+                           uint32_t(upload_skip_stats.bytes_hashed >> 10),
+                           uint32_t(upload_skip_stats.hash_ns / 1000));
+    // wwe2k14 patch (Session 7b, BARNARROW): cpf_bar (recorded here, before the cpf* events) and its log.
+    shared_memory_->RecordNarrowBarrierFrameCounters(GetCurrentFrame());
+  }
+  counters.checkpoint_next_id = crash_checkpoints_enabled() ? uint32_t(crash_checkpoint_next_id_) : 0;
+  RebarFrameBoundary();  // wwe2k14 patch (Session 7b, REBAR)
+  // wwe2k14 patch (Session 7c, TEXDIRECT): cpf_texdirect, the verify comparisons and the [s7][TEXDIRECT] log.
+  if (texture_cache_) {
+    texture_cache_->RecordDirectLoadFrameCounters(frame_current_);
+  }
+  CausesFrameBoundary();  // wwe2k14 patch (Session 7c, CAUSES): cpf_sync, cpf_sync2, [s7][CAUSES]
+  // wwe2k14 patch (Session 7c, TEXLOAD): cpf_texload and the [s7][TEXLOAD] summary.
+  if (texture_cache_) {
+    texture_cache_->TexLoadFrameBoundary(frame_current_);
+  }
+  // wwe2k14 patch (Session 7b, GPUMARKS): cpf_gm.
+  if (gpu_marks_) {
+    GpuMarks& marks = *gpu_marks_;
+    counters.gpu_marks = marks.counter_marks;
+    counters.gpu_marks_dropped = marks.counter_dropped;
+    counters.gpu_marks_frames_written = marks.counter_frames_written;
+    marks.counter_marks = 0;
+    marks.counter_dropped = 0;
+    marks.counter_frames_written = 0;
+  }
+  NoopSkipFrameBoundary();  // wwe2k14 patch (Session 7c, NOOPSKIP): cpf_noop and its log.
+}
+
+// wwe2k14 patch (Session 7b, REBAR): measurement only. Called at every frame boundary (from
+// CollectFrameCounters, right before the cpf* events and cp_swap). Records, while the timeline is on:
+//   cpf_rebar  a = host time (us) of this frame's copies of guest memory into the shared memory upload
+//              buffers (UploadRanges; counted only while the timeline and vulkan_upload_copy_timing are on, 0
+//              otherwise), b = KiB requested from the uniform
+//              buffer pool (guest draw constants, CP7 repacks included), c = upload buffer pool pages created
+//              (shared memory upload + uniform; 0 once the pools have grown to their working size)
+// and logs an [s7][REBAR] summary about every 300 frames (always). The counters are cumulative in the pools
+// and the shared memory; deltas are taken here (a recreated pool restarts from 0 - counted from there).
+void VulkanCommandProcessor::RebarFrameBoundary() {
+  RebarStats& stats = rebar_stats_;
+  const ui::vulkan::VulkanUploadBufferPool* upload_pool =
+      shared_memory_ ? shared_memory_->upload_buffer_pool() : nullptr;
+  const ui::vulkan::VulkanUploadBufferPool* uniform_pool = uniform_buffer_pool_.get();
+  RebarStats::Totals now;
+  if (upload_pool) {
+    const ui::vulkan::VulkanUploadBufferPool::Stats& pool_stats = upload_pool->stats();
+    now.upload_bytes = pool_stats.requested_bytes;
+    now.upload_pages = pool_stats.pages_created;
+    now.upload_pages_device_local = pool_stats.pages_device_local;
+    now.upload_fallbacks = pool_stats.allocation_fallbacks;
+    now.upload_pages_over_share = pool_stats.pages_over_share;
+  }
+  if (shared_memory_) {
+    now.upload_copy_ticks = shared_memory_->upload_copy_ticks();
+    now.upload_verify_skipped = shared_memory_->upload_verify_skipped();
+  }
+  if (uniform_pool) {
+    const ui::vulkan::VulkanUploadBufferPool::Stats& pool_stats = uniform_pool->stats();
+    now.uniform_bytes = pool_stats.requested_bytes;
+    now.uniform_pages = pool_stats.pages_created;
+    now.uniform_pages_device_local = pool_stats.pages_device_local;
+    now.uniform_fallbacks = pool_stats.allocation_fallbacks;
+    now.uniform_pages_over_share = pool_stats.pages_over_share;
+  }
+  auto delta = [](uint64_t current, uint64_t previous) {
+    return current >= previous ? current - previous : current;
+  };
+  const uint64_t tick_frequency = std::max(rex::chrono::Clock::QueryHostTickFrequency(), uint64_t(1));
+  if (perf::timeline::Enabled()) {
+    const RebarStats::Totals& last = stats.frame;
+    perf::timeline::Record(
+        "cpf_rebar",
+        uint32_t(std::min(delta(now.upload_copy_ticks, last.upload_copy_ticks) * 1000000 / tick_frequency,
+                          uint64_t(UINT32_MAX))),
+        uint32_t(std::min(delta(now.uniform_bytes, last.uniform_bytes) >> 10, uint64_t(UINT32_MAX))),
+        uint32_t(delta(now.upload_pages, last.upload_pages) + delta(now.uniform_pages, last.uniform_pages)));
+  }
+  stats.frame = now;
+  const uint64_t frame = frame_current_;
+  if (stats.window_first_frame == UINT64_MAX) {
+    stats.window = now;
+    stats.window_first_frame = frame;
+    return;
+  }
+  if (frame - stats.window_first_frame < 300) {
+    return;
+  }
+  const RebarStats::Totals& first = stats.window;
+  const double frames = double(frame - stats.window_first_frame);
+  auto pool_memory = [](const ui::vulkan::VulkanUploadBufferPool* pool) -> std::string {
+    if (!pool || pool->memory_type() == UINT32_MAX) {
+      return "no pages yet";
+    }
+    return fmt::format("new pages in memory type {}{}, device-local preference {}", pool->memory_type(),
+                       pool->memory_type() == pool->device_local_memory_type() ? " (device-local)" : "",
+                       pool->prefers_device_local() ? "on" : "off");
+  };
+  REXGPU_INFO(
+      "[s7][REBAR] frames {}-{}: shared memory upload pool ({}): {:.0f} KB/frame, copies {:.3f} ms/frame "
+      "(host time, while the timeline and vulkan_upload_copy_timing are on), {} pages in total ({} "
+      "device-local, {} allocation fallbacks, {} over the heap share), streaming copy verify skipped {}; "
+      "uniform pool ({}): {:.0f} KB/frame, {} pages in total ({} device-local, {} allocation fallbacks, {} "
+      "over the heap share){}{}",
+      stats.window_first_frame, frame, pool_memory(upload_pool),
+      double(delta(now.upload_bytes, first.upload_bytes) >> 10) / frames,
+      double(delta(now.upload_copy_ticks, first.upload_copy_ticks)) * 1000.0 / double(tick_frequency) / frames,
+      now.upload_pages, now.upload_pages_device_local, now.upload_fallbacks, now.upload_pages_over_share,
+      delta(now.upload_verify_skipped, first.upload_verify_skipped), pool_memory(uniform_pool),
+      double(delta(now.uniform_bytes, first.uniform_bytes) >> 10) / frames, now.uniform_pages,
+      now.uniform_pages_device_local, now.uniform_fallbacks, now.uniform_pages_over_share,
+      (upload_pool && upload_pool->prefers_device_local() != REXCVAR_GET(vulkan_upload_pool_device_local))
+          ? "; vulkan_upload_pool_device_local changed - takes effect after a restart"
+          : "",
+      (uniform_pool && uniform_pool->prefers_device_local() != REXCVAR_GET(vulkan_uniform_pool_device_local))
+          ? "; vulkan_uniform_pool_device_local changed - takes effect after a restart"
+          : "");
+  stats.window = now;
+  stats.window_first_frame = frame;
+}
