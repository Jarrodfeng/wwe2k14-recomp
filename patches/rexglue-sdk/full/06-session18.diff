+// wwe2k14 patch (Session 18, DLAA step 2): camera motion vectors.
+void VulkanCommandProcessor::DlaaSetCamera(uint64_t frame, const float view[16], float fov_degrees, float near_z,
+                                           float far_z) {
+  std::lock_guard<std::mutex> lock(dlaa_camera_mutex_);
+  DlaaCamera& c = dlaa_cameras_[frame % 16];
+  c.frame = frame;
+  for (int i = 0; i < 16; ++i) c.view[i] = view[i];
+  c.fov_degrees = fov_degrees, c.near_z = near_z, c.far_z = far_z;
+}
+
+bool VulkanCommandProcessor::DlaaFindCamera(uint64_t frame, DlaaCamera& out) {
+  std::lock_guard<std::mutex> lock(dlaa_camera_mutex_);
+  const DlaaCamera& c = dlaa_cameras_[frame % 16];
+  if (c.frame != frame) return false;
+  out = c;
+  return true;
+}
+
+// Row-vector rigid inverse (the world -> view matrices are rotation + translation).
+static void DlaaRigidInverse(const double m[16], double out[16]) {
+  for (int i = 0; i < 3; ++i)
+    for (int j = 0; j < 3; ++j) out[i * 4 + j] = m[j * 4 + i];
+  for (int j = 0; j < 3; ++j)
+    out[12 + j] = -(m[12] * out[0 * 4 + j] + m[13] * out[1 * 4 + j] + m[14] * out[2 * 4 + j]);
+  out[3] = out[7] = out[11] = 0, out[15] = 1;
+}
+
+static void DlaaMul(const double a[16], const double b[16], double out[16]) {
+  for (int i = 0; i < 4; ++i)
+    for (int j = 0; j < 4; ++j) {
+      double s = 0;
+      for (int k = 0; k < 4; ++k) s += a[i * 4 + k] * b[k * 4 + j];
+      out[i * 4 + j] = s;
+    }
+}
