+/**
+ * @file        ui/vulkan/streamline.cpp
+ * @brief       NVIDIA Streamline (DLSS / DLAA) loader and DLAA evaluation (wwe2k14 patch, Session 18). See
+ *              rex/ui/vulkan/streamline.h.
