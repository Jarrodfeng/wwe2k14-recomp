+bool VulkanCommandProcessor::DlaaEnsureMotionResources(uint32_t width, uint32_t height) {
+  if (dlaa_motion_failed_) return false;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (dlaa_motion_pipeline_ == VK_NULL_HANDLE) {
+    const VkDescriptorSetLayout set_layout = texture_cache_->dlaa_storage_set_layout();
+    if (set_layout == VK_NULL_HANDLE) {
+      REXGPU_ERROR("[dlaa] motion: no storage set layout (vulkan_texture_load_direct off?)");
+      dlaa_motion_failed_ = true;
+      return false;
+    }
+    const VkDescriptorSetLayout layouts[3] = {set_layout, set_layout, set_layout};
+    VkPushConstantRange push;
+    push.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    push.offset = 0;
+    push.size = 96;
+    VkPipelineLayoutCreateInfo info;
+    info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    info.pNext = nullptr;
+    info.flags = 0;
+    info.setLayoutCount = 3;
+    info.pSetLayouts = layouts;
+    info.pushConstantRangeCount = 1;
+    info.pPushConstantRanges = &push;
+    if (dfn.vkCreatePipelineLayout(device, &info, nullptr, &dlaa_motion_layout_) != VK_SUCCESS) {
+      REXGPU_ERROR("[dlaa] motion: pipeline layout failed");
+      dlaa_motion_failed_ = true;
+      return false;
+    }
+    dlaa_motion_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, dlaa_motion_layout_, shaders::dlaa_motion_cs, sizeof(shaders::dlaa_motion_cs));
+    if (dlaa_motion_pipeline_ == VK_NULL_HANDLE) {
+      REXGPU_ERROR("[dlaa] motion: compute pipeline failed");
+      dlaa_motion_failed_ = true;
+      return false;
+    }
+  }
+  if (dlaa_motion_image_ != VK_NULL_HANDLE && dlaa_motion_size_[0] == width && dlaa_motion_size_[1] == height) {
+    return true;
+  }
+  if (dlaa_motion_image_ != VK_NULL_HANDLE) {
+    AwaitAllQueueOperationsCompletion();
+    dfn.vkDestroyImageView(device, dlaa_motion_view_, nullptr);
+    dfn.vkDestroyImage(device, dlaa_motion_image_, nullptr);
+    dfn.vkFreeMemory(device, dlaa_motion_memory_, nullptr);
+    dlaa_motion_image_ = VK_NULL_HANDLE, dlaa_motion_view_ = VK_NULL_HANDLE, dlaa_motion_memory_ = VK_NULL_HANDLE;
+  }
+  VkImageCreateInfo image_info = {};
+  image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+  image_info.imageType = VK_IMAGE_TYPE_2D;
+  image_info.format = VK_FORMAT_R16G16_SFLOAT;
+  image_info.extent = {width, height, 1};
+  image_info.mipLevels = 1;
+  image_info.arrayLayers = 1;
+  image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+  image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+  image_info.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+  image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  if (!ui::vulkan::util::CreateDedicatedAllocationImage(vulkan_device, image_info,
+                                                       ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+                                                       dlaa_motion_image_, dlaa_motion_memory_)) {
+    REXGPU_ERROR("[dlaa] motion: image {}x{} failed", width, height);
+    dlaa_motion_failed_ = true;
+    return false;
+  }
+  VkImageViewCreateInfo view_info = {};
+  view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+  view_info.image = dlaa_motion_image_;
+  view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+  view_info.format = VK_FORMAT_R16G16_SFLOAT;
+  view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+  if (dfn.vkCreateImageView(device, &view_info, nullptr, &dlaa_motion_view_) != VK_SUCCESS) {
+    REXGPU_ERROR("[dlaa] motion: image view failed");
+    dlaa_motion_failed_ = true;
+    return false;
+  }
+  if (dlaa_motion_set_ == VK_NULL_HANDLE) {
+    dlaa_motion_set_ = texture_cache_->DlaaStorageSetForView(dlaa_motion_view_);
+  } else {
+    VkDescriptorImageInfo di = {VK_NULL_HANDLE, dlaa_motion_view_, VK_IMAGE_LAYOUT_GENERAL};
+    VkWriteDescriptorSet w = {};
+    w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    w.dstSet = dlaa_motion_set_;
+    w.descriptorCount = 1;
+    w.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    w.pImageInfo = &di;
+    dfn.vkUpdateDescriptorSets(device, 1, &w, 0, nullptr);
+  }
+  if (dlaa_motion_set_ == VK_NULL_HANDLE) {
+    REXGPU_ERROR("[dlaa] motion: descriptor set failed");
+    dlaa_motion_failed_ = true;
+    return false;
+  }
+  dlaa_motion_size_[0] = width, dlaa_motion_size_[1] = height;
+  dlaa_motion_initialized_layout_ = false;
