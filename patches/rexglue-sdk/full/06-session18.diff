+// Runs on the submission thread when the deferred command buffer is executed.
+static void DlaaEvaluateCallback(VkCommandBuffer command_buffer, const void* data) {
+  static std::atomic<uint32_t> failures_logged{0}, evaluations{0};
+  const auto& frame = *static_cast<const ui::vulkan::streamline::DlaaFrame*>(data);
+  std::string reason;
+  if (!ui::vulkan::streamline::EvaluateDlaa(command_buffer, frame, &reason)) {
+    if (failures_logged.fetch_add(1) < 5) REXGPU_WARN("[dlaa] DLSS evaluate failed: {}", reason);
+  } else if (evaluations.fetch_add(1) < 3) {
+    REXGPU_INFO("[dlaa] DLSS evaluated (DLAA, {}x{}, frame index {}, jitter {:+.3f} {:+.3f}{})", frame.width,
+                frame.height, frame.frame_index, frame.jitter[0], frame.jitter[1], frame.reset ? ", reset" : "");
+  }
+}
