+  info.pNext = r32_storage_view ? &format_list : nullptr;
+  info.flags = r32_storage_view ? VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT : 0;
+  info.imageType = VK_IMAGE_TYPE_2D;
+  info.format = format;
+  info.extent = {width, height, 1};
