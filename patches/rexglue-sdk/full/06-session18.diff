+static void DlaaMat(const double m[16], float out[16]) {
+  for (int i = 0; i < 16; ++i) out[i] = float(m[i]);
+}
+
+static bool DlaaInverse(const double m[16], double inv[16]) {  // general 4x4 (Gauss-Jordan)
+  double a[4][8];
+  for (int i = 0; i < 4; ++i)
+    for (int j = 0; j < 8; ++j) a[i][j] = j < 4 ? m[i * 4 + j] : (j - 4 == i ? 1.0 : 0.0);
+  for (int c = 0; c < 4; ++c) {
+    int p = c;
+    for (int r = c + 1; r < 4; ++r)
+      if (std::abs(a[r][c]) > std::abs(a[p][c])) p = r;
+    if (std::abs(a[p][c]) < 1e-30) return false;
+    if (p != c)
+      for (int j = 0; j < 8; ++j) std::swap(a[p][j], a[c][j]);
+    const double d = a[c][c];
+    for (int j = 0; j < 8; ++j) a[c][j] /= d;
+    for (int r = 0; r < 4; ++r)
+      if (r != c) {
+        const double f = a[r][c];
+        for (int j = 0; j < 8; ++j) a[r][j] -= f * a[c][j];
+      }
+  }
+  for (int i = 0; i < 4; ++i)
+    for (int j = 0; j < 4; ++j) inv[i * 4 + j] = a[i][j + 4];
+  return true;
+}
+
+void VulkanCommandProcessor::DlaaRunDlss(const VulkanTextureCache::DlaaStorage& color, uint32_t width,
+                                         uint32_t height, const double rep[16], const double view_now[16],
+                                         float fov_degrees, float near_z, float far_z, bool reset) {
+  DeferredCommandBuffer& cb = deferred_command_buffer();
+  const VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  // The motion pass's outputs -> DLSS (compute) reads.
+  PushImageMemoryBarrier(dlaa_depthf_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  PushImageMemoryBarrier(dlaa_motion_image_, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  // The scene colour (GENERAL, from DlaaResolveCopyTarget) -> our input copy.
+  PushImageMemoryBarrier(dlaa_in_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+                         VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+  VkImageCopy region = {};
+  region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.extent = {width, height, 1};
+  cb.CmdVkCopyImage(color.image, VK_IMAGE_LAYOUT_GENERAL, dlaa_in_.image, VK_IMAGE_LAYOUT_GENERAL, 1, &region);
+  PushImageMemoryBarrier(dlaa_in_.image, range, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_GENERAL,
+                         VK_IMAGE_LAYOUT_GENERAL);
+  PushImageMemoryBarrier(dlaa_dlss_out_.image, range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                         VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+
+  // The frame for Streamline: projection (row vectors, view x right / y down / z forward, reversed depth).
+  ui::vulkan::streamline::DlaaFrame f;
+  f.frame_index = uint32_t(dlaa_frame_);
+  f.width = width, f.height = height;
+  auto set_image = [](ui::vulkan::streamline::Image& o, const DlaaImage& i) {
+    o.image = i.image, o.view = i.view, o.memory = i.memory, o.format = i.format;
+    o.layout = VK_IMAGE_LAYOUT_GENERAL, o.flags = i.flags, o.usage = i.usage;
+  };
+  set_image(f.color_in, dlaa_in_);
+  set_image(f.depth, dlaa_depthf_);
+  set_image(f.color_out, dlaa_dlss_out_);
+  f.motion.image = dlaa_motion_image_, f.motion.view = dlaa_motion_view_, f.motion.memory = dlaa_motion_memory_;
+  f.motion.format = VK_FORMAT_R16G16_SFLOAT, f.motion.layout = VK_IMAGE_LAYOUT_GENERAL;
+  f.motion.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+  const double aspect = double(width) / double(std::max(1u, height));
+  const double tv = std::tan(double(fov_degrees) * 0.5 * 3.14159265358979323846 / 180.0), th = tv * aspect;
+  const double n = near_z, fz = far_z;
+  double proj[16] = {1.0 / th, 0, 0, 0, 0, 1.0 / tv, 0, 0, 0, 0, -n / (fz - n), 1, 0, 0, fz * n / (fz - n), 0};
+  double inv_proj[16], tmp[16], c2p[16], p2c[16];
+  DlaaInverse(proj, inv_proj);
+  // clip -> view_now -> view_prev -> prev clip (row vectors: left to right).
+  for (int i = 0; i < 4; ++i)
+    for (int j = 0; j < 4; ++j) {
+      double s = 0;
+      for (int k = 0; k < 4; ++k) s += inv_proj[i * 4 + k] * rep[k * 4 + j];
+      tmp[i * 4 + j] = s;
+    }
+  for (int i = 0; i < 4; ++i)
+    for (int j = 0; j < 4; ++j) {
+      double s = 0;
+      for (int k = 0; k < 4; ++k) s += tmp[i * 4 + k] * proj[k * 4 + j];
+      c2p[i * 4 + j] = s;
+    }
+  if (!DlaaInverse(c2p, p2c)) std::memcpy(p2c, c2p, sizeof(p2c));
+  DlaaMat(proj, f.view_to_clip);
+  DlaaMat(inv_proj, f.clip_to_view);
+  DlaaMat(c2p, f.clip_to_prev_clip);
+  DlaaMat(p2c, f.prev_clip_to_clip);
+  const float sign = float(REXCVAR_GET(gpu_dlaa_jitter_sign));
+  f.jitter[0] = REXCVAR_GET(gpu_dlaa_jitter) ? sign * dlaa_jitter_[0] : 0.0f;
+  f.jitter[1] = REXCVAR_GET(gpu_dlaa_jitter) ? sign * dlaa_jitter_[1] : 0.0f;
+  f.mvec_scale[0] = 1.0f / float(width), f.mvec_scale[1] = 1.0f / float(height);
+  f.near_z = near_z, f.far_z = far_z;
+  f.vertical_fov_radians = float(double(fov_degrees) * 3.14159265358979323846 / 180.0);
+  f.aspect = float(aspect);
+  // World-space camera: the world -> view matrix's columns are right / down / forward; position from the translation.
+  for (int i = 0; i < 3; ++i) {
+    f.camera_right[i] = float(view_now[i * 4 + 0]);
+    f.camera_up[i] = float(-view_now[i * 4 + 1]);
+    f.camera_fwd[i] = float(view_now[i * 4 + 2]);
+    f.camera_pos[i] = float(-(view_now[12] * view_now[i * 4 + 0] + view_now[13] * view_now[i * 4 + 1] +
+                              view_now[14] * view_now[i * 4 + 2]));
+  }
+  // A cut: no previous camera, or a big turn (the rotation part of view_now -> view_prev).
+  const double trace = rep[0] + rep[5] + rep[10];
+  const double angle = std::acos(std::clamp((trace - 1.0) * 0.5, -1.0, 1.0)) * 180.0 / 3.14159265358979323846;
+  f.depth_inverted = true;
+  f.reset = reset || angle > REXCVAR_GET(gpu_dlaa_reset_degrees);
+  cb.CmdHostCallback(&DlaaEvaluateCallback, &f, sizeof(f));
+  current_external_compute_pipeline_ = VK_NULL_HANDLE;  // Streamline bound its own compute state
+  // DLSS's output -> the scene colour texture (GENERAL), then the barrier the next sampling transition chains from.
+  PushImageMemoryBarrier(dlaa_dlss_out_.image, range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  PushImageMemoryBarrier(color.image, range, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                         VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_GENERAL,
+                         VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+  if (REXCVAR_GET(gpu_dlaa)) {
+    cb.CmdVkCopyImage(dlaa_dlss_out_.image, VK_IMAGE_LAYOUT_GENERAL, color.image, VK_IMAGE_LAYOUT_GENERAL, 1,
+                      &region);
+  }
+  PushImageMemoryBarrier(color.image, range, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT,
+                         VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL);
+  ++dlaa_dlss_frames_;
+  if (dlaa_dlss_log_left_ || dlaa_dlss_frames_ % 600 == 0) {
+    if (dlaa_dlss_log_left_) --dlaa_dlss_log_left_;
+    REXGPU_INFO("[dlaa] DLSS: frame {}: colour 0x{:08X} {}x{} (format {}), jitter {:+.3f} {:+.3f}, turn {:.2f} deg{}; "
+                "{} frame(s)", dlaa_frame_, dlaa_color_regs_[0], width, height, uint32_t(color.host_format),
+                f.jitter[0], f.jitter[1], angle, f.reset ? " (reset)" : "", dlaa_dlss_frames_);
+  }
+}
+
+void VulkanCommandProcessor::DlaaMotionPass() {
+  const uint32_t debug = uint32_t(std::clamp(REXCVAR_GET(gpu_dlaa_debug), 0, 2));
+  // DLAA (step 3): needs Streamline + DLSS on this device; debug views take precedence.
+  const bool dlss = !debug && REXCVAR_GET(gpu_dlaa) && ui::vulkan::streamline::Active() &&
+                    ui::vulkan::streamline::DlssAvailable();
+  if ((debug || dlss) && !dlaa_color_valid_) return;
+  const auto color_info = reg::RB_COPY_DEST_INFO{dlaa_color_regs_[3]};
+  const auto depth_info = reg::RB_COPY_DEST_INFO{dlaa_depth_regs_[3]};
+  auto tex_format = [](reg::RB_COPY_DEST_INFO di) {
+    return xenos::TextureFormat(uint32_t(di.copy_dest_format));  // k_8_8_8_8 = 6 in both enums
+  };
+  // Both are 1280-wide k_8_8_8_8 targets in 2K14 (run 1287); the resolve's width is its pitch.
+  VulkanTextureCache::DlaaStorage depth, color;
+  const bool have_depth = texture_cache_->DlaaResolveStorage(
+      dlaa_depth_regs_[0], dlaa_depth_regs_[1], dlaa_depth_regs_[1], dlaa_depth_regs_[2], tex_format(depth_info),
+      xenos::Endian(uint32_t(depth_info.copy_dest_endian) & 3), depth);
+  // The colour only for a debug view: written through our output image and a copy (the game's own colour texture
+  // has no storage view: run 1389).
+  const bool have_color = have_depth && (!(debug || dlss) || texture_cache_->DlaaResolveCopyTarget(
+      dlaa_color_regs_[0], dlaa_color_regs_[1], dlaa_color_regs_[1], dlaa_color_regs_[2], tex_format(color_info),
+      xenos::Endian(uint32_t(color_info.copy_dest_endian) & 3), color, dlss));
+  if (have_color && (debug || dlss) && color.host_format == VK_FORMAT_UNDEFINED) {
+    color.host_format = VK_FORMAT_R8G8B8A8_UNORM;  // k_8_8_8_8 (runs 1390-1395 reported none); size-compatible
+  }
+  if (!have_depth || !have_color) {
+    if (dlaa_motion_log_left_) {
+      --dlaa_motion_log_left_;
+      REXGPU_WARN("[dlaa] motion: frame {}: no {} texture: {}", dlaa_frame_, have_depth ? "colour" : "depth",
+                  have_depth ? (color.failure ? color.failure : "?") : (depth.failure ? depth.failure : "?"));
+    }
+    return;
+  }
+  if (!DlaaEnsureMotionResources(depth.width, depth.height)) return;
+  if (dlss && (color.width != depth.width || color.height != depth.height ||
+               !DlaaEnsureImage(dlaa_depthf_, VK_FORMAT_R32_SFLOAT, true, depth.width, depth.height) ||
+               !DlaaEnsureImage(dlaa_in_, color.host_format, false, color.width, color.height) ||
+               !DlaaEnsureImage(dlaa_dlss_out_, color.host_format, false, color.width, color.height))) {
+    if (dlaa_dlss_log_left_) {
+      --dlaa_dlss_log_left_;
+      REXGPU_WARN("[dlaa] DLSS: frame {}: colour {}x{} vs depth {}x{}, or our images failed", dlaa_frame_,
+                  color.width, color.height, depth.width, depth.height);
+    }
+    return;
+  }
+  if (debug && (color.width != depth.width || color.height != depth.height ||
+                !DlaaEnsureOutputImage(color.host_format, color.width, color.height))) {
+    if (dlaa_motion_log_left_) {
+      --dlaa_motion_log_left_;
+      REXGPU_WARN("[dlaa] motion: frame {}: colour {}x{} vs depth {}x{}, or no output image", dlaa_frame_,
+                  color.width, color.height, depth.width, depth.height);
+    }
+    return;
+  }
+  const int64_t offset = REXCVAR_GET(gpu_dlaa_camera_offset);
+  DlaaCamera now, prev;
+  const bool have_now = DlaaFindCamera(uint64_t(int64_t(dlaa_frame_) + offset), now);
+  const bool have_prev = DlaaFindCamera(uint64_t(int64_t(dlaa_frame_) + offset - 1), prev);
+  if (!have_now || !have_prev) {
+    ++dlaa_motion_no_camera_;
+    if (!have_now) return;
+    prev = now;  // no motion
+  }
+  struct {
+    float reproject[16];
+    float tan_half_fov[2];
+    float near_far[2];
+    float jitter[2];
+    uint32_t size;
+    uint32_t mode;
+  } pc;
+  static_assert(sizeof(pc) == 96, "push constants");
+  double inv_now[16], rep[16];
+  DlaaRigidInverse(now.view, inv_now);
+  DlaaMul(inv_now, prev.view, rep);
+  // GLSL mat4 from push constants is column-major: row-vector v * M needs M's columns = our rows -> transpose.
+  for (int i = 0; i < 4; ++i)
+    for (int j = 0; j < 4; ++j) pc.reproject[j * 4 + i] = float(rep[i * 4 + j]);
+  const double aspect = double(depth.width) / double(std::max(1u, depth.height));
+  const double t = std::tan(double(now.fov_degrees) * 0.5 * 3.14159265358979323846 / 180.0);
+  if (REXCVAR_GET(gpu_dlaa_fov_vertical)) {
+    pc.tan_half_fov[0] = float(t * aspect), pc.tan_half_fov[1] = float(t);
+  } else {
+    pc.tan_half_fov[0] = float(t), pc.tan_half_fov[1] = float(t / aspect);
+  }
+  pc.near_far[0] = now.near_z, pc.near_far[1] = now.far_z;
+  pc.jitter[0] = REXCVAR_GET(gpu_dlaa_jitter) ? dlaa_jitter_[0] : 0.0f;
+  pc.jitter[1] = REXCVAR_GET(gpu_dlaa_jitter) ? dlaa_jitter_[1] : 0.0f;
+  pc.size = depth.width | (depth.height << 16);
+  const bool bgra = color.host_format == VK_FORMAT_B8G8R8A8_UNORM || color.host_format == VK_FORMAT_B8G8R8A8_SRGB;
+  pc.mode = debug | (uint32_t(std::clamp(REXCVAR_GET(gpu_dlaa_depth_order), 0, 2)) << 2) | (bgra ? 16u : 0u) |
+            (dlss ? 32u : 0u) |
+            (uint32_t(std::clamp(REXCVAR_GET(gpu_dlaa_debug_scale), 1, 255)) << 8);
+  // The motion image: previous contents not needed.
+  PushImageMemoryBarrier(dlaa_motion_image_, ui::vulkan::util::InitializeSubresourceRange(),
+                         dlaa_motion_initialized_layout_ ? VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT
+                                                         : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         dlaa_motion_initialized_layout_ ? VK_ACCESS_SHADER_READ_BIT : 0,
+                         VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+  dlaa_motion_initialized_layout_ = true;
+  if (dlss) {  // the depth for DLSS: every pixel written
+    PushImageMemoryBarrier(dlaa_depthf_.image, ui::vulkan::util::InitializeSubresourceRange(),
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+                           VK_IMAGE_LAYOUT_GENERAL);
+  }
+  // Our output image (debug): its old contents are not needed (every pixel is written).
+  if (debug) {
+    PushImageMemoryBarrier(dlaa_out_image_, ui::vulkan::util::InitializeSubresourceRange(),
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+                           VK_IMAGE_LAYOUT_GENERAL);
+  }
+  DeferredCommandBuffer& cb = deferred_command_buffer();
+  BindExternalComputePipeline(dlaa_motion_pipeline_);
+  // Set 1 must be valid even without a debug view (the shader only writes it in one): the depth's set stands in.
+  const VkDescriptorSet sets[3] = {depth.set, debug ? dlaa_out_set_ : dlss ? dlaa_depthf_.set : depth.set,
+                                    dlaa_motion_set_};
+  cb.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, dlaa_motion_layout_, 0, 3, sets, 0, nullptr);
+  cb.CmdVkPushConstants(dlaa_motion_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pc), &pc);
+  SubmitBarriers(true);
+  cb.CmdVkDispatch((depth.width + 7) / 8, (depth.height + 7) / 8, 1);
+  if (debug) {
+    PushImageMemoryBarrier(dlaa_out_image_, ui::vulkan::util::InitializeSubresourceRange(),
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_IMAGE_LAYOUT_GENERAL,
+                           VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    SubmitBarriers(true);
+    VkImageCopy region = {};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.extent = {color.width, color.height, 1};
+    cb.CmdVkCopyImage(dlaa_out_image_, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, color.image,
+                      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+  }
+  if (dlss) {
+    DlaaRunDlss(color, depth.width, depth.height, rep, now.view, now.fov_degrees, now.near_z, now.far_z,
+                !have_prev);
+  }
+  ++dlaa_motion_passes_;
+  if (dlaa_motion_log_left_ || dlaa_motion_passes_ % 600 == 0) {
+    if (dlaa_motion_log_left_) --dlaa_motion_log_left_;
+    REXGPU_INFO("[dlaa] motion: frame {}: depth 0x{:08X} {}x{} (host format {}), colour 0x{:08X} (host format {}), "
+                "cameras {} / {} (offset {}), fov {:.2f} near {} far {}, camera moved {:.3f} / {:.3f} / {:.3f}, "
+                "debug {}; passes {} without camera {}",
+                dlaa_frame_, dlaa_depth_regs_[0], depth.width, depth.height, uint32_t(depth.host_format),
+                dlaa_color_regs_[0], uint32_t(color.host_format), have_now ? "now" : "-", have_prev ? "prev" : "-",
+                offset, now.fov_degrees, now.near_z, now.far_z, rep[12], rep[13], rep[14], debug, dlaa_motion_passes_,
+                dlaa_motion_no_camera_);
+  }
+}
+
+// wwe2k14 patch (Session 18, DLAA): the next frame's jitter.
+static float DlaaHalton(uint32_t index, uint32_t base) {
+  float f = 1.0f, r = 0.0f;
+  for (uint32_t i = index; i; i /= base) {
+    f /= float(base);
+    r += f * float(i % base);
+  }
+  return r;
+}
+
+void VulkanCommandProcessor::DlaaOnSwap() {
+  dlaa_last_.frame = dlaa_frame_;
+  dlaa_last_.x = dlaa_jitter_[0], dlaa_last_.y = dlaa_jitter_[1];
+  dlaa_last_.jittered = dlaa_jittered_draws_;
+  if (REXCVAR_GET(gpu_dlaa_jitter) && dlaa_log_left_ && dlaa_frame_ > 0) {
+    --dlaa_log_left_;
+    REXGPU_INFO("[dlaa] frame {}: jitter {:+.4f} {:+.4f} host px on {} scene draw(s)", dlaa_frame_, dlaa_jitter_[0],
+                dlaa_jitter_[1], dlaa_jittered_draws_);
+  }
+  ++dlaa_frame_;
+  dlaa_scene_done_ = false;
+  dlaa_color_valid_ = false;
+  dlaa_depth_regs_[0] = 0;
+  dlaa_jittered_draws_ = 0;
+  float x = 0, y = 0;
+  const std::string test = REXCVAR_GET(gpu_dlaa_jitter_test);
+  if (!test.empty() && std::sscanf(test.c_str(), "%f,%f", &x, &y) == 2) {
+  } else {
+    const uint32_t phases = uint32_t(std::max(1, REXCVAR_GET(gpu_dlaa_jitter_phases)));
+    const uint32_t i = uint32_t(dlaa_frame_ % phases) + 1;  // Halton from index 1 (index 0 is 0, 0)
+    x = DlaaHalton(i, 2) - 0.5f, y = DlaaHalton(i, 3) - 0.5f;
+  }
+  dlaa_jitter_[0] = x, dlaa_jitter_[1] = y;
+}
+
 void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
                                        uint32_t frontbuffer_height) {
   MatteOnSwap(matte_resolve_index_, matte_dumped_, matte_depth_dumped_);  // wwe2k14 patch (Session 16, MATTE)
+  DlaaOnSwap();  // wwe2k14 patch (Session 18, DLAA)
