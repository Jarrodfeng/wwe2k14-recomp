+    if (x + i < c.width) {
+      v |= (texelFetch(stencil_source, ivec2(int(c.origin_x + x + i), int(c.origin_y + g.y)), 0).r & 255u) << (8u * i);
+    }
+  }
+  dest[c.slot_dword + ((g.y * c.pitch + x) >> 2u)] = v;
