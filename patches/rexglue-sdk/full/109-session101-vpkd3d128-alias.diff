+// wwe2k14 patch (Session 101, lane 46): vpkd3d128 types 3 / 4 / 5 write vD lane by lane (u16 stores) and read
+// the source words (u32 loads, the sign bit AFTER the store) lane by lane. When vD == vB the stores overwrite
+// words that later reads need (the game's four UV packers are `vpkd3d128 v63,v63,5,2,2`: u's sign was lost).
+// Snapshot the four source words first, in a scope of their own, and read only the snapshot. Not aliased: the
+// generated code is unchanged.
+static bool vpkd3d128_aliased(BuilderContext& ctx) {
+  return ctx.insn.operands[0] == ctx.insn.operands[1];
+}
+static void vpkd3d128_open_snapshot(BuilderContext& ctx) {
+  if (!vpkd3d128_aliased(ctx)) return;
+  const auto vB = ctx.v(ctx.insn.operands[1]);
+  ctx.println("\t{{");
+  ctx.println("\tuint32_t vpk_src[4] = {{ {0}.u32[0], {0}.u32[1], {0}.u32[2], {0}.u32[3] }};", vB);
+}
+static void vpkd3d128_close_snapshot(BuilderContext& ctx) {
+  if (!vpkd3d128_aliased(ctx)) return;
+  ctx.println("\t}}");
+}
+// The expression for source word `idx`: the snapshot when aliased, else the register itself.
+static std::string vpkd3d128_src(BuilderContext& ctx, size_t idx) {
+  if (vpkd3d128_aliased(ctx)) return fmt::format("vpk_src[{}]", idx);
+  return fmt::format("{}.u32[{}]", ctx.v(ctx.insn.operands[1]), idx);
+}
