@@ -256,3 +256,37 @@ test_vpkd3d128_float16_4_0:
   blr
   #_ REGISTER_OUT v3 [3F000000, BF000000, 3F800000, BF800000]
   #_ REGISTER_OUT v4 [CDCDCDCD, CDCDCDCD, 3800B800, 3C00BC00]
+
+# --- wwe2k14 patch (Session 101, lane 46): in place (vD == vB). The stores into vD overwrite source words the
+# --- generator still reads (the sign bit is read AFTER the half is stored). Every expectation below equals the
+# --- result of the same pack into a separate register. Encodings are the vD != vB ones above with the VD field
+# --- (bits 21-25, little-endian numbering) changed 4 -> 3, and the shift in bits 6-7.
+# The game's four UV packers: `vpkd3d128 v63,v63,5,2,2` (FLOAT16_4, shift 2). u's sign was lost.
+
+test_vpkd3d128_float16_4_inplace_shift2_0:
+  #_ REGISTER_IN v3 [BFC00000, 3F800000, 3FC00000, BFC00000]
+  # vpkd3d128 v3, v3, 5, 2, 2
+  .long 0x18761E90
+  blr
+  #_ REGISTER_OUT v3 [BE003C00, 3E00BE00, 3FC00000, BFC00000]
+
+test_vpkd3d128_float16_4_inplace_shift0_0:
+  #_ REGISTER_IN v3 [3F000000, BF000000, 3F800000, BF800000]
+  # vpkd3d128 v3, v3, 5, 2, 0
+  .long 0x18761E10
+  blr
+  #_ REGISTER_OUT v3 [3F000000, BF000000, 3800B800, 3C00BC00]
+
+test_vpkd3d128_float16_2_inplace_shift3_0:
+  #_ REGISTER_IN v3 [BFC00000, 3F800000, 00000000, 00000000]
+  # vpkd3d128 v3, v3, 3, 1, 3
+  .long 0x186D1ED0
+  blr
+  #_ REGISTER_OUT v3 [BE003C00, 3F800000, 00000000, 00000000]
+
+test_vpkd3d128_short_4_inplace_shift0_0:
+  #_ REGISTER_IN v3 [40400001, 40400002, 40400003, 40400004]
+  # vpkd3d128 v3, v3, 4, 2, 0
+  .long 0x18721E10
+  blr
+  #_ REGISTER_OUT v3 [40400001, 40400002, 00010002, 00030004]
