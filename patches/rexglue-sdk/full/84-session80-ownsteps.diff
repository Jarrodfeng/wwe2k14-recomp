+  const auto make = [&](VkFormat format, VkImageUsageFlags usage, VkImageAspectFlags aspects, VkImage& image,
+                        VkDeviceMemory& memory, VkImageView& view) {
+    VkImageCreateInfo image_info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    image_info.imageType = VK_IMAGE_TYPE_2D;
+    image_info.format = format;
+    image_info.extent = {width, height, 1};
+    image_info.mipLevels = 1;
+    image_info.arrayLayers = 1;
+    image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_info.usage = usage;
+    image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!ui::vulkan::util::CreateDedicatedAllocationImage(vulkan_device, image_info,
+                                                          ui::vulkan::util::MemoryPurpose::kDeviceLocal, image, memory)) {
+      return false;
+    }
+    VkImageViewCreateInfo view_info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    view_info.image = image;
+    view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    view_info.format = format;
+    view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange(aspects);
+    return dfn.vkCreateImageView(device, &view_info, nullptr, &view) == VK_SUCCESS;
+  };
+  bool ok = make(kOwnedColorFormat, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT,
+                 VK_IMAGE_ASPECT_COLOR_BIT, o.image, o.memory, o.view);
+  ok = ok && make(post_ds_format_, VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
+                  VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, o.depth, o.depth_memory, o.depth_view);
+  if (ok) {
+    const VkImageView views[2] = {o.view, o.depth_view};
+    VkFramebufferCreateInfo fb_info = {VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    fb_info.renderPass = owned_render_pass_[kind];
+    fb_info.attachmentCount = 2;
+    fb_info.pAttachments = views;
+    fb_info.width = width;
+    fb_info.height = height;
+    fb_info.layers = 1;
+    ok = dfn.vkCreateFramebuffer(device, &fb_info, nullptr, &o.framebuffer) == VK_SUCCESS;
+  }
+  if (!ok) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device, o.framebuffer);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, o.view);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, o.depth_view);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device, o.image);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device, o.depth);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, o.memory);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, o.depth_memory);
+    REXGPU_ERROR("[native][owned] could not make a {}x{} image: owned steps off", width, height);
+    owned_failed_ = true;
+    return -1;
+  }
+  REXGPU_INFO("[native][owned] image {}x{} (class {}) made", width, height, kind);
+  owned_images_.push_back(o);
+  return int16_t(owned_images_.size() - 1);
+}
+
+void NativeRenderer::OwnedRefreshList() {
+  // (Copied under the cvar registry lock - a live set assigns the string from another thread; review.)
+  const std::string list = rex::cvar::Query<std::string>("gpu_native_own_steps");
+  if (list == owned_list_text_) return;
+  owned_list_text_ = list;
+  owned_list_.clear();
+  size_t i = 0;
+  while (i < list.size()) {
+    const size_t end = std::min(list.find(',', i), list.size());
+    const std::string item = list.substr(i, end - i);
+    char* stop = nullptr;
+    const unsigned long long hash = std::strtoull(item.c_str(), &stop, 16);
+    if (hash && stop && stop != item.c_str()) owned_list_.push_back(uint64_t(hash));
+    i = end + 1;
+  }
+}
+
+void NativeRenderer::OwnedDisable(uint64_t pixel_shader_hash, const char* why) {
+  if (std::find(owned_disabled_.begin(), owned_disabled_.end(), pixel_shader_hash) != owned_disabled_.end()) return;
+  owned_disabled_.push_back(pixel_shader_hash);
+  REXGPU_WARN("[native][owned] frame {}: ps {:016X} not owned any more ({})", frame_, pixel_shader_hash, why);
+}
+
+std::bitset<2048> NativeRenderer::OwnedDrawTiles(const Draw& draw) const {
+  // The EDRAM tiles a draw writes (its colour and depth), in guest pixels from its rectangle.
+  std::bitset<2048> tiles;
+  uint32_t scale_x = 1, scale_y = 1;
+  command_processor_.NativeResolutionScale(scale_x, scale_y);
+  int32_t rect[4];
+  TruthDrawRect(draw, rect);
+  const uint32_t gx0 = uint32_t(std::max(rect[0], 0)) / scale_x, gy0 = uint32_t(std::max(rect[1], 0)) / scale_y;
+  const uint32_t gx1 = (uint32_t(std::max(rect[2], 0)) + scale_x - 1) / scale_x;
+  const uint32_t gy1 = (uint32_t(std::max(rect[3], 0)) + scale_y - 1) / scale_y;
+  if (gx1 <= gx0 || gy1 <= gy0) return tiles;
+  const uint32_t pitch = std::max(1u, ((draw.surface_info & 0x3FFF) * draw.truth_sx + 79) / 80);
+  if (draw.truth_color >= 0 && (draw.color_write_mask & 0xF)) {
+    const auto format = xenos::ColorRenderTargetFormat((draw.color_info >> 16) & 0xF);
+    tiles |= EdramTiles(draw.color_info & 0xFFF, pitch, xenos::IsColorRenderTargetFormat64bpp(format), gx0, gy0, gx1,
+                        gy1);
+  }
+  if (draw.truth_depth >= 0 && (draw.raster.depth_write || draw.raster.stencil || draw.fast_clear)) {
+    tiles |= EdramTiles(draw.depth_info & 0xFFF, pitch, false, gx0, gy0, gx1, gy1);
+  }
+  return tiles;
+}
+
+void NativeRenderer::OwnedReplayPending(const char* why) {
+  // An owned output whose copy did not follow as expected: the draw recorded into the truth images now, as it would
+  // have been (the same submission - its bindings and constants still hold - and nothing recorded since reads or writes
+  // its tiles: this runs before what found it is recorded), so the EDRAM state and the copy are exact; the shader is
+  // not owned any more (review: a loss must not leave the tiles without its draw).
+  if (!owned_pending_.valid) return;
+  owned_pending_.valid = false;
+  ++truth_counts_.owned_lost_draw;
+  if (!REXCVAR_GET(gpu_native_own_steps_debug_replay)) OwnedDisable(owned_pending_.draw.pixel_shader_hash, why);
+  owned_replaying_ = true;
+  truth_foreign_bind_ = true;  // (its sets are not the command processor's current ones: bound again)
+  truth_bound_valid_ = false;
+  TruthRecordDraw(owned_pending_.draw);
+  truth_foreign_bind_ = true;
+  truth_bound_valid_ = false;
+  owned_replaying_ = false;
+  command_processor_.NativeForgetState();
+}
+
+bool NativeRenderer::OwnedTakeDraw(const Draw& draw) {
+  if (owned_replaying_) return false;
+  if (owned_list_.empty() || owned_failed_ || !truth_ || !replacing_ || truth_failed_) {
+    if (owned_pending_.valid) OwnedReplayPending("owned steps off before its copy");
+    return false;
+  }
+  const uint32_t base = draw.color_info & 0xFFF;
+  const uint32_t pitch = std::max(1u, ((draw.surface_info & 0x3FFF) * draw.truth_sx + 79) / 80);
+  // Not taken: a truth draw that writes tiles of an owned output waiting for its copy (colour or depth, any surface
+  // over them) - the output replayed into the truth images first, then this draw over it as on the console.
+  const auto not_taken = [&](bool refused) {
+    if (refused) ++truth_counts_.owned_refused;
+    if (owned_pending_.valid && (OwnedDrawTiles(draw) & owned_pending_.tiles).any()) {
+      OwnedReplayPending("a draw over its tiles before its copy");
+    }
+    return false;
+  };
+  if (!OwnedWants(draw.pixel_shader_hash)) return not_taken(false);
+  // (Not where the CPU reads copies back - the readback mode, readback_resolve_override or the setting; review.)
+  // (The first refusals are logged with the draw's state.)
+  static uint32_t refusals_logged = 0;
+  const auto refuse = [&](const char* why) {
+    if (refusals_logged < 12) {
+      ++refusals_logged;
+      REXGPU_INFO("[native][owned] frame {}: ps {:016X} refused ({}): class {} colour 0x{:08X} c{} d{} mask 0x{:X} "
+                  "all 0x{:X} blend 0x{:08X} clear {} depth {}{} stencil {} sx {} cover {},{}-{},{} restore {} served {}",
+                  frame_, draw.pixel_shader_hash, why, draw.truth_class, draw.color_info, draw.truth_color,
+                  draw.truth_depth, draw.color_write_mask, draw.color_mask_all, draw.blend_control, draw.fast_clear,
+                  draw.raster.depth_test ? "t" : "-", draw.raster.depth_write ? "w" : "-", draw.raster.stencil,
+                  draw.truth_sx, draw.cover[0], draw.cover[1], draw.cover[2], draw.cover[3], draw.restore,
+                  serve_pending_.size());
+    }
+    return not_taken(true);
+  };
+  if (command_processor_.NativeReadbackActive()) return refuse("readback window");
+  if (draw.truth_class != 1 || ((draw.color_info >> 16) & 0xF) != 0 || draw.truth_color < 0) return refuse("target");
+  if (draw.truth_depth >= 0 || draw.raster.depth_test || draw.raster.depth_write || draw.raster.stencil) {
+    return refuse("depth");
+  }
+  if ((draw.color_write_mask & 0xF) != 0xF || (draw.color_mask_all & ~0xFu) || draw.blend_control != 0x00010001u) {
+    return refuse("mask / blend");
+  }
+  if (draw.fast_clear || draw.memexport || draw.occlusion_query || draw.xfb_buffer != VK_NULL_HANDLE ||
+      draw.instance_count != 1 || draw.truth_sx != 1 || draw.truth_sy != 1 || draw.restore || TruthTwinPitch(pitch)) {
+    return refuse("kind");
+  }
+  if (draw.pipeline == VK_NULL_HANDLE) return refuse("no pipeline");
+  if (!serve_pending_.empty()) return refuse("served binding");
+  uint32_t scale_x = 1, scale_y = 1;
+  command_processor_.NativeResolutionScale(scale_x, scale_y);
+  int32_t rect[4];
+  TruthDrawRect(draw, rect);
+  // From the surface's origin, every pixel of it drawn (proven coverage): our image is exactly the rectangle, not
+  // loaded.
+  if (rect[0] != 0 || rect[1] != 0 || rect[2] <= 0 || rect[3] <= 0 || rect[2] % int32_t(scale_x) ||
+      rect[3] % int32_t(scale_y) || rect[2] > 4096 || rect[3] > 4096) {
+    return refuse("rectangle");
+  }
+  // Every pixel of it drawn (proven coverage) - or, not proven, the open pass into the same image has drawn only clears
+  // of one known colour covering it: our image starts with that colour, rounded as the target stores it (as
+  // gpu_native_truth_clear_load: 1/255), and holds what the surface holds under the draw.
+  const bool covered = draw.cover[2] > draw.cover[0] && draw.cover[3] > draw.cover[1] && draw.cover[0] <= 0 &&
+                       draw.cover[1] <= 0 && draw.cover[2] * int32_t(scale_x) >= rect[2] &&
+                       draw.cover[3] * int32_t(scale_y) >= rect[3];
+  const auto& pc = truth_pass_clears_;
+  const bool cleared = !covered && truth_pass_open_ && truth_pass_color_ == draw.truth_color && pc.valid &&
+                       pc.rect[0] <= 0 && pc.rect[1] <= 0 && pc.rect[2] >= rect[2] && pc.rect[3] >= rect[3] &&
+                       pc.area == uint64_t(pc.rect[2] - pc.rect[0]) * uint64_t(pc.rect[3] - pc.rect[1]);
+  if (!covered && !cleared) return refuse("coverage");
+  VkClearValue clear_value = {};
+  if (cleared) {
+    for (uint32_t i = 0; i < 4; ++i) {
+      // (Review: the product its own statement, so no compiler fuses it with the add - the GPU's is unfused.)
+      const float s = std::min(std::max(pc.color[i], 0.0f), 1.0f) * 255.0f;
+      clear_value.color.float32[i] = std::trunc(s + 0.5f) / 255.0f;
+    }
+  }
+  const uint32_t width = uint32_t(rect[2]), height = uint32_t(rect[3]);
+  const std::bitset<2048> tiles = OwnedDrawTiles(draw);
+  // An owned output still waiting for its copy (one at a time): this draw writes every pixel of it (the same surface
+  // and rectangle - on the console its pixels are overwritten, never copied: dropped), or it is replayed into the truth
+  // images first (review: a second owned draw before the first's copy).
+  if (owned_pending_.valid) {
+    if (owned_pending_.base == base && owned_pending_.pitch_tiles == pitch &&
+        owned_pending_.width == width / scale_x && owned_pending_.height == height / scale_y && covered) {
+      owned_pending_.valid = false;
+    } else {
+      OwnedReplayPending("another owned draw before its copy");
+    }
+  }
+  // Out of the open truth pass and the command processor's (an owned image is drawn in a pass of its own).
+  // (A cleared start: that truth pass - nothing but its clears - is remembered, turned off when the copy is taken;
+  // only when it wrote nothing our image does not hold - no depth or stencil, no colour outside our rectangle - since
+  // the truth images go on counting those tiles as cleared. Review: the blurs' clears write depth too: kept.)
+  const bool clears_ours = pc.rect[0] == 0 && pc.rect[1] == 0 && pc.rect[2] == rect[2] && pc.rect[3] == rect[3] &&
+                           !truth_pass_touched_depth_;
+  const size_t pass_begin = cleared && truth_pass_open_ && clears_ours ? truth_pass_begin_offset_ : SIZE_MAX;
+  if (cleared && !clears_ours && REXCVAR_GET(gpu_native_own_steps_drop_clears)) ++truth_counts_.owned_clears_kept;
+  EndTruthPass();
+  const size_t pass_end = pass_begin != SIZE_MAX ? truth_pass_end_offset_ : SIZE_MAX;
+  command_processor_.EndRenderPass();
+  command_processor_.SubmitBarriers(true);
+  const int16_t index = OwnedImageFor(width, height, 1);
+  if (index < 0) return not_taken(true);  // (all of this size held, or one could not be made: owned_failed_)
+  const OwnedImage& o = owned_images_[index];
+  DeferredCommandBuffer& cb = command_processor_.deferred_command_buffer();
+  // Before the pass: the image's earlier reads (a sampler in an earlier pass or frame) done; its old pixels not kept
+  // (from UNDEFINED), the colour and depth in their attachment layouts.
+  const VkPipelineStageFlags shader_stages = VK_PIPELINE_STAGE_VERTEX_SHADER_BIT |
+                                             VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
+                                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+  const VkPipelineStageFlags attachment_stages = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT |
+                                                 VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT |
+                                                 VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT;
+  VkImageMemoryBarrier barriers[2] = {};
+  for (VkImageMemoryBarrier& b : barriers) {
+    b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  }
+  barriers[0].image = o.image;
+  barriers[0].dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  barriers[0].newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  barriers[0].subresourceRange = ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT);
+  barriers[1].image = o.depth;
+  barriers[1].srcAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;  // (its last pass's, review)
+  barriers[1].dstAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+  barriers[1].newLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+  barriers[1].subresourceRange =
+      ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+  cb.CmdVkPipelineBarrier(shader_stages | attachment_stages, attachment_stages, 0, 0, nullptr, 0, nullptr, 2, barriers);
+  VkRenderPassBeginInfo begin_info = {VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+  begin_info.renderPass = cleared ? owned_render_pass_clear_[1] : owned_render_pass_[1];
+  begin_info.framebuffer = o.framebuffer;
+  begin_info.renderArea = {{0, 0}, {width, height}};
+  begin_info.clearValueCount = cleared ? 1 : 0;
+  begin_info.pClearValues = cleared ? &clear_value : nullptr;
+  cb.CmdVkBeginRenderPass(&begin_info, VK_SUBPASS_CONTENTS_INLINE);
+  // The draw as TruthRecordDraw records it: its pipeline, every set it binds, its viewport, our image's rectangle as
+  // the scissor, its depth bias and blend constants.
+  cb.CmdVkBindPipeline(VK_PIPELINE_BIND_POINT_GRAPHICS, draw.pipeline);
+  for (uint32_t s = 0; s < SpirvShaderTranslator::kDescriptorSetCount; ++s) {
+    if (!(draw.sets_bound & (1u << s)) || draw.sets[s] == VK_NULL_HANDLE) continue;
+    const bool constants = s == SpirvShaderTranslator::kDescriptorSetConstants && draw.dynamic_offset_count;
+    cb.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS, draw.layout, s, 1, &draw.sets[s],
+                               constants ? draw.dynamic_offset_count : 0, constants ? draw.dynamic_offsets : nullptr);
+  }
+  const VkViewport viewport = draw.viewport;
+  cb.CmdVkSetViewport(0, 1, &viewport);
+  const VkRect2D scissor = {{0, 0}, {width, height}};
+  cb.CmdVkSetScissor(0, 1, &scissor);
+  cb.CmdVkSetDepthBias(draw.raster.depth_bias_constant, 0.0f, draw.raster.depth_bias_slope);
+  cb.CmdVkSetBlendConstants(draw.blend_constants);
+  if (draw.indexed) {
+    cb.CmdVkBindIndexBuffer(draw.index_buffer, draw.index_offset, draw.index_type);
+    cb.CmdVkDrawIndexed(draw.vertex_count, 1, 0, 0, 0);
+  } else {
+    cb.CmdVkDraw(draw.vertex_count, 1, 0, 0);
+  }
+  cb.CmdVkEndRenderPass();
+  // After it: readable by the samplers of its page.
+  VkImageMemoryBarrier readable = barriers[0];
+  readable.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+  readable.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+  readable.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+  readable.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  cb.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, shader_stages, 0, 0, nullptr, 0, nullptr, 1,
+                          &readable);
+  // What the next truth draw may take as bound is not (as after own crowd's draw); nothing merges into this one.
+  truth_bound_valid_ = false;
+  truth_bound_pipeline_ = VK_NULL_HANDLE;
+  truth_bound_index_buffer_ = VK_NULL_HANDLE;
+  truth_bound_stencil_valid_ = false;
+  truth_foreign_bind_ = true;
+  truth_last_recorded_ = false;
+  drew_this_frame_ = true;
+  owned_pending_.valid = true;
+  owned_pending_.base = base;
+  owned_pending_.pitch_tiles = pitch;
+  owned_pending_.width = width / scale_x;
+  owned_pending_.height = height / scale_y;
+  owned_pending_.image = index;
+  owned_pending_.frame = frame_;
+  owned_pending_.tiles = tiles;
+  owned_pending_.draw = draw;  // (replayed into the truth images if its copy does not follow as expected)
+  owned_pending_.clears_begin = pass_begin;
+  owned_pending_.clears_end = pass_end;
+  owned_pending_.clears_submission = command_processor_.GetCurrentSubmission();
+  ++truth_counts_.owned_draws;
+  if (segment_log_frames_ > 0) {
+    REXGPU_INFO("[native][seg] frame {} owned draw: ps {:016X} into our image {} ({}x{}), surface base {} pitch {}",
+                frame_, draw.pixel_shader_hash, index, width, height, base, pitch);
+  }
+  return true;
+}
+
+bool NativeRenderer::OwnedTakeResolve(const draw_util::ResolveInfo& info, bool copy_known) {
+  if (owned_list_.empty() || !truth_ || !replacing_) return false;
+  const uint32_t page = (info.copy_dest_base >> 12) & 0x1FFFF;
+  // Pages whose memory any copy writes (colour or depth, any target, any copy shader) are the game's again (review).
+  if (info.copy_dest_extent_length) {
+    const uint64_t start = info.copy_dest_extent_start, end = start + info.copy_dest_extent_length;
+    const size_t before = owned_pages_.size();
+    owned_pages_.erase(std::remove_if(owned_pages_.begin(), owned_pages_.end(),
+                                      [&](const OwnedPage& p) {
+                                        return start < uint64_t(p.extent_start) + p.extent_length &&
+                                               uint64_t(p.extent_start) < end;
+                                      }),
+                       owned_pages_.end());
+    if (owned_pages_.size() != before) command_processor_.NativeOwnedPagesChanged();
+  }
+  if (!owned_pending_.valid || !info.copy_dest_extent_length) return false;
+  // The copy's source tiles: none of the owned output's - not its copy (it stays pending); some - its copy, taken if
+  // it is exactly the owned rectangle, else the output is replayed into the truth images and this copy runs from them.
+  uint32_t span_base = 0, row_length = 0, rows = 0, span_pitch = 0;
+  info.GetCopyEdramTileSpan(span_base, row_length, rows, span_pitch);
+  std::bitset<2048> source;
+  for (uint32_t r = 0; r < rows; ++r) {
+    for (uint32_t c = 0; c < row_length; ++c) source.set((span_base + r * span_pitch + c) & 2047u);
+  }
+  if (!(source & owned_pending_.tiles).any()) return false;
+  const auto lose = [&]() {
+    if (segment_log_frames_ > 0) {
+      REXGPU_INFO("[native][seg] frame {} owned output replayed: copy into page 0x{:05X} not of its rectangle / plain",
+                  frame_, page);
+    }
+    OwnedReplayPending("a copy of its tiles not of its rectangle / not plain");
+    return false;
+  };
+  if (!copy_known || info.IsCopyingDepth() || info.rb_copy_control.copy_src_select != 0 ||
+      REXCVAR_GET(gpu_native_own_steps_debug_replay)) {
+    return lose();
+  }
+  // The copy of exactly the owned rectangle, from the surface's origin, into a texture's origin, as a plain one:
+  // an 8-bit-per-channel unsigned destination (k_8: the red channel; k_8_8_8_8: all four), no exponent bias, no
+  // red / blue swap.
+  const reg::RB_COPY_DEST_INFO d = info.copy_dest_info;
+  const uint32_t w = owned_pending_.width, h = owned_pending_.height;
+  if (info.color_edram_info.pitch_tiles != owned_pending_.pitch_tiles || info.color_edram_info.msaa_samples !=
+      xenos::MsaaSamples::k1X || info.coordinate_info.edram_offset_x_div_8 || info.coordinate_info.edram_offset_y_div_8 ||
+      info.coordinate_info.width_div_8 * 8 != w || info.height_div_8 * 8 != h || span_base != owned_pending_.base ||
+      rows != (h + 15) / 16 || row_length != (w + 79) / 80 ||
+      (d.copy_dest_format != xenos::ColorFormat::k_8 && d.copy_dest_format != xenos::ColorFormat::k_8_8_8_8) ||
+      d.copy_dest_number != xenos::SurfaceNumberFormat::kUnsignedRepeatingFraction || d.copy_dest_exp_bias ||
+      d.copy_dest_swap || d.copy_dest_array || info.copy_dest_base_x || info.copy_dest_base_y ||
+      info.copy_dest_coordinate_info.offset_x_div_8 || info.copy_dest_coordinate_info.offset_y_div_8) {
+    return lose();
+  }
+  OwnedPage p;
+  p.page = page;
+  p.image = owned_pending_.image;
+  p.width = w;
+  p.height = h;
+  p.format = uint32_t(d.copy_dest_format);
+  p.endian = uint32_t(d.copy_dest_endian);
+  p.extent_start = info.copy_dest_extent_start;
+  p.extent_length = info.copy_dest_extent_length;
+  p.producer = owned_pending_.draw.pixel_shader_hash;
+  p.frame = frame_;
+  owned_pages_.push_back(p);
+  owned_pending_.valid = false;
+  command_processor_.NativeOwnedPagesChanged();
+  ++truth_counts_.owned_copies;
+  // (gpu_native_own_steps_drop_clears: the truth pass of the clears it started from turned off now - our image holds
+  // what they wrote; their tiles are read by nothing but other surfaces' alias loads of pixels no copy takes (in the
+  // logged frames), and keep their older pixels as gpu_shadow_half_rate leaves a skipped map's while the images still
+  // count them as cleared. Only in the submission it was recorded in: the offsets are that stream's.)
+  if (owned_pending_.clears_begin != SIZE_MAX && REXCVAR_GET(gpu_native_own_steps_drop_clears) &&
+      owned_pending_.clears_submission == command_processor_.GetCurrentSubmission()) {
+    DeferredCommandBuffer& cb = command_processor_.deferred_command_buffer();
+    const bool dropped = cb.NopRenderPass(owned_pending_.clears_begin, owned_pending_.clears_end, true);
+    ++(dropped ? truth_counts_.owned_clears_dropped : truth_counts_.owned_clears_kept);
+    // (gpu_native_truth_drop_dead_passes: that pass is off already, if it is the candidate.)
+    if (dropped && dead_pass_.valid && dead_pass_.begin == owned_pending_.clears_begin) dead_pass_.valid = false;
+  }
+  if (segment_log_frames_ > 0) {
+    REXGPU_INFO("[native][seg] frame {} owned copy left out: page 0x{:05X} ({}x{}, format {}) is our image {}", frame_,
+                page, w, h, p.format, p.image);
+  }
+  return true;
+}
+
+VkImageView NativeRenderer::OwnedView(uint32_t base_page, uint32_t width, uint32_t height, uint32_t format,
+                                      uint32_t endian, bool scaled_ok, const VkComponentMapping& mapping) {
+  if (owned_pages_.empty() || owned_list_.empty() || !truth_ || !replacing_) return VK_NULL_HANDLE;
+  const OwnedPage* p = nullptr;
+  for (const OwnedPage& q : owned_pages_) {
+    if (q.page == base_page) p = &q;
+  }
+  // (Held from this frame's copy or the last frame's: a page the game stopped copying into is its texture's again.)
+  if (!p || p->frame + 1 < frame_ || p->image < 0 || size_t(p->image) >= owned_images_.size()) return VK_NULL_HANDLE;
+  // A sampler that reads the page otherwise than the copy wrote it (size, format, byte order) or with a resolution
+  // scale not ours (review: the texture's scaled-resolve flag decides the fetch's texel maths): not given our image -
+  // it reads the texture, which the left-out copy did not write - and the shader that made it is not owned any more
+  // (from its next draw the game's copy runs again; logged).
+  if (p->width != width || p->height != height || p->format != format || p->endian != endian || !scaled_ok) {
+    ++truth_counts_.owned_refused;
+    OwnedDisable(p->producer, "a sampler of its page reads it otherwise");
+    return VK_NULL_HANDLE;
+  }
+  // The texture's swizzle over our RGBA8 image: a k_8 texture's single channel is our red, its missing ones read as
+  // an R8 view's do (green, blue 0; alpha 1); a k_8_8_8_8 one's are ours as they are.
+  const bool single = format == uint32_t(xenos::ColorFormat::k_8);
+  VkComponentMapping components = mapping;
+  const VkComponentSwizzle own[4] = {VK_COMPONENT_SWIZZLE_R, VK_COMPONENT_SWIZZLE_G, VK_COMPONENT_SWIZZLE_B,
+                                     VK_COMPONENT_SWIZZLE_A};
+  VkComponentSwizzle* const parts[4] = {&components.r, &components.g, &components.b, &components.a};
+  for (uint32_t i = 0; i < 4; ++i) {
+    VkComponentSwizzle& s = *parts[i];
+    if (s == VK_COMPONENT_SWIZZLE_IDENTITY) s = own[i];
+    if (single) {
+      if (s == VK_COMPONENT_SWIZZLE_G || s == VK_COMPONENT_SWIZZLE_B) s = VK_COMPONENT_SWIZZLE_ZERO;
+      if (s == VK_COMPONENT_SWIZZLE_A) s = VK_COMPONENT_SWIZZLE_ONE;
+    }
+  }
+  const OwnedImage& o = owned_images_[p->image];
+  for (const OwnedViewEntry& v : owned_views_) {
+    if (v.image == o.image && !std::memcmp(&v.components, &components, sizeof(components))) {
+      ++truth_counts_.owned_served;
+      return v.view;
+    }
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  VkImageViewCreateInfo view_info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+  view_info.image = o.image;
+  view_info.viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY;  // (as the texture cache's views of 2D textures)
+  view_info.format = kOwnedColorFormat;
+  view_info.components = components;
+  view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT);
+  VkImageView view = VK_NULL_HANDLE;
+  if (vulkan_device->functions().vkCreateImageView(vulkan_device->device(), &view_info, nullptr, &view) !=
+      VK_SUCCESS) {
+    return VK_NULL_HANDLE;
+  }
+  owned_views_.push_back({o.image, components, view});
+  ++truth_counts_.owned_served;
+  return view;
+}
+
+void NativeRenderer::OwnedOnFrameEnd() {
+  // An output whose copy never came (the frame ended first): lost - counted, its shader not owned any more (its
+  // tiles are left as gpu_shadow_half_rate leaves a skipped map's).
+  if (owned_pending_.valid) {
+    owned_pending_.valid = false;
+    ++truth_counts_.owned_lost_copy;
+    OwnedDisable(owned_pending_.draw.pixel_shader_hash, "no copy of it before the frame's end");
+  }
+  // Pages not copied into for two frames are their textures' again.
+  const size_t before = owned_pages_.size();
+  owned_pages_.erase(std::remove_if(owned_pages_.begin(), owned_pages_.end(),
+                                    [&](const OwnedPage& p) { return p.frame + 2 <= frame_; }),
+                     owned_pages_.end());
+  if (owned_pages_.size() != before) command_processor_.NativeOwnedPagesChanged();
+  OwnedRefreshList();  // (the list for the next frame)
+}
+
+void NativeRenderer::OwnedDestroy() {
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (OwnedViewEntry& v : owned_views_) ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, v.view);
+  owned_views_.clear();
+  for (OwnedImage& o : owned_images_) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device, o.framebuffer);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, o.view);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, o.depth_view);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device, o.image);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device, o.depth);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, o.memory);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, o.depth_memory);
+  }
+  owned_images_.clear();
+  owned_pages_.clear();
+  for (VkRenderPass& rp : owned_render_pass_) ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyRenderPass, device, rp);
+  for (VkRenderPass& rp : owned_render_pass_clear_) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyRenderPass, device, rp);
+  }
+}
