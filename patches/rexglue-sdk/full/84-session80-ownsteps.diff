+// wwe2k14 patch (Session 80, OWN_RENDERER_PLAN.md "The shadows" step 2; gpu_native_own_steps). Owned steps: a pass of
+// the 360's frame whose output is only ever read through its copy, drawn into an exact-size image of ours instead of
+// the truth images. On the console such a draw goes into an EDRAM surface laid out in 80-pixel tiles (a 256x256
+// blur into a 320-wide surface whose tiles another surface's pixels alias), then a resolve copies the rectangle into a
+// texture in guest memory; NATIVE's truth frame emulates all of that exactly (the surface's tiles alias-loaded, its
+// pass stored, the copy run as a compute batch into the texture). For a listed pixel shader here, the draw - the
+// game's own pipeline and bindings, its interpolation and our pixel shader as before - is recorded into our image in a
+// render pass of its own (colour not loaded: the draw covers it all; stored; left readable), the copy that follows is
+// left out, and every draw that samples the copy's texture page is given our image's view (the texture's memory and
+// its own image are never written while the page is ours). The EDRAM tiles keep what they had, as
+// gpu_shadow_half_rate leaves them when it skips a map. Map of the hooks: docs\native\OWNED_STEPS_MAP.md (game repo).
+
+#include <rex/graphics/vulkan/native/native_renderer.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+#include <rex/cvar.h>
+#include <rex/graphics/vulkan/command_processor.h>
+#include <rex/logging.h>
+#include <rex/ui/vulkan/util.h>
+
+REXCVAR_DEFINE_STRING(gpu_native_own_steps, "", "GPU/Native",
+                      "Session 80 (OWN_RENDERER_PLAN.md \"The shadows\"): guest pixel shaders (hex hashes, "
+                      "comma-separated) whose truth draws are owned steps: a draw of one (colour only into an RGBA8 "
+                      "surface, unblended, no depth or stencil, covering its rectangle from the surface's origin) is "
+                      "recorded into an exact-size image of ours, the copy of that rectangle into a texture that follows "
+                      "is left out, and the draws sampling that texture are given our image. Not in readback windows. "
+                      "Empty = off");
+REXCVAR_DEFINE_BOOL(gpu_native_own_steps_drop_clears, true, "GPU/Native",
+                    "Session 80 (with gpu_native_own_steps): an owned draw that starts from the clears of its truth pass "
+                    "turns that pass (nothing but those clears) off - our image holds what they wrote");
+REXCVAR_DEFINE_BOOL(gpu_native_own_steps_debug_replay, false, "GPU/Native",
+                    "Session 80 (diagnostic): every owned output's copy taken as not matching - the draw replayed into "
+                    "the truth images and the copy run from them, the shader still owned (the replay path's check: "
+                    "same-frame shots equal to the owned steps off)");
+
+namespace rex::graphics::vulkan::native {
+
+namespace {
+// The RGBA8 class's format (the truth and post targets' class 1: kPostTargetFormats[1]).
+constexpr VkFormat kOwnedColorFormat = VK_FORMAT_R8G8B8A8_UNORM;
+constexpr uint32_t kOwnedImagesPerSize = 4;
+}  // namespace
+
+bool NativeRenderer::OwnedWants(uint64_t pixel_shader_hash) const {
+  // (The list as copied at the last frame's end - OwnedRefreshList; a shader that lost an output is out for good.)
+  return !owned_list_.empty() &&
+         std::find(owned_list_.begin(), owned_list_.end(), pixel_shader_hash) != owned_list_.end() &&
+         std::find(owned_disabled_.begin(), owned_disabled_.end(), pixel_shader_hash) == owned_disabled_.end();
+}
+
+int16_t NativeRenderer::OwnedImageFor(uint32_t width, uint32_t height, uint32_t kind) {
+  // One not holding a page now (nor the output still waiting for its copy): a step reads the page an earlier one left
+  // in another image, and a page's image may still be sampled later in the frame.
+  uint32_t of_size = 0;
+  for (size_t i = 0; i < owned_images_.size(); ++i) {
+    const OwnedImage& o = owned_images_[i];
+    if (o.width != width || o.height != height || o.kind != kind) continue;
+    ++of_size;
+    const bool held = (owned_pending_.valid && owned_pending_.image == int16_t(i)) ||
+                      std::any_of(owned_pages_.begin(), owned_pages_.end(),
+                                  [&](const OwnedPage& p) { return p.image == int16_t(i); });
+    if (!held) return int16_t(i);
