   OnPaint();
 }
 
+// wwe2k14 Session 71 (Android, ANDROID_PLAN F10: the black screen after leaving the app and coming back). Android
+// destroys the window's ANativeWindow while the app is in the background and makes a new one on return; SDL then
+// points SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER at the new one, but nothing told the presenter, which kept presenting
+// to the old surface (VK_ERROR_SURFACE_LOST / OUT_OF_DATE: "dropped as outdated", a black screen). Background: let go
+// of the surface (the VkSurfaceKHR holds its own reference to the old window, so this is safe after it is gone).
+// Foreground: attach a surface made from the current window. SDL only resumes the app (DID_ENTER_FOREGROUND) once the
+// new surface is ready (SDLActivity.handleNativeState waits for mIsSurfaceReady), so the pointer is the new one.
+// Untested on the phone at the time of writing (Session 71 had no phone).
+void WindowSDL::HandleAndroidSurfaceEvent(bool foreground) {
+  if (phase() != Phase::kOpen) {
+    return;
+  }
+  REXLOG_INFO("WindowSDL: app {} the background: {} the presentation surface", foreground ? "left" : "went to",
+              foreground ? "re-creating" : "releasing");
+  OnSurfaceChanged(foreground);
+  if (foreground) {
+    RequestPaint();
+  }
+}
+
 void WindowSDL::HandleWindowEvent(SDL_Event& event) {
