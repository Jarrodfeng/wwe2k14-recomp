@@ -9,7 +9,10 @@
  * @modified    Tom Clay & Rien Gupta, 2026 - Adapted for ReXGlue runtime (POSIX + macOS)
  */
 
+#include <cstdlib>
 #include <memory>
+#include <string>
+#include <string_view>
 
 #include <fcntl.h>
 #include <sys/mman.h>
@@ -114,7 +117,19 @@ std::unique_ptr<MappedMemory> MappedMemory::Open(const std::filesystem::path& pa
       open_flags |= O_RDWR;
       break;
   }
-  int file_descriptor = open(path.c_str(), open_flags);
+  int file_descriptor = -1;
+#if REX_PLATFORM_ANDROID
+  // wwe2k14 Session 71: a file the player picked with Android's file picker reaches the game as /proc/self/fd/N (the
+  // activity opened it through the content resolver). Opening that path again is refused for a file outside the app's
+  // own folder (scoped storage checks the target), so map a duplicate of the descriptor the process already holds.
+  static constexpr std::string_view kFdPrefix = "/proc/self/fd/";
+  const std::string path_string = path.string();
+  if (path_string.rfind(kFdPrefix, 0) == 0) {
+    const int held = std::atoi(path_string.c_str() + kFdPrefix.size());
+    if (held >= 0) file_descriptor = fcntl(held, F_DUPFD_CLOEXEC, 0);
+  } else
+#endif
+  file_descriptor = open(path.c_str(), open_flags);
   if (file_descriptor < 0) {
     return nullptr;
   }
