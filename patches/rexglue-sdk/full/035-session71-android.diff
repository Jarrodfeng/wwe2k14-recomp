   switch (event.type) {
diff --git a/src/ui/windowed_app_context_sdl.cpp b/src/ui/windowed_app_context_sdl.cpp
index dc0b4c2ead4c0b61a160f2f59329ccc19ee3a07a..c33d6461717b2f2b8ff76897ff37dc8e5117e1cd 100644
--- a/src/ui/windowed_app_context_sdl.cpp
+++ b/src/ui/windowed_app_context_sdl.cpp
@@ -175,6 +175,18 @@ void SDLWindowedAppContext::ProcessEvent(SDL_Event& event) {
       }
       break;
     }
+#if REX_PLATFORM_ANDROID
+    // wwe2k14 Session 71: the app's window surface goes away in the background (WindowSDL::HandleAndroidSurfaceEvent).
+    case SDL_EVENT_DID_ENTER_BACKGROUND:
+    case SDL_EVENT_DID_ENTER_FOREGROUND: {
+      std::vector<WindowSDL*> windows;
+      for (const auto& [id, window] : windows_) windows.push_back(window);
+      for (WindowSDL* window : windows) {
+        window->HandleAndroidSurfaceEvent(event.type == SDL_EVENT_DID_ENTER_FOREGROUND);
+      }
+      break;
+    }
+#endif
     default:
       break;
   }
