diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 25e86c4cb1cc89a7a9e3852d81dd785d82e5fd8d..71dd09c88bf4b28dbb4280702c3eeaad41d1c3ab 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -15671,6 +15671,140 @@ bool VulkanCommandProcessor::RepeatDrawFast(const Shader* vertex_shader, uint64_
   return true;
 }
 
+// wwe2k14 patch (Session 60, CROWD BATCH): the crowd members after their run's first draw, as more instances of it.
+// Each member is exactly what RepeatDrawFast's merge does for a repeat whose only change is the vertex float constants
+// (its c76-c78 written, the vertex float constants uploaded one stride after the run's last, one instance added to the
+// draw recorded last), without the per-draw path around it: the lean checks, the repeat comparison, the native draw
+// copy - all of them hold for every member as they held for the first (the game records nothing else between them).
+// Stops at the first member that does not fit (the 256-vec4 range, another offset or buffer, a draw recorded after);
+// the caller draws the rest through the normal path, which starts a new run.
+uint32_t VulkanCommandProcessor::AppendCrowdInstances(const uint32_t* members, uint32_t count) {
+  RepeatFastStats& stats = repeat_fast_stats_;
+  ConstantsDynamicOffsets* const constants_dynamic = constants_dynamic_offsets_.get();
+  RepeatPrev& prev = repeat_prev_;
+  // (Why a run was not batched, the first few times: a reason code.)
+  auto refuse = [this](uint32_t reason) -> uint32_t {
+    if (crowd_batch_refusals_logged_ < 12) {
+      ++crowd_batch_refusals_logged_;
+      REXGPU_INFO("[scene][crowd] batch refused at frame {}: reason {}", frame_current_, reason);
+    }
+    return 0;
+  };
+  if (!count) return 0;
+  if (!REXCVAR_GET(vulkan_repeat_draw_fast) || !REXCVAR_GET(vulkan_repeat_draw_merge)) return refuse(1);
+  if (!prev.valid) return refuse(2);
+  if (!prev.merge_stride) return refuse(3);
+  if (!prev.run_instances) return refuse(4);
+  if (!constants_dynamic || REXCVAR_GET(vulkan_constants_dynamic_offsets_per_draw_sets) ||
+      REXCVAR_GET(vulkan_constants_dynamic_offsets_verify) || anatomy_active_ || gpu_marks_active_ ||
+      recstats_frames_ > 0 || skip_frame_draws_ || (crash_checkpoints_enabled() && !prev.crash_valid)) {
+    return refuse(5);
+  }
+  if (!current_guest_graphics_pipeline_layout_ || current_guest_graphics_pipeline_ != prev.pipeline ||
+      current_external_graphics_pipeline_ != VK_NULL_HANDLE) {
+    return refuse(6);
+  }
+  const auto* vertex_shader = static_cast<const VulkanShader*>(active_vertex_shader());
+  if (!vertex_shader || vertex_shader != prev.vertex_shader ||
+      vertex_shader->constant_register_map().float_count != prev.float_count) {
+    return refuse(7);
+  }
+  constexpr uint32_t kAllConstantBuffersMask = (UINT32_C(1) << SpirvShaderTranslator::kConstantBufferCount) - 1;
+  constexpr uint32_t kVertexFloatBit = UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatVertex;
+  constexpr uint32_t kConstantsSetBit = UINT32_C(1) << SpirvShaderTranslator::kDescriptorSetConstants;
+  if ((current_constant_buffers_up_to_date_ | kVertexFloatBit) != kAllConstantBuffersMask) return refuse(8);
+  // The run's draw is the truth draw recorded last (a native frame), or a host draw (AddInstanceToLastDraw checks that
+  // nothing was recorded after it).
+  const bool native_replacing = native_ && native_->enabled() && native_->replacing();
+  native::Draw* truth_base = nullptr;
+  if (native_replacing) {
+    if (!native_repeat_draw_valid_ || !native_repeat_draw_ || !native_repeat_draw_->owned ||
+        !native_repeat_draw_->truth || native_repeat_draw_->pipeline == VK_NULL_HANDLE) {
+      return refuse(9);
+    }
+    truth_base = native_repeat_draw_.get();
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const size_t uniform_buffer_alignment = size_t(vulkan_device->properties().minUniformBufferOffsetAlignment);
+  const size_t float_constants_size = sizeof(float) * 4 * std::max(prev.float_count, UINT32_C(1));
+  uint32_t* const regs = register_file_->values;
+  constexpr uint32_t kCrowdRegister = XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * 76;  // c76-c78
+  VkDescriptorBufferInfo& buffer_info =
+      current_constant_buffer_infos_[SpirvShaderTranslator::kConstantBufferFloatVertex];
+  uint32_t done = 0, stop = 0;
+  for (; done < count; ++done) {
+    const uint32_t n = prev.run_instances;
+    if (n * prev.merge_stride + prev.float_count > 256 ||
+        current_graphics_descriptor_sets_[SpirvShaderTranslator::kDescriptorSetConstants] != prev.run_set ||
+        (truth_base && !native_->TruthLastDrawRecorded())) {
+      stop = n * prev.merge_stride + prev.float_count > 256 ? 10 : truth_base && !native_->TruthLastDrawRecorded() ? 12 : 11;
+      break;
+    }
+    std::memcpy(regs + kCrowdRegister, members + 12 * size_t(done), 12 * sizeof(uint32_t));
+    // The vertex float constants, as RepeatDrawFast uploads them.
+    current_constant_buffers_up_to_date_ &= ~kVertexFloatBit;
+    uint8_t* mapping = uniform_buffer_pool_->Request(frame_current_, float_constants_size, uniform_buffer_alignment,
+                                                     buffer_info.buffer, buffer_info.offset);
+    if (!mapping) {
+      stop = 13;
+      break;
+    }
+    constants_dynamic->mappings[SpirvShaderTranslator::kConstantBufferFloatVertex] = mapping;
+    buffer_info.range = VkDeviceSize(float_constants_size);
+    uint8_t* const float_pool_mapping = mapping;
+    uint8_t* const float_shadow = constants_dynamic->shadow[SpirvShaderTranslator::kConstantBufferFloatVertex];
+    if (float_shadow) mapping = float_shadow;
+    if (REXCVAR_GET(vulkan_float_constant_runs)) {
+      GatherFloatConstantRuns(mapping, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X], current_float_constant_map_vertex_);
+    } else {
+      for (uint32_t i = 0; i < 4; ++i) {
+        uint64_t float_constant_map_entry = current_float_constant_map_vertex_[i];
+        uint32_t float_constant_index;
+        while (bit_inline::bit_scan_forward(float_constant_map_entry, &float_constant_index)) {
+          float_constant_map_entry &= ~(1ull << float_constant_index);
+          std::memcpy(mapping, &regs[XE_GPU_REG_SHADER_CONSTANT_000_X + (i << 8) + (float_constant_index << 2)],
+                      sizeof(float) * 4);
+          mapping += sizeof(float) * 4;
+        }
+      }
+    }
+    if (float_shadow) std::memcpy(float_pool_mapping, float_shadow, float_constants_size);
+    current_constant_buffers_up_to_date_ |= kVertexFloatBit;
+    current_graphics_descriptor_set_values_up_to_date_ &= ~kConstantsSetBit;
+    if (!constants_dynamic->PrepareSet(*this, false)) {
+      current_constant_buffers_up_to_date_ &= ~kVertexFloatBit;
+      break;
+    }
+    current_graphics_descriptor_set_values_up_to_date_ |= kConstantsSetBit;
+    bool next_instance = current_graphics_descriptor_sets_[SpirvShaderTranslator::kDescriptorSetConstants] ==
+                         prev.run_set;
+    for (uint32_t i = 0; next_instance && i < ConstantsDynamicOffsets::kBufferCount; ++i) {
+      uint32_t expected = prev.run_offsets[i];
+      if (i == SpirvShaderTranslator::kConstantBufferFloatVertex) expected += n * prev.merge_stride * 16;
+      next_instance = constants_dynamic->dynamic_offsets[i] == expected;
+    }
+    // (A truth draw's instance is claimed as the repeat path claims it: the same images and pipeline as the run's.)
+    if (!next_instance || (truth_base && !native_->ClaimTruthLean(*truth_base)) ||
+        !deferred_command_buffer_.AddInstanceToLastDraw(prev.host_indexed)) {
+      // Not this run's next instance: the normal path uploads again and starts a new run.
+      stop = !next_instance ? 14 : (truth_base && truth_base->truth_epoch == 0) ? 15 : 16;
+      current_constant_buffers_up_to_date_ &= ~kVertexFloatBit;
+      break;
+    }
+    ++prev.run_instances;
+    current_graphics_descriptor_sets_bound_up_to_date_ &= ~kConstantsSetBit;
+    ++stats.fast;
+    ++stats.merged;
+    if (truth_base) native_->NoteTruthInstance();
+    prev.sets_bound = current_graphics_descriptor_sets_bound_up_to_date_;
+  }
+  // The registers as the members' own records would have left them: the last member drawn here. (The normal path
+  // writes the remaining members' constants itself.) Nothing is dirty for the draw recorded last.
+  if (done) repeat_dirty_ = 0;
+  if (!done && stop) refuse(stop);
+  return done;
+}
