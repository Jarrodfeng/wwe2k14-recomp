+/**
+ * @file        rex/input/mnk/bind_match.h
+ * @brief       Keyboard bind string matching (pure, header-only: no SDL, no cvars, so a host test includes it).
+ *
+ * wwe2k14 patch (Session 103, bare modifiers; Jarrod: players cannot use Shift, Alt or Ctrl in the keyboard controls).
+ *
+ * A bind value is a comma-separated list of alternatives, each optionally carrying modifier prefixes: "Q,I" or
+ * "Shift+W". Modifier matching is exact ("Up" stays silent while Shift is held, "Shift+Up" stays silent without it:
+ * that is what lets the D-pad share the arrow keys), EXCEPT for a modifier the player bound as a button on its own
+ * (a bare "Shift", "Control" or "Alt" token in any keybind_*): that modifier is a button then, so it fires its own
+ * bind, no longer picks which chord matches, and a chord that uses it ("Shift+Up") still needs it held. With no bare
+ * modifier bound (bare_mods == 0) the rule is exactly the old exact-modifier rule.
+ */
+#pragma once
+
+#include <rex/ui/virtual_key.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <string_view>
+
+namespace rex::ui {
+VirtualKey ParseVirtualKey(std::string_view name);  // rex/ui/keybinds.h
+}
+
+namespace rex::input::mnk {
+
+constexpr uint8_t kModShift = 1u << 0;
+constexpr uint8_t kModCtrl = 1u << 1;
+constexpr uint8_t kModAlt = 1u << 2;
+
+inline uint8_t LiveModifiers(const bool (&key_down)[256]) {
+  uint8_t mods = 0;
+  if (key_down[static_cast<uint16_t>(rex::ui::VirtualKey::kShift)])
+    mods |= kModShift;
+  if (key_down[static_cast<uint16_t>(rex::ui::VirtualKey::kControl)])
+    mods |= kModCtrl;
+  if (key_down[static_cast<uint16_t>(rex::ui::VirtualKey::kMenu)])
+    mods |= kModAlt;
+  return mods;
+}
+
+// Strips leading modifier prefixes off 'token', advancing it to the bare key
+// name and returning the mask they require.
+inline uint8_t TakeModifiers(std::string_view& token) {
+  uint8_t mods = 0;
+  for (;;) {
+    size_t plus = token.find('+');
+    if (plus == std::string_view::npos || plus == 0) {
+      break;
+    }
+    std::string_view head = token.substr(0, plus);
+    uint8_t bit = 0;
+    if (head == "Shift") {
+      bit = kModShift;
+    } else if (head == "Ctrl" || head == "Control") {
+      bit = kModCtrl;
+    } else if (head == "Alt") {
+      bit = kModAlt;
+    } else {
+      break;
+    }
+    mods |= bit;
+    token.remove_prefix(plus + 1);
+  }
+  return mods;
+}
+
+inline std::string_view TrimSpaces(std::string_view s) {
+  while (!s.empty() && s.front() == ' ') {
+    s.remove_prefix(1);
+  }
+  while (!s.empty() && s.back() == ' ') {
+    s.remove_suffix(1);
+  }
+  return s;
+}
+
+// The modifier bit when 'vk' is Shift / Control / Alt, else 0.
+inline uint8_t ModifierBit(rex::ui::VirtualKey vk) {
+  switch (vk) {
+    case rex::ui::VirtualKey::kShift:
+      return kModShift;
+    case rex::ui::VirtualKey::kControl:
+      return kModCtrl;
+    case rex::ui::VirtualKey::kMenu:
+      return kModAlt;
+    default:
+      return 0;
+  }
+}
+
+// The modifiers bound as a button: those that appear as a bare token (no prefix) in any alternative of 'binds'.
+inline uint8_t BareModifierMask(std::initializer_list<std::string_view> binds) {
+  uint8_t bare = 0;
+  for (std::string_view rest : binds) {
+    while (!rest.empty()) {
+      const size_t comma = rest.find(',');
+      std::string_view token = TrimSpaces(rest.substr(0, comma));
+      rest = comma == std::string_view::npos ? std::string_view() : rest.substr(comma + 1);
+      if (token.empty() || TakeModifiers(token) != 0) {
+        continue;
+      }
+      bare |= ModifierBit(rex::ui::ParseVirtualKey(token));
+    }
+  }
+  return bare;
+}
+
+// 'bare_mods': the BareModifierMask of all binds (0 = the exact-modifier rule of old).
+inline bool TokenPressed(const bool (&key_down)[256], std::string_view token, uint8_t live_mods,
+                         uint8_t bare_mods = 0) {
+  const uint8_t want = TakeModifiers(token);
+  const rex::ui::VirtualKey vk = rex::ui::ParseVirtualKey(token);
+  if (vk == rex::ui::VirtualKey::kNone) {
+    return false;
+  }
+  const uint16_t idx = static_cast<uint16_t>(vk);
+  if (want == 0 && ModifierBit(vk) != 0) {
+    return idx < 256 && key_down[idx];  // a modifier as a button of its own
+  }
+  if ((want & ~bare_mods) != (live_mods & ~bare_mods)) {
+    return false;  // modifiers bound as buttons do not pick the chord
+  }
+  if ((want & bare_mods & ~live_mods) != 0) {
+    return false;  // a chord that uses a button-modifier still needs it held
+  }
+  return idx < 256 && key_down[idx];
+}
+
+// True when any alternative of 'cvar_val' is pressed.
+inline bool IsBindPressed(const bool (&key_down)[256], uint8_t bare_mods, std::string_view cvar_val) {
+  const uint8_t live_mods = LiveModifiers(key_down);
+  std::string_view rest(cvar_val);
+  while (!rest.empty()) {
+    size_t comma = rest.find(',');
+    std::string_view token = rest.substr(0, comma);
+    if (comma == std::string_view::npos) {
+      rest = std::string_view();
+    } else {
+      rest.remove_prefix(comma + 1);
+    }
+    token = TrimSpaces(token);
+    if (!token.empty() && TokenPressed(key_down, token, live_mods, bare_mods)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace rex::input::mnk
