+bool VulkanCommandProcessor::NativeBoundsRect(xenos::PrimitiveType prim_type, const VulkanShader& vertex_shader,
+                                              uint32_t index_count, const IndexBufferInfo* index_buffer_info,
+                                              int32_t rect[4]) {
+  const auto t0 = std::chrono::steady_clock::now();
+  const auto done = [&](uint32_t outcome, bool ok) {
+    if (!ok) std::fill(rect, rect + 4, 0);
+    native_->TruthNoteBounds(
+        outcome, std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count());
+    return ok;
+  };
+  const RegisterFile& regs = *register_file_;
+  using PT = xenos::PrimitiveType;
+  if (prim_type != PT::kTriangleList && prim_type != PT::kTriangleStrip && prim_type != PT::kTriangleFan &&
+      prim_type != PT::kQuadList) {
+    return done(2, false);
+  }
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  const auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  const auto initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  const bool indexed = initiator.source_select == xenos::SourceSelect::kDMA;
+  if (window_offset.window_x_offset || window_offset.window_y_offset ||
+      !ShaderInterpreter::CanInterpretShader(vertex_shader) || !vertex_shader.cf_memexport_info().empty() ||
+      !index_count || index_count > 8192 || (!indexed && initiator.source_select != xenos::SourceSelect::kAutoIndex) ||
+      (indexed && (!index_buffer_info || index_buffer_info->count < index_count))) {
+    return done(2, false);
+  }
+  // The inputs: the shader, the registers that place a vertex, every constant (float, bool / loop, fetch), the bytes of
+  // the vertex buffers it fetches and of the index buffer.
+  const uint32_t index_size = indexed && index_buffer_info->format == xenos::IndexFormat::kInt32 ? 4u : 2u;
+  const uint32_t key_regs[] = {
+      uint32_t(prim_type), index_count, indexed ? index_buffer_info->guest_base : 0u,
+      indexed ? uint32_t(index_buffer_info->format) : 0u, indexed ? uint32_t(index_buffer_info->endianness) : 0u,
+      regs[XE_GPU_REG_VGT_INDX_OFFSET], regs[XE_GPU_REG_VGT_MIN_VTX_INDX], regs[XE_GPU_REG_VGT_MAX_VTX_INDX],
+      regs[XE_GPU_REG_VGT_MULTI_PRIM_IB_RESET_INDX], regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL],
+      regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_PA_CL_VPORT_XSCALE], regs[XE_GPU_REG_PA_CL_VPORT_XOFFSET],
+      regs[XE_GPU_REG_PA_CL_VPORT_YSCALE], regs[XE_GPU_REG_PA_CL_VPORT_YOFFSET], regs[XE_GPU_REG_SQ_VS_CONST],
+      uint32_t(initiator.source_select)};
+  // (Each part hashed on its own, then the list of hashes.)
+  uint64_t parts[16] = {};
+  uint32_t part_count = 0;
+  parts[part_count++] = vertex_shader.ucode_data_hash();
+  parts[part_count++] = XXH3_64bits(key_regs, sizeof(key_regs));
+  parts[part_count++] = XXH3_64bits(&regs[XE_GPU_REG_SHADER_CONSTANT_000_X], sizeof(uint32_t) * 4 * 512);
+  parts[part_count++] = XXH3_64bits(
+      &regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031],
+      sizeof(uint32_t) * (XE_GPU_REG_SHADER_CONSTANT_LOOP_31 + 1 - XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031));
+  parts[part_count++] = XXH3_64bits(&regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], sizeof(uint32_t) * 6 * 32);
+  bool inputs_ok = true;
+  const Shader::ConstantRegisterMap& map = vertex_shader.constant_register_map();
+  for (uint32_t i = 0; i < 96 && inputs_ok; ++i) {
+    if (!(map.vertex_fetch_bitmap[i >> 5] & (uint32_t(1) << (i & 31)))) continue;
+    const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(i);
+    const uint32_t address = (uint32_t(fetch.address) << 2) & 0x1FFFFFFFu, bytes = uint32_t(fetch.size) << 2;
+    // (At most 8 vertex buffers and 1 MB each.)
+    inputs_ok = part_count < 15 && bytes <= (1u << 20) && uint64_t(address) + bytes <= 0x20000000u;
+    if (inputs_ok) parts[part_count++] = bytes ? XXH3_64bits(memory_->TranslatePhysical(address), bytes) : 0;
+  }
+  if (inputs_ok && indexed) {
+    const uint32_t address = index_buffer_info->guest_base & 0x1FFFFFFFu, bytes = index_count * index_size;
+    inputs_ok = part_count < 16 && uint64_t(address) + bytes <= 0x20000000u;
+    if (inputs_ok) parts[part_count++] = XXH3_64bits(memory_->TranslatePhysical(address), bytes);
+  }
+  if (!inputs_ok) return done(2, false);
+  const uint64_t key = XXH3_64bits(parts, sizeof(uint64_t) * part_count) | 1;  // (0: an empty entry)
+  for (const NativeBoundsEntry& e : native_bounds_cache_) {
+    if (e.key == key) {
+      std::copy(e.rect, e.rect + 4, rect);
+      return done(e.ok ? 1 : 2, e.ok);
+    }
+  }
+  // The vertices the draw uses, as the vertex grouper gives them to the shader (offset, masked, clamped). 16-bit
+  // indices with a 32-bit swap mode swap as the primitive processor makes them, and a restart index is no vertex
+  // exactly where the primitive processor resets (primitive_processor.cpp: strips and fans with multi_prim_ib_ena, a
+  // 16-bit buffer only for a reset index that fits; compared in the guest's byte order).
+  std::vector<uint32_t>& indices = native_bounds_indices_;
+  indices.clear();
+  const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t index_min = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  const uint32_t index_max = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  xenos::Endian index_endian = indexed ? index_buffer_info->endianness : xenos::Endian::kNone;
+  if (index_size == 2 && index_endian != xenos::Endian::kNone && index_endian != xenos::Endian::k8in16) {
+    index_endian = index_endian == xenos::Endian::k8in32 ? xenos::Endian::k8in16 : xenos::Endian::kNone;
+  }
+  bool reset_enabled = false;
+  uint32_t reset_guest_endian = 0;
+  if (indexed && regs.Get<reg::PA_SU_SC_MODE_CNTL>().multi_prim_ib_ena &&
+      (prim_type == PT::kTriangleStrip || prim_type == PT::kTriangleFan)) {
+    reset_guest_endian = xenos::GpuSwap(regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx, index_endian);
+    reset_enabled = index_size == 4 || reset_guest_endian <= UINT16_MAX;
+  }
+  const uint8_t* index_data =
+      indexed ? memory_->TranslatePhysical<const uint8_t*>(index_buffer_info->guest_base & 0x1FFFFFFFu) : nullptr;
+  for (uint32_t i = 0; i < index_count; ++i) {
+    uint32_t raw = i;
+    if (indexed) {
+      if (index_size == 4) {
+        uint32_t v;
+        std::memcpy(&v, index_data + size_t(i) * 4, 4);
+        if (reset_enabled && v == reset_guest_endian) continue;
+        raw = xenos::GpuSwap(v, index_endian);
+      } else {
+        uint16_t v;
+        std::memcpy(&v, index_data + size_t(i) * 2, 2);
+        if (reset_enabled && v == reset_guest_endian) continue;
+        raw = xenos::GpuSwap(v, index_endian);
+      }
+    }
+    indices.push_back(std::min(std::max((raw + index_offset) & xenos::kVertexIndexMask, index_min), index_max));
+  }
+  std::sort(indices.begin(), indices.end());
+  indices.erase(std::unique(indices.begin(), indices.end()), indices.end());
+  bool ok = !indices.empty() && indices.size() <= 2048;
+  double min_x = DBL_MAX, max_x = -DBL_MAX, min_y = DBL_MAX, max_y = -DBL_MAX;
+  if (ok) {
+    if (!rename_interpreter_) rename_interpreter_ = std::make_unique<ShaderInterpreter>(regs, *memory_);
+    struct PositionSink : ShaderInterpreter::ExportSink {
+      void Export(ucode::ExportRegister export_register, const float* value, uint32_t value_mask) override {
+        if (export_register != ucode::ExportRegister::kVSPosition) return;
+        for (uint32_t i = 0; i < 4; ++i) {
+          if (value_mask & (1u << i)) position[i] = value[i];
+        }
+        written |= value_mask;
+      }
+      float position[4] = {};
+      uint32_t written = 0;
+    } sink;
+    ShaderInterpreter& interpreter = *rename_interpreter_;
+    interpreter.SetShader(xenos::ShaderType::kVertex, vertex_shader.ucode_dwords());
+    interpreter.SetExportSink(&sink);
+    const double scale_x = vte.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0;
+    const double scale_y = vte.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0;
+    const double offset_x = vte.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0;
+    const double offset_y = vte.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0;
+    interpreter.reset_fetches_out_of_range();
+    for (const uint32_t index : indices) {
+      std::memset(interpreter.temp_registers(), 0, sizeof(float) * 4 * xenos::kMaxShaderTempRegisters);
+      interpreter.temp_registers()[0] = float(index);
+      sink.written = 0;
+      interpreter.Execute();
+      // As the translated shader (spirv_translator.cpp): the host's W is the exported w with VTX_W0_FMT, else 1 / w;
+      // its screen xy is the exported xy with VTX_XY_FMT (already divided), else xy / W. Every W above 0 - then the
+      // rasterized pixels lie inside the box of the projected vertices (clipping only takes away).
+      const double w_host = vte.vtx_w0_fmt ? double(sink.position[3]) : 1.0 / double(sink.position[3]);
+      ok = (sink.written & 0b1011) == 0b1011 && w_host > 0.0 && std::isfinite(w_host) &&
+           std::isfinite(sink.position[0]) && std::isfinite(sink.position[1]);
+      if (!ok) break;
+      const double w = vte.vtx_xy_fmt ? 1.0 : w_host;
+      const double px = double(sink.position[0]) / w * scale_x + offset_x;
+      const double py = double(sink.position[1]) / w * scale_y + offset_y;
+      min_x = std::min(min_x, px), max_x = std::max(max_x, px);
+      min_y = std::min(min_y, py), max_y = std::max(max_y, py);
+    }
+    // (Review: a fetch outside its buffer reads 0 here but memory on the GPU - no box then.)
+    ok = ok && !interpreter.fetches_out_of_range();
+    interpreter.SetExportSink(nullptr);
+  }
+  // Widened by 2 pixels (either pixel-centre rule, the samples of a pixel, the rasterizer's snapping).
+  ok = ok && min_x >= -16384.0 && max_x <= 16384.0 && min_y >= -16384.0 && max_y <= 16384.0;
+  if (ok) {
+    rect[0] = std::max(0, int32_t(std::floor(min_x - 2.0)));
+    rect[1] = std::max(0, int32_t(std::floor(min_y - 2.0)));
+    rect[2] = std::max(rect[0], int32_t(std::ceil(max_x + 2.0)));
+    rect[3] = std::max(rect[1], int32_t(std::ceil(max_y + 2.0)));
+    ok = rect[2] > rect[0] && rect[3] > rect[1];
+  }
+  NativeBoundsEntry& entry = native_bounds_cache_[native_bounds_next_];
+  native_bounds_next_ = (native_bounds_next_ + 1) % uint32_t(native_bounds_cache_.size());
+  entry.key = key;
+  entry.ok = ok;
+  if (ok) {
+    std::copy(rect, rect + 4, entry.rect);
+  } else {
+    std::fill(std::begin(entry.rect), std::end(entry.rect), 0);
+  }
+  return done(ok ? 0 : 2, ok);
+}
