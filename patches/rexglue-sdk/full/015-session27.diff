                       "DLAA / DLSS (Session 24): no jitter on frames after the camera moved more than this many render "
                       "pixels in a frame (estimated over the screen at view depths 300 and 2000): fast camera shots "
@@ -5080,6 +5083,12 @@ void VulkanCommandProcessor::DlssRecord(VkImageView guest_output_view, uint32_t
     f.out_width = out_width, f.out_height = out_height;
     reset = pending.reset || angle > REXCVAR_GET(gpu_dlaa_reset_degrees) ||
             dlss_last_eval_frame_ + 1 != pending.frame;
+    // wwe2k14 patch (Session 27): a camera cut is seen 2-3 frames before the picture changes (replay s21_lb, runs
+    // 1971-1975: the first frame of the new shot still blended the old one); keep resetting for
+    // gpu_dlss_reset_hold_frames frames after a cut so the frame that really cuts has no old history.
+    if (reset)
+      dlss_reset_hold_ = std::max(dlss_reset_hold_, std::clamp(REXCVAR_GET(gpu_dlss_reset_hold_frames), 1, 16));
+    if (dlss_reset_hold_ > 0) reset = true, --dlss_reset_hold_;
     f.reset = reset;
     cb.CmdHostCallback(&DlssEvaluateCallback, &f, sizeof(f));
     current_external_compute_pipeline_ = VK_NULL_HANDLE;  // Streamline bound its own compute state
