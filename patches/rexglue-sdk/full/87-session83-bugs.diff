+// wwe2k14 patch (Session 83): the newest press (key_press_seq_) among a bind's keys that are down now; 0 = none.
+uint32_t BindPressSeq(const bool (&key_down)[256], const uint32_t (&seq)[256], std::string_view rest) {
+  uint32_t newest = 0;
+  while (!rest.empty()) {
+    const size_t comma = rest.find(',');
+    std::string_view token = TrimSpaces(rest.substr(0, comma));
+    rest = comma == std::string_view::npos ? std::string_view() : rest.substr(comma + 1);
+    TakeModifiers(token);
+    const auto idx = static_cast<uint16_t>(rex::ui::ParseVirtualKey(token));
+    if (idx != 0 && idx < 256 && key_down[idx]) newest = std::max(newest, seq[idx]);
+  }
+  return newest;
+}
