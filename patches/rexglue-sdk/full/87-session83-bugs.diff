+// wwe2k14 patch (Session 83, WIDE): one of gpu_wide_post_vs (parsed again only when the setting changes).
+bool VulkanCommandProcessor::IsWidePostVs(uint64_t vs_hash) {
+  const std::string text = REXCVAR_GET(gpu_wide_post_vs);
+  if (text != wide_post_vs_text_) {
+    wide_post_vs_text_ = text;
+    wide_post_vs_.clear();
+    for (size_t pos = 0; pos < text.size();) {
+      const size_t comma = std::min(text.find(',', pos), text.size());
+      if (const uint64_t h = std::strtoull(text.substr(pos, comma - pos).c_str(), nullptr, 16)) wide_post_vs_.push_back(h);
+      pos = comma + 1;
+    }
+  }
+  return std::find(wide_post_vs_.begin(), wide_post_vs_.end(), vs_hash) != wide_post_vs_.end();
+}
