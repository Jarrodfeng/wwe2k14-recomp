+      hit = r.complete;
+      if (!hit) ++t.misses;
+      return &r;
+    }
+  }
+  DrawRec& v = set[0].frame <= set[1].frame ? set[0] : set[1];
+  v.key = key;
+  v.vs = in.vs;
+  v.ps = in.ps;
+  v.dma_base = in.dma_base;
+  v.initiator = in.initiator;
+  v.frame = frame;
+  v.complete = false;
+  ++t.misses;
+  return &v;
+}
