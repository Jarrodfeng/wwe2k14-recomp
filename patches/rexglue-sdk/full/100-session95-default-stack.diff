+/**
+ * @file        perf/gpu_gap.h
+ * @brief       What the GPU does between two frames (wwe2k14 patch, Session 95, item T)
+ *
+ * Measurement only (present_gpu_gap_stats, default off). The command processor hands in the timestamps of each of its
+ * submissions and the Vulkan presenter those of each paint: one queue, one timestamp clock, so the time between
+ * them is read on the GPU's own timeline, with no CPU wake-up in it. Every 600 frames one [pace][gpu-gap] line.
+ * A separate header so that the headers the game exe includes stay unchanged. Defined in perf/gpu_gap.cpp (rexruntime).
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::perf::gpu_gap {
+
+bool Enabled();
+// From the presenter, once: ns per timestamp tick and the mask of the valid bits. Nothing is reported before it.
+void SetTicks(double ns_per_tick, uint64_t tick_mask);
+// A command processor submission / a presenter paint that has completed, in raw timestamp ticks. Any thread, any order.
+void NoteSubmission(uint64_t begin_tick, uint64_t end_tick, bool is_swap);
+void NotePaint(uint64_t begin_tick, uint64_t end_tick);
+
+}  // namespace rex::perf::gpu_gap
diff --git a/include/rex/perf/hang_beats.h b/include/rex/perf/hang_beats.h
new file mode 100644
index 0000000000000000000000000000000000000000..aef843212eb79dd5fbab9ff938e19e98545effb2
--- /dev/null
+++ b/include/rex/perf/hang_beats.h
@@ -0,0 +1,46 @@
+/**
+ * @file        rex/perf/hang_beats.h
+ * @brief       Signs of life from the threads a freeze stops (wwe2k14 Session 95, piece HANG)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The GPU side bumps these; the game's guard thread (src/hang_guard.h in the wwe2k14 repository) reads them once a second
+ * and names which side of a freeze stopped. A getter from one library, never an inline variable: each shared library would
+ * get its own copy. Cheap: relaxed atomics.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::perf::hang_beats {
+
+// wwe2k14_test_hang: where a test stops a thread for good (the guest side stops in the game's own code).
+enum TestSide : uint32_t { kTestNone = 0, kTestPaint = 1, kTestFence = 2 };
+
+struct Beats {
+  std::atomic<uint64_t> command{0};           // the command thread went round its loop (busy or idle)
+  std::atomic<uint64_t> paints{0};            // a paint started
+  std::atomic<uint64_t> presents{0};          // vkQueuePresentKHR accepted a picture
+  std::atomic<uint64_t> fence_steps{0};       // a fence wait timed out one more 1 s step
+  std::atomic<uint64_t> acquire_timeouts{0};  // Android: the bounded acquire gave up, that present was skipped
+  std::atomic<uint32_t> in_paint{0};          // a thread is inside the paint now
+  std::atomic<uint32_t> test_side{kTestNone};
+  std::atomic<uint64_t> vk_used_mb{0};        // device-local heaps, from the last read (VK_EXT_memory_budget); 0 = none
+  std::atomic<uint64_t> vk_budget_mb{0};
+  std::atomic<bool> want_budget{false};       // the guard is on: read the budget every pass, not only for the [s58] line
+};
+
+Beats& Get();
+
+// For a beat with one writer: no read-modify-write instruction.
+inline void Beat(std::atomic<uint64_t>& beat) {
+  beat.store(beat.load(std::memory_order_relaxed) + 1, std::memory_order_relaxed);
+}
+
+// Test only: returns at once unless wwe2k14_test_hang chose this side, then never (a fence test still counts its steps).
+void TestBlock(TestSide side);
+
+}  // namespace rex::perf::hang_beats
diff --git a/include/rex/system/xmemory.h b/include/rex/system/xmemory.h
index 9766478e59ed21d20e90a2a1f9a8d33addb494fd..1b8c90e8e88ad84585f036dd1872ff082aee47dd 100644
--- a/include/rex/system/xmemory.h
+++ b/include/rex/system/xmemory.h
@@ -28,18 +28,19 @@ class ByteStream;
 
 namespace rex::memory::detail {
 
-/// Compensates for host allocation granularity coarser than 4KB on the 0xE0
-/// physical heap. When the granularity exceeds 0x1000, the backing file maps the
-/// 0xE0 heap at a 0x1000-byte offset that the mapping API rounds away (Windows
-/// MapViewOfFileEx rounds down to 64KB; macOS arm64 uses 16KB pages), so guest
-/// accesses must add it back. This must agree with Memory::MapViews, which only
-/// sets host_address_offset when allocation_granularity() > 0x1000:
-///   - Windows:        64KB granularity  -> offset
-///   - macOS arm64:    16KB granularity  -> offset
-///   - macOS x86_64:    4KB granularity  -> no offset
-///   - Linux (any):     4KB granularity  -> no offset (mmap handles it natively)
+/// Compensates for a host that cannot map the 0xE0 physical heap at its 0x1000
+/// file offset (macOS arm64: 16KB pages), so guest accesses must add it back.
+/// This must agree with PhysicalHeap::Initialize, which only sets
+/// host_address_offset when view_offset_granularity() > 0x1000, and with the
+/// codegen's REX_PHYS_HOST_OFFSET (resources/templates/codegen/pch_h.inja):
+///   - Windows:         4KB view offsets -> no offset (wwe2k14 patch, Session 95: a
+///                      placeholder view, MapFileView; the check was 21% of the
+///                      executed guest instructions)
+///   - macOS arm64:    16KB pages        -> offset
+///   - macOS x86_64:    4KB              -> no offset
+///   - Linux (any):     4KB              -> no offset (mmap handles it natively)
 constexpr u32 PhysicalHostOffset([[maybe_unused]] u32 guest_addr) noexcept {
-#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && defined(__aarch64__))
+#if REX_PLATFORM_MAC && defined(__aarch64__)
   return (guest_addr >= 0xE0000000u) ? 0x1000u : 0u;
 #else
   return 0u;
