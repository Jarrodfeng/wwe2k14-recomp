+    const uint64_t bit = uint64_t(1) << (page & 63);
+    if (word & bit) {
+      word &= ~bit;
+      if (h.streak[page] < 255) ++h.streak[page];
+      if (h.streak[page] == 2) ++h.streak2;
+      if (h.streak[page] >= need && !(h.tex[page >> 6] & bit)) {
+        h.hot[page >> 6] |= bit;
+        h.streak[page] = 0;
+        ++h.became_hot;
+        ++h.hot_now;
+        h.any_hot = true;
+        continue;
+      }
+      h.active[keep++] = page;
+    } else {
