+SkinOnce::SkinOnce(VulkanCommandProcessor& cp) : cp_(cp) {}
+
+SkinOnce::~SkinOnce() {
+  const ui::vulkan::VulkanDevice* device = cp_.GetVulkanDevice();
+  if (!device) return;
+  const ui::vulkan::VulkanDevice::Functions& dfn = device->functions();
+  const VkDevice d = device->device();
+  if (pipeline_) dfn.vkDestroyPipeline(d, pipeline_, nullptr);
+  if (module_) dfn.vkDestroyShaderModule(d, module_, nullptr);
+  if (pool_) dfn.vkDestroyDescriptorPool(d, pool_, nullptr);
+  if (pipeline_layout_) dfn.vkDestroyPipelineLayout(d, pipeline_layout_, nullptr);
+  if (set_layout_) dfn.vkDestroyDescriptorSetLayout(d, set_layout_, nullptr);
+  if (params_map_) dfn.vkUnmapMemory(d, params_memory_);
+  if (params_buffer_) dfn.vkDestroyBuffer(d, params_buffer_, nullptr);
+  if (params_memory_) dfn.vkFreeMemory(d, params_memory_, nullptr);
+  if (out_buffer_) dfn.vkDestroyBuffer(d, out_buffer_, nullptr);
+  if (out_memory_) dfn.vkFreeMemory(d, out_memory_, nullptr);
+}
+
+bool SkinOnce::EnsureInit(VkBuffer mirror_buffer) {
+  if (ready_) return true;
+  if (init_failed_) return false;
+  init_failed_ = true;
+  const ui::vulkan::VulkanDevice* device = cp_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = device->functions();
+  const VkDevice d = device->device();
+  size_t word_count = 0;
+  const uint32_t* words = shader_swap::SkinOnceCompute(&word_count);
+  if (!words) {
+    REXGPU_WARN("[skin1] no compute shader registered: skin once stays off");
+    return false;
+  }
+  const VkDeviceSize out_bytes = VkDeviceSize(kOutVertices) * 48, params_bytes = VkDeviceSize(kSlots) * kSlotRows * 16;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(device, out_bytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+                                                         out_buffer_, out_memory_) ||
+      !ui::vulkan::util::CreateDedicatedAllocationBuffer(device, params_bytes, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, ui::vulkan::util::MemoryPurpose::kUpload, params_buffer_, params_memory_)) {
+    REXGPU_WARN("[skin1] the buffers could not be made: skin once stays off");
+    return false;
+  }
+  void* mapped = nullptr;
+  if (dfn.vkMapMemory(d, params_memory_, 0, VK_WHOLE_SIZE, 0, &mapped) != VK_SUCCESS) return false;
+  params_map_ = static_cast<uint32_t*>(mapped);
+
+  VkDescriptorSetLayoutBinding bindings[4] = {};
+  for (uint32_t i = 0; i < 4; ++i) {
+    bindings[i].binding = i;
+    bindings[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    bindings[i].descriptorCount = 1;
+    bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  }
+  VkDescriptorSetLayoutCreateInfo set_info = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+  set_info.bindingCount = 4;
+  set_info.pBindings = bindings;
+  if (dfn.vkCreateDescriptorSetLayout(d, &set_info, nullptr, &set_layout_) != VK_SUCCESS) return false;
+  VkPushConstantRange push = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 4};
+  VkPipelineLayoutCreateInfo layout_info = {VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+  layout_info.setLayoutCount = 1;
+  layout_info.pSetLayouts = &set_layout_;
+  layout_info.pushConstantRangeCount = 1;
+  layout_info.pPushConstantRanges = &push;
+  if (dfn.vkCreatePipelineLayout(d, &layout_info, nullptr, &pipeline_layout_) != VK_SUCCESS) return false;
+  VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 4};
+  VkDescriptorPoolCreateInfo pool_info = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+  pool_info.maxSets = 1;
+  pool_info.poolSizeCount = 1;
+  pool_info.pPoolSizes = &pool_size;
+  if (dfn.vkCreateDescriptorPool(d, &pool_info, nullptr, &pool_) != VK_SUCCESS) return false;
+  VkDescriptorSetAllocateInfo alloc = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+  alloc.descriptorPool = pool_;
+  alloc.descriptorSetCount = 1;
+  alloc.pSetLayouts = &set_layout_;
+  if (dfn.vkAllocateDescriptorSets(d, &alloc, &set_) != VK_SUCCESS) return false;
+  const VkDescriptorBufferInfo infos[4] = {{mirror_buffer, 0, VK_WHOLE_SIZE}, {out_buffer_, 0, VK_WHOLE_SIZE}, {params_buffer_, 0, VK_WHOLE_SIZE}, {params_buffer_, 0, VK_WHOLE_SIZE}};
+  VkWriteDescriptorSet writes[4] = {};
+  for (uint32_t i = 0; i < 4; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = set_;
+    writes[i].dstBinding = i;
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    writes[i].pBufferInfo = &infos[i];
+  }
+  dfn.vkUpdateDescriptorSets(d, 4, writes, 0, nullptr);
+  VkShaderModuleCreateInfo module_info = {VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+  module_info.codeSize = word_count * 4;
+  module_info.pCode = words;
+  if (dfn.vkCreateShaderModule(d, &module_info, nullptr, &module_) != VK_SUCCESS) return false;
+  VkComputePipelineCreateInfo pipe_info = {VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+  pipe_info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+  pipe_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+  pipe_info.stage.module = module_;
+  pipe_info.stage.pName = "main";
+  pipe_info.layout = pipeline_layout_;
+  if (dfn.vkCreateComputePipelines(d, VK_NULL_HANDLE, 1, &pipe_info, nullptr, &pipeline_) != VK_SUCCESS) {
+    REXGPU_WARN("[skin1] the compute pipeline could not be made: skin once stays off");
+    return false;
+  }
+  init_failed_ = false;
+  ready_ = true;
+  return true;
+}
+
+void SkinOnce::Tick(uint64_t frame, uint64_t submission, uint64_t completed) {
+  submission_ = submission;
+  completed_ = completed;
+  if (frame == frame_) return;
+  frame_ = frame;
+  jobs_.clear();
+  // The frame's output space is in use up to the submission now open (a job can be read by any submission of its frame).
+  for (auto it = segments_.rbegin(); it != segments_.rend() && it->submission == UINT64_MAX; ++it) it->submission = submission;
+  Summary(frame);
+}
+
+// The palette rows a vertex range needs: 3 x (its largest USED bone byte + 1), scanned once per range (a mirror entry made again has a new place, and is scanned again). A byte whose blend weight is
+// nothing does not count: run s95-skin1 001 read every byte and came to 153 rows a job on average against the real palettes' 4-86 (WRESTLER_DRAWS_MAP.md section 10), so the stale registers past
+// the palette went into the hash and 136 jobs a frame served 158 draws. Such a bone gets the job's last matrix in the compute shader, weighted by nothing.
+uint32_t SkinOnce::PaletteRows(const Request& q, uint32_t bones) {
+  const uint32_t blend = (q.bools & 8u) ? 4 : (q.bools & 4u) ? 3 : (q.bools & 2u) ? 2 : 1;  // the position's blend; bones above it are the tangent's (b4)
+  uint64_t key = Mix(Mix(Mix(uint64_t(q.address), q.mirror_offset), (uint64_t(q.first) << 32) | q.count), (uint64_t(q.stride_words) << 16) | (blend << 8) | bones);
+  const auto it = scanned_.find(key);
+  if (it != scanned_.end()) return it->second;
+  if (scanned_.size() > 65536) scanned_.clear();
+  const bool weighted = q.stride_words >= 11;
+  const uint32_t dword = weighted ? 7 : 4;
+  const uint32_t* src = q.mem->TranslatePhysical<const uint32_t*>(q.address + q.first * q.stride_words * 4);
+  constexpr float kNothing = 1.0f / 65536.0f;
+  uint32_t top = 0;
+  for (uint32_t i = 0; i < q.count; ++i) {
+    const uint32_t* vertex = src + size_t(i) * q.stride_words;
+    float wa = 0.0f, wc = 0.0f, wb = 0.0f;
+    if (weighted) {
+      wa = std::bit_cast<float>(std::byteswap(vertex[4]));
+      wc = std::bit_cast<float>(std::byteswap(vertex[5]));
+      wb = std::bit_cast<float>(std::byteswap(vertex[6]));
+    }
+    // What each bone byte weighs (vs_ch.glsl's ChSkin; the normal's third bone gets what wa and wc leave).
+    float w[4] = {1.0f, 1.0f, 1.0f, 1.0f};
+    if (blend == 4) {
+      w[0] = wa, w[1] = wc, w[2] = 1.0f - wa - wc, w[3] = 1.0f - wa - wc - wb;
+    } else if (blend == 3) {
+      w[0] = wa, w[1] = wc, w[2] = 1.0f - wa - wc;
+    } else if (blend == 2) {
+      w[0] = wa, w[1] = 1.0f - wa;
+    }
+    const uint32_t v = std::byteswap(vertex[dword]);
+    for (uint32_t k = 0; k < bones; ++k) {
+      if (!(std::abs(w[k]) < kNothing)) top = std::max(top, (v >> (8 * k)) & 0xFFu);  // (a NaN weight counts)
+    }
+  }
+  const uint32_t rows = std::min(3 * (top + 1), 180u);
+  scanned_.emplace(key, rows);
+  return rows;
+}
+
+bool SkinOnce::AllocateOut(uint32_t vertices, uint32_t* at) {
+  while (!segments_.empty() && segments_.front().submission <= completed_) segments_.pop_front();
+  if (vertices >= kOutVertices) return false;
+  if (segments_.empty()) {
+    if (out_head_ + vertices > kOutVertices) out_head_ = 0;
+  } else {
+    const uint32_t tail = segments_.front().start;
+    if (out_head_ >= tail) {  // free: [head, end) and [0, tail)
+      if (out_head_ + vertices > kOutVertices) {
+        if (vertices >= tail) return false;
+        out_head_ = 0;
+      }
+    } else if (out_head_ + vertices >= tail) {  // free: [head, tail)
+      return false;
+    }
+  }
+  *at = out_head_;
+  if (!segments_.empty() && segments_.back().end == out_head_ && segments_.back().submission == UINT64_MAX) {
+    segments_.back().end = out_head_ + vertices;
+  } else {
+    segments_.push_back({out_head_, out_head_ + vertices, UINT64_MAX});
+  }
+  out_head_ += vertices;
+  return true;
+}
+
+bool SkinOnce::OpenSlot() {
+  if (slot_ >= 0) return true;
+  for (uint32_t i = 0; i < kSlots; ++i) {
+    if (slot_submission_[i] <= completed_) {
+      slot_ = int32_t(i);
+      slot_rows_ = 0;
+      chunks_ = 0;
+      slot_submission_[i] = UINT64_MAX;
+      return true;
+    }
+  }
+  return false;
+}
+
+void SkinOnce::WriteJobFlags(const Job& j) {
+  uint32_t* row = params_map_ + (size_t(j.row) + 1) * 4;
+  row[0] = j.flags;
+  row[2] = j.scale_bits;
+}
+
+bool SkinOnce::MakeJob(const Request& q, uint64_t key, uint32_t palette_rows, VkDeviceSize* offset) {
+  if (!OpenSlot()) {
+    ++window_.refused[kRefParams];
+    return false;
+  }
+  const uint32_t chunks = (q.count + kChunk - 1) / kChunk;
+  if (slot_rows_ + 2 + palette_rows + chunks_ + chunks + 1 > kSlotRows) {
+    ++window_.refused[kRefParams];
+    return false;
+  }
+  uint32_t at = 0;
+  if (!AllocateOut(q.count, &at)) {
+    ++window_.refused[kRefOut];
+    return false;
+  }
+  const uint32_t slot_base = uint32_t(slot_) * kSlotRows;
+  Job j;
+  j.out_vertex = at;
+  j.row = slot_base + slot_rows_;
+  j.palette = j.row + 2;
+  j.serial = serial_;
+  j.flags = q.bools & (q.main ? 0x1Eu : 0x0Eu);
+  j.scale_bits = 0x3F800000u;
+  if (q.main) {
+    j.main_set = true;
+    j.flags |= q.style ? 0x100u : 0u;
+    j.scale_bits = q.scale_bits;
+  }
+  uint32_t* row0 = params_map_ + size_t(j.row) * 4;
+  row0[0] = uint32_t((q.mirror_offset >> 2) + uint64_t(q.first) * q.stride_words);
+  row0[1] = q.stride_words;
+  row0[2] = q.count;
+  row0[3] = at;
+  row0[5] = uint32_t(int32_t(j.palette) - 76);
+  row0[7] = palette_rows;
+  WriteJobFlags(j);
+  std::memcpy(params_map_ + size_t(j.palette) * 4, q.vs_float + 4 * 76, size_t(palette_rows) * 16);
+  slot_rows_ += 2 + palette_rows;
+  for (uint32_t c = 0; c < chunks; ++c) {
+    uint32_t* chunk = params_map_ + size_t(slot_base + kSlotRows - 1 - chunks_) * 4;
+    chunk[0] = j.row;
+    chunk[1] = c * kChunk;
+    ++chunks_;
+  }
+  jobs_.emplace(key, j);
+  ++window_.jobs;
+  window_.job_vertices += q.count;
+  window_.palette_rows += palette_rows;
+  *offset = VkDeviceSize(at) * 48;
+  if (!logged_first_) {
+    logged_first_ = true;
+    REXGPU_INFO("[skin1] first job (frame {}): {} vertices of {} dwords at 0x{:08X}, {} palette rows; each wrestler vertex is skinned once a frame", frame_, q.count, q.stride_words, q.address, palette_rows);
+  }
+  return true;
+}
+
+bool SkinOnce::GetJob(const Request& q, VkDeviceSize* offset) {
+  if (!EnsureInit(q.mirror_buffer)) {
+    ++window_.refused[kRefInit];
+    return false;
+  }
+  const uint32_t b = q.bools;
+  uint32_t bones = (b & 8u) ? 4 : (b & 4u) ? 3 : (b & 2u) ? 2 : 1;
+  if (q.main && (b & 16u)) bones = std::max(bones, 3u);
+  const uint32_t rows = PaletteRows(q, bones);
+  uint64_t key = XXH3_64bits(q.vs_float + 4 * 76, size_t(rows) * 16);
+  key = Mix(Mix(Mix(Mix(key, q.address), q.mirror_offset), (uint64_t(q.first) << 32) | q.count), (uint64_t(q.stride_words) << 8) | ((b >> 1) & 7u));
+  const auto found = jobs_.find(key);
+  if (found != jobs_.end()) {
+    Job& j = found->second;
+    const uint32_t main_flags = (q.bools & 0x1Eu) | (q.style ? 0x100u : 0u);
+    if (!q.main || (j.main_set && j.flags == main_flags && j.scale_bits == q.scale_bits)) {
+      ++window_.found;
+      *offset = VkDeviceSize(j.out_vertex) * 48;
+      return true;
+    }
+    if (!j.main_set && j.serial == serial_) {  // the side passes came first and the job has not gone out: the main pass's blend form is the job's
+      j.main_set = true;
+      j.flags = main_flags;
+      j.scale_bits = q.scale_bits;
+      WriteJobFlags(j);
+      ++window_.found;
+      *offset = VkDeviceSize(j.out_vertex) * 48;
+      return true;
+    }
+    // Gone out with other main-pass inputs (or none): a job of its own.
+    key = Mix(Mix(key, main_flags), q.scale_bits);
+    const auto own = jobs_.find(key);
+    if (own != jobs_.end()) {
+      ++window_.found;
+      *offset = VkDeviceSize(own->second.out_vertex) * 48;
+      return true;
+    }
+    ++window_.own_main;
+  }
+  return MakeJob(q, key, rows, offset);
+}
+
+void SkinOnce::Record(DeferredCommandBuffer& hoist, uint64_t submission) {
+  if (!chunks_) return;
+  const ui::vulkan::VulkanDevice* device = cp_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = device->functions();
+  // (The slot's bytes reach the GPU at the queue submit; a non-coherent type needs the flush.)
+  VkMappedMemoryRange range = {VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, params_memory_, 0, VK_WHOLE_SIZE};
+  dfn.vkFlushMappedMemoryRanges(device->device(), 1, &range);
+  const uint32_t chunk_top = uint32_t(slot_) * kSlotRows + kSlotRows - 1;
+  hoist.CmdVkBindPipeline(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_);
+  hoist.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout_, 0, 1, &set_, 0, nullptr);
+  hoist.CmdVkPushConstants(pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(chunk_top), &chunk_top);
+  hoist.CmdVkDispatch(chunks_, 1, 1);
+  VkMemoryBarrier barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+  barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT;
+  hoist.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_VERTEX_INPUT_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+  slot_submission_[slot_] = submission;
+  slot_ = -1;
+  chunks_ = 0;
+  ++serial_;
+}
+
+void SkinOnce::Summary(uint64_t frame) {
+  if (frame < window_first_frame_ + 600) return;
+  const uint64_t frames = std::max<uint64_t>(frame - window_first_frame_, 1);
+  const uint64_t draws = window_.draws[0] + window_.draws[1] + window_.draws[2];
+  if (draws) {
+    const uint64_t index_vertices = window_.index_vertices[0] + window_.index_vertices[1] + window_.index_vertices[2];
+    std::string refused;
+    for (uint32_t i = 0; i < kRefCount; ++i) {
+      if (window_.refused[i]) refused += fmt::format("{}{} {}", refused.empty() ? "" : ", ", kRefusedNames[i], window_.refused[i]);
+    }
+    REXGPU_INFO("[skin1] frames {}-{}: a frame {} draws read skinned rows (shadow {}, rim {}, main {}), {} index vertices ({} vertices named by the draws, counting a vertex once a draw) through them; skinned once: {} vertices in {} jobs a frame ({} draws found a job, {} main-pass jobs of their own, {} palette rows); refused {{{}}}",
+                window_first_frame_, frame, draws / frames, window_.draws[0] / frames, window_.draws[1] / frames, window_.draws[2] / frames, index_vertices / frames, window_.draw_vertices / frames, window_.job_vertices / frames,
+                window_.jobs / frames, window_.found / frames, window_.own_main / frames, window_.palette_rows / frames, refused.empty() ? "none" : refused);
+  }
+  window_ = Window{};
+  window_first_frame_ = frame;
+}
+
+}  // namespace rex::graphics::vulkan::native
diff --git a/src/graphics/vulkan/native/skin_once.h b/src/graphics/vulkan/native/skin_once.h
new file mode 100644
index 0000000000000000000000000000000000000000..57a261ac1da350cd374594fd83aad4cc64cfd829
--- /dev/null
+++ b/src/graphics/vulkan/native/skin_once.h
@@ -0,0 +1,129 @@
+// wwe2k14 patch (Session 95, gpu_native_skin_once, default off): each wrestler vertex skinned once a frame, into a real vertex buffer every later pass reads.
+// The wrestlers' meshes are drawn by 4-6 passes a frame (shadow maps, rim light map, main pass), and every pass ran the whole blend in its vertex shader (docs\native\WRESTLER_DRAWS_MAP.md: 80k index
+// vertices became ~300k). Here a typed draw of a listed shader (shader_swap::SkinOnceRow) names a JOB: (vertex range, palette bytes, bool constants b1-b3). The first draw of a job in a frame adds it to
+// the submission's list; every other draw with the same key (the rim map and the main pass share palettes; ~70% of the shadow draws too) finds it. The draw itself binds the job's rows as a vertex
+// buffer and takes the shader's _so variant (an attribute draw of its own: Draw::vb[0] / vi = 12). EndSubmission records ONE compute dispatch for the submission's jobs at the head of the
+// submission, after the hoisted uploads (Record): no render pass is ever broken for it. A job's source is the vertex mirror pool (host-endian vertices, kept right by VertexMirror's own watches).
+// A main-pass draw brings what only it knows (the blend form, b4, the c218 normal scale): written into the job while it is still pending, else the draw gets a job of its own.
+// Every refusal leaves the draw exactly as it was (the plain skinning shader); counted by reason in the 600-frame line.
+// State: everything is in this object, used from the command thread only. A job that runs a draw would own the per-draw Request; the job table and the rings would stay shared behind one owner.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <unordered_map>
+
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::memory {
+class Memory;
+}
+namespace rex::graphics::vulkan {
+class DeferredCommandBuffer;
+class VulkanCommandProcessor;
+namespace native {
+
+class SkinOnce {
+ public:
+  enum Role : uint32_t { kRoleShadow, kRoleRim, kRoleMain, kRoleCount };
+  enum Refused : uint32_t { kRefSpecial, kRefBaseExt, kRefNotFresh, kRefIndex, kRefFetch, kRefVariant, kRefMirror, kRefInit, kRefParams, kRefOut, kRefPending, kRefClaim, kRefCount };
+
+  explicit SkinOnce(VulkanCommandProcessor& cp);
+  ~SkinOnce();
+
+  struct Request {
+    rex::memory::Memory* mem = nullptr;
+    VkBuffer mirror_buffer = VK_NULL_HANDLE;
+    VkDeviceSize mirror_offset = 0;  // the mirror's place of the fetch constant's address
+    uint32_t address = 0;            // the same, guest physical bytes
+    uint32_t stride_words = 0;
+    uint32_t first = 0, count = 0;   // the vertices the draw's indices name (the fetch constant's numbering)
+    const uint32_t* vs_float = nullptr;  // the draw's 1024-word float bank
+    uint32_t bools = 0;              // the bool constants' first word
+    bool main = false;               // a main-pass draw: `style` and `scale_bits` count, and b4
+    uint32_t style = 0;              // CH_SKIN_STYLE
+    uint32_t scale_bits = 0;         // the float bits of c218.w + 1
+  };
+  // Once per listed draw, before Get: a new frame starts a new job table and closes the frame's output space.
+  void Tick(uint64_t frame, uint64_t submission, uint64_t completed);
+  // True: the job's rows start at *offset (bytes) of buffer(), one 48-byte vertex per row group, vertex `first` first.
+  bool Get(const Request& q, VkDeviceSize* offset) {
+    const bool ok = GetJob(q, offset);
+    if (ok) window_.draw_vertices += q.count;
+    return ok;
+  }
+  VkBuffer buffer() const { return out_buffer_; }
+  bool Pending() const { return chunks_ != 0; }
+  // The submission's jobs into its hoist stream (after the stream's closing barrier). `submission` = the one being ended.
+  void Record(DeferredCommandBuffer& hoist, uint64_t submission);
+
+  void Refuse(Refused why) { ++window_.refused[why]; }
+  void NoteTaken(Role role, uint32_t index_count) {
+    ++window_.draws[role];
+    window_.index_vertices[role] += index_count;
+  }
+
+ private:
+  bool GetJob(const Request& q, VkDeviceSize* offset);
+  static constexpr uint32_t kSlots = 8;                      // params: one slot per submission in flight
+  static constexpr uint32_t kSlotRows = 65536;               // 1 MiB of 16-byte rows
+  static constexpr uint32_t kOutVertices = 32 * 1024 * 1024 / 48;  // the output ring
+  static constexpr uint32_t kChunk = 64;                     // the compute shader's local size
+
+  struct Job {
+    uint32_t out_vertex = 0;     // the first vertex in the output ring
+    uint32_t row = 0;            // its two rows in params
+    uint32_t flags = 0;
+    uint32_t scale_bits = 0;
+    uint32_t palette = 0;
+    uint64_t serial = 0;         // the Record it goes out with
+    bool main_set = false;
+  };
+  struct Segment {
+    uint32_t start, end;         // output vertices
+    uint64_t submission;         // UINT64_MAX while its frame is open
+  };
+
+  bool EnsureInit(VkBuffer mirror_buffer);
+  uint32_t PaletteRows(const Request& q, uint32_t bones);
+  bool AllocateOut(uint32_t vertices, uint32_t* at);
+  bool OpenSlot();
+  void WriteJobFlags(const Job& j);
+  bool MakeJob(const Request& q, uint64_t key, uint32_t palette_rows, VkDeviceSize* offset);
+  void Summary(uint64_t frame);
+
+  VulkanCommandProcessor& cp_;
+  bool init_failed_ = false, ready_ = false;
+  VkBuffer out_buffer_ = VK_NULL_HANDLE, params_buffer_ = VK_NULL_HANDLE;
+  VkDeviceMemory out_memory_ = VK_NULL_HANDLE, params_memory_ = VK_NULL_HANDLE;
+  uint32_t* params_map_ = nullptr;  // uint32 view of the 16-byte rows
+  VkDescriptorSetLayout set_layout_ = VK_NULL_HANDLE;
+  VkPipelineLayout pipeline_layout_ = VK_NULL_HANDLE;
+  VkDescriptorPool pool_ = VK_NULL_HANDLE;
+  VkDescriptorSet set_ = VK_NULL_HANDLE;
+  VkShaderModule module_ = VK_NULL_HANDLE;
+  VkPipeline pipeline_ = VK_NULL_HANDLE;
+
+  uint64_t frame_ = UINT64_MAX, submission_ = 0, completed_ = 0;
+  std::unordered_map<uint64_t, Job> jobs_;                 // this frame's
+  std::unordered_map<uint64_t, uint32_t> scanned_;         // palette rows of a vertex range (by its mirror place)
+  // The open slot: rows from the bottom (jobs, palettes), chunks from the top.
+  int32_t slot_ = -1;
+  uint32_t slot_rows_ = 0, chunks_ = 0;
+  uint64_t serial_ = 1;
+  std::array<uint64_t, kSlots> slot_submission_{};
+  // The output ring.
+  uint32_t out_head_ = 0;
+  std::deque<Segment> segments_;
+
+  struct Window {
+    uint64_t draws[kRoleCount] = {}, index_vertices[kRoleCount] = {}, refused[kRefCount] = {};
+    uint64_t draw_vertices = 0, jobs = 0, job_vertices = 0, found = 0, own_main = 0, palette_rows = 0;
+  } window_;
+  uint64_t window_first_frame_ = 0;
+  bool logged_first_ = false;
+};
+
+}  // namespace native
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/native/vertex_input.cpp b/src/graphics/vulkan/native/vertex_input.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0c3e85c707162cbda40e9bf91ef792c0f75eff22
--- /dev/null
+++ b/src/graphics/vulkan/native/vertex_input.cpp
@@ -0,0 +1,83 @@
+// wwe2k14 patch (Session 95, Lane B2): the attribute draws' state. See vertex_input.h.
+
+#include "vertex_input.h"
+
+#include <string>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DECLARE(bool, gpu_native_index_no_restart);  // (vertex_mirror.cpp)
+REXCVAR_DECLARE(bool, gpu_native_index_verify);      // (same)
+REXCVAR_DECLARE(bool, gpu_native_index_stitch);      // (same)
+REXCVAR_DECLARE(bool, gpu_native_crowd_input);       // Session 95 (P7): own_crowd.cpp
+
+namespace rex::graphics::vulkan::native {
+
+namespace {
+const char* const kRefusalNames[kViRefusalCount] = {"not-typed",   "not-owned-only", "crowd",       "merge",       "xfb",         "fast-clear",  "instance-world", "view-blocks",
+                                                    "vs-expand",   "memexport",      "ps-fetch",    "line-loop",   "translated-off", "no-form",  "variant-refused", "attributes",
+                                                    "fetch-type",  "fetch-size",     "fetch-endian", "fetch-range", "pool-none",   "pool-full",   "pool-too-big",   "gpu-written",
+                                                    "index-range", "identity",       "reset-values", "converted",  "builtin-dma", "no-index-identity", "crowd-mesh"};
+}  // namespace
+
+ViForm& VertexInputState::Form(VkShaderModule module, uint64_t modification, uint32_t ext, bool* fresh) {
+  uint64_t h = uint64_t(reinterpret_cast<uintptr_t>(module)) * 0x9E3779B97F4A7C15ull;
+  h ^= modification + 0x7F4A7C159E3779B9ull + (h << 6) + (h >> 2);
+  h ^= uint64_t(ext) * 0xC2B2AE3D27D4EB4Full;
+  const auto [it, inserted] = forms_.try_emplace(h);
+  *fresh = inserted;
+  return it->second;
+}
+
+void VertexInputState::FrameTick(uint64_t frame, IndexPool& pool, uint64_t window_changes) {
+  const bool quit = quit_req_.load(std::memory_order_acquire) && !quit_ack_.load(std::memory_order_relaxed);
+  if (frame == frame_ && !quit) return;
+  frame_ = frame;
+  struct AckAtExit {
+    std::atomic<bool>* ack;
+    ~AckAtExit() { if (ack) ack->store(true, std::memory_order_release); }
+  } ack_at_exit{quit ? &quit_ack_ : nullptr};
+  no_restart_ = REXCVAR_GET(gpu_native_index_no_restart);
+  index_verify_ = REXCVAR_GET(gpu_native_index_verify);
+  stitch_ = REXCVAR_GET(gpu_native_index_stitch);
+  crowd_input_ = REXCVAR_GET(gpu_native_crowd_input);
+  // (The storage window's own line resets its count every 600 frames of its own.)
+  window_changes_ += window_changes >= window_changes_last_ ? window_changes - window_changes_last_ : window_changes;
+  window_changes_last_ = window_changes;
+  if (!window_first_frame_) window_first_frame_ = frame;
+  if (!quit && frame - window_first_frame_ < 600) return;
+  const Counters& n = counters_;
+  uint64_t storage = 0;
+  std::string reasons;
+  for (uint32_t i = 0; i < kViRefusalCount; ++i) {
+    storage += n.refused[i];
+    if (n.refused[i]) reasons += fmt::format("{}{} {}", reasons.empty() ? "" : ", ", kRefusalNames[i], n.refused[i]);
+  }
+  const uint64_t attribute = n.ours + n.translated + n.ring;
+  // Session 95 (P7): the crowd's own part, at the end of the line (nothing when the switch is off, so the line reads as before).
+  std::string crowd;
+  if (crowd_input_) {
+    std::string why;
+    for (uint32_t i = 0; i < kViRefusalCount; ++i) {
+      if (n.crowd_why[i]) why += fmt::format("{}{} {}", why.empty() ? "" : ", ", kRefusalNames[i], n.crowd_why[i]);
+    }
+    crowd = fmt::format("; crowd {{first members state only {}, own runs on attributes {} ({} members), own runs on storage {} {{{}}}, member draws on attributes {}}}", n.crowd_state, n.crowd_runs,
+                        n.crowd_run_members, n.refused[kViCrowd], why.empty() ? "none" : why, n.crowd_member_draws);
+  }
+  if (attribute || storage || n.crowd_state) {
+    const IndexPool::Counters& p = pool.counters();
+    const uint64_t calls = pool.callback_calls();
+    const uint64_t calls_window = calls - callback_calls_last_;  // (callback_calls() is monotonic)
+    callback_calls_last_ = calls;
+    REXGPU_INFO("[vinput] frames {}-{}: attribute draws {} (ours {}, translated {}, ring {}), storage draws {} {{{}}}, pipeline pending {}, planned but fell back {}; attribute draws with a range uploaded this submission {}; "
+                "index pool {{hits {}, converts {}, marks {}, callback calls {}, peak bytes {}, with reset values {}}}; window changes {}; stitched {} ({} guest elements to {}){}",
+                window_first_frame_, frame, attribute, n.ours, n.translated, n.ring, storage, reasons.empty() ? "none" : reasons, n.pending, n.fell_back, n.uploaded, p.hits, p.uploads,
+                p.invalidations + p.gpu_invalidations, calls_window, p.peak_bytes, n.with_reset, window_changes_, n.stitched, n.stitched_in, n.stitched_out, crowd);
+  }
+  counters_ = Counters{};
+  window_changes_ = 0;
+  window_first_frame_ = frame;
+}
+
+}  // namespace rex::graphics::vulkan::native
diff --git a/src/graphics/vulkan/native/vertex_input.h b/src/graphics/vulkan/native/vertex_input.h
new file mode 100644
index 0000000000000000000000000000000000000000..bea076f853a0d9afb3a71b215905502245497206
--- /dev/null
+++ b/src/graphics/vulkan/native/vertex_input.h
@@ -0,0 +1,128 @@
+// wwe2k14 patch (Session 95, Lane B2 of out\s95\android_structural.md; gpu_native_vertex_input): the attribute draws. A typed draw whose vertices and indices pass section 3.2's identity reads its
+// vertices as vertex attributes, with the shared memory buffer (or the inline ring) bound directly as vertex buffers and its DMA indices from the index pool: the vertex stage reads no storage buffer
+// and selects no storage window. D3dDirectAccess::BuildVertexInputPlan (owned_front_own.cpp) decides per draw, before UpdateBindings; every refusal keeps the draw exactly as it was and is counted by
+// name in the [vinput] line. A draw whose attribute pipeline is still being made is dropped like any draw with a pending pipeline: once decided, an attribute draw has selected no window, so there is
+// no plain fallback behind the claim.
+// State: this object is the command thread's (a job that planned a draw would own a copy of the latched switches and its own counters; the form table would be shared, filled ahead of the job).
+#pragma once
+
+#include <cstdint>
+#include <unordered_map>
+
+#include <rex/graphics/pipeline/shader/vertex_input_layout.h>
+#include <rex/logging/api.h>
+#include <rex/ui/vulkan/api.h>
+
+#include "index_pool.h"
+
+namespace rex::graphics::vulkan::native {
+
+// Why a draw stayed on storage, in the order section 3.2 checks (each failure counted by name).
+enum ViRefusal : uint32_t {
+  kViNotTyped,       // the old lean path, or a draw continuing a claimed base
+  kViNotOwnedOnly,   // not an owned-only frame
+  kViCrowd,          // a crowd member or a run's first member; with gpu_native_crowd_input, a run own crowd drew on its storage form (why: crowd_why)
+  kViMerge,          // an instanced (merged constants) base
+  kViXfb,            // transform feedback
+  kViFastClear,
+  kViInstanceWorld,
+  kViViewBlocks,
+  kViVsExpand,       // the vertex shader expands points / rectangles
+  kViMemexport,
+  kViPsFetch,        // the pixel shader fetches vertices
+  kViLineLoop,       // a line loop's closing index
+  kViTranslatedOff,  // a translated shader at level 1
+  kViNoForm,         // no _vi module, or the translated shader's form is not eligible
+  kViVariantRefused, // the variant could not be made (translation or pipeline)
+  kViAttributes,     // over the attribute limit
+  kViFetchType,
+  kViFetchSize,
+  kViFetchEndian,
+  kViFetchRange,
+  kViPoolNone,       // the pool could not be made
+  kViPoolFull,
+  kViPoolTooBig,
+  kViGpuWritten,     // the index range holds GPU-written data
+  kViIndexRange,     // the pool could not read the index range
+  kViIdentity,       // an index plus the base leaves the VGT clamp, 24 bits or goes below 0
+  kViResetValues,    // reset values in the data under gpu_native_index_no_restart, and not a stitched strip (gpu_native_index_stitch off, or not a triangle strip)
+  kViConverted,      // kHostConverted indices
+  kViBuiltinDma,     // kHostBuiltinForDMA indices
+  kViNoIndexIdentity,  // a draw without guest indices leaves the clamp
+  kViCrowdMesh,      // an own crowd run's indices reach past its mesh (only in crowd_why)
+  kViRefusalCount,
+};
+
+// One translation's attribute form (by plain module, modification and ext; made once, cleared with the caches). The pipeline is made by the claim, not here.
+struct ViForm {
+  VkShaderModule module = VK_NULL_HANDLE;
+  uint32_t vi = 0;  // the pipeline key's: one byte per binding, the stride in dwords
+  uint32_t binding_count = 0;
+  uint8_t fetch_constant[kViMaxBindings] = {};
+  bool translated = false;
+  bool failed = false;  // no form: never retried
+  ViRefusal refusal = kViNoForm;
+};
+
+// What BuildVertexInputPlan decided for one draw.
+struct VertexInputPlan {
+  bool ok = false;
+  ViForm* form = nullptr;
+  VkBuffer vb[kViMaxBindings] = {};
+  VkDeviceSize vb_offsets[kViMaxBindings] = {};
+  // Session 95 (P7, gpu_native_crowd_input): a run's first member held for own crowd: recorded for its state only, no draw call, so it reads no vertex: no storage window, no vertex range requested.
+  // Its indices are planned for own crowd (NativeRenderer::OwnCrowdNoteIndex); `ok` stays false, the state stays the plain draw's.
+  bool crowd_state = false;
+  bool pool_index = false;  // DMA indices: from the pool at index_offset (else the draw's own: none or built-in)
+  VkDeviceSize index_offset = 0;
+  uint32_t index_count = 0;  // (P2b) a stitched strip: the elements to draw instead of the draw's own count (0 = the draw's own)
+  int32_t first_vertex = 0;  // vertexOffset of an indexed draw, firstVertex of the others
+  // Session 95 (r3cmd, gpu_d3d_draw_record): what the pool answered, the check of a record's plan.
+  uint32_t index_min = 0, index_max = 0;
+  bool index_has_reset = false, index_stitched = false;
+};
+
+class VertexInputState {
+ public:
+  VertexInputState() { rex::RegisterQuitFlush(&quit_req_, &quit_ack_); }
+  ~VertexInputState() { rex::UnregisterQuitFlush(&quit_req_); }
+  VertexInputState(const VertexInputState&) = delete;
+  VertexInputState& operator=(const VertexInputState&) = delete;
+  struct Counters {
+    uint64_t ours = 0, translated = 0, ring = 0;  // attribute draws drawn (ring: whatever the shader)
+    uint64_t pending = 0;                         // attribute draws dropped: pipeline still being made
+    uint64_t fell_back = 0;                       // planned attribute draws handed back to the typed fallback (in neither total)
+    uint64_t uploaded = 0;                        // attribute draws with a range uploaded in this submission
+    uint64_t with_reset = 0;                      // DMA draws whose indices hold a reset value, taken or refused
+    uint64_t stitched = 0, stitched_in = 0, stitched_out = 0;  // (P2b) attribute draws drawn from a stitched strip; their guest elements and the elements drawn
+    uint64_t refused[kViRefusalCount] = {};
+    // Session 95 (P7, gpu_native_crowd_input): first members recorded for state only (no vertex read at all); own crowd's runs on attributes (and their members); crowd member draws on attributes
+    // (also in ours / translated); why a run stayed on own crowd's storage form (the run is in refused[kViCrowd]).
+    uint64_t crowd_state = 0, crowd_runs = 0, crowd_run_members = 0, crowd_member_draws = 0;
+    uint64_t crowd_why[kViRefusalCount] = {};
+  };
+  Counters& counters() { return counters_; }
+  // Latched once a frame.
+  bool no_restart() const { return no_restart_; }
+  bool stitch() const { return stitch_; }
+  bool index_verify() const { return index_verify_; }
+  bool crowd_input() const { return crowd_input_; }  // Session 95 (P7): gpu_native_crowd_input
+
+  // This translation's form; *fresh = it was just added, the caller fills it.
+  ViForm& Form(VkShaderModule module, uint64_t modification, uint32_t ext, bool* fresh);
+  void ClearForms() { forms_.clear(); }
+
+  // Once a frame, before the pool's own FrameEnd (the same 600-frame windows): the latches, and the [vinput] line of a finished window. `window_changes` = the storage window's running count.
+  void FrameTick(uint64_t frame, IndexPool& pool, uint64_t window_changes);
+
+ private:
+  std::atomic<bool> quit_req_{false}, quit_ack_{false};  // (Session 95) rex::RegisterQuitFlush: the quit closes the last [vinput] window
+  Counters counters_;
+  std::unordered_map<uint64_t, ViForm> forms_;
+  bool no_restart_ = false, index_verify_ = false, stitch_ = false, crowd_input_ = false;
+  uint64_t frame_ = UINT64_MAX, window_first_frame_ = 0;
+  uint64_t window_changes_last_ = 0, window_changes_ = 0;
+  uint64_t callback_calls_last_ = 0;
+};
