+uint64_t PlanCensusFloats(const uint32_t* bank, const uint64_t* bitmap) {
+  uint64_t h = 0;
+  for (uint32_t i = 0; i < 4; ++i) {
+    uint64_t m = bitmap[i];
+    while (m) {
+      const uint32_t b = uint32_t(std::countr_zero(m));
+      m &= m - 1;
+      h = XXH3_64bits_withSeed(bank + (i * 64 + b) * 4, 16, h);
+    }
+  }
+  return h;
+}
