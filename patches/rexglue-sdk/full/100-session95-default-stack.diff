+// wwe2k14 patch (Session 95, Lane C of out\s95\android_structural.md, section 3.1): see the header. A refused form's fields mean nothing.
+const char* Shader::BuildVertexInputForm(VertexInputFormInfo& form) const {
+  if (type() != xenos::ShaderType::kVertex) {
+    return "not-vertex";
+  }
+  if (memexport_eM_written_) {
+    return "memexport";
+  }
+  std::vector<VertexFetchCensusEntry> fetches;
+  GatherVertexFetchCensus(fetches);
+  const auto binding_of = [&form](uint32_t fetch_constant) {
+    uint32_t binding = 0;
+    while (binding < form.binding_count && form.fetch_constant[binding] != fetch_constant) {
+      ++binding;
+    }
+    return binding;
+  };
+  for (const VertexFetchCensusEntry& fetch : fetches) {
+    if (!fetch.plain_index) {
+      return "computed-index";
+    }
+    if (!fetch.stride_words) {
+      return "stride-0";
+    }
+    const uint32_t needed_words = xenos::GetVertexFormatNeededWords(fetch.format, fetch.used_components);
+    if (!needed_words) {
+      continue;
+    }
+    if (fetch.offset_words < 0) {
+      return "negative-offset";
+    }
+    if (uint32_t(fetch.offset_words) + uint32_t(std::bit_width(needed_words)) > fetch.stride_words) {
+      return "fetch-past-stride";
+    }
+    const uint32_t binding = binding_of(fetch.fetch_constant);
+    if (binding == form.binding_count) {
+      if (binding == kViMaxBindings) {
+        return "too-many-bindings";
+      }
+      form.fetch_constant[binding] = fetch.fetch_constant;
+      form.stride[binding] = fetch.stride_words;
+      ++form.binding_count;
+    } else if (form.stride[binding] != fetch.stride_words) {
+      return "mixed-strides";
+    }
+  }
+  for (uint32_t binding = 0; binding < form.binding_count; ++binding) {
+    if (form.stride[binding] >= kViInstanceRate) {  // (bit 7 of the byte is the instance-rate flag: a stride of 128 words or more has no attribute form)
+      return "too-many-attributes";
+    }
+    form.vi |= form.stride[binding] << (8 * binding);  // (the stride field of a vfetch is 8 bits)
+  }
+  ViAttr attributes[kViMaxAttributes] = {};
+  if (form.vi && !ViAttributes(form.vi, attributes)) {
+    return "too-many-attributes";
+  }
+  for (const VertexFetchCensusEntry& fetch : fetches) {
+    uint32_t needed_words = xenos::GetVertexFormatNeededWords(fetch.format, fetch.used_components);
+    for (uint32_t word = uint32_t(fetch.offset_words); needed_words; needed_words >>= 1, ++word) {
+      uint32_t location = 0, component = 0;
+      if ((needed_words & 1) && ViWord(form.vi, binding_of(fetch.fetch_constant), word, &location, &component)) {
+        form.read_locations |= uint32_t(1) << location;
+      }
+    }
+  }
+  return nullptr;
+}
