+  uint32_t family[kFamilyCount] = {};
+  uint32_t first_id = 0;
+  uint64_t vk_vs = 0, vk_fs = 0;
+  const char* kind = "unknown";  // color, msaa, depth, int, noblit, notstored, transient, overflow, nodraws, unknown
+  Source source;
