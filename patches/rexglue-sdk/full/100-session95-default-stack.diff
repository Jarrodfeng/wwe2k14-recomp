+  const uint64_t frame = A::Frame(cp);
+  for (uint32_t w = 0; w < kRecWays; ++w) {
+    DrawRec& r = set[w];
+    if (r.key == key && r.vs == in.vs && r.ps == in.ps && r.dma_base == in.dma_base && r.initiator == in.initiator) {
