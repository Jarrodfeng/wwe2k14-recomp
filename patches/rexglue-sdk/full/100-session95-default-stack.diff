 namespace {
 
+void ChooseFullscreenMode(SDL_Window* sdl_window) {
+  const int32_t min_height = REXCVAR_GET(present_fullscreen_small_mode);
+  if (min_height <= 0) {
+    return;
+  }
+  const SDL_DisplayID display = SDL_GetDisplayForWindow(sdl_window);
+  const SDL_DisplayMode* desktop = display ? SDL_GetDesktopDisplayMode(display) : nullptr;
+  if (!desktop || desktop->w <= 0 || desktop->h <= 0) {
+    REXLOG_WARN("[pace] present_fullscreen_small_mode: no desktop mode: {}", SDL_GetError());
+    return;
+  }
+  const int min_width = (min_height * 16 + 8) / 9;
+  int count = 0;
+  SDL_DisplayMode** modes = SDL_GetFullscreenDisplayModes(display, &count);
+  const SDL_DisplayMode* chosen = nullptr;
+  std::string list;
+  for (int i = 0; i < count; ++i) {
+    const SDL_DisplayMode* m = modes[i];
+    if (list.size() < 400) {
+      list += fmt::format(" {}x{}@{:.0f}", m->w, m->h, m->refresh_rate);
+    }
+    // The desktop's shape: the panel keeps its pixels square whatever the driver's scaling setting is.
+    const int64_t cross = int64_t(m->w) * desktop->h - int64_t(m->h) * desktop->w;
+    const bool same_shape = std::abs(cross) * 100 <= int64_t(desktop->w) * desktop->h;
+    if (!same_shape || m->w < min_width || m->h < min_height ||
+        std::abs(m->refresh_rate - desktop->refresh_rate) > 1.0f || m->pixel_density != desktop->pixel_density) {
+      continue;
+    }
+    if (!chosen || int64_t(m->w) * m->h < int64_t(chosen->w) * chosen->h) {
+      chosen = m;
+    }
+  }
+  REXLOG_INFO("[pace] present_fullscreen_small_mode: desktop {}x{}@{:.0f}, modes:{}", desktop->w, desktop->h,
+              desktop->refresh_rate, list);
+  if (chosen && (chosen->w != desktop->w || chosen->h != desktop->h)) {
+    if (SDL_SetWindowFullscreenMode(sdl_window, chosen)) {
+      REXLOG_INFO("[pace] present_fullscreen_small_mode: fullscreen at {}x{}@{:.0f}", chosen->w, chosen->h,
+                  chosen->refresh_rate);
+    } else {
+      REXLOG_WARN("[pace] present_fullscreen_small_mode: {}x{} refused: {}", chosen->w, chosen->h, SDL_GetError());
+    }
+  } else {
+    REXLOG_INFO("[pace] present_fullscreen_small_mode: no smaller mode of the desktop's shape; staying at the desktop's");
+  }
+  SDL_free(modes);
+}
