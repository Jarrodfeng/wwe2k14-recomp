+// wwe2k14 patch (Session 85, gpu_dynamic_shadows): which dynamic shadow caster a draw is (0 none, 1 wrestler map caster,
+// 2 circle shadow, 3 ring mask / props caster). Hashes from the Session 80 owned-steps list (native_frame.h) and
+// docs/native/WRESTLER_DRAWS_MAP.md. The ring casters are told by their vertex shader AND the flat pixel shader, so
+// the main pass's own draws of the same meshes (other pixel shaders) stay.
+static uint32_t DynamicShadowCasterKind(uint64_t ps_hash, uint64_t vs_hash) {
+  if (ps_hash == 0xDA494C9383E18961ull) return 1;
+  if (ps_hash == 0xD05BFEA12F4350ADull) return 2;
+  if (ps_hash == 0xA4A965C189287B99ull && (vs_hash == 0xA96C8C4D28D28F80ull || vs_hash == 0xA878C3FD5E27FB35ull)) return 3;
+  return 0;
+}
+
+// wwe2k14 patch (Session 85, gpu_dynamic_shadows): the shadow chain's surface key (colour info with its format, depth
+// info with its format; the pitch is left out: a pass draws its flat fills at half the pitch) and its pitch test (the
+// maps' 512-wide targets read 481-560 in the register, the fills 280 - a draw at 280 counts only as the flat fill).
+static uint64_t ShadowChainKey(const RegisterFile& regs) {
+  return uint64_t(regs[XE_GPU_REG_RB_COLOR_INFO] & 0xF0FFFu) | (uint64_t(regs[XE_GPU_REG_RB_DEPTH_INFO] & 0x1FFFFu) << 20);
+}
+static bool ShadowChainPitchOk(const RegisterFile& regs, uint64_t ps_hash, bool copy) {
+  const uint32_t pitch = regs[XE_GPU_REG_RB_SURFACE_INFO] & 0x3FFF;
+  return (pitch > 480 && pitch <= 560) || (pitch == 280 && (copy || ps_hash == 0xA4A965C189287B99ull));
+}
+static bool ShadowChainHas(const std::vector<uint64_t>& v, uint64_t key) {
+  return std::find(v.begin(), v.end(), key) != v.end();
+}
+// The pass shaders whose surfaces are never the chain: the rim-light pass (D03E7D4C), its blur (632189BA), and the copy
+// quad (7ABDFEFB).
+static bool ShadowChainNotShadow(uint64_t ps_hash) {
+  return ps_hash == 0xD03E7D4C719B0EDBull || ps_hash == 0x632189BAFAE233F0ull || ps_hash == 0x7ABDFEFBCADB4BF9ull;
+}
+
+// wwe2k14 patch (Session 85, gpu_dynamic_shadows): the per-window count of skipped caster draws (one INFO line per 600
+// guest frames while the setting is false).
+static void DynamicShadowsNoteSkip(uint32_t kind, uint64_t frame) {
+  static uint64_t counts[4] = {}, window = UINT64_MAX;
+  const uint64_t w = frame / 600;
+  if (window != UINT64_MAX && w != window) {
+    REXGPU_INFO("[shadow] dynamic shadows OFF, frames {}-{}: caster draws skipped: wrestler maps {}, circle {}, ring/props {}",
+                window * 600, window * 600 + 599, counts[1], counts[2], counts[3]);
+    counts[1] = counts[2] = counts[3] = 0;
+  }
+  window = w;
+  ++counts[kind];
+}
+
+// wwe2k14 patch (Session 85, gpu_scene_crowd_density): a crowd member draw (the three known crowd vertex shaders, as
+// the crowd cull knows them) whose fixed rank - the same hash of its world position c76.w c77.w c78.w as the queued
+// members' (src\graphics\command_processor.cpp) - is not below the density. Draws the game made outside the queued runs
+// (~140 a frame in the match at 0%, anatomy run 21) are reached here; the queued ones too, consistently.
+// Also the skinned-model vertex shader 0E2A3DF5BAA2CA18 - but only into the scene's own render target (pitch >= 640: run
+// 035's probe: it draws 15 ~220-index figures into an 80-wide target, which stay, and one 1443-index person at an
+// arena position in the 1280-wide scene pass: the lone ringside spectator that was left at 0%, run 028 / 035).
+static bool CrowdDensityRejects(const RegisterFile& regs, uint64_t vs_hash, int32_t density) {
+  if (vs_hash == 0x0E2A3DF5BAA2CA18ull) {
+    if ((regs[XE_GPU_REG_RB_SURFACE_INFO] & 0x3FFFu) < 640u) return false;
+    // A skinned shader: its c76-c78 may be an animated bone, so a rank of those bits could flicker at 10-90%. Binary:
+    // present at any density above 0, gone at 0 (review, Opus).
+    return density == 0;
+  } else if (vs_hash != 0xD5E2FCC9F76BC40Cull && vs_hash != 0xC1028A64EFCF8229ull && vs_hash != 0x183CC64A4C4E96ACull) {
+    return false;
+  }
+  constexpr uint32_t kVsConst = 0x4000 + 4 * 76;  // VS float constant c76
+  uint32_t h = regs[kVsConst + 3] * 0x9E3779B1u ^ regs[kVsConst + 7] * 0x85EBCA77u ^ regs[kVsConst + 11] * 0xC2B2AE3Du;
+  h ^= h >> 16, h *= 0x7FEB352Du, h ^= h >> 15, h *= 0x846CA68Bu, h ^= h >> 16;
+  return int32_t(h % 100u) >= density;
+}
