+// wwe2k14 Android port: SDL's Java activity loads the app library (libmain.so) and calls SDL_main on its own thread.
+// The activity names the app's own files folder in WWE2K14_FILES_DIR; it becomes the working folder (so the default
+// logs\ folder lands there) and HOME (so the default user folder does too).
+extern "C" __attribute__((visibility("default"))) int SDL_main(int argc, char* argv[]) {
+  if (const char* files_dir = std::getenv("WWE2K14_FILES_DIR"); files_dir && *files_dir) {
+    chdir(files_dir);
+    setenv("HOME", files_dir, 1);
+  }
+  if (!rex::InitializeAndroidSystemForApplicationContext()) {
+    return EXIT_FAILURE;
+  }
+  int result = RunWindowedApp(argc, argv);
+  rex::ShutdownAndroidSystem();
+  return result;
+}
