diff --git a/src/core/memory_posix.cpp b/src/core/memory_posix.cpp
index b52bf39c927a03b6b03c4ede083adc5b0ae50809..f79e4af6b079ed15a06717c1f2b2a7d229a699a3 100644
--- a/src/core/memory_posix.cpp
+++ b/src/core/memory_posix.cpp
@@ -305,7 +305,17 @@ void* AllocFixed(void* base_address, size_t length, AllocationType allocation_ty
       (allocation_type == AllocationType::kCommit ||
        allocation_type == AllocationType::kReserveCommit)) {
     // Verify the entire range is mapped before using mprotect
+#if REX_PLATFORM_ANDROID
+    // wwe2k14 patch (Session 64, Android): msync(MS_ASYNC) checks the same thing (ENOMEM when any part of the range is
+    // unmapped) without changing anything, instead of parsing /proc/self/maps (6,000+ lines on the phone) for every
+    // guest commit: the game's main thread spent the loading screens' hitches in that parse (simpleperf, run 047).
+    // An address that is not page-aligned (EINVAL) still takes the /proc check.
+    const bool fully_mapped = msync(base_address, length, MS_ASYNC) == 0 ||
+                              (errno == EINVAL && IsRangeFullyMapped(base_address, length));
+    if (fully_mapped) {
+#else
     if (IsRangeFullyMapped(base_address, length)) {
+#endif
       if (mprotect(base_address, length, static_cast<int>(prot_requested)) == 0) {
         return base_address;
       }
