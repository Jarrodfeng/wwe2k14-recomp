diff --git a/src/core/android.cpp b/src/core/android.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e083bb1a6998dfe1a5608ec57a95d0b6647860f3
--- /dev/null
+++ b/src/core/android.cpp
@@ -0,0 +1,75 @@
+/**
+ * @file        rex/core/android.cpp
+ * @brief       Android system glue: API level, start-up / shut-down of the Android pieces
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * wwe2k14 Android port. Xenia declared these (rex/platform.h, rex/system.h, rex/filesystem.h) without an Android
+ * implementation in this tree. Game files reach the runtime as plain paths (an ISO in the app's folder, or a file
+ * descriptor from Android's file picker as /proc/self/fd/N), so content:// URIs are not opened here.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <cstdlib>
+#include <string_view>
+
+#include <android/api-level.h>
+#include <sys/system_properties.h>
+
+#include <rex/filesystem.h>
+#include <rex/memory/utils.h>
+#include <rex/system.h>
+#include <rex/thread.h>
+
+namespace rex {
+
+int GetAndroidApiLevel() {
+  static const int level = [] {
+#if __ANDROID_API__ >= 29
+    return android_get_device_api_level();
+#else
+    // android_get_device_api_level() is only in the API 29+ headers; read the property it reads.
+    char value[PROP_VALUE_MAX] = {};
+    if (__system_property_get("ro.build.version.sdk", value) > 0) {
+      return std::atoi(value);
+    }
+    return __ANDROID_API__;
+#endif
+  }();
+  return level;
+}
+
+bool InitializeAndroidSystemForApplicationContext() {
+  memory::AndroidInitialize();
+  thread::AndroidInitialize();
+  filesystem::AndroidInitialize();
+  return true;
+}
+
+void ShutdownAndroidSystem() {
+  filesystem::AndroidShutdown();
+  thread::AndroidShutdown();
+  memory::AndroidShutdown();
+}
+
+namespace filesystem {
+
+void AndroidInitialize() {}
+void AndroidShutdown() {}
+
+bool IsAndroidContentUri(const std::string_view source) {
+  return source.starts_with("content://");
+}
+
+int OpenAndroidContentFileDescriptor(const std::string_view, const char*) {
+  // Not supported: pass /proc/self/fd/N paths instead (see the file comment).
+  return -1;
+}
+
+}  // namespace filesystem
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d43a4676f3de7a37c385cf37f3d51373659a84de
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,57 @@
+/**
+ * @file        rex/core/fiber_android.cpp
+ * @brief       Android backend for rex::thread::Fiber: not supported (stub)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * wwe2k14 Android port: Bionic has no getcontext / makecontext / swapcontext. Titles that never create guest fibers
+ * (WWE 2K14: no CreateFiber / ConvertThreadToFiber / SwitchToFiber in its code) only need thread fibers, which the
+ * runtime makes for every guest thread. Creating or switching a fiber logs and aborts, so a title that does use fibers
+ * fails loudly instead of misbehaving.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <cstdlib>
+
+#include <rex/logging.h>
+#include <rex/thread/fiber.h>
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+[[noreturn]] static void FibersUnsupported(const char* what) {
+  REXSYS_ERROR("fibers are not supported on Android ({})", what);
+  std::abort();
+}
+
+// The runtime converts every guest thread at start-up, fibers used or not (phone run 003). A thread fiber needs no saved
+// context until something switches away from it, so this one works; Create / SwitchTo are the real fiber use.
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t, void (*)(void*), void*) {
+  FibersUnsupported("Create");
+}
+
+void Fiber::SwitchTo(Fiber*) {
+  FibersUnsupported("SwitchTo");
+}
+
+void Fiber::Destroy() {
+  // Only thread fibers exist here (Create aborts).
+  if (tls_current_ == this) {
+    tls_current_ = nullptr;
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_ANDROID
