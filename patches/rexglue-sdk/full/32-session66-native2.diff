+    std::vector<AliasEntry>& list = it->second;
+    for (size_t i = 0; i < list.size();) {
+      if (list[i].frame + 2 <= frame_) {
+        AliasClassify(list[i], kAliasStale);
+        list.erase(list.begin() + ptrdiff_t(i));
+      } else {
+        ++i;
+      }
