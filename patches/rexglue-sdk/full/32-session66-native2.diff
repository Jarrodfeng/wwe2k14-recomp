@@ -959,6 +986,22 @@ class Shader {
     return nullptr;
   }
   Translation* GetOrCreateTranslation(uint64_t modification, bool* is_new = nullptr);
+  // wwe2k14 patch (Session 66, native_ext): the translation of a modification and a NATIVE specialisation word. With
+  // native_ext 0 it is exactly GetOrCreateTranslation(modification) (the same translation, the same key); otherwise a
+  // translation of its own, keyed by a 64-bit mix of both (a clash is as unlikely as two modification hashes clashing).
+  static uint64_t TranslationKey(uint64_t modification, uint32_t native_ext) {
+    if (!native_ext) {
+      return modification;
+    }
+    uint64_t x = modification ^ (uint64_t(native_ext) * 0x9E3779B97F4A7C15ull);
+    x ^= x >> 30;
+    x *= 0xBF58476D1CE4E5B9ull;
+    x ^= x >> 27;
+    x *= 0x94D049BB133111EBull;
+    x ^= x >> 31;
+    return x ? x : 1;
+  }
