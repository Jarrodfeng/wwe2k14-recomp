+// At each frame end (after the frame's draws): the frame's line, the count down, the summary at the end.
+void VulkanCommandProcessor::VertexCensusFrameEnd() {
+  const int32_t left = REXCVAR_GET(gpu_native_vertex_census);
+  const int32_t ps_left = REXCVAR_GET(gpu_native_ps_census);
+  if (vertex_census_p_) {  // wwe2k14 patch (Session 66, PS spec 1)
+    ++ps_census_frames_;
+    if (ps_left > 0) {
+      rex::cvar::SetFlagByName("gpu_native_ps_census", std::to_string(ps_left - 1));
+    }
+    if (ps_left <= 1) {
+      PsCensusSummary();
+      ps_census_shaders_.clear();
+      ps_census_frames_ = 0;
+    }
+  }
+  if (vertex_census_v_) {
+    VertexCensus& census = vertex_census_;
+    ++census.frames;
+    REXGPU_INFO("[vfetch][census] frame {}: {}", frame_current_, VertexCensusDescribe(census.frame, kVertexCensusKindCount));
+    VertexCensusCounts& total = census.total;
+    total.draws += census.frame.draws;
+    total.eligible += census.frame.eligible;
+    total.no_fetch += census.frame.no_fetch;
+    for (uint32_t i = 0; i < kVertexCensusKindCount; ++i) total.kinds[i] += census.frame.kinds[i];
+    for (uint32_t i = 0; i < 16; ++i) total.types[i] += census.frame.types[i];
+    for (uint32_t i = 0; i < 4; ++i) total.endian[i] += census.frame.endian[i];
+    census.frame = VertexCensusCounts();
+    if (left > 0) {
+      rex::cvar::SetFlagByName("gpu_native_vertex_census", std::to_string(left - 1));
+    }
+    if (left <= 1) {  // counted down to 0, or set back to 0 by hand
+      VertexCensusSummary();
+      vertex_census_ = VertexCensus();
+    }
+  }
+  vertex_census_v_ = REXCVAR_GET(gpu_native_vertex_census) > 0;
+  vertex_census_p_ = REXCVAR_GET(gpu_native_ps_census) > 0;
+  vertex_census_on_ = vertex_census_v_ || vertex_census_p_;
+}
