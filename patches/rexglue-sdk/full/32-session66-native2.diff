+          walk_exec(instr, cf_index);
+        } break;
+        case ControlFlowOpcode::kLoopStart:
+          control_flow_complex = true;
+          note_backward(cf.loop_start.address(), cf_index);
+          break;
+        case ControlFlowOpcode::kLoopEnd:
+          control_flow_complex = true;
+          note_backward(cf.loop_end.address(), cf_index);
+          break;
+        case ControlFlowOpcode::kCondCall:
+          control_flow_complex = true;
+          note_backward(cf.cond_call.address(), cf_index);
+          break;
+        case ControlFlowOpcode::kReturn:
+          control_flow_complex = true;
+          break;
+        case ControlFlowOpcode::kCondJmp:
+          control_flow_complex = true;
+          note_backward(cf.cond_jmp.address(), cf_index);
+          break;
+        default:
