+// wwe2k14 patch (Session 66, PS spec 2, gpu_native_ps_mul_mode): see the header.
+bool SpirvShaderTranslator::MulRuleOperandTainted(const InstructionOperand& operand) {
+  if (operand.storage_source != InstructionStorageSource::kRegister) {
+    return false;  // float constants: finite by assumption
+  }
+  if (operand.storage_addressing_mode != InstructionStorageAddressingMode::kAbsolute ||
+      operand.storage_index >= 128) {
+    mul_rule_tracking_ = false;
+    return true;
+  }
+  const uint8_t bits = mul_rule_reg_taint_[operand.storage_index];
+  for (uint32_t i = 0; i < operand.component_count; ++i) {
+    const SwizzleSource source = operand.components[i];
+    if (source <= SwizzleSource::kW && (bits >> uint32_t(source)) & 1) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SpirvShaderTranslator::MulRuleBeginInstruction(const ParsedAluInstruction& instr) {
+  mul_rule_action_vector_ = mul_rule_action_scalar_ = 0;
+  if (!mul_rule_mode_) {
+    return;
+  }
+  if (mul_rule_mode_ == 3) {
+    mul_rule_action_vector_ = mul_rule_action_scalar_ = 2;
+    return;
+  }
+  // Modes 1 and 2: the operands of each part (the vector and the scalar operation read the registers as they were
+  // before the instruction).
+  mul_rule_vector_tainted_ = false;
+  for (uint32_t i = 0; i < instr.vector_operand_count; ++i) {
+    mul_rule_vector_tainted_ |= MulRuleOperandTainted(instr.vector_operands[i]);
+  }
+  mul_rule_scalar_tainted_ = false;
+  for (uint32_t i = 0; i < instr.scalar_operand_count; ++i) {
+    mul_rule_scalar_tainted_ |= MulRuleOperandTainted(instr.scalar_operands[i]);
+  }
+  switch (instr.scalar_opcode) {
+    case ucode::AluScalarOpcode::kAddsPrev:
+    case ucode::AluScalarOpcode::kMulsPrev:
+    case ucode::AluScalarOpcode::kMulsPrev2:
+    case ucode::AluScalarOpcode::kSubsPrev:
+      mul_rule_scalar_tainted_ |= mul_rule_ps_tainted_;
+      break;
+    default:
+      break;
+  }
+  const uint32_t unclean_action = mul_rule_mode_ == 2 ? 1 : 0;
+  mul_rule_action_vector_ = (mul_rule_tracking_ && !mul_rule_vector_tainted_) ? 2 : unclean_action;
+  mul_rule_action_scalar_ = (mul_rule_tracking_ && !mul_rule_scalar_tainted_) ? 2 : unclean_action;
+}
+
+void SpirvShaderTranslator::MulRuleNoteResult(const InstructionResult& result, bool tainted, bool weak) {
+  if (result.storage_target != InstructionStorageTarget::kRegister || !result.original_write_mask) {
+    return;
+  }
+  if (result.storage_addressing_mode != InstructionStorageAddressingMode::kAbsolute || result.storage_index >= 128) {
+    mul_rule_tracking_ = false;
+    return;
+  }
+  uint8_t& bits = mul_rule_reg_taint_[result.storage_index];
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (!((result.original_write_mask >> i) & 1)) {
+      continue;
+    }
+    // A constant 0 / 1 lane and a saturated one are finite.
+    const bool lane_tainted = tainted && !result.is_clamped && result.components[i] <= SwizzleSource::kW;
+    if (weak) {
+      bits |= uint8_t(lane_tainted ? 1u << i : 0u);
+    } else {
+      bits = uint8_t((bits & ~(1u << i)) | (lane_tainted ? 1u << i : 0u));
+    }
+  }
+}
+
+void SpirvShaderTranslator::MulRuleEndInstruction(const ParsedAluInstruction& instr) {
+  if (!mul_rule_mode_ || mul_rule_mode_ == 3 || !mul_rule_tracking_) {
+    return;
+  }
+  const bool weak = instr.is_predicated || !mul_rule_exec_unconditional_;
+  bool scalar_result_tainted = mul_rule_scalar_tainted_;
+  switch (instr.scalar_opcode) {
+    case ucode::AluScalarOpcode::kExp:
+    case ucode::AluScalarOpcode::kLogc:
+    case ucode::AluScalarOpcode::kLog:
+    case ucode::AluScalarOpcode::kRcpc:
+    case ucode::AluScalarOpcode::kRcpf:
+    case ucode::AluScalarOpcode::kRcp:
+    case ucode::AluScalarOpcode::kRsqc:
+    case ucode::AluScalarOpcode::kRsqf:
+    case ucode::AluScalarOpcode::kRsq:
+    case ucode::AluScalarOpcode::kSqrt:
+      scalar_result_tainted = true;
+      break;
+    default:
+      break;
+  }
+  MulRuleNoteResult(instr.vector_and_constant_result, mul_rule_vector_tainted_, weak);
+  MulRuleNoteResult(instr.scalar_result, scalar_result_tainted, weak);
+  if (instr.scalar_opcode != ucode::AluScalarOpcode::kRetainPrev) {
+    mul_rule_ps_tainted_ = weak ? (mul_rule_ps_tainted_ || scalar_result_tainted) : scalar_result_tainted;
+  }
+}
