+  // The body of AwaitAllQueueOperationsCompletion (which flushes first itself, so it is not called from here): end the
+  // open submission and wait for every submission once.
+  const auto wait_start = std::chrono::steady_clock::now();
+  CheckSubmissionFenceAndDeviceLoss(GetCurrentSubmission());
+  const bool completed = !device_lost_ && !submission_open_ && submissions_in_flight_fences_.empty();
+  const auto wait_end = std::chrono::steady_clock::now();
+
+  uint64_t bytes = 0;
+  for (const PendingReadback& pending : readback_pending_) {
+    auto it = readback_buffers_.find(pending.key);
+    if (it == readback_buffers_.end()) {
+      continue;  // (not evicted while queued - see EvictOldReadbackBuffers)
+    }
+    ReadbackBuffer& readback = it->second;
+    readback.pending[pending.slot] = false;
+    if (!completed) {
+      continue;  // as the synchronous path: a failed wait copies nothing
+    }
+    const uint32_t read_index = pending.slot;
+    const uint32_t written_address = pending.address;
+    const uint32_t written_length = pending.length;
+    if (readback.buffers[read_index] == VK_NULL_HANDLE || written_length > readback.sizes[read_index] ||
+        readback.mapped_data[read_index] == nullptr) {
+      continue;
+    }
+    VkMappedMemoryRange readback_memory_range = {};
+    readback_memory_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    readback_memory_range.memory = readback.memories[read_index];
+    readback_memory_range.offset = 0;
+    readback_memory_range.size = VK_WHOLE_SIZE;
+    dfn.vkInvalidateMappedMemoryRanges(device, 1, &readback_memory_range);
+
+    if (pending.stats) {
+      // The [resolve_stats] line of the synchronous path, with the fields of the time the resolve was issued.
+      const auto* p = static_cast<const uint8_t*>(readback.mapped_data[read_index]);
+      uint64_t nonzero_bytes = 0, nonzero_words = 0, sum = 0;
+      uint64_t hash = 0xCBF29CE484222325ull;
+      for (uint32_t i = 0; i < written_length; ++i) {
+        nonzero_bytes += p[i] != 0, sum += p[i];
+        hash = (hash ^ p[i]) * 0x100000001B3ull;
+      }
+      for (uint32_t i = 0; i + 4 <= written_length; i += 4) {
+        uint32_t w;
+        std::memcpy(&w, p + i, 4);
+        nonzero_words += w != 0;
+      }
+      REXGPU_INFO("[resolve_stats] resolve {} dest 0x{:08X} {} bytes: non-zero bytes {:.2f}%, words {:.2f}%, mean byte "
+                  "{:.2f}, color_info 0x{:08X} surface_info 0x{:08X}, hash {:016X}, frame {}",
+                  pending.stats_resolve_index, written_address, written_length,
+                  written_length ? 100.0 * double(nonzero_bytes) / written_length : 0.0,
+                  written_length >= 4 ? 100.0 * double(nonzero_words) / (written_length / 4) : 0.0,
+                  written_length ? double(sum) / written_length : 0.0, pending.stats_color_info,
+                  pending.stats_surface_info, hash, pending.stats_frame);
+    }
+    uint8_t* destination = memory_->TranslatePhysical(written_address);
+    if (destination) {
+      std::memcpy(destination, readback.mapped_data[read_index], written_length);
+      bytes += written_length;
+    }
+  }
+
+  const size_t entries = readback_pending_.size();
+  readback_pending_.clear();
+  ++readback_batch_flushes_;
+  readback_batch_entries_ += entries;
+  readback_batch_entries_total_ += entries;
+  readback_batch_bytes_ += bytes;
+  readback_batch_wait_us_ +=
+      uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(wait_end - wait_start).count());
+  ++readback_batch_reason_flushes_[size_t(reason)];
+  readback_batch_reason_entries_[size_t(reason)] += entries;
+  if (!completed) {
+    REXGPU_WARN("[readback][batch] flush ({}) of {} entries dropped: the wait did not complete (device lost {})",
+                kReadbackFlushReasonNames[size_t(reason)], entries, device_lost_);
+  }
+  readback_flushing_ = false;
+  ReadbackBatchMaybeLog();
+}
+
+// Every 5 s while batching is active: flushes, entries, bytes, wait time and the flushes / entries by reason.
+void VulkanCommandProcessor::ReadbackBatchMaybeLog() {
+  if (!readback_batch_flushes_ && readback_pending_.empty()) {
+    return;
+  }
+  const int64_t now_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                             std::chrono::steady_clock::now().time_since_epoch())
+                             .count();
+  if (!readback_batch_log_ns_) {
+    readback_batch_log_ns_ = now_ns;
+    return;
+  }
+  if (now_ns - readback_batch_log_ns_ < 5000000000ll) {
+    return;
+  }
+  std::string reasons;
+  for (size_t i = 0; i < size_t(GuestVisibleEvent::kCount); ++i) {
+    if (readback_batch_reason_flushes_[i]) {
+      reasons += fmt::format(" {}={}/{}", kReadbackFlushReasonNames[i], readback_batch_reason_flushes_[i],
+                             readback_batch_reason_entries_[i]);
+    }
+  }
+  REXGPU_INFO("[readback][batch] {:.1f} s: {} flushes, {} entries (avg {:.1f}, max pending {}), {:.1f} MB copied "
+              "back, {:.1f} ms waiting; by reason (flushes/entries):{}; pending now {}; frame {}",
+              double(now_ns - readback_batch_log_ns_) / 1e9, readback_batch_flushes_, readback_batch_entries_,
+              readback_batch_flushes_ ? double(readback_batch_entries_) / double(readback_batch_flushes_) : 0.0,
+              readback_batch_max_pending_, double(readback_batch_bytes_) / (1024.0 * 1024.0),
+              double(readback_batch_wait_us_) / 1000.0, reasons.empty() ? std::string(" (none)") : reasons,
+              readback_pending_.size(), frame_current_);
+  readback_batch_log_ns_ = now_ns;
+  readback_batch_flushes_ = readback_batch_entries_ = readback_batch_max_pending_ = 0;
+  readback_batch_bytes_ = readback_batch_wait_us_ = 0;
+  std::fill(std::begin(readback_batch_reason_flushes_), std::end(readback_batch_reason_flushes_), 0ull);
+  std::fill(std::begin(readback_batch_reason_entries_), std::end(readback_batch_reason_entries_), 0ull);
+}
