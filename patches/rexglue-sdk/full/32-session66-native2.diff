+    if (f.path_resolves[i]) {
+      paths += fmt::format("{}{} {}", paths.empty() ? "" : ", ", kAliasPathNames[i], f.path_resolves[i]);
+    }
+  }
+  std::string classes;
+  for (uint32_t i = 0; i < kAliasClasses; ++i) {
+    classes += fmt::format("{}{} {}", i ? " " : "", kAliasClassNames[i], f.cls[i]);
+  }
