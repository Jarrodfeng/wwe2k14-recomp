+    "evw_shd", "evw_ext", "evw_zpd", "mem_write", "cond_write", "reg_to_mem", "scratch", "rptr",
+    "interrupt", "swap", "wait_reg_mem", "await", "slot_reuse", "batch_max", "mode_change", "cvar_off", "shutdown"};
