+// wwe2k14 patch (Session 66, B2.0 census gpu_native_vertex_census): see the header. Walks the control flow in ucode
+// order as AnalyzeUcode does, tracking whether r0.x may have been written before each vfetch.
+void Shader::GatherVertexFetchCensus(std::vector<VertexFetchCensusEntry>& out) const {
+  out.clear();
+  if (!is_ucode_analyzed_ || type() != xenos::ShaderType::kVertex) {
+    return;
+  }
+  bool control_flow_complex = false;
+  bool r0x_written = false;
+  uint32_t first_backward_target = UINT32_MAX;
+  VertexFetchInstruction previous_vfetch_full;
+  std::memset(&previous_vfetch_full, 0, sizeof(previous_vfetch_full));
+  bool previous_full_plain = false;
+  const auto result_may_write_r0x = [](const InstructionResult& result) {
+    return result.storage_target == InstructionStorageTarget::kRegister && (result.original_write_mask & 1) &&
+           (result.storage_index == 0 ||
+            result.storage_addressing_mode != InstructionStorageAddressingMode::kAbsolute);
+  };
+  const auto note_backward = [&](uint32_t target, uint32_t cf_index) {
+    if (target <= cf_index) {
+      first_backward_target = std::min(first_backward_target, target);
+    }
+  };
+  const auto walk_exec = [&](const ParsedExecInstruction& instr, uint32_t cf_index) {
+    uint32_t sequence = instr.sequence;
+    for (uint32_t instr_offset = instr.instruction_address;
+         instr_offset < instr.instruction_address + instr.instruction_count; ++instr_offset, sequence >>= 2) {
+      const uint32_t* op_ptr = ucode_data_.data() + instr_offset * 3;
+      if (sequence & 0b01) {
+        auto& op = *reinterpret_cast<const FetchInstruction*>(op_ptr);
+        if (op.opcode() == FetchOpcode::kVertexFetch) {
+          const VertexFetchInstruction& vfetch_op = op.vertex_fetch();
+          ParsedVertexFetchInstruction fetch_instr;
+          if (ParseVertexFetchInstruction(vfetch_op, previous_vfetch_full, fetch_instr)) {
+            previous_vfetch_full = vfetch_op;
+          }
+          VertexFetchCensusEntry entry;
+          entry.instruction_address = instr_offset;
+          entry.cf_index = cf_index;
+          entry.fetch_constant = fetch_instr.operands[1].storage_index;
+          entry.is_mini = fetch_instr.is_mini_fetch;
+          if (entry.is_mini) {
+            entry.plain_index = previous_full_plain;
+          } else {
+            const InstructionOperand& index = fetch_instr.operands[0];
+            entry.plain_index = !control_flow_complex && !r0x_written &&
+                                index.storage_source == InstructionStorageSource::kRegister &&
+                                index.storage_index == 0 &&
+                                index.storage_addressing_mode == InstructionStorageAddressingMode::kAbsolute &&
+                                !index.is_negated && !index.is_absolute_value &&
+                                index.components[0] == SwizzleSource::kX;
+            previous_full_plain = entry.plain_index;
+          }
+          entry.format = fetch_instr.attributes.data_format;
+          entry.stride_words = fetch_instr.attributes.stride;
+          entry.offset_words = fetch_instr.attributes.offset;
+          entry.is_signed = fetch_instr.attributes.is_signed;
+          entry.is_normalized = !fetch_instr.attributes.is_integer;
+          entry.is_index_rounded = fetch_instr.attributes.is_index_rounded;
+          entry.used_components = fetch_instr.result.GetUsedResultComponents();
+          out.push_back(entry);
+          if (result_may_write_r0x(fetch_instr.result)) {
+            r0x_written = true;
+          }
+        } else {
+          ParsedTextureFetchInstruction tfetch_instr;
+          ParseTextureFetchInstruction(op.texture_fetch(), tfetch_instr);
+          if (result_may_write_r0x(tfetch_instr.result)) {
+            r0x_written = true;
+          }
+        }
+      } else {
+        auto& op = *reinterpret_cast<const AluInstruction*>(op_ptr);
+        ParsedAluInstruction alu_instr;
+        ParseAluInstruction(op, type(), alu_instr);
+        if (result_may_write_r0x(alu_instr.vector_and_constant_result) ||
+            result_may_write_r0x(alu_instr.scalar_result)) {
+          r0x_written = true;
+        }
+      }
+    }
+  };
+  for (uint32_t i = 0; i < cf_pair_index_bound_; ++i) {
+    ControlFlowInstruction cf_ab[2];
+    UnpackControlFlowInstructions(ucode_data_.data() + i * 3, cf_ab);
+    for (uint32_t j = 0; j < 2; ++j) {
+      const uint32_t cf_index = i * 2 + j;
+      const ControlFlowInstruction& cf = cf_ab[j];
+      switch (cf.opcode()) {
+        case ControlFlowOpcode::kExec:
+        case ControlFlowOpcode::kExecEnd: {
+          ParsedExecInstruction instr;
+          ParseControlFlowExec(cf.exec, cf_index, instr);
+          walk_exec(instr, cf_index);
+        } break;
+        case ControlFlowOpcode::kCondExec:
+        case ControlFlowOpcode::kCondExecEnd:
+        case ControlFlowOpcode::kCondExecPredClean:
+        case ControlFlowOpcode::kCondExecPredCleanEnd: {
+          ParsedExecInstruction instr;
+          ParseControlFlowCondExec(cf.cond_exec, cf_index, instr);
+          walk_exec(instr, cf_index);
+        } break;
+        case ControlFlowOpcode::kCondExecPred:
+        case ControlFlowOpcode::kCondExecPredEnd: {
