+// wwe2k14 patch (Session 66, PS spec 1): how many translations the texture specialisation would make per pixel shader.
+void VulkanCommandProcessor::PsCensusSummary() {
+  uint64_t draws = 0, unspecialised = 0, pairs = 0;
+  uint32_t drawn = 0, max_keys = 0, multi = 0;
+  std::map<uint32_t, uint32_t> histogram;
+  std::vector<std::pair<uint32_t, uint64_t>> top;
+  for (const auto& [hash, ps] : ps_census_shaders_) {
+    if (!ps.draws) continue;
+    ++drawn;
+    draws += ps.draws;
+    unspecialised += ps.unspecialised_draws;
+    const uint32_t keys = uint32_t(ps.keys.size()) + (ps.keys_overflow ? 1 : 0);
+    pairs += keys;
+    max_keys = std::max(max_keys, keys);
+    multi += keys > 1;
+    ++histogram[keys];
+    top.emplace_back(keys, hash);
+  }
+  std::sort(top.begin(), top.end(), std::greater<>());
+  std::string hist_text, top_text;
+  for (const auto& [k, n] : histogram) hist_text += fmt::format("{}{} keys:{}", hist_text.empty() ? "" : " ", k, n);
+  for (size_t i = 0; i < top.size() && i < 5 && top[i].first > 1; ++i) {
+    const PsCensusShader& ps = ps_census_shaders_[top[i].second];
+    std::string keys;
+    for (uint32_t k : ps.keys) keys += fmt::format("{}{:X}", keys.empty() ? "" : ",", k);
+    top_text += fmt::format("{}{:016X} ({} draws) keys {}", top_text.empty() ? "" : "; ", top[i].second, ps.draws, keys);
+  }
+  REXGPU_INFO(
+      "[ps][census] summary over {} frames (key = texture mask bits 0-3, epilogue idle bit 4, LOD-bias-0 bits 8-11): "
+      "pixel shaders {}, draws {}, draws with key 0 (nothing to specialise) {}, distinct (shader, key) translations {}, "
+      "max keys per shader {}, shaders with >1 key {}, shaders by key count {{{}}}; most keys: {}",
+      ps_census_frames_, drawn, draws, unspecialised, pairs, max_keys, multi, hist_text,
+      top_text.empty() ? "-" : top_text);
+}
+
+void VulkanCommandProcessor::VertexCensusSummary() {
+  const VertexCensus& census = vertex_census_;
+  std::map<std::string, uint64_t> formats;
+  uint32_t max_modes = 0, multi_mode_shaders = 0, max_keys = 0, multi_key_shaders = 0;
+  for (const auto& [hash, shader] : census.shaders) {
+    if (!shader.draws) continue;
+    for (const auto& f : shader.formats) formats[f.first] += shader.draws * f.second;
+    uint32_t modes = 0;
+    for (uint32_t m = 0; m < 4; ++m) modes += (shader.modes_seen >> m) & 1;
+    max_modes = std::max(max_modes, modes);
+    multi_mode_shaders += modes > 1;
+    const uint32_t keys = uint32_t(shader.keys.size()) + (shader.keys_overflow ? 1 : 0);
+    max_keys = std::max(max_keys, keys);
+    multi_key_shaders += keys > 1;
+  }
+  std::string format_text;
+  for (const auto& [name, n] : formats) format_text += fmt::format("{}{}:{}", format_text.empty() ? "" : ", ", name, n);
+  const VertexCensusCounts& t = census.total;
+  uint32_t shaders_drawn = 0;
+  for (const auto& entry : census.shaders) shaders_drawn += entry.second.draws ? 1 : 0;
+  std::string kinds, types, endian;
+  for (uint32_t i = 0; i < kVertexCensusKindCount; ++i) {
+    kinds += fmt::format("{}{}:{}", i ? " " : "", kVertexCensusKindNames[i], t.kinds[i]);
+  }
+  for (uint32_t i = 0; i < 16; ++i) {
+    if (t.types[i]) types += fmt::format("{}{}:{}", types.empty() ? "" : " ", VertexCensusTypeName(i), t.types[i]);
+  }
+  for (uint32_t i = 0; i < 4; ++i) {
+    endian += fmt::format("{}{}:{}", i ? " " : "", kVertexCensusEndianNames[i], t.endian[i]);
+  }
+  REXGPU_INFO(
+      "[vfetch][census] summary over {} frames: draws {}, eligible-index draws {} ({:.1f}%), no-vfetch draws {}, paths "
+      "{{{}}}, host types {{{}}}, formats {{{}}} (draw-weighted, per vfetch), endian modes {{{}}} (draw-weighted, per "
+      "fetch constant), distinct endian modes per shader max {}, shaders {}, shaders seeing >1 endian mode {}, distinct "
+      "endian keys (the modes of all a shader's fetch constants together) per shader max {}, shaders seeing >1 key {}",
+      census.frames, t.draws, t.eligible, t.draws ? 100.0 * double(t.eligible) / double(t.draws) : 0.0, t.no_fetch,
+      kinds, types, format_text, endian, max_modes, shaders_drawn, multi_mode_shaders, max_keys, multi_key_shaders);
+}
