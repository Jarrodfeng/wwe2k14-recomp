+// One draw (weight draws) of the vertex shader, recorded by the path `kind`.
+void VulkanCommandProcessor::VertexCensusDraw(const VulkanShader& vertex_shader, const Shader* pixel_shader,
+                                              VertexCensusKind kind, uint32_t host_vertex_shader_type,
+                                              uint32_t weight) {
+  if (kind <= kVertexCensusLean) {
+    vertex_census_last_type_ = host_vertex_shader_type;
+  }
+  if (vertex_census_p_ && pixel_shader) {  // wwe2k14 patch (Session 66, PS spec 1)
+    PsCensusShader& ps = ps_census_shaders_[pixel_shader->ucode_data_hash()];
+    // The key of every pixel specialisation the shader's draws could have (settings forced on): bits 0-3 the texture
+    // signs mask, bit 4 the colour epilogue state (native_ext), bits 8-11 which of the first 4 texture bindings have a
+    // fetch constant LOD bias of 0 (word 4 bits 12:21 - the cheap follow-up, not specialised yet).
+    uint32_t key = pipeline_cache_->GetNativePixelSpecKey(pixel_shader, true) & 0xF;
+    if (NativePixelExt(pixel_shader, true) & SpirvShaderTranslator::kNativeExtEpilogueIdle) {
+      key |= 1u << 4;
+    }
+    for (const Shader::TextureBinding& binding : pixel_shader->texture_bindings()) {
+      if (binding.binding_index < 4 &&
+          !((register_file_->GetTextureFetch(binding.fetch_constant).dword_4 >> 12) & 0x3FFu)) {
+        key |= 1u << (8 + binding.binding_index);
+      }
+    }
+    ps.draws += weight;
+    ps.unspecialised_draws += key ? 0 : weight;
+    if (!ps.keys_overflow && std::find(ps.keys.begin(), ps.keys.end(), key) == ps.keys.end()) {
+      if (ps.keys.size() < 32) {
+        ps.keys.push_back(key);
+      } else {
+        ps.keys_overflow = true;
+      }
+    }
+  }
+  if (!vertex_census_v_) {
+    return;
+  }
+  VertexCensus& census = vertex_census_;
+  VertexCensusShader& shader = census.shaders[vertex_shader.ucode_data_hash()];
+  if (!shader.analyzed) {
+    shader.analyzed = true;
+    shader.bindings = uint32_t(vertex_shader.vertex_bindings().size());
+    vertex_shader.GatherVertexFetchCensus(census.scratch);
+    for (const Shader::VertexFetchCensusEntry& e : census.scratch) {
+      ++shader.fetches;
+      shader.plain += e.plain_index ? 1 : 0;
+      const std::string description = fmt::format("{} {} {}", VertexCensusFormatName(e.format),
+                                                  e.is_normalized ? "norm" : "int", e.is_signed ? "signed" : "unsigned");
+      bool found = false;
+      for (auto& f : shader.formats) {
+        if (f.first == description) {
+          ++f.second;
+          found = true;
+          break;
+        }
+      }
+      if (!found) shader.formats.emplace_back(description, 1u);
+    }
+    shader.eligible = shader.fetches && shader.plain == shader.fetches;
+    REXGPU_INFO("[vfetch][census] shader {:016X}: {} vfetch ({} full, {} mini), {} bindings, plain index {}/{} -> {}",
+                vertex_shader.ucode_data_hash(), shader.fetches,
+                std::count_if(census.scratch.begin(), census.scratch.end(), [](const auto& e) { return !e.is_mini; }),
+                std::count_if(census.scratch.begin(), census.scratch.end(), [](const auto& e) { return e.is_mini; }),
+                shader.bindings, shader.plain, shader.fetches,
+                !shader.fetches ? "no vfetch" : shader.eligible ? "eligible" : "not eligible");
+    for (const Shader::VertexFetchCensusEntry& e : census.scratch) {
+      REXGPU_INFO("[vfetch][census]   vf{} @{}: {} {} {} stride {}w offset {}w components 0x{:X} index {}{}",
+                  e.fetch_constant, e.instruction_address, VertexCensusFormatName(e.format),
+                  e.is_normalized ? "norm" : "int", e.is_signed ? "signed" : "unsigned", e.stride_words, e.offset_words,
+                  e.used_components, e.plain_index ? "plain" : "computed", e.is_mini ? " (mini, full's index)" : "");
+    }
+  }
+  const RegisterFile& regs = *register_file_;
+  uint32_t key = 0;
+  const std::vector<Shader::VertexBinding>& bindings = vertex_shader.vertex_bindings();
+  VertexCensusCounts& frame = census.frame;
+  for (size_t i = 0; i < bindings.size(); ++i) {
+    const uint32_t mode = uint32_t(regs.GetVertexFetch(bindings[i].fetch_constant).endian) & 3;
+    frame.endian[mode] += weight;
+    shader.modes_seen |= 1u << mode;
+    if (i < 8) key |= mode << (2 * i);
+  }
+  if (!bindings.empty() && bindings.size() <= 8 && !shader.keys_overflow &&
+      std::find(shader.keys.begin(), shader.keys.end(), key) == shader.keys.end()) {
+    if (shader.keys.size() < 16) {
+      shader.keys.push_back(key);
+    } else {
+      shader.keys_overflow = true;
+    }
+  }
+  shader.draws += weight;
+  frame.draws += weight;
+  frame.kinds[kind] += weight;
+  frame.types[host_vertex_shader_type & 15] += weight;
+  if (!shader.fetches) {
+    frame.no_fetch += weight;
+  } else if (shader.eligible) {
+    frame.eligible += weight;
+  }
+}
