+void VulkanCommandProcessor::FlushPendingReadbacks(GuestVisibleEvent reason) {
+  if (readback_pending_.empty() || readback_flushing_) {
+    return;
+  }
+  static_assert(std::size(kReadbackFlushReasonNames) == size_t(GuestVisibleEvent::kCount),
+                "kReadbackFlushReasonNames must match GuestVisibleEvent");
