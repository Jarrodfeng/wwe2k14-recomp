+void VulkanCommandProcessor::OnGuestVisibleWrite(GuestVisibleEvent event, uint32_t address) {
+  if (readback_pending_.empty()) {
+    return;
+  }
+  if (!REXCVAR_GET(readback_resolve_batch)) {
+    FlushPendingReadbacks(GuestVisibleEvent::kCvarOff);
+    return;
