+      }
+    }
+  }
+  // A fetch at or after a backward target may run again after r0.x was written.
+  if (first_backward_target != UINT32_MAX) {
+    for (VertexFetchCensusEntry& entry : out) {
+      if (entry.cf_index >= first_backward_target) {
+        entry.plain_index = false;
+      }
+    }
+  }
+}
