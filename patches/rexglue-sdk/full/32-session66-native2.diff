+uint32_t VulkanPipelineCache::GetNativeVertexMulKey() const {
+  const NativeSpecLatch& spec = NativeSpec();
+  if (!spec.vs_mul || !spec.native) {
+    return 0;
+  }
+  return spec.vs_mul | (spec.vs_fetch_finite ? 4u : 0u);
