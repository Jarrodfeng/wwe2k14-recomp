+// wwe2k14 patch (Session 66, B2.0 gpu_native_vertex_census): see the header.
+namespace {
+const char* VertexCensusFormatName(xenos::VertexFormat format) {
+  switch (format) {
+    case xenos::VertexFormat::k_8_8_8_8: return "8_8_8_8";
+    case xenos::VertexFormat::k_2_10_10_10: return "2_10_10_10";
+    case xenos::VertexFormat::k_10_11_11: return "10_11_11";
+    case xenos::VertexFormat::k_11_11_10: return "11_11_10";
+    case xenos::VertexFormat::k_16_16: return "16_16";
+    case xenos::VertexFormat::k_16_16_16_16: return "16_16_16_16";
+    case xenos::VertexFormat::k_16_16_FLOAT: return "16_16_FLOAT";
+    case xenos::VertexFormat::k_16_16_16_16_FLOAT: return "16_16_16_16_FLOAT";
+    case xenos::VertexFormat::k_32: return "32";
+    case xenos::VertexFormat::k_32_32: return "32_32";
+    case xenos::VertexFormat::k_32_32_32_32: return "32_32_32_32";
+    case xenos::VertexFormat::k_32_FLOAT: return "32_FLOAT";
+    case xenos::VertexFormat::k_32_32_FLOAT: return "32_32_FLOAT";
+    case xenos::VertexFormat::k_32_32_32_32_FLOAT: return "32_32_32_32_FLOAT";
+    case xenos::VertexFormat::k_32_32_32_FLOAT: return "32_32_32_FLOAT";
+    default: return "undefined";
+  }
+}
+const char* VertexCensusTypeName(uint32_t type) {
+  switch (Shader::HostVertexShaderType(type)) {
+    case Shader::HostVertexShaderType::kVertex: return "vertex";
+    case Shader::HostVertexShaderType::kMemExportCompute: return "memexport";
+    case Shader::HostVertexShaderType::kPointListAsTriangleStrip: return "point_strip";
+    case Shader::HostVertexShaderType::kRectangleListAsTriangleStrip: return "rect_strip";
+    default: return "domain";
+  }
+}
+const char* const kVertexCensusEndianNames[4] = {"none", "8in16", "8in32", "16in32"};
+const char* const kVertexCensusKindNames[] = {"full", "native", "lean", "repeat", "crowd"};
+template <typename Counts>
+std::string VertexCensusDescribe(const Counts& c, uint32_t kind_count) {
+  std::string kinds, types, endian;
+  for (uint32_t i = 0; i < kind_count; ++i) {
+    kinds += fmt::format("{}{}:{}", i ? " " : "", kVertexCensusKindNames[i], c.kinds[i]);
+  }
+  for (uint32_t i = 0; i < 16; ++i) {
+    if (c.types[i]) types += fmt::format("{}{}:{}", types.empty() ? "" : " ", VertexCensusTypeName(i), c.types[i]);
+  }
+  for (uint32_t i = 0; i < 4; ++i) {
+    endian += fmt::format("{}{}:{}", i ? " " : "", kVertexCensusEndianNames[i], c.endian[i]);
+  }
+  return fmt::format("draws {}, eligible-index {}, no-vfetch {}, paths {{{}}}, host types {{{}}}, endian {{{}}}", c.draws,
+                     c.eligible, c.no_fetch, kinds, types, endian);
+}
