+
+bool DrainLogging(unsigned timeout_ms) {
+  std::shared_ptr<rex::AsyncSink> s;
+  {
+    std::lock_guard lock(g_mutex);
+    s = g_async_sink;
+  }
+  return !s || s->Drain(timeout_ms);
+}
