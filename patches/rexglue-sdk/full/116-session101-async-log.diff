+LogWriteStats TakeLogWriteStats() {
+  std::shared_ptr<rex::AsyncSink> s;
+  {
+    std::lock_guard lock(g_mutex);
+    s = g_async_sink;
+  }
+  return s ? s->TakeStats() : LogWriteStats{};
 }
 
