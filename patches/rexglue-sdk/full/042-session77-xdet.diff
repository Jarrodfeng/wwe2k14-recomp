@@ -203,14 +203,28 @@ inline int32_t cvt_f64_i32_current(double v) {
   return simde_mm_cvtsd_si32(simde_mm_load_sd(&v));
 #endif
 }
+// wwe2k14 patch (Session 77, XDET_PLAN.md gap 13): fctid / fctidz saturate like the PowerPC on every platform: NaN ->
+// 0x8000000000000000, at or above 2^63 -> INT64_MAX, below -2^63 -> INT64_MIN. x86's conversion returned
+// 0x8000000000000000 for exactly 2^63 (the generated guard was "> double(LLONG_MAX)", and double(LLONG_MAX) is 2^63);
+// ARM saturated to INT64_MAX (tools\android\cpu_semantics: input 43e0000000000000). 2^63 and -2^63 are exact doubles,
+// and every double of magnitude 2^52 or more is an integer, so the range test needs no rounding first.
 inline int64_t cvt_f64_i64_current(double v) {
+  if (v != v) return INT64_MIN;
+  if (v >= 9223372036854775808.0) return INT64_MAX;
+  if (v < -9223372036854775808.0) return INT64_MIN;
 #if defined(__aarch64__) || defined(_M_ARM64)
-  const double r = std::nearbyint(v);
-  return r < -9223372036854775808.0 ? INT64_MIN : r >= 9223372036854775808.0 ? INT64_MAX : int64_t(r);
+  return int64_t(std::nearbyint(v));
 #else
   return simde_mm_cvtsd_si64(simde_mm_load_sd(&v));
 #endif
 }
+// fctidz: the same, rounding toward zero (a C++ conversion of an in-range double truncates on every platform).
+inline int64_t cvt_f64_i64_trunc(double v) {
+  if (v != v) return INT64_MIN;
+  if (v >= 9223372036854775808.0) return INT64_MAX;
+  if (v < -9223372036854775808.0) return INT64_MIN;
+  return int64_t(v);
+}
 
