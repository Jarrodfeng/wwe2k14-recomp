+// wwe2k14 patch (Session 77): the codegen binary itself, so a changed instruction builder regenerates (the version
+// string and the templates hash stayed the same when only a builder changed: the fctid / fctidz saturation fix
+// reported "1 module(s) up to date" and left all 876 old statements in place). Files are still written only when
+// their content changes, so a rebuilt tool with the same output costs one codegen pass and no recompiles.
+// The codegen tool's own binaries: the executable and the runtime library next to it (the xex loader and the export
+// tables codegen reads). They are also written to the depfile (below), so the build re-runs codegen when either
+// changes (Session 77 review: without them ninja never started the new rexglue, and the fingerprint above never ran).
+std::vector<std::filesystem::path> ToolBinaries() {
+  std::vector<std::filesystem::path> out;
+  const std::filesystem::path exe = rex::filesystem::GetExecutablePath();
+  if (exe.empty()) return out;
+  out.push_back(exe);
+#if REX_PLATFORM_WIN32
+  const std::filesystem::path runtime = exe.parent_path() / "rexruntime.dll";
+#elif REX_PLATFORM_MAC
+  const std::filesystem::path runtime = exe.parent_path() / "librexruntime.dylib";
+#else
+  const std::filesystem::path runtime = exe.parent_path() / "librexruntime.so";
+#endif
+  std::error_code ec;
+  if (std::filesystem::exists(runtime, ec)) out.push_back(runtime);
+  return out;
+}
+
+const std::string& ToolBinaryHash() {
+  static const std::string hash = [] {
+    std::string all;
+    for (const auto& path : ToolBinaries()) {
+      const std::string digest = rex::hash_file(path);
+      all += (all.empty() ? "" : "+") + (digest.empty() ? std::string("<unreadable>") : digest);
+    }
+    if (all.empty()) {
+      REXCODEGEN_WARN("codegen: cannot find or read its own binary; a changed tool may not regenerate");
+      return std::string("<unknown>");
+    }
+    return all;
+  }();
+  return hash;
+}
