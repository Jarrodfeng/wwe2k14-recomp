+// wwe2k14 patch (Session 8, FLIGHT): the newest crash checkpoint records for the app's flight recorder, newest
+// first. Called from any thread (a dump), while this thread may keep recording: racy by design, so each record
+// is copied and shown only if its id is still the expected one after the copy. Nothing is locked or allocated on
+// the command processor side.
+std::string VulkanCommandProcessor::FlightGpuRecords(void* user, uint32_t max_records) {
+  if (!REXCVAR_GET(vulkan_flight_gpu_records)) {
+    return "  (off: vulkan_flight_gpu_records=false)\n";
+  }
+  auto* self = static_cast<VulkanCommandProcessor*>(user);
+  if (!self || !self->crash_checkpoints_enabled()) {
+    return "  (none: needs vulkan_gpu_crash_diagnostics=true and VK_NV_device_diagnostic_checkpoints)\n";
+  }
+  const CrashCheckpointRecord* ring = self->crash_checkpoint_ring_.data();
+  const size_t ring_size = self->crash_checkpoint_ring_.size();
+  const uint64_t next = *reinterpret_cast<const volatile uint64_t*>(&self->crash_checkpoint_next_id_);
+  const uint64_t completed = *reinterpret_cast<const volatile uint64_t*>(&self->submission_completed_);
+  std::string out = fmt::format(
+      "  next record id {}, current submission {}, completed submission {}, CP frame {}; {} slots\n", next,
+      self->GetCurrentSubmission(), completed, self->frame_current_, ring_size);
+  if (!ring || ring_size != kCrashCheckpointRingSize || next <= 1) {
+    return out + "  (no records yet)\n";
+  }
+  const uint64_t count = std::min<uint64_t>({uint64_t(max_records), next - 1, uint64_t(ring_size) / 2});
+  for (uint64_t k = 0; k < count; ++k) {
+    const uint64_t id = next - 1 - k;
+    const CrashCheckpointRecord* slot = &ring[id % kCrashCheckpointRingSize];
+    CrashCheckpointRecord r;
+    std::memcpy(static_cast<void*>(&r), static_cast<const void*>(slot), sizeof(r));
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if (r.id != id || *reinterpret_cast<const volatile uint64_t*>(&slot->id) != id) {
+      continue;
+    }
+    out += fmt::format(
+        "  #{} {} sub={}{} frame={} vs={:016X} ps={:016X} prim={}/{} guest_count={} host_count={} ib_type={} "
+        "ib_base=0x{:X} edram_mode={} memexport={}/{} surface=0x{:08X} color0=0x{:08X} depth=0x{:08X}\n",
+        r.id, CrashCheckpointPhaseName(uint32_t(r.last_phase)), r.submission,
+        r.submission > completed ? " (not completed)" : "", r.frame, r.vertex_shader_hash, r.pixel_shader_hash,
+        r.guest_primitive_type, r.host_primitive_type, r.guest_index_count, r.host_vertex_count,
+        r.index_buffer_type, r.guest_index_base, r.edram_mode, r.memexport_vertex, r.memexport_pixel,
+        r.rb_surface_info, r.rb_color_info, r.rb_depth_info);
+  }
+  return out;
+}
