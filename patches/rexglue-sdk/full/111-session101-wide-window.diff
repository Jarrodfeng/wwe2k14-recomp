 // wwe2k14 patch (Session 61): after a draw is recorded - the DLSS pre-HUD snapshot (Session 24) and the hide-HUD /
 // wide detection (Session 33) of the post chain's last pass. IssueDraw and (Session 61: truth frames take that pass
 // through it) IssueDrawLean both call it.
+// wwe2k14 patch (Session 101, lane 178; renderer_adapter/wide_rule.h FullViewQuad, lane 177): does this flat pixel-placed rectangle (the game's
+// T_Rect: four (x, y, z) vertices, PosScale c0.xy = (2 / view width, 2 / view height), fUseProjMatrix c28.x = 0; clip = ((x, y) - 0.5) * PosScale - 1)
+// cover the whole view, all four edges within 1 guest pixel? Axis-aligned, a real area; a line, a point or a rotated quad do not.
+static bool WideFullViewRect(const float* x, const float* y, float pos_x, float pos_y, float use_proj) {
+  if (!(pos_x > 0) || !(pos_y > 0) || use_proj != 0) return false;
+  const float w = 2.0f / pos_x, h = 2.0f / pos_y;
+  if (!(w >= 320.0f && w <= 16384.0f && h >= 180.0f && h <= 16384.0f)) return false;
+  float x0 = x[0], x1 = x[0], y0 = y[0], y1 = y[0];
+  for (int i = 0; i < 4; ++i) {
+    if (!std::isfinite(x[i]) || !std::isfinite(y[i])) return false;
+    x0 = x[i] < x0 ? x[i] : x0, x1 = x[i] > x1 ? x[i] : x1;
+    y0 = y[i] < y0 ? y[i] : y0, y1 = y[i] > y1 ? y[i] : y1;
+  }
+  if (!(x1 - x0 > 0.5f * w) || !(y1 - y0 > 0.5f * h)) return false;
+  bool corner[4] = {false, false, false, false};
+  for (int i = 0; i < 4; ++i) {
+    const bool lx = std::fabs(x[i] - x0) < 0.01f, hx = std::fabs(x[i] - x1) < 0.01f;
+    const bool ly = std::fabs(y[i] - y0) < 0.01f, hy = std::fabs(y[i] - y1) < 0.01f;
+    if (!(lx || hx) || !(ly || hy)) return false;
+    corner[(hx ? 1 : 0) + (hy ? 2 : 0)] = true;
+  }
+  if (!(corner[0] && corner[1] && corner[2] && corner[3])) return false;
+  const float slack = 1.0f;
+  return x0 <= 0.5f + slack && x1 >= w + 0.5f - slack && y0 <= 0.5f + slack && y1 >= h + 0.5f - slack;
+}
