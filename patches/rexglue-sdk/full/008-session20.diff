+// wwe2k14 patch (Session 20, RECSTATS)
+void VulkanCommandProcessor::RecStatsDrawBegin(uint64_t vertex_shader_hash) {
+  recstats_in_draw_ = true;
+  recstats_draw_group_ =
+      std::find(recstats_vs_.begin(), recstats_vs_.end(), vertex_shader_hash) != recstats_vs_.end();
+  recstats_draw_start_ = deferred_command_buffer_.record_stats();
+}
+
+void VulkanCommandProcessor::RecStatsDrawEnd() {
+  if (!recstats_in_draw_) {
+    return;
+  }
+  recstats_in_draw_ = false;
+  const RecordStats& now = deferred_command_buffer_.record_stats();
+  RecordStats& sum = recstats_draw_group_ ? recstats_group_ : recstats_rest_;
+  for (uint32_t i = 0; i < RecordStats::kCount; ++i) {
+    sum.c[i] += now.c[i] - recstats_draw_start_.c[i];
+  }
+  ++(recstats_draw_group_ ? recstats_group_draws_ : recstats_rest_draws_);
+}
+
+void VulkanCommandProcessor::RecStatsFrameBoundary() {
+  const int32_t frames = REXCVAR_GET(gpu_record_stats);
+  const RecordStats& now = deferred_command_buffer_.record_stats();
+  if (frames != recstats_frames_) {
+    // Switched on, off or to another window: start a new window.
+    recstats_frames_ = frames;
+    recstats_window_frames_ = 0;
+  }
+  if (frames <= 0) {
+    return;
+  }
+  const std::string vs = REXCVAR_GET(gpu_record_stats_vs);
+  if (vs != recstats_vs_string_) {
+    recstats_vs_string_ = vs;
+    recstats_vs_.clear();
+    for (size_t pos = 0; pos < vs.size();) {
+      const size_t end = std::min(vs.find(',', pos), vs.size());
+      const uint64_t h = std::strtoull(vs.substr(pos, end - pos).c_str(), nullptr, 16);
+      if (h) recstats_vs_.push_back(h);
+      pos = end + 1;
+    }
+    recstats_window_frames_ = 0;
+  }
+  if (recstats_window_frames_ == 0) {
+    recstats_window_start_ = now;
+    recstats_first_frame_ = frame_current_;
+    recstats_group_ = {};
+    recstats_rest_ = {};
+    recstats_group_draws_ = 0;
+    recstats_rest_draws_ = 0;
+  }
+  if (++recstats_window_frames_ <= uint32_t(frames)) {
+    return;
+  }
+  const double n = double(recstats_window_frames_ - 1);
+  auto line = [](const RecordStats& s, double d) {
+    using R = RecordStats;
+    auto v = [&](uint32_t i) { return d > 0 ? double(s.c[i]) / d : 0.0; };
+    return fmt::format(
+        "barrier batches {:.3f} (memory {:.3f}, buffer {:.3f}, image {:.3f}), rendering begins {:.3f}, pipeline binds "
+        "{:.3f}, descriptor binds {:.3f} ({:.3f} sets), push constants {:.3f} ({:.1f} bytes), vertex / index binds "
+        "{:.3f}, viewport / scissor {:.3f}, draws {:.3f}, dispatches {:.3f}",
+        v(R::kBarrierBatches), v(R::kMemoryBarriers), v(R::kBufferBarriers), v(R::kImageBarriers),
+        v(R::kRenderingBegins), v(R::kPipelineBinds), v(R::kDescriptorBinds), v(R::kDescriptorSets),
+        v(R::kPushConstants), v(R::kPushConstantBytes), v(R::kVertexIndexBinds), v(R::kViewportScissor),
+        v(R::kDraws), v(R::kDispatches));
+  };
+  RecordStats frame;
+  for (uint32_t i = 0; i < RecordStats::kCount; ++i) {
+    frame.c[i] = now.c[i] - recstats_window_start_.c[i];
+  }
+  REXGPU_INFO("[s20][RECSTATS] frames {}-{}, per frame: IssueDraw calls {:.1f} (group {:.1f}); {}",
+              recstats_first_frame_, frame_current_, double(recstats_group_draws_ + recstats_rest_draws_) / n,
+              double(recstats_group_draws_) / n, line(frame, n));
+  REXGPU_INFO("[s20][RECSTATS] group ({} shaders), per IssueDraw call: {}", recstats_vs_.size(),
+              line(recstats_group_, double(recstats_group_draws_)));
+  REXGPU_INFO("[s20][RECSTATS] rest, per IssueDraw call: {}", line(recstats_rest_, double(recstats_rest_draws_)));
+  recstats_window_frames_ = 0;
+  // This boundary starts the next window.
+  recstats_window_start_ = now;
+  recstats_first_frame_ = frame_current_;
+  recstats_group_ = {};
+  recstats_rest_ = {};
+  recstats_group_draws_ = 0;
+  recstats_rest_draws_ = 0;
+  recstats_window_frames_ = 1;
+}
