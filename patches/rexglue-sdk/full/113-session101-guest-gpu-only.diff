index 0000000..e7fe0e2
--- /dev/null
+++ b/tests/unit/system/guest_gpu_only_test.cpp
@@ -0,0 +1,181 @@
+/**
+ * @file        tests/unit/system/guest_gpu_only_test.cpp
+ * @brief       RuntimeConfig::guest_gpu_only: the graphics system brought up with no provider and no command processor
+ *
+ * wwe2k14 patch (Session 101, lane 233, docs/renderer/LEAVE_THE_COMMAND_STREAM.md 3b). Own executable (guest_gpu_only_test):
+ * it builds a full Runtime, and the guest Memory cannot be shared with the unit_tests binary's.
+ *
+ * What it proves, offline, with no graphics device on the machine needed (nothing in guest-only mode creates one):
+ *   - Runtime::Setup with the real rexgpu-xenos plugin and guest_gpu_only succeeds, provider() / presenter() /
+ *     command_processor() stay null, SetupPresentation is refused;
+ *   - GPU MMIO reads / writes (the vblank status, the V counter, the viewport size, CP_RB_WPTR) are answered;
+ *   - the Vd ring calls, shader storage, ClearCaches, InvalidateGpuMemory, and Shutdown (Pause / Resume are not virtual and not exported from the plugin: audited by reading) do not touch a null
+ *     command processor;
+ *   - the VSync thread ticks and runs the guest interrupt callback (a host thunk counts the vblanks);
+ *   - VdSwap forms its swap packet in guest memory without any graphics object.
+ */
+
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/graphics/graphics_system.h>
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+#include <rex/memory/utils.h>
+#include <rex/ppc/context.h>
+#include <rex/runtime.h>
+#include <rex/system/function_dispatcher.h>
+#include <rex/system/gpu_plugin.h>
+#include <rex/system/interfaces/graphics.h>
+#include <rex/system/mmio_handler.h>
+#include <rex/system/xmemory.h>
+
+namespace rex::ui {
+class WindowedAppContext;
+}
+
+namespace rex::kernel::xboxkrnl {
+void VdSwap_entry(mapped_void buffer_ptr, mapped_void fetch_ptr, mapped_void unk2, mapped_void unk3, mapped_void unk4,
+                  mapped_u32 frontbuffer_ptr, mapped_u32 texture_format_ptr, mapped_u32 color_space_ptr,
+                  mapped_u32 width, mapped_u32 height);
+}
+
+using rex::X_STATUS;
+
+namespace {
+
+std::atomic<uint32_t> g_vblanks{0};
+std::atomic<uint32_t> g_last_source{0xFFFFFFFF};
+std::atomic<uint32_t> g_last_data{0};
+
+void VblankHandler(PPCContext& ctx, uint8_t*) {
+  g_last_source = uint32_t(ctx.r3.u64);
+  g_last_data = uint32_t(ctx.r4.u64);
+  ++g_vblanks;
+}
+
+uint32_t MmioLoad(uint32_t addr) {
+  auto* mmio = rex::runtime::MMIOHandler::global_handler();
+  REQUIRE(mmio != nullptr);
+  uint32_t value = 0xDEADBEEF;
+  REQUIRE(mmio->CheckLoad(addr, &value));
+  return value;
+}
+
+}  // namespace
+
+TEST_CASE("guest_gpu_only: MMIO, VSync, Vd calls and VdSwap with no provider / command processor", "[gpu][guest_gpu_only]") {
+  rex::RuntimeConfig config;
+  config.graphics = rex::system::LoadGpuPlugin("xenos", "vulkan");
+  REQUIRE(config.graphics != nullptr);
+  config.guest_gpu_only = true;
+
+  rex::Runtime runtime{std::filesystem::path{}};
+  // The ReXApp path: ConstructRuntime always sets an app context, so Runtime::Setup would ask for presentation. The pointer is only
+  // stored (guest-only mode never presents), so a dummy stands in for the window system.
+  runtime.set_app_context(reinterpret_cast<rex::ui::WindowedAppContext*>(uintptr_t(0x10)));
+  REQUIRE(runtime.Setup(std::move(config)) == X_STATUS_SUCCESS);
+
+  rex::system::IGraphicsSystem* igs = runtime.graphics_system();
+  REQUIRE(igs != nullptr);
+  auto* gs = static_cast<rex::graphics::GraphicsSystem*>(igs);  // the plugin's system is the SDK's GraphicsSystem
+
+  {  // nothing is built
+    CHECK(gs->guest_gpu_only());
+    CHECK(igs->provider() == nullptr);
+    CHECK(igs->presenter() == nullptr);
+    CHECK_FALSE(igs->has_presentation());
+    CHECK(gs->command_processor() == nullptr);
+    CHECK(igs->SetupPresentation(nullptr) != X_STATUS_SUCCESS);  // refused, and still nothing built
+    CHECK(igs->provider() == nullptr);
+  }
+
+  {  // MMIO answers
+    CHECK(MmioLoad(0x7FC80000 + 0x1951 * 4) == 1u);  // interrupt status: vblank
+    const uint32_t vcounter = MmioLoad(0x7FC80000 + 0x194C * 4);
+    CHECK(vcounter > 0u);
+    CHECK(vcounter <= 0xFFFu);
+    const uint32_t viewport = MmioLoad(0x7FC80000 + 0x1961 * 4);
+    CHECK((viewport >> 16) > 0u);
+    CHECK((viewport & 0xFFFF) > 0u);
+    CHECK(MmioLoad(0x7FC80000 + 0x0F00 * 4) == 0x08100748u);  // RB_EDRAM_TIMING
+    // Writes: CP_RB_WPTR used to go to the command processor; unknown registers only log.
+    auto* mmio = rex::runtime::MMIOHandler::global_handler();
+    CHECK(mmio->CheckStore(0x7FC80000 + 0x01C5 * 4, 0x40));
+    CHECK(mmio->CheckStore(0x7FC80000 + 0x1844 * 4, 0));
+    CHECK(mmio->CheckStore(0x7FC80000 + 0x0400 * 4, 1));
+    // A register the guest wrote reads back from the file.
+    CHECK(MmioLoad(0x7FC80000 + 0x0400 * 4) == 1u);
+  }
+
+  {  // IGraphicsSystem calls that used to reach the command processor
+    igs->InitializeRingBuffer(0x1000, 16);
+    igs->EnableReadPointerWriteBack(0x2000, 6);
+    igs->InitializeShaderStorage(std::filesystem::path{"guest_gpu_only_test_cache"}, 0x545408B2, true);
+    igs->InitializeShaderStorage(std::filesystem::path{"guest_gpu_only_test_cache"}, 0x545408B2, false);
+    gs->ClearCaches();
+    gs->InvalidateGpuMemory();
+    CHECK_FALSE(std::filesystem::exists("guest_gpu_only_test_cache"));  // no shader storage was made
+  }
+
+  {  // VSync thread ticks and runs the guest callback
+    auto* dispatcher = runtime.function_dispatcher();
+    constexpr uint32_t kImage = 0x82000000u;
+    REQUIRE(dispatcher->InitializeFunctionTable(kImage, 0x10000u, kImage, 0x100000u));
+    const uint32_t thunk = dispatcher->AllocateThunk(&VblankHandler, kImage + 0x100);
+    REQUIRE(thunk != 0);
+    g_vblanks = 0;
+    igs->SetInterruptCallback(thunk, 0x12345678);
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (g_vblanks.load() < 5 && std::chrono::steady_clock::now() < deadline) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    CHECK(g_vblanks.load() >= 5u);
+    CHECK(g_last_source.load() == 0u);  // MarkVblank dispatches source 0
+    CHECK(g_last_data.load() == 0x12345678u);
+  }
+
+  {  // VdSwap forms its swap packet with no graphics object
+    auto* memory = runtime.memory();
+    // A front buffer in physical memory, a swap command area, a fetch constant and the parameter words.
+    const uint32_t front = memory->SystemHeapAlloc(0x1000, 0x1000, rex::memory::kSystemHeapPhysical);
+    const uint32_t area = memory->SystemHeapAlloc(256, 64, rex::memory::kSystemHeapPhysical);
+    const uint32_t fetch = memory->SystemHeapAlloc(32, 32, rex::memory::kSystemHeapPhysical);
+    const uint32_t params = memory->SystemHeapAlloc(64, 16, rex::memory::kSystemHeapPhysical);
+    REQUIRE(front != 0);
+    REQUIRE(area != 0);
+    REQUIRE(fetch != 0);
+    REQUIRE(params != 0);
+    namespace xenos = rex::graphics::xenos;
+    xenos::xe_gpu_texture_fetch_t constant{};
+    constant.base_address = front >> 12;
+    constant.size_2d.width = 1279;
+    constant.size_2d.height = 719;
+    uint32_t* fetch_host = reinterpret_cast<uint32_t*>(memory->TranslateVirtual(fetch));
+    rex::memory::copy_and_swap_32_unaligned(fetch_host, reinterpret_cast<const uint32_t*>(&constant), 6);
+    uint32_t* p = reinterpret_cast<uint32_t*>(memory->TranslateVirtual(params));
+    rex::memory::store_and_swap<uint32_t>(&p[0], front);
+    rex::memory::store_and_swap<uint32_t>(&p[1], uint32_t(xenos::TextureFormat::k_8_8_8_8));
+    rex::memory::store_and_swap<uint32_t>(&p[2], 0);
+    rex::memory::store_and_swap<uint32_t>(&p[3], 1280);
+    rex::memory::store_and_swap<uint32_t>(&p[4], 720);
+    auto mv = [&](uint32_t a) { return mapped_void(memory->TranslateVirtual(a), a); };
+    auto mu = [&](uint32_t a) { return mapped_u32(reinterpret_cast<be_u32*>(memory->TranslateVirtual(a)), a); };
+    rex::kernel::xboxkrnl::VdSwap_entry(mv(area), mv(fetch), mv(0), mv(0), mv(0), mu(params), mu(params + 4), mu(params + 8),
+                                        mu(params + 12), mu(params + 16));
+    // The packet: type-0 write of 6 fetch registers, then PM4_XE_SWAP carrying kSwapSignature.
+    const uint32_t* dwords = reinterpret_cast<const uint32_t*>(memory->TranslateVirtual(area));
+    CHECK(rex::memory::load_and_swap<uint32_t>(&dwords[0]) ==
+          xenos::MakePacketType0(rex::graphics::XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0, 6));
+    CHECK(rex::memory::load_and_swap<uint32_t>(&dwords[7]) == xenos::MakePacketType3(xenos::PM4_XE_SWAP, 4));
+    CHECK(rex::memory::load_and_swap<uint32_t>(&dwords[8]) == xenos::kSwapSignature);
+    CHECK(rex::memory::load_and_swap<uint32_t>(&dwords[11]) == 720u);
+  }
+
+  runtime.Shutdown();  // the command-processor-less system shuts down (VSync thread joined, nothing else to stop)
+  CHECK(runtime.graphics_system() == nullptr);
+}
