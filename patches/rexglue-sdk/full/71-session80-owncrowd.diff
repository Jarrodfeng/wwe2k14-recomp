+bool VulkanCommandProcessor::OwnCrowdDraw(const uint32_t* members, uint32_t count) {
+  if (!REXCVAR_GET(gpu_native_own_crowd) || !native_ || !native_->enabled() || !native_->replacing() || !count) {
+    return false;
+  }
+  const auto* vs = static_cast<const VulkanShader*>(active_vertex_shader());
+  const auto* ps = static_cast<const VulkanShader*>(active_pixel_shader());
+  if (!vs || !ps) return false;
+  std::shared_ptr<const OwnCrowdProgram> program;
+  {
+    std::lock_guard<std::mutex> lock(own_crowd_mutex_);
+    for (const auto& p : own_crowd_programs_) {
+      if (p->vertex_shader_hash == vs->ucode_data_hash()) program = p;
+    }
+  }
+  // (Once per vertex shader and reason, up to 32: why a crowd run kept the game's draws - our coverage.)
+  const auto decline = [&](uint32_t reason, const char* why) {
+    const uint64_t key = vs->ucode_data_hash() ^ (uint64_t(reason) << 59);
+    if (own_crowd_unknown_.size() < 32 &&
+        std::find(own_crowd_unknown_.begin(), own_crowd_unknown_.end(), key) == own_crowd_unknown_.end()) {
+      own_crowd_unknown_.push_back(key);
+      REXGPU_INFO("[native][own_crowd] crowd vertex shader {:016X} (pixel shader {:016X}) kept the game's draws: {}",
+                  vs->ucode_data_hash(), ps->ucode_data_hash(), why);
+    }
+    return false;
+  };
+  if (!program) return decline(1, "no program of ours");
+  const bool entrance = (program->flags & 1) != 0;
+  const RegisterFile& regs = *register_file_;
+  // The member mesh: the vertex shader's first binding, 7 dwords a vertex, 8-in-32 (as the crowd shaders fetch it).
+  const auto& bindings = vs->vertex_bindings();
+  if (bindings.empty() || bindings[0].stride_words != 7) return decline(2, "mesh not 7 dwords a vertex");
+  const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(bindings[0].fetch_constant);
+  const uint32_t base = uint32_t(fetch.address) << 2, bytes = uint32_t(fetch.size) << 2;
+  if (xenos::Endian(fetch.endian) != xenos::Endian::k8in32 || bytes < 28 || bytes > (16u << 20) ||
+      uint64_t(base) + bytes > 0x20000000ull) {
+    return decline(3, "mesh endian or size");
+  }
+  // The position as the guest's: clip space from the shader, the host's ndc conversion (no divides by w).
+  const SpirvShaderTranslator::SystemConstants& sc = system_constants_;
+  if ((sc.flags & (SpirvShaderTranslator::kSysFlag_XYDividedByW | SpirvShaderTranslator::kSysFlag_ZDividedByW)) ||
+      !(sc.flags & SpirvShaderTranslator::kSysFlag_WNotReciprocal)) {
+    return decline(4, "position divided by w / reciprocal w");
+  }
+  native::NativeRenderer::OwnCrowdInput in;
+  in.vertex_shader_hash = vs->ucode_data_hash();
+  in.vs_words = program->vs.data();
+  in.vs_count = program->vs.size();
+  in.fs_words = program->fs.data();
+  in.fs_count = program->fs.size();
+  in.mesh_guest = memory_->TranslatePhysical(base);
+  in.mesh_vertices = bytes / 28;
+  in.members = members;
+  in.member_count = count;
+  // The scene block (src\scene\own_crowd_vs.glsl CrowdScene): the game's vertex constants by register.
+  uint32_t* scene = reinterpret_cast<uint32_t*>(in.scene);
+  const auto c = [&](uint32_t vec4_index, uint32_t reg) {
+    for (uint32_t i = 0; i < 4; ++i) scene[vec4_index * 4 + i] = regs[XE_GPU_REG_SHADER_CONSTANT_000_X + 4 * reg + i];
+  };
+  for (uint32_t i = 0; i < 4; ++i) {
+    c(i, 56 + i);     // view_proj
+    c(4 + i, 8 + i);  // light_dir
+    c(8 + i, 0 + i);  // light_color
+  }
+  c(12, 74);
+  c(13, 180);
+  c(14, 181);
+  c(15, 182);
+  c(16, 184);
+  c(17, 189);
+  c(18, 190);
+  c(19, 255);
+  for (uint32_t i = 0; i < 3; ++i) {
+    in.scene[20 * 4 + i] = sc.ndc_scale[i];
+    in.scene[21 * 4 + i] = sc.ndc_offset[i];
+  }
+  scene[22 * 4 + 0] = uint32_t(sc.vertex_index_endian);
+  scene[22 * 4 + 1] = uint32_t(sc.vertex_base_index);
+  scene[22 * 4 + 2] = sc.vertex_index_min;
+  scene[22 * 4 + 3] = sc.vertex_index_max;
+  // The textures and their samplers as the first member's draw bound them.
+  const auto texture = [&](const VulkanShader* shader, bool vertex, uint32_t fc, VkImageView& view,
+                           VkSampler& sampler) {
+    view = texture_cache_->GetActiveBindingOrNullImageView(fc, xenos::FetchOpDimension::k2D, false);
+    const auto& samplers = shader->GetSamplerBindingsAfterTranslation();
+    const auto& current = vertex ? current_samplers_vertex_ : current_samplers_pixel_;
+    sampler = VK_NULL_HANDLE;
+    for (size_t i = 0; i < samplers.size() && i < current.size(); ++i) {
+      if (samplers[i].fetch_constant == fc) sampler = current[i].second;
+    }
+    return view != VK_NULL_HANDLE && sampler != VK_NULL_HANDLE;
+  };
+  if (!texture(ps, false, 0, in.views[1], in.samplers[1])) return decline(5, "colour texture (fetch 0)");
+  if (entrance) {
+    if (!texture(ps, false, 13, in.views[2], in.samplers[2])) return decline(6, "lighting map (fetch 13)");
+    in.views[0] = in.views[1];
+    in.samplers[0] = in.samplers[1];
+  } else {
+    if (!texture(vs, true, 16, in.views[0], in.samplers[0])) return decline(7, "vertex lighting map (fetch 16)");
+    in.views[2] = in.views[1];
+    in.samplers[2] = in.samplers[1];
+  }
+  if (!native_->RecordOwnCrowd(in)) return false;  // (counted in the renderer's own line)
+  // Our pipeline, layout and set were bound: everything the next draw relies on is forgotten.
+  NativeStateTouched(false);
+  repeat_prev_.valid = false;
+  return true;
+}
