+void VulkanCommandProcessor::BarMapFrameBoundary() {
+  const int32_t frames = REXCVAR_GET(gpu_barrier_map);
+  if (frames != barmap_frames_) {
+    barmap_frames_ = frames;
+    barmap_sites_.clear();
+    barmap_window_frames_ = 0;
+  }
+  if (frames <= 0) {
+    return;
+  }
+  if (barmap_window_frames_++ == 0) {
+    // The first boundary starts the window (a partial frame before it is dropped).
+    barmap_sites_.clear();
+    barmap_first_frame_ = frame_current_;
+    return;
+  }
+  if (barmap_window_frames_ <= uint32_t(frames)) {
+    return;
+  }
+  const double n = double(barmap_window_frames_ - 1);
+  std::vector<const BarMapSite*> sites;
+  uint64_t batches = 0, ends = 0;
+  for (const auto& [key, s] : barmap_sites_) {
+    sites.push_back(&s);
+    batches += s.batches;
+    ends += s.render_pass_ends;
+  }
+  std::sort(sites.begin(), sites.end(),
+            [](const BarMapSite* a, const BarMapSite* b) { return a->batches > b->batches; });
+  HMODULE module = nullptr;
+  GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                     reinterpret_cast<LPCWSTR>(&BarMapRecordModuleAnchor), &module);
+  REXGPU_INFO("[s21][BARMAP] frames {}-{}: {:.1f} SubmitBarriers batches per frame ({:.1f} ending a render pass), "
+              "{} call sites; module base {:X}",
+              barmap_first_frame_, frame_current_, double(batches) / n, double(ends) / n, sites.size(),
+              reinterpret_cast<uintptr_t>(module));
+  for (size_t i = 0; i < sites.size() && i < 40; ++i) {
+    const BarMapSite& s = *sites[i];
+    REXGPU_INFO(
+        "[s21][BARMAP] site {}: {:.2f}/frame, cmds {:.2f}, buffers shared {:.2f} edram {:.2f} other {:.2f}, images "
+        "{:.2f}, render pass ends {:.2f}, src {:08X} dst {:08X}, stack {:X} {:X} {:X}",
+        i, double(s.batches) / n, double(s.commands) / n, double(s.buffer_shared) / n, double(s.buffer_edram) / n,
+        double(s.buffer_other) / n, double(s.images) / n, double(s.render_pass_ends) / n, s.src_stages,
+        s.dst_stages, s.stack[0], s.stack[1], s.stack[2]);
+  }
+  barmap_sites_.clear();
+  barmap_first_frame_ = frame_current_;
+  barmap_window_frames_ = 1;
+}
