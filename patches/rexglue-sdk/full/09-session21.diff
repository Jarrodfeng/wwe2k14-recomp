+// wwe2k14 patch (Session 21, BARMAP): gpu_barrier_map. Measurement only. Called by SubmitBarriers for a non-empty
+// batch while the setting is on: the call site is 3 return addresses (RtlCaptureStackBackTrace from SubmitBarriers'
+// caller up); tools\perf\barmap.py symbolizes them against the staged PDBs. (windows.h comes in through the
+// platform headers.)
+
+void VulkanCommandProcessor::BarMapRecord() {
+  BarMapSite site;
+  void* frames[3] = {};
+  RtlCaptureStackBackTrace(1, 3, frames, nullptr);  // 1: skip SubmitBarriers itself
+  for (uint32_t i = 0; i < 3; ++i) {
+    site.stack[i] = reinterpret_cast<uintptr_t>(frames[i]);
+  }
+  const uint64_t key = site.stack[0] * 0x9E3779B97F4A7C15ull ^ (site.stack[1] * 0xC2B2AE3D27D4EB4Full) ^
+                       (site.stack[2] * 0x165667B19E3779F9ull);
+  auto [it, inserted] = barmap_sites_.try_emplace(key, site);
+  BarMapSite& s = it->second;
+  ++s.batches;
+  s.commands += uint32_t(pending_barriers_.size());
+  const VkBuffer shared_buffer = shared_memory_ ? shared_memory_->buffer() : VK_NULL_HANDLE;
+  const VkBuffer edram_buffer = render_target_cache_ ? render_target_cache_->edram_buffer() : VK_NULL_HANDLE;
+  for (const VkBufferMemoryBarrier& b : pending_barriers_buffer_memory_barriers_) {
+    if (b.buffer == shared_buffer) {
+      ++s.buffer_shared;
+    } else if (b.buffer == edram_buffer) {
+      ++s.buffer_edram;
+    } else {
+      ++s.buffer_other;
+    }
+  }
+  s.images += uint32_t(pending_barriers_image_memory_barriers_.size());
+  if (in_render_pass_) {
+    ++s.render_pass_ends;
+  }
