+// wwe2k14 patch (Session 99, GitHub #180, UNCONFIRMED hypothesis): the pin-escape meter (hold A) fills slowly with an external controller on
+// Android, fine with the touch pad (which has no motor and never reaches here). Every guest XamInputSetState came here and, on the guest thread,
+// queued a UI-thread event pump, took the controllers lock (draining the event queue) and called SDL_RumbleGamepad - on Android a JNI / HID
+// write per call. The guest repeats the same motor values; XInput holds them until they change, and SDL's effect armed below lasts
+// kRumbleDurationMs. So an unchanged (left, right) pair for the same device while its effect still has well over kRumbleRearmMs left returns
+// success at once: no pump, no lock, no SDL call. A change (to 0 too) goes through immediately, and the same values are re-armed before the
+// effect runs out. File-scope (no header change): DeviceIds are never reused (AllocateDeviceId counts up), so a device that goes away and comes
+// back starts fresh. One difference: an unchanged repeat for a device removed since its last arm returns success, not DEVICE_NOT_CONNECTED,
+// until the next change or re-arm (GetDeviceState reports the removal as before).
+namespace {
+constexpr int64_t kRumbleRearmMs = 50000;  // (re-arm 15 s before SDL's 65.5 s effect would run out)
+struct RumbleMemo {
+  uint16_t left = 0, right = 0;
+  int64_t armed_ms = 0;
+};
+std::mutex g_rumble_mutex;
+std::unordered_map<uint32_t, RumbleMemo> g_rumble_memo;
+std::atomic<uint64_t> g_rumble_calls{0}, g_rumble_skipped{0}, g_rumble_sent{0};
+std::atomic<int64_t> g_rumble_max_us{0};
+int64_t RumbleNowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
