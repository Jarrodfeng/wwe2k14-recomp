       }
+      // wwe2k14 patch (Session 19, DRAWRUNS): state_hash,fetch_hash end the row.
+      fmt::format_to(std::back_inserter(text), ",{:016X},{:016X}\n", row.state_hash, row.fetch_hash);
     }
     bool write_ok = true;
     if (text.size()) {
@@ -2990,7 +3010,9 @@ void CommandProcessor::AnatomyFrameBoundary() {
       "ext_minx,ext_maxx,ext_miny,ext_maxy,ext_ok,ext_why,ext_us,"
