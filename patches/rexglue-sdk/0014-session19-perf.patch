From ba0bfeeeeb72d9816919e30e2c5a1ae20a9ba528 Mon Sep 17 00:00:00 2001
From: Jarrod <230525910+Jarrodfeng@users.noreply.github.com>
Date: Wed, 14 Oct 2026 22:24:31 +1100
Subject: [PATCH 2/4] Session 19 VMCACHE: kernel_video_mode_cache (default
 off): VdQueryVideoMode's configured width/height cached for up to 1 s instead
 of 4 by-name cvar lookups per call (4.5% of the CP, run 1437)

---
 src/kernel/xboxkrnl/xboxkrnl_video.cpp | 32 ++++++++++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/src/kernel/xboxkrnl/xboxkrnl_video.cpp b/src/kernel/xboxkrnl/xboxkrnl_video.cpp
index 1254710..d078e0a 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_video.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_video.cpp
@@ -17,6 +17,7 @@
 #include <string>
 
 #include <rex/cvar.h>
+#include <chrono>  // wwe2k14 patch (Session 19, VMCACHE)
 #include <rex/graphics/pipeline/texture/info.h>
 #include <rex/graphics/register_file.h>
 #include <rex/graphics/video_mode_util.h>
@@ -33,6 +34,14 @@
 #include <rex/system/xtypes.h>
 #include <rex/ui/flags.h>
 
+// wwe2k14 patch (Session 19, VMCACHE): VdQueryVideoMode runs every frame (IssueSwap on the command processor, and
+// the guest) and each call made four by-name setting lookups (HasNonDefaultValue: a mutex, a string allocation and
+// the value formatted to a string): 4.5% of the command processor's samples in run 1437. With this on, the configured
+// width / height are computed at most once per second (a changed setting still takes effect within a second).
+REXCVAR_DEFINE_BOOL(kernel_video_mode_cache, false, "Kernel",
+                    "wwe2k14 (Session 19): cache VdQueryVideoMode's configured width / height for up to 1 s instead "
+                    "of looking the settings up by name on every call (every frame)");
+
 namespace {
 // Display gamma type: 0 - linear, 1 - sRGB (CRT), 2 - BT.709 (HDTV), 3 - power
 constexpr uint32_t kDisplayGammaType = 2;
@@ -230,8 +239,27 @@ void VdGetCurrentDisplayInformation_entry(ppc_ptr_t<X_DISPLAY_INFO> display_info
 
 void VdQueryVideoMode(X_VIDEO_MODE* video_mode) {
   // Exposed as CVARs so the guest can observe custom display settings.
-  uint32_t display_width = GetConfiguredVideoModeWidth();
-  uint32_t display_height = GetConfiguredVideoModeHeight();
+  uint32_t display_width, display_height;
+  if (REXCVAR_GET(kernel_video_mode_cache)) {
+    // wwe2k14 patch (Session 19, VMCACHE): width and height packed in one word, refreshed at most once per second.
+    static std::atomic<uint64_t> cached_size{0};
+    static std::atomic<int64_t> cached_at_ms{0};
+    const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                               std::chrono::steady_clock::now().time_since_epoch())
+                               .count();
+    uint64_t size = cached_size.load(std::memory_order_acquire);
+    if (!size || now_ms - cached_at_ms.load(std::memory_order_relaxed) >= 1000) {
+      // 0 = nothing cached yet (a real size is never 0: width >= 640, height >= 480).
+      size = (uint64_t(GetConfiguredVideoModeWidth()) << 32) | GetConfiguredVideoModeHeight();
+      cached_at_ms.store(now_ms, std::memory_order_relaxed);
+      cached_size.store(size, std::memory_order_release);
+    }
+    display_width = uint32_t(size >> 32);
+    display_height = uint32_t(size);
+  } else {
+    display_width = GetConfiguredVideoModeWidth();
+    display_height = GetConfiguredVideoModeHeight();
+  }
   float refresh_rate_hz = GetConfiguredVideoModeRefreshRate();
 
   std::memset(video_mode, 0, sizeof(X_VIDEO_MODE));
-- 
