diff --git a/include/rex/graphics/shared_memory.h b/include/rex/graphics/shared_memory.h
index 950ca66..787a705 100644
--- a/include/rex/graphics/shared_memory.h
+++ b/include/rex/graphics/shared_memory.h
@@ -284,6 +284,27 @@ class SharedMemory {
   void CaptureUploadClearOnly();
   // Hashes the hashed pages of upload_ranges_ and fills upload_ranges_after_skip_ with what still needs a copy.
