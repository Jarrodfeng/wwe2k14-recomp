+        case 0x2: matched = v <= ref; break;
+        case 0x3: matched = v == ref; break;
+        case 0x4: matched = v != ref; break;
+        case 0x5: matched = v >= ref; break;
+        case 0x6: matched = v > ref; break;
+        case 0x7: matched = true; break;
+        default: matched = false; break;
