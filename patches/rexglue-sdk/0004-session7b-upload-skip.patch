+      "device-local, {} allocation fallbacks, {} over the heap share), streaming copy verify skipped {}; "
+      "uniform pool ({}): {:.0f} KB/frame, {} pages in total ({} device-local, {} allocation fallbacks, {} "
+      "over the heap share){}{}",
+      stats.window_first_frame, frame, pool_memory(upload_pool),
+      double(delta(now.upload_bytes, first.upload_bytes) >> 10) / frames,
+      double(delta(now.upload_copy_ticks, first.upload_copy_ticks)) * 1000.0 / double(tick_frequency) / frames,
+      now.upload_pages, now.upload_pages_device_local, now.upload_fallbacks, now.upload_pages_over_share,
+      delta(now.upload_verify_skipped, first.upload_verify_skipped), pool_memory(uniform_pool),
+      double(delta(now.uniform_bytes, first.uniform_bytes) >> 10) / frames, now.uniform_pages,
+      now.uniform_pages_device_local, now.uniform_fallbacks, now.uniform_pages_over_share,
