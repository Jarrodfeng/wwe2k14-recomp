+  anatomy_gpu_row_ = 0;
+  // Review fix: a submission still open (see above) starts this frame's part of it here, bottom-of-pipe, so after
+  // the earlier frame's part (its top-of-pipe cb_begin at the command buffer's start, if any, stays the earlier
+  // frame's).
+  if (submission_open_) {
+    marks.open.cb_begin_tried = true;
+    uint32_t query;
+    if (GpuMarksAllocate(GpuMarkKind::kCbBegin, query)) {
+      deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, marks.pool, query);
+    }
+  }
+}
+
+bool VulkanCommandProcessor::GpuMarksInitialize() {
+  GpuMarks& marks = *gpu_marks_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanInstance::Functions& ifn = vulkan_device->vulkan_instance()->functions();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkPhysicalDevice physical_device = vulkan_device->physical_device();
+  uint32_t queue_family_count = 0;
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count, nullptr);
+  std::vector<VkQueueFamilyProperties> queue_families(queue_family_count);
+  ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count,
+                                               queue_families.data());
+  const uint32_t queue_family = vulkan_device->queue_family_graphics_compute();
+  const uint32_t valid_bits =
+      queue_family < queue_family_count ? queue_families[queue_family].timestampValidBits : 0;
+  VkPhysicalDeviceProperties physical_device_properties;
+  ifn.vkGetPhysicalDeviceProperties(physical_device, &physical_device_properties);
+  const float period_ns = physical_device_properties.limits.timestampPeriod;
+  if (!valid_bits || !(period_ns > 0.0f)) {
+    REXGPU_WARN(
+        "[s7][GPUMARKS] GPU timestamps unavailable (queue family {} timestampValidBits {}, timestampPeriod {}); "
+        "gpu_anatomy_gpu_marks has no effect",
+        queue_family, valid_bits, period_ns);
+    marks.unsupported = true;
+    return false;
+  }
+  VkQueryPoolCreateInfo query_pool_create_info = {};
+  query_pool_create_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  query_pool_create_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  query_pool_create_info.queryCount = GpuMarks::kFrameSlots * GpuMarks::kMarksPerFrame;
+  if (dfn.vkCreateQueryPool(vulkan_device->device(), &query_pool_create_info, nullptr, &marks.pool) !=
+      VK_SUCCESS) {
+    REXGPU_WARN("[s7][GPUMARKS] Failed to create a timestamp query pool; gpu_anatomy_gpu_marks has no effect");
+    marks.pool = VK_NULL_HANDLE;
+    marks.unsupported = true;
+    return false;
+  }
+  marks.period_ns = double(period_ns);
+  marks.mask = valid_bits >= 64 ? UINT64_MAX : (uint64_t(1) << valid_bits) - 1;
+  REXGPU_INFO("[s7][GPUMARKS] GPU marks on: {} frame slots of {} timestamps, {} valid bits, {} ns per tick",
+              GpuMarks::kFrameSlots, GpuMarks::kMarksPerFrame, valid_bits, period_ns);
+  return true;
+}
+
+bool VulkanCommandProcessor::GpuMarksAllocate(GpuMarkKind kind, uint32_t& query_out) {
+  GpuMarks& marks = *gpu_marks_;
+  GpuMarks::Frame& frame = marks.frames[marks.current];
+  GpuMarksSubmission& open = marks.open;
+  const uint32_t index = uint32_t(frame.marks.size());
+  const uint32_t query = marks.current * GpuMarks::kMarksPerFrame + index;
+  // The submission's queries to reset: consecutive ones extend the last range.
+  const bool extend = open.reset_count &&
+                      open.reset_first[open.reset_count - 1] + open.reset_size[open.reset_count - 1] == query;
+  if (index >= GpuMarks::kMarksPerFrame || (!extend && open.reset_count >= GpuMarksSubmission::kMaxResets)) {
+    ++frame.dropped;
+    ++marks.counter_dropped;
+    return false;
+  }
+  if (extend) {
+    ++open.reset_size[open.reset_count - 1];
+  } else {
+    open.reset_first[open.reset_count] = query;
+    open.reset_size[open.reset_count] = 1;
+    ++open.reset_count;
+  }
+  const uint64_t submission = GetCurrentSubmission();
+  frame.marks.push_back({submission, anatomy_gpu_row_, kind});
+  frame.last_submission = submission;
+  ++marks.counter_marks;
+  query_out = query;
+  return true;
+}
+
+void VulkanCommandProcessor::GpuMark(GpuMarkKind kind) {
+  // Only inside a submission: the mark is one of its deferred commands, and its query is in the ranges its
+  // command buffer resets first.
+  if (!submission_open_) {
+    return;
+  }
+  GpuMarks& marks = *gpu_marks_;
+  uint32_t query;
+  if (!marks.open.cb_begin_tried) {
+    // The submission's first mark in a marked frame: its cb_begin comes first in the frame's order.
+    marks.open.cb_begin_tried = true;
+    if (GpuMarksAllocate(GpuMarkKind::kCbBegin, query)) {
+      marks.open.cb_begin = query;
+    }
+  }
+  if (GpuMarksAllocate(kind, query)) {
+    deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, marks.pool, query);
+  }
+}
+
+VulkanCommandProcessor::GpuMarksSubmission VulkanCommandProcessor::GpuMarksEndSubmission() {
+  GpuMarks& marks = *gpu_marks_;
+  GpuMarksSubmission& open = marks.open;
+  // Once per submission (if EndSubmission fails after this, it's called again for the same submission; `open`
+  // is cleared only once the submission is closed).
+  if (gpu_marks_active_ && open.cb_end == UINT32_MAX) {
+    uint32_t query;
+    if (!open.cb_begin_tried) {
+      open.cb_begin_tried = true;
+      if (GpuMarksAllocate(GpuMarkKind::kCbBegin, query)) {
+        open.cb_begin = query;
+      }
+    }
+    if (GpuMarksAllocate(GpuMarkKind::kCbEnd, query)) {
+      open.cb_end = query;
+    }
+  }
+  GpuMarksSubmission submission = open;
+  submission.pool = open.reset_count ? marks.pool : VK_NULL_HANDLE;
+  return submission;
+}
+
+void VulkanCommandProcessor::GpuMarksWriteBegin(VkCommandBuffer command_buffer,
+                                                const GpuMarksSubmission& marks) const {
+  if (marks.pool == VK_NULL_HANDLE) {
+    return;
+  }
+  // First in the command buffer: outside any render pass, and query commands on the same queries execute in
+  // submission order, so the resets precede every write of these queries.
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  for (uint32_t i = 0; i < marks.reset_count; ++i) {
+    dfn.vkCmdResetQueryPool(command_buffer, marks.pool, marks.reset_first[i], marks.reset_size[i]);
+  }
+  if (marks.cb_begin != UINT32_MAX) {
+    dfn.vkCmdWriteTimestamp(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, marks.pool, marks.cb_begin);
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksWriteEnd(VkCommandBuffer command_buffer,
+                                              const GpuMarksSubmission& marks) const {
+  if (marks.pool != VK_NULL_HANDLE && marks.cb_end != UINT32_MAX) {
+    GetVulkanDevice()->functions().vkCmdWriteTimestamp(command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                                       marks.pool, marks.cb_end);
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksNotRun(uint64_t submission) {
+  // Submit thread, before the vkQueueSubmit that signals the job's fence: in the list by the time the command
+  // processor sees the submission completed (and reads the frames holding its marks).
+  std::lock_guard<std::mutex> lock(gpu_marks_not_run_mutex_);
+  gpu_marks_not_run_.push_back(submission);
+}
+
+void VulkanCommandProcessor::GpuMarksRead() {
+  GpuMarks& marks = *gpu_marks_;
+  if (marks.pool == VK_NULL_HANDLE) {
+    return;
+  }
+  // Oldest first (from the slot the next frame would take), and in order: stop at the first frame that isn't
+  // over or whose last submission hasn't completed (submission_completed_: fences seen signaled, so the results
+  // are there and nothing waits).
+  bool wrote = false;
+  bool pending = false;
+  for (uint32_t i = 0; i < GpuMarks::kFrameSlots; ++i) {
+    const uint32_t slot = (marks.next_slot + i) % GpuMarks::kFrameSlots;
+    GpuMarks::Frame& frame = marks.frames[slot];
+    if (!frame.in_use) {
+      continue;
+    }
+    if (pending || !frame.ended || frame.last_submission > submission_completed_) {
+      pending = true;
+      continue;
+    }
+    GpuMarksWriteFrame(slot);
+    wrote = true;
+  }
+  if (wrote && (marks.log_frames >= GpuMarks::kLogFrames || (!pending && !gpu_marks_active_))) {
+    GpuMarksLogSummary();
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksWriteFrame(uint32_t slot) {
+  GpuMarks& marks = *gpu_marks_;
+  GpuMarks::Frame& frame = marks.frames[slot];
+  const uint32_t count = uint32_t(frame.marks.size());
+  // (timestamp, availability) per query; the availability stays 0 for a query without a result.
+  marks.results.assign(size_t(count) * 2, 0);
+  // Review fix: the submissions whose command buffers didn't run (GpuMarksNotRun) never reset or wrote their
+  // marks' queries for this use: they would read as the slot's previous results, or as uninitialized queries.
+  // Not read (no result). A submission's marks are consecutive in a frame, so the others are read in runs. Entries
+  // older than this frame's last submission are no longer needed (frames are written in order; the last one may
+  // also hold marks of the next frame).
+  std::vector<uint64_t>& not_run = marks.not_run;
+  not_run.clear();
+  {
+    std::lock_guard<std::mutex> lock(gpu_marks_not_run_mutex_);
+    if (!gpu_marks_not_run_.empty()) {
+      const uint64_t first_submission = count ? frame.marks.front().submission : frame.last_submission;
+      for (uint64_t submission : gpu_marks_not_run_) {
+        if (submission >= first_submission && submission <= frame.last_submission) {
+          not_run.push_back(submission);
+        }
+      }
+      gpu_marks_not_run_.erase(std::remove_if(gpu_marks_not_run_.begin(), gpu_marks_not_run_.end(),
+                                              [&frame](uint64_t submission) {
+                                                return submission < frame.last_submission;
+                                              }),
+                               gpu_marks_not_run_.end());
+    }
+  }
+  auto ran = [&not_run](uint64_t submission) {
+    return std::find(not_run.begin(), not_run.end(), submission) == not_run.end();
+  };
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  for (uint32_t run_begin = 0; run_begin < count;) {
+    if (!ran(frame.marks[run_begin].submission)) {
+      ++run_begin;
+      continue;
+    }
+    uint32_t run_end = run_begin + 1;
+    while (run_end < count && ran(frame.marks[run_end].submission)) {
+      ++run_end;
+    }
+    const uint32_t run_count = run_end - run_begin;
+    uint64_t* const run_results = marks.results.data() + size_t(run_begin) * 2;
+    const VkResult result = vulkan_device->functions().vkGetQueryPoolResults(
+        vulkan_device->device(), marks.pool, slot * GpuMarks::kMarksPerFrame + run_begin, run_count,
+        sizeof(uint64_t) * 2 * run_count, run_results, sizeof(uint64_t) * 2,
+        VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+    // VK_NOT_READY: some queries have no result (their commands never ran); the others are valid.
+    if (result != VK_SUCCESS && result != VK_NOT_READY) {
+      std::fill(run_results, run_results + size_t(run_count) * 2, uint64_t(0));
+    }
+    run_begin = run_end;
+  }
+  auto available = [&](uint32_t i) { return marks.results[size_t(i) * 2 + 1] != 0; };
+  auto ticks = [&](uint32_t i) { return marks.results[size_t(i) * 2]; };
+  const uint64_t mask = marks.mask;
+  auto delta = [mask](uint64_t later, uint64_t earlier) -> int64_t {
+    const uint64_t d = (later - earlier) & mask;
+    if (mask != UINT64_MAX && d > (mask >> 1)) {
+      return int64_t(d) - int64_t(mask) - 1;
+    }
+    return int64_t(d);
+  };
+  const double us_per_tick = marks.period_ns / 1000.0;
+  auto us = [&](uint64_t later, uint64_t earlier) { return double(delta(later, earlier)) * us_per_tick; };
+
+  // Times are relative to the frame's first cb_begin with a result (else its first mark with one).
+  bool base_found = false;
+  uint64_t base = 0;
+  for (int pass = 0; pass < 2 && !base_found; ++pass) {
+    for (uint32_t i = 0; i < count; ++i) {
+      if (available(i) && (pass || frame.marks[i].kind == GpuMarkKind::kCbBegin)) {
+        base = ticks(i);
+        base_found = true;
+        break;
+      }
+    }
+  }
+
+  fmt::memory_buffer& text = marks.text;
+  text.clear();
+  auto append_us = [&](bool valid, double value) {
+    if (valid) {
+      fmt::format_to(std::back_inserter(text), ",{:.2f}", value);
+    } else {
+      text.push_back(',');
+    }
+  };
+  auto append_row = [&](uint32_t row, const char* kind, uint64_t submission, bool t_valid, double t_us,
+                        bool prep_valid, double prep_us, bool exec_valid, double exec_us, bool row_valid,
+                        double row_us) {
+    fmt::format_to(std::back_inserter(text), "{},{},{},{}", frame.frame, row, kind, submission);
+    append_us(t_valid, t_us);
+    append_us(prep_valid, prep_us);
+    append_us(exec_valid, exec_us);
+    append_us(row_valid, row_us);
+    text.push_back('\n');
+  };
+
+  // A pre / before mark waiting for its post / after.
+  struct OpenRow {
+    bool valid = false;
+    bool copy = false;
+    uint32_t row = 0;
+    uint64_t submission = 0;
+    bool t_valid = false;
+    uint64_t t = 0;
+    bool prep_valid = false;
+    double prep_us = 0.0;
+  } open_row;
+  double prep_sum_us = 0.0;
+  double exec_sum_us = 0.0;
+  auto flush_open_row = [&](bool post_valid, uint64_t post_t) {
+    const bool exec_valid = open_row.t_valid && post_valid;
+    const double exec_us = exec_valid ? us(post_t, open_row.t) : 0.0;
+    append_row(open_row.row, open_row.copy ? "copy" : "draw", open_row.submission, open_row.t_valid && base_found,
+               open_row.t_valid ? us(open_row.t, base) : 0.0, open_row.prep_valid, open_row.prep_us, exec_valid,
+               exec_us, open_row.prep_valid && exec_valid, open_row.prep_us + exec_us);
+    if (open_row.prep_valid) {
+      prep_sum_us += open_row.prep_us;
+    }
+    if (exec_valid) {
+      exec_sum_us += exec_us;
+    }
+    open_row.valid = false;
+  };
+
+  std::vector<std::pair<int64_t, int64_t>>& intervals = marks.intervals;
+  intervals.clear();
+  uint32_t unavailable = 0;
+  bool prev_valid = false;
+  uint64_t prev_t = 0;
+  uint64_t prev_submission = 0;
+  bool cb_begin_valid = false;
+  uint64_t cb_begin_t = 0;
+  uint64_t cb_begin_submission = 0;
+  // The last cb_end with a result (carried over from the frames written before).
+  bool last_cb_end_valid = marks.last_cb_end_valid;
+  uint64_t last_cb_end_t = marks.last_cb_end_t;
+  uint64_t last_cb_end_submission = marks.last_cb_end_submission;
+  for (uint32_t i = 0; i < count; ++i) {
+    const GpuMarks::Mark& mark = frame.marks[i];
+    const bool valid = available(i);
+    const uint64_t t = valid ? ticks(i) : 0;
+    if (!valid) {
+      ++unavailable;
+    }
+    // The time since the previous mark of the same submission (after a cb_begin: see kCbBegin).
+    const bool since_prev_valid = valid && prev_valid && prev_submission == mark.submission;
+    const double since_prev_us = since_prev_valid ? us(t, prev_t) : 0.0;
+    // Where the next mark of this submission measures from.
+    uint64_t next_prev_t = t;
+    switch (mark.kind) {
+      case GpuMarkKind::kCbBegin:
+        append_row(mark.row, "cb_begin", mark.submission, valid && base_found, valid ? us(t, base) : 0.0, false,
+                   0.0, false, 0.0, false, 0.0);
+        cb_begin_valid = valid;
+        cb_begin_t = t;
+        cb_begin_submission = mark.submission;
+        // Review fix: a top-of-pipe cb_begin may be written while the previous submission's work is still
+        // running, and the bottom-of-pipe mark after it waits for that work. So the submission's first row
+        // measures its prep from the previous submission's cb_end when that is later (known when the previous
+        // submission is the one right before and its cb_end is in this frame or the frame written before).
+        if (valid && last_cb_end_valid && last_cb_end_submission + 1 == mark.submission &&
+            delta(last_cb_end_t, t) > 0) {
+          next_prev_t = last_cb_end_t;
+        }
+        break;
+      case GpuMarkKind::kCbEnd: {
+        // Review fix: a copy still waiting for its after mark here is one whose readback path ended the
+        // submission inside the copy (so it has no after mark): the submission's cb_end, bottom-of-pipe right
+        // after the copy's commands, ends it, and leaves no tail.
+        const bool copy_ended = open_row.valid && open_row.copy && open_row.submission == mark.submission;
+        if (copy_ended) {
+          flush_open_row(valid, t);
+        }
+        const double tail_us = copy_ended ? 0.0 : since_prev_us;
+        append_row(mark.row, "cb_end", mark.submission, valid && base_found, valid ? us(t, base) : 0.0,
+                   since_prev_valid, tail_us, false, 0.0, since_prev_valid, tail_us);
+        if (valid && cb_begin_valid && cb_begin_submission == mark.submission) {
+          intervals.emplace_back(delta(cb_begin_t, base), delta(t, base));
+        }
+        if (valid) {
+          last_cb_end_valid = true;
+          last_cb_end_t = t;
+          last_cb_end_submission = mark.submission;
+        }
+      } break;
+      case GpuMarkKind::kDrawPre:
+      case GpuMarkKind::kCopyBefore:
+        if (open_row.valid) {
+          flush_open_row(false, 0);
+        }
+        open_row.valid = true;
+        open_row.copy = mark.kind == GpuMarkKind::kCopyBefore;
+        open_row.row = mark.row;
+        open_row.submission = mark.submission;
+        open_row.t_valid = valid;
+        open_row.t = t;
+        open_row.prep_valid = since_prev_valid;
+        open_row.prep_us = since_prev_us;
+        break;
+      case GpuMarkKind::kDrawPost:
+      case GpuMarkKind::kCopyAfter: {
+        const bool copy = mark.kind == GpuMarkKind::kCopyAfter;
+        if (open_row.valid && open_row.row == mark.row && open_row.copy == copy) {
+          flush_open_row(valid, t);
+        } else {
+          // Its pre / before mark was dropped.
+          if (open_row.valid) {
+            flush_open_row(false, 0);
+          }
+          append_row(mark.row, copy ? "copy" : "draw", mark.submission, false, 0.0, false, 0.0, false, 0.0, false,
+                     0.0);
+        }
+      } break;
+    }
+    if (valid) {
+      prev_valid = true;
+      prev_t = next_prev_t;
+      prev_submission = mark.submission;
+    }
+  }
+  if (open_row.valid) {
+    flush_open_row(false, 0);
+  }
+  marks.last_cb_end_valid = last_cb_end_valid;
+  marks.last_cb_end_t = last_cb_end_t;
+  marks.last_cb_end_submission = last_cb_end_submission;
+
+  // Submissions: their cb intervals summed, and their union (submissions may overlap on the GPU).
+  std::sort(intervals.begin(), intervals.end());
+  int64_t cb_sum = 0;
+  int64_t busy = 0;
+  int64_t run_begin = 0;
+  int64_t run_end = 0;
+  int64_t span_end = 0;
+  for (size_t i = 0; i < intervals.size(); ++i) {
+    const auto [begin, end] = intervals[i];
+    cb_sum += end - begin;
+    if (!i) {
+      run_begin = begin;
+      run_end = end;
+    } else if (begin <= run_end) {
+      run_end = std::max(run_end, end);
+    } else {
+      busy += run_end - run_begin;
+      run_begin = begin;
+      run_end = end;
+    }
+    span_end = i ? std::max(span_end, end) : end;
+  }
+  if (!intervals.empty()) {
+    busy += run_end - run_begin;
+  }
+  const int64_t idle = intervals.empty() ? 0 : (span_end - intervals.front().first) - busy;
+  const double cb_sum_us = double(cb_sum) * us_per_tick;
+  const double busy_us = double(busy) * us_per_tick;
+  const double idle_us = double(idle) * us_per_tick;
+
+  GpuMarks::Files* files = frame.files.get();
+  if (files && !files->write_failed && files->rows && files->frames) {
+    bool write_ok = !text.size() || std::fwrite(text.data(), 1, text.size(), files->rows) == text.size();
+    write_ok = std::fprintf(files->frames, "%u,%u,%.2f,%.2f,%.2f,%u,%u,%u\n", frame.frame,
+                            uint32_t(intervals.size()), cb_sum_us, busy_us, idle_us, count, frame.dropped,
+                            unavailable) > 0 &&
+               write_ok;
+    if (!write_ok) {
+      files->write_failed = true;
+      REXGPU_WARN("[s7][GPUMARKS] Write error on {}; no more GPU marks for this capture", files->gpu_path);
+    }
+    marks.log_path = files->gpu_path;
+  }
+
+  ++marks.log_frames;
+  marks.log_marks += count;
+  marks.log_dropped += frame.dropped;
+  marks.log_unavailable += unavailable;
+  marks.log_submissions += intervals.size();
+  marks.log_cb_sum_us += cb_sum_us;
+  marks.log_busy_us += busy_us;
+  marks.log_idle_us += idle_us;
+  marks.log_prep_us += prep_sum_us;
+  marks.log_exec_us += exec_sum_us;
+  ++marks.counter_frames_written;
+
+  frame.in_use = false;
+  frame.files.reset();
+}
+
+void VulkanCommandProcessor::GpuMarksLogSummary() {
+  GpuMarks& marks = *gpu_marks_;
+  if (!marks.log_frames && !marks.log_frames_not_marked) {
+    return;
+  }
+  const double frames = double(std::max(marks.log_frames, uint32_t(1)));
+  REXGPU_INFO(
+      "[s7][GPUMARKS] {} frame(s) written (last to {}), per frame: {:.0f} marks ({:.1f} dropped, {:.1f} without a "
+      "result), {:.1f} submissions, cb sum {:.2f} ms, busy {:.2f} ms, idle gaps {:.2f} ms, rows: prep {:.2f} ms, "
+      "draw/resolve {:.2f} ms; {} frame(s) not marked (query slot still in use)",
