+
+void VulkanCommandProcessor::GpuMarksShutdown() {
+  if (!gpu_marks_) {
+    return;
+  }
+  GpuMarks& marks = *gpu_marks_;
+  // ShutdownContext has awaited all queue operations: write every marked frame that can be.
+  if (gpu_marks_active_) {
+    marks.frames[marks.current].ended = true;
+    gpu_marks_active_ = false;
+  }
+  marks.files.reset();
+  GpuMarksRead();
+  uint32_t abandoned = 0;
+  for (const GpuMarks::Frame& frame : marks.frames) {
+    abandoned += frame.in_use ? 1 : 0;
+  }
+  if (abandoned) {
+    REXGPU_WARN("[s7][GPUMARKS] {} marked frame(s) not written (their GPU work didn't complete)", abandoned);
+  }
+  GpuMarksLogSummary();
+  if (marks.pool != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), marks.pool, nullptr);
+    marks.pool = VK_NULL_HANDLE;
+  }
+  {
+    std::lock_guard<std::mutex> lock(gpu_marks_not_run_mutex_);
+    gpu_marks_not_run_.clear();
+  }
+  gpu_marks_.reset();
+}
