+      marks.log_cb_sum_us / frames / 1000.0, marks.log_busy_us / frames / 1000.0,
+      marks.log_idle_us / frames / 1000.0, marks.log_prep_us / frames / 1000.0,
+      marks.log_exec_us / frames / 1000.0, marks.log_frames_not_marked);
