+// wwe2k14 patch (Session 7c, NOOPSKIP): called at every frame boundary (from CollectFrameCounters, right before the
+// cpf* events and cp_swap). Records, while the timeline is on and either setting is on (or the frame classified a
+// draw), with a fixed layout (for the report tool):
+//   cpf_noop  a = draws that can't change anything (skipped with gpu_skip_noop_draws, would be with the stats
+//             setting only), b = draws writing no color render target but depth (or stencil), c = draws writing
+//             nothing to the EDRAM but rejected for memexport (vertex or pixel shader) or an active occlusion query
+// and logs an [s7][NOOPSKIP] summary every 300 frames when the window classified any draw. The window and its
+// per-frame rates only count classified frames (either setting on at this boundary, or a draw classified in the
+// frame), so a window spanning a toggle (or both settings off) isn't diluted by frames that weren't classified; for
+// an A/B of gpu_skip_noop_draws keep gpu_skip_noop_draws_stats on in both arms, so both are classified and cost the
+// same.
+void VulkanCommandProcessor::NoopSkipFrameBoundary() {
+  NoopSkipStats& stats = noop_skip_stats_;
+  NoopSkipStats::Counts& frame = stats.frame;
+  const bool skip_on = REXCVAR_GET(gpu_skip_noop_draws);
+  const bool frame_classified = frame.checked || skip_on || REXCVAR_GET(gpu_skip_noop_draws_stats);
+  if (frame_classified && perf::timeline::Enabled()) {
+    perf::timeline::Record(
+        "cpf_noop", uint32_t(frame.outcomes[kNoopSkipOk]),
+        uint32_t(frame.outcomes[kNoopSkipRejectDepthWrite] +
+                 frame.outcomes[kNoopSkipRejectStencilWrite]),
+        uint32_t(frame.outcomes[kNoopSkipRejectMemexportVertex] +
+                 frame.outcomes[kNoopSkipRejectMemexportPixel] +
+                 frame.outcomes[kNoopSkipRejectOcclusionQuery]));
+  }
+  // Logs and empties the window. The shader pairs are counted straight into the window by NoopSkipDraw, so they're
+  // emptied here, not when the next window starts (after the next frame's draws).
+  auto close_window = [this, &stats](const char* note) {
+    NoopSkipLogWindow(note);
+    stats.window = NoopSkipStats::Counts();
+    stats.shader_pair_count = 0;
+    stats.shader_pairs_dropped = 0;
+    stats.window_first_frame = UINT64_MAX;
+    stats.window_frames_classified = 0;
+    stats.window_frames_skip_on = 0;
+  };
+  const uint64_t frame_number = frame_current_;
+  if (stats.window_first_frame != UINT64_MAX && frame_number < stats.window_last_frame) {
+    // frame_current_ went back: the context was recreated (ShutdownContext resets it to 1). The pairs of this
+    // frame's draws go into the closed window.
+    close_window(" (partial window: context recreated)");
+  }
+  if (frame_classified) {
+    if (stats.window_first_frame == UINT64_MAX) {
+      stats.window_first_frame = frame_number;
+    }
+    ++stats.window_frames_classified;
+    if (skip_on || frame.skipped) {
+      ++stats.window_frames_skip_on;
+    }
+    NoopSkipStats::Counts& window = stats.window;
+    window.checked += frame.checked;
+    window.color += frame.color;
+    for (uint32_t i = 0; i < kNoopSkipOutcomeCount; ++i) {
+      window.outcomes[i] += frame.outcomes[i];
+    }
+    window.skipped += frame.skipped;
+    frame = NoopSkipStats::Counts();
+  }
+  // Not classified: frame is already empty (frame.checked is 0, and only NoopSkipDraw counts).
+  if (stats.window_first_frame == UINT64_MAX) {
+    return;
+  }
+  stats.window_last_frame = frame_number;
+  if (frame_number - stats.window_first_frame + 1 >= 300) {
+    close_window("");
+  }
+}
