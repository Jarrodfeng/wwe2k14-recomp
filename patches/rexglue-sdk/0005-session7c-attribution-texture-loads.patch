+void VulkanCommandProcessor::NoopSkipLogWindow(const char* note) {
+  const NoopSkipStats& stats = noop_skip_stats_;
+  const NoopSkipStats::Counts& window = stats.window;
+  if (!window.checked || stats.window_first_frame == UINT64_MAX) {
+    return;
+  }
+  static const char* const kRejectNames[kNoopSkipOutcomeCount] = {
+      nullptr, "depth write", "stencil write", "vertex shader memexport", "pixel shader memexport",
+      "occlusion query active"};
+  // Rejection reasons, most first.
+  uint32_t reject_order[kNoopSkipOutcomeCount - 1];
