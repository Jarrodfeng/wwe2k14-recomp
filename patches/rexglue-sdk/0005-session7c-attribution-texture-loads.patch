+void VulkanCommandProcessor::GpuMarksSparseDrawPre() {
+  GpuMarks& marks = *gpu_marks_;
+  marks.sparse_post_pending = false;
+  if (CausesEventSum() != marks.sparse_event_sum) {
+    GpuMark(GpuMarkKind::kDrawPre);
+    marks.sparse_post_pending = true;
+    marks.sparse_post_kind = GpuMarkKind::kDrawPost;
+  } else if (int64_t(anatomy_gpu_row_) + 1 - int64_t(marks.sparse_first_row) >= int64_t(marks.sparse_every)) {
+    // Event-free: a block mark after the draw call ends the block of rows sparse_first_row...this one.
+    marks.sparse_post_pending = true;
+    marks.sparse_post_kind = GpuMarkKind::kBlockEnd;
+  }
+}
+
+void VulkanCommandProcessor::GpuMarksSparseDrawPost() {
+  GpuMarks& marks = *gpu_marks_;
+  if (marks.sparse_post_pending) {
+    marks.sparse_post_pending = false;
+    GpuMark(marks.sparse_post_kind);
+  }
