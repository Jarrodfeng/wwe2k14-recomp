+void VulkanCommandProcessor::GpuMarksBeginSubmission() {
+  GpuMarks& marks = *gpu_marks_;
+  // Bookkeeping only (meaningful while gpu_marks_active_): where the new command buffer's cb_begin will be.
+  marks.open.begin_pos = GpuMarksPosition(true);
+  if (gpu_marks_active_ && gpu_marks_sparse_) {
+    // The cb_begin starts the next interval: no block is open, and the previous submission's tail (after its last
+    // mark, up to its cb_end) doesn't make this submission's first draw eventful.
+    deferred_command_buffer_.SetEventHook(nullptr);
+    marks.sparse_event_sum = CausesEventSum();
+    marks.sparse_first_row = marks.open.begin_pos / 2;
+  }
+}
