# The build stamp (Session 101, lane 19): writes <OUT> (wwe2k14_build_stamp.h) with what the case zip's manifest says about the build:
# the git hash and whether the tree is dirty, the SDK pin, the APK number. Run by the CMake target wwe2k14_stamp on EVERY build
#   cmake -DSRC=<repo> -DOUT=<header> [-DREX_BIN=<dir|dir>] [-DSDK_SRC=<dir>] [-DIS_ANDROID=1] -P tools/build_stamp.cmake
# and the header is rewritten only when its text changes (only src/build_stamp.cpp includes it, so only that file recompiles).
# Nothing from the game: a hash, a flag, an id from tools\sdk_pins.json. A value that cannot be found is "unknown" (the manifest then says why).
#
# The SDK pin (review fixes 2-4, 8): the newest tools/sdk_pins.json entry for which EVERY rex*.dll it lists is in REX_BIN with the same sha256
# (at least two: the runtime and the gpu library; one runtime hash is shared by up to 63 pins). The answer is cached in <OUT>.pin, keyed on the
# DLL hashes + the pin file's size and time, so a build that changed none of them does no JSON work. A pin file that is malformed or half
# written (build_sdk.ps1 writing meanwhile) gives "unknown", never a failed build. Android links the SDK statically: no DLL lookup ("src:<hash>").
cmake_minimum_required(VERSION 3.25)

find_program(GIT_EXE git)
set(GIT "unknown")
set(DIRTY 0)
if(GIT_EXE)
    execute_process(COMMAND "${GIT_EXE}" --no-optional-locks -C "${SRC}" rev-parse --short=12 HEAD OUTPUT_VARIABLE GIT_OUT RESULT_VARIABLE GIT_RC
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(GIT_RC EQUAL 0 AND GIT_OUT)
        set(GIT "${GIT_OUT}")
        execute_process(COMMAND "${GIT_EXE}" --no-optional-locks -C "${SRC}" status --porcelain --untracked-files=no OUTPUT_VARIABLE ST_OUT
                        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(ST_OUT)
            set(DIRTY 1)
        endif()
    endif()
endif()

set(PIN "unknown")
set(PINS_FILE "${SRC}/tools/sdk_pins.json")
set(BIN "")
if(NOT IS_ANDROID)
    string(REPLACE "|" ";" REX_BIN "${REX_BIN}")
    foreach(dir IN LISTS REX_BIN)
        if(dir AND EXISTS "${dir}/rexruntime.dll")
            set(BIN "${dir}")
            break()
        endif()
    endforeach()
endif()

if(BIN AND EXISTS "${PINS_FILE}")
    file(GLOB DLLS "${BIN}/rex*.dll")
    list(SORT DLLS)
    set(KEY "")
    foreach(d IN LISTS DLLS)
        get_filename_component(N "${d}" NAME)
        file(SHA256 "${d}" H_${N})   # (the name has a dot: variable names with dots are fine in CMake)
        string(APPEND KEY "${N}=${H_${N}};")
    endforeach()
    file(SIZE "${PINS_FILE}" PS)
    file(TIMESTAMP "${PINS_FILE}" PT "%s")
    string(APPEND KEY "pins=${PS}@${PT}")
    set(CACHE_FILE "${OUT}.pin")
    set(CACHED "")
    if(EXISTS "${CACHE_FILE}")
        file(STRINGS "${CACHE_FILE}" CACHED_LINES)
        list(LENGTH CACHED_LINES CL)
        if(CL EQUAL 2)
            list(GET CACHED_LINES 0 CACHED_KEY)
            list(GET CACHED_LINES 1 CACHED_PIN)
            if(CACHED_KEY STREQUAL KEY)
                set(CACHED "${CACHED_PIN}")
            endif()
        endif()
    endif()
    if(CACHED)
        set(PIN "${CACHED}")
    else()
        string(SUBSTRING "${H_rexruntime.dll}" 0 12 SHA12)
        set(PIN "unpinned:${SHA12}")
        file(READ "${PINS_FILE}" PINS_JSON)
        string(FIND "${PINS_JSON}" "${H_rexruntime.dll}" FOUND)   # quick out: this runtime is in no pin at all
        set(BAD 0)
        if(NOT FOUND EQUAL -1)
            string(JSON PIN_COUNT ERROR_VARIABLE ERR LENGTH "${PINS_JSON}" pins)
            if(ERR OR NOT PIN_COUNT GREATER 0)
                set(BAD 1)
            else()
                math(EXPR LAST "${PIN_COUNT} - 1")
                foreach(i RANGE ${LAST})
                    string(JSON FILES ERROR_VARIABLE ERR GET "${PINS_JSON}" pins ${i} files)
                    if(ERR)
                        set(BAD 1)
                        break()
                    endif()
                    string(JSON FILE_COUNT ERROR_VARIABLE ERR LENGTH "${FILES}")
                    if(ERR)
                        set(BAD 1)
                        break()
                    endif()
                    set(MATCHED 0)
                    set(ALL_OK 1)
                    math(EXPR FLAST "${FILE_COUNT} - 1")
                    foreach(j RANGE ${FLAST})
                        string(JSON FNAME ERROR_VARIABLE E1 GET "${FILES}" ${j} name)
                        string(JSON FSHA ERROR_VARIABLE E2 GET "${FILES}" ${j} sha256)
                        if(E1 OR E2)
                            set(BAD 1)
                            break()
                        endif()
                        if(FNAME MATCHES "^rex.*\\.dll$")
                            string(TOLOWER "${FSHA}" FSHA)
                            if(DEFINED H_${FNAME} AND FSHA STREQUAL "${H_${FNAME}}")
                                math(EXPR MATCHED "${MATCHED} + 1")
                            else()
                                set(ALL_OK 0)
                            endif()
                        endif()
                    endforeach()
                    if(BAD)
                        break()
                    endif()
                    if(ALL_OK AND MATCHED GREATER 1)
                        string(JSON PIN_ID ERROR_VARIABLE ERR GET "${PINS_JSON}" pins ${i} id)
                        if(NOT ERR)
                            set(PIN "${PIN_ID}")   # the newest entry wins
                        endif()
                    endif()
                endforeach()
            endif()
        endif()
        if(BAD)
            set(PIN "unknown")   # a malformed pin file: no pin, not a failed build (nothing cached)
        else()
            file(WRITE "${CACHE_FILE}" "${KEY}\n${PIN}\n")
        endif()
    endif()
elseif(SDK_SRC AND GIT_EXE AND EXISTS "${SDK_SRC}")
    execute_process(COMMAND "${GIT_EXE}" --no-optional-locks -C "${SDK_SRC}" rev-parse --short=12 HEAD OUTPUT_VARIABLE SDK_OUT RESULT_VARIABLE SDK_RC
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(SDK_RC EQUAL 0 AND SDK_OUT)
        set(PIN "src:${SDK_OUT}")
    endif()
endif()

set(TEXT "// Generated by tools/build_stamp.cmake on every build (Session 101, lane 19). Do not edit, do not commit (out/).\n#pragma once\n")
string(APPEND TEXT "#define WWE2K14_BUILD_GIT \"${GIT}\"\n#define WWE2K14_BUILD_DIRTY ${DIRTY}\n#define WWE2K14_BUILD_SDK_PIN \"${PIN}\"\n")
if(IS_ANDROID AND EXISTS "${SRC}/android/VERSION")
    file(STRINGS "${SRC}/android/VERSION" AV LIMIT_COUNT 1)
    if(AV MATCHES "^android-v([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
        math(EXPR APK "${CMAKE_MATCH_1} * 10000 + ${CMAKE_MATCH_2} * 100 + ${CMAKE_MATCH_3}")
        string(APPEND TEXT "#define WWE2K14_BUILD_APK ${APK}\n")
    endif()
endif()

set(OLD "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" OLD)
endif()
if(NOT OLD STREQUAL TEXT)
    get_filename_component(OUT_DIR "${OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${OUT_DIR}")
    file(WRITE "${OUT}" "${TEXT}")
    message(STATUS "build stamp: git ${GIT} dirty=${DIRTY} sdk ${PIN}")
endif()
