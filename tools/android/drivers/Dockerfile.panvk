# Session 72 part 7: the build box for PanVK (Mali), thirdparty\mali-panvk (github.com/JimVulkan/mali-panvk, MIT; Mesa
# 27.0.0-devel with a kbase backend for stock Android). Its first stage builds host tools that need LLVM 21 with clang,
# libclc and the SPIR-V LLVM translator (its README: "one major version, 21 tested"). Official sources only: Ubuntu's
# packages, PyPI's meson, Google's NDK.
#   built and run by tools\android\drivers\build_drivers.ps1
FROM ubuntu:25.10
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-mako python3-yaml python3-packaging python3-ply \
      bison flex glslang-tools ninja-build pkg-config cmake git wget unzip ca-certificates file \
      llvm-21-dev libclang-21-dev clang-21 libclc-21-dev libllvmspirvlib-21-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages 'meson==1.9.1'
ENV PATH=/usr/lib/llvm-21/bin:$PATH
ARG NDK=android-ndk-r29
RUN wget -q https://dl.google.com/android/repository/${NDK}-linux.zip -O /tmp/ndk.zip \
    && unzip -q /tmp/ndk.zip -d /opt && rm /tmp/ndk.zip && mv /opt/${NDK} /opt/ndk
ENV NDK=/opt/ndk
