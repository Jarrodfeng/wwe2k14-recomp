#version 450
#extension GL_GOOGLE_include_directive : require
// Session 95 (gpu_native_skin_once): every wrestler vertex a frame's draws name, skinned once, into a real vertex buffer every later pass reads (vertex inputs; _so variants of the vertex shaders).
// One dispatch at the head of a submission (the SDK's hoist stream), over a list of 64-vertex chunks. The blend is vs_ch.glsl's own code (both of its compiled forms: CH_SKIN_STYLE), so the
// main pass gets the bits it had; the side passes (shadow, rim) get the same position to the rounding (their own blends sum in another order; every pass of a mesh now agrees exactly).
// Inputs (all bound by the SDK, vulkan/native/skin_once.cpp):
//   mirror_words  the vertex mirror pool: the meshes' vertices in host byte order
//   t / fc        one params buffer seen as uvec4 rows and vec4 rows: a chunk row (job row, first vertex), a job's two rows, the palette
//   out_rows      the output ring: three uvec4 rows a vertex (world.xyz + uv dword, normal.xyz + colour dword, tangent.xyz)
// A job: row 0 (first source dword, dwords a vertex, vertices, first output row / 3), row 1 (flags: bits 1-4 = bool constants b1-b4, bit 8 = CH_SKIN_STYLE 1; palette base; normal scale bits; palette rows).
// The palette base is arranged so that fc.c[76 + a] is the job's own bone register c[76 + a] (a = 3 x the bone byte), which is what lets vs_ch.glsl's code run here unchanged.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) restrict readonly buffer SoMirror { uint mirror_words[]; };
layout(set = 0, binding = 1, std430) restrict writeonly buffer SoOut { uvec4 out_rows[]; };
layout(set = 0, binding = 2, std430) restrict readonly buffer SoParamsFloat { vec4 c[]; } fc;
layout(set = 0, binding = 3, std430) restrict readonly buffer SoParamsRows { uvec4 t[]; };
layout(push_constant) uniform SoPush { uint chunk_top; } so_push;

uint so_flags = 0u;
int so_palette = 0;
float so_top = 0.0;  // the job's last bone's address

uint XeFetchDword(int address) { return mirror_words[address]; }
float XeFetchFloat(int address) { return uintBitsToFloat(XeFetchDword(address)); }

#include "xenos_vs_math.glsl"

bool XeBool(int b) { return ((so_flags >> uint(b)) & 1u) != 0u; }

// The guest's address register (xenos_vs_skin.glsl), moved to this job's palette. Only the bones the palette holds can be named: a byte past them weighs nothing (SkinOnce::PaletteRows) and gets the last bone.
int XeAddress(float x) {
  precise float t = x + 0.5;
  float f = floor(t);
  if (isnan(f)) return so_palette;
  return int(clamp(f, 0.0, so_top)) + so_palette;
}

// vs_ch.glsl's clamp to the 256 registers (xenos_vs_skin.glsl) means nothing here: XeAddress above already keeps the address inside this job's palette.
int XeBone(int a) { return a; }

vec3 AvBone(vec4 p, int a) {
  vec4 q = p.wzxy;
  return vec3(AvDot4R(q, fc.c[76 + a].wzxy), AvDot4R(q, fc.c[77 + a].wzxy), AvDot4R(q, fc.c[78 + a].wzxy));
}

#define CH_SKIN_STYLE 0
#define ChSkin ChSkin0
#define ChSkinTangent ChSkinTangent0
#define ChFetchNormal ChFetchNormal0
#define ChTurn ChTurn0
#define ChBlend ChBlend0
#include "vs_ch.glsl"
#undef VS_CH_GLSL
#undef CH_SKIN_STYLE
#undef ChSkin
#undef ChSkinTangent
#undef ChFetchNormal
#undef ChTurn
#undef ChBlend
#define CH_SKIN_STYLE 1
#define ChSkin ChSkin1
#define ChSkinTangent ChSkinTangent1
#define ChFetchNormal ChFetchNormal1
#define ChTurn ChTurn1
#define ChBlend ChBlend1
#include "vs_ch.glsl"

void main() {
  uvec4 chunk = t[so_push.chunk_top - gl_WorkGroupID.x];
  uvec4 j0 = t[chunk.x];
  uvec4 j1 = t[chunk.x + 1u];
  uint v = chunk.y + gl_LocalInvocationID.x;
  if (v >= j0.z) return;
  uint stride = j0.y;
  int at = int(j0.x + v * stride);
  so_flags = j1.x;
  so_palette = int(j1.y);
  so_top = float(j1.w) - 3.0;
  float scale = uintBitsToFloat(j1.z);

  // The four vertex layouts (dwords): 12 and 11 have blend weights, 9 and 8 are rigid (one byte quad of bones, weights read as 0).
  vec3 weights = vec3(0.0);
  int d_bytes = 4, d_normal = 5, d_tangent = 6, d_quad = 7, d_uv = 8;
  if (stride >= 11u) {
    weights = vec3(XeFetchFloat(at + 4), XeFetchFloat(at + 5), XeFetchFloat(at + 6));
    d_bytes = 7;
    d_normal = 8;
    d_tangent = 9;
    d_quad = stride == 12u ? 10 : 9;
    d_uv = stride == 12u ? 11 : 10;
  } else if (stride == 8u) {
    d_tangent = 5;
    d_quad = 6;
    d_uv = 7;
  }
  vec4 position = AvFetchPosition(at);
  uint packed_bytes = XeFetchDword(at + d_bytes);
  vec4 bytes = vec4(bitfieldExtract(packed_bytes, 0, 8), bitfieldExtract(packed_bytes, 8, 8), bitfieldExtract(packed_bytes, 16, 8),
                    bitfieldExtract(packed_bytes, 24, 8));
  vec3 normal = AvMulX3(vec3(scale), ChFetchNormal0(at + d_normal));
  vec3 tangent_in = AvMulX3(vec3(scale), ChFetchNormal0(at + d_tangent));

  vec3 world, turned;
  if ((so_flags & 256u) != 0u) {
    ChBlend1 s = ChSkin1(position, normal, bytes, weights, 3.0, 1.0, 0.0);
    world = s.position;
    turned = s.normal;
  } else {
    ChBlend0 s = ChSkin0(position, normal, bytes, weights, 3.0, 1.0, 0.0);
    world = s.position;
    turned = s.normal;
  }
  vec3 tangent = ChSkinTangent0(tangent_in, bytes, weights, 3.0, 1.0);

  uint row = (j0.w + v) * 3u;
  out_rows[row] = uvec4(floatBitsToUint(world), XeFetchDword(at + d_uv));
  out_rows[row + 1u] = uvec4(floatBitsToUint(turned), XeFetchDword(at + d_quad));
  out_rows[row + 2u] = uvec4(floatBitsToUint(tangent), 0u);
}
